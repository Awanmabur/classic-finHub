<% const tariffZone=typeof businessTimeZone==='string'?businessTimeZone:'UTC';
const tariffFormatDate=typeof formatLocalDate==='function'?formatLocalDate:value=>new Date(value).toISOString();
const tariffToday=typeof businessToday==='string'?businessToday:new Date().toISOString().slice(0,10); %>
<script src="/js/network-tariffs.js?v=<%= assetVersion %>" defer></script>
<section class="view show workspaceStack networkTariffPage">
 <section class="card">
  <div class="cardHead"><div><b>Provider rate sheets</b><br><span>Approved deposit and withdrawal rates, organized by network</span></div><a class="btn" href="/tenant/treasury">Cash &amp; float</a></div>
  <div class="cardBody workspaceStack">
   <p class="tiny">Provider charges and expected agent commissions appear together in each sheet, but remain separate in accounting. Rates are estimates; actual commission is recorded only when received.</p>
   <div class="workspaceActions"><a class="btn" href="/tenant/mobile-money/network-activity">Network activity</a><a class="btn" href="/tenant/mobile-money/report">Operations report</a></div>
  </div>
 </section>
 <% const visibleProviderSheets=(data.providerSheets||[]).filter(sheet=>sheet.status==='approved');
    const currentTariffBranch=String(data.selectedBranchId||'');
    const hasActiveMtnWallet=(data.commissions?.wallets||[]).some(wallet=>wallet.network==='MTN'&&wallet.currency==='UGX'&&
      (wallet.branchId?String(wallet.branchId)===currentTariffBranch:true));
    const mtnFullyActivated=visibleProviderSheets.some(sheet=>sheet.network==='MTN'&&sheet.branchId===currentTariffBranch&&sheet.completeMTN);
    const formattedRate=(rate,currency)=>!rate?'—':rate.kind==='basis_points'?(Number(rate.value)/100).toFixed(2)+'%':data.formatMinor(rate.value,currency); %>
 <% if(visibleProviderSheets.length||(data.canActivatePublished&&hasActiveMtnWallet&&!mtnFullyActivated)){ %>
 <section class="card" id="configured-network-sheets">
  <div class="cardHead"><div><b>Network rate sheets</b><span class="tiny">One sheet per provider and branch · deposit and withdrawal rates together</span></div><span class="tag"><%= visibleProviderSheets.length %> active <%= visibleProviderSheets.length===1?'sheet':'sheets' %></span></div>
  <div class="cardBody workspaceStack">
   <% visibleProviderSheets.forEach((sheet,index)=>{ %>
   <details class="networkTariffRecord" <%- index===0?'open':'' %>>
    <summary>
     <span><b><%= sheet.displayName %></b><small><%= sheet.branchName %> · <%= sheet.currency %></small></span>
     <span class="tag"><%= sheet.sourceKind==='published_reference'?'Owner-authorized estimates':'Approved rates' %></span>
    </summary>
    <div class="networkTariffRecordBody workspaceStack">
     <% if(sheet.sourceKind==='published_reference'){ %><p class="tiny">Existing published provider rates, authorized for estimates. Commission is not income until the network actually pays it.</p><% } %>
     <% sheet.operations.forEach(op=>{ %>
      <div class="workspaceStack">
       <b><%= op.label %> rates</b>
       <div class="tableWrap networkTariffScroll" role="region" tabindex="0" aria-label="<%= sheet.displayName %> <%= op.label %> rate ranges">
        <table>
         <thead><tr><th>From</th><th>To</th><% if(op.hasCommission){ %><th>Agent commission</th><% } %><% if(op.hasCharge){ %><th>Customer network fee</th><% } %></tr></thead>
         <tbody><% op.rows.forEach(row=>{ %><tr>
          <td><%= data.formatMinor(row.minMinor,sheet.currency) %></td><td><%= data.formatMinor(row.maxMinor,sheet.currency) %></td>
          <% if(op.hasCommission){ %><td><%= formattedRate(row.commission,sheet.currency) %></td><% } %>
          <% if(op.hasCharge){ %><td><%= formattedRate(row.charge,sheet.currency) %></td><% } %>
         </tr><% }) %></tbody>
        </table>
       </div>
      </div>
     <% }) %>
     <% if(sheet.hasDraft){ %><span class="tiny">A proposed rate update is awaiting review; the existing approved version remains active.</span><% } %>
    </div>
   </details>
   <% }) %>
   <% if(data.canActivatePublished&&hasActiveMtnWallet&&!mtnFullyActivated){ %>
   <form method="post" action="/tenant/mobile-money/tariffs/published/activate" class="networkTariffActions">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="network" value="MTN">
    <input type="hidden" name="scheduleKind" value="all">
    <button class="btn btnPrimary" type="submit">Authorize existing MTN rates</button>
    <span class="tiny">One action uses the saved deposit and withdrawal commission and network fee bands. No rate entry is needed.</span>
   </form>
   <% } %>
  </div>
 </section>
 <% } %>
 <% if(data.canPropose||data.canReview){ %>
 <details class="card networkRateAdvanced" id="technical-rate-settings">
  <summary class="cardHead"><b>Advanced rate maintenance</b><span class="tiny">Edit existing rates, review updates or deactivate a component</span></summary>
  <div class="cardBody">
 <section class="card" id="configured-network-sheets">
  <div class="cardHead"><b>Rate components</b><span class="tiny">Technical settings · not separate provider sheets</span></div>
  <div class="cardBody workspaceStack">
   
   <% data.schedules.forEach(schedule=>{ const branch=data.branches.find(b=>String(b._id)===String(schedule.branchId)); %>
   <details class="networkTariffRecord">
    <summary><span><b><%= schedule.network==='MTN SSD'?'MTN MoMo South Sudan':schedule.network==='MTN'?'MTN MoMo Uganda':schedule.network %></b><small><%= branch?.name||'Assigned branch' %> · <%= schedule.currency %> · <%= ({cash_in:'Customer deposit',cash_out:'Customer withdrawal',send:'Send money',bill_payment:'Bill payment',airtime_sale:'Sell airtime',merchant_payment:'Merchant payment'})[schedule.operation]||schedule.operation %> · <%= schedule.scheduleKind==='customer_network_fee'?'Customer fee':'Agent commission' %> · Version <%= schedule.version %></small></span><span class="tag"><%= schedule.status==='approved'?(schedule.sourceKind==='published_reference'?'Owner-authorized reference estimate':'Approved for quoting'):schedule.status==='retired'?'Retired':'Awaiting independent review' %></span></summary>
    <div class="networkTariffRecordBody">
     <div class="networkTariffMetadata"><span>Effective from <b><%= new Date(schedule.effectiveFrom).toISOString().slice(0,10) %></b></span><span>Source <b><%= schedule.evidenceReference %></b></span><span>Authorized by <b><%= schedule.approvedBy?(schedule.sourceKind==='published_reference'?'Tenant Owner (provider confirmation not implied)':'Independent reviewer'):'Pending' %></b></span></div>
     <div class="tableWrap networkTariffScroll" role="region" tabindex="0" aria-label="Scrollable commission ranges"><table><thead><tr><th>Minimum (<%= schedule.currency %>)</th><th>Maximum</th><th>Rate method</th><th>Rate (minor units or bps)</th></tr></thead><tbody>
      <% schedule.tiers.forEach(tier=>{ %><tr><td><%= data.formatMinor(tier.minMinor,schedule.currency) %></td><td><%= data.formatMinor(tier.maxMinor,schedule.currency) %></td><td><%= tier.rate.kind==='flat'?'Fixed':'Percentage' %></td><td><%= tier.rate.value %><%= tier.rate.kind==='basis_points'?' bps':'' %></td></tr><% }) %>
     </tbody></table></div>

     <form class="networkTariffQuoteForm" method="get" action="/tenant/mobile-money/tariffs/<%= schedule._id %>/quote">
      <label class="field">Transaction amount (<%= schedule.currency %>)<input class="control" name="amount" type="text" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" placeholder="Amount to quote" required></label>
      <button class="btn" type="submit">Estimate commission</button>
      <span class="tiny">Reference estimate only — no money is posted.</span>
     </form>
     <% if(data.canPropose&&schedule.status==='approved'&&(data.actorRole==='Tenant Owner'||String(schedule.branchId)===String(user.branchId))){ %>
     <details class="networkTariffEdit"><summary>Edit approved sheet · prepare next version</summary>
      <form class="networkTariffForm" method="post" data-editor-currency="<%= schedule.currency %>" action="/tenant/mobile-money/tariffs/<%= schedule._id %>/revise">
       <input type="hidden" name="_csrf" value="<%= csrfToken %>">
       <label class="field">Updated provider document or agreement<input class="control" name="evidenceReference" minlength="12" maxlength="350" required value="<%= schedule.evidenceReference %>"></label>
       <div class="row2">
        <label class="field">New effective date (branch-local)<input class="control" type="date" name="effectiveFrom" value="<%= tariffToday %>" required></label>
        <label class="field">Expires on (optional)<input class="control" type="date" name="expiresAt" value="<%= schedule.expiresAt?new Date(schedule.expiresAt).toISOString().slice(0,10):'' %>"></label>
       </div>
       <% if(!data.allProviders.find(p=>p.key===schedule.network)?.currency){ %>
        <label class="field">Verified wallet for this provider market<select class="control" name="walletAccountId" required><option value="">Choose wallet</option><% data.commissions.wallets.filter(w=>w.network===schedule.network&&w.currency===schedule.currency&&String(w.branchId)===String(schedule.branchId)).forEach(w=>{ %><option value="<%= w._id %>"><%= w.name %></option><% }) %></select></label>
       <% } %>
       <label class="field">Rate bands<textarea class="control networkTariffBands" name="bands" rows="7" data-rate-editor maxlength="30000" required><%= data.serializeLines(schedule.tiers) %></textarea></label>
       <div class="networkTariffActions"><button class="btn btnPrimary" type="submit">Submit updated version for review</button><small>The current approved version stays active until its replacement is approved.</small></div>
      </form>
     </details>
     <% } %>
     <% if(data.canPropose&&schedule.status==='draft'&&(data.actorRole==='Tenant Owner'||!data.actorRole||String(schedule.createdBy)===String(data.actorId))){ %>
     <details class="networkTariffEdit"><summary>Edit draft rates</summary>
      <form class="networkTariffForm" method="post" data-editor-currency="<%= schedule.currency %>" action="/tenant/mobile-money/tariffs/<%= schedule._id %>/edit">
       <input type="hidden" name="_csrf" value="<%= csrfToken %>">
       <input type="hidden" name="revision" value="<%= schedule.revision %>">
       <label class="field">Provider contract or rate sheet reference<input class="control" name="evidenceReference" minlength="12" maxlength="350" required value="<%= schedule.evidenceReference %>"></label>
       <label class="field">Rate bands<textarea class="control networkTariffBands" name="bands" rows="7" data-rate-editor maxlength="30000" required spellcheck="false"><%= data.serializeLines(schedule.tiers) %></textarea></label>
       <div class="networkTariffActions"><button class="btn" type="submit">Save draft revisions</button><span class="tiny">Approved schedules are immutable. Updates require an independent review.</span></div>
      </form>
     </details>
     <% } %>
     <% if(data.canReview&&schedule.status==='draft'&&String(schedule.createdBy)!==String(data.actorId||'')){ %>
      <div class="networkTariffAction"><p class="tiny">Review the original provider agreement before approving. You cannot approve your own submission.</p>
       <form action="/tenant/mobile-money/tariffs/<%= schedule._id %>/approve" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btnPrimary">Approve rate sheet</button></form>
      </div>
     <% } %>
     <% if(data.canReview&&schedule.status==='approved'&&(String(schedule.createdBy)!==String(data.actorId||'')||(schedule.sourceKind==='published_reference'&&data.actorRole==='Tenant Owner'))){ %>
      <form action="/tenant/mobile-money/tariffs/<%= schedule._id %>/retire" method="post" class="networkTariffAction"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn">Retire rate sheet</button></form>
     <% } %>
     <p class="tiny">A schedule is an estimate. The provider balance or daily commission statement is required before recognizing actual commission revenue.</p>
    </div>
   </details>
   <% }) %>
  </div>
 </section>

  </div>
 </details>
 <% } %>
 <% if(data.canPropose){ %>
 <details class="card networkNewSheet" id="network-sheet-form">
  <summary class="cardHead"><b>Custom provider rates — only when the built-in sheet is unavailable or outdated</b><span class="tiny">Manual provider agreement · independent review</span></summary>
  <form class="cardBody networkTariffForm" method="post" action="/tenant/mobile-money/tariffs" autocomplete="off">
   <input type="hidden" name="_csrf" value="<%= csrfToken %>">
   <div class="networkTariffFields">
    <label class="field">Network<select name="network" class="control" data-provider-select required><option value="">Choose network</option><% data.providerChoices.forEach(p=>{ %><option value="<%= p.key %>" data-currency="<%= p.currency %>"><%= p.displayName %></option><% }) %></select></label>
    <label class="field">Currency (set by network or verified wallet)<input class="control" type="text" data-provider-currency-display readonly placeholder="Choose a network"><input type="hidden" name="currency" data-provider-currency></label>
    <label class="field" data-tariff-market-wallet-field hidden>Verified network wallet<select name="walletAccountId" class="control" data-tariff-market-wallet disabled><option value="">Choose reconciled network wallet</option><% data.commissions.wallets.forEach(w=>{ %><option value="<%= w._id %>" data-network="<%= w.network %>" data-currency="<%= w.currency %>" data-branch="<%= w.branchId %>"><%= w.name %> · <%= w.currency %></option><% }) %></select><small>For networks serving several markets, your approved wallet determines the currency.</small></label>
    <% if(data.actorRole==='Mobile Money Operator'&&data.branches.length===1){ %>
    <label class="field">Operating branch<input class="control" type="text" value="<%= data.branches[0].name %>" readonly tabindex="-1"><input type="hidden" name="branchId" value="<%= data.branches[0]._id %>"></label>
    <% }else{ %><label class="field">Branch<select name="branchId" class="control" required><option value="">Choose branch</option><% data.branches.forEach(b=>{ %><option value="<%= b._id %>"><%= b.name %></option><% }) %></select></label><% } %>
    <label class="field">Schedule type<select name="scheduleKind" class="control" required><option value="agent_commission">Agent commission paid by provider</option><option value="customer_network_fee">Network charge paid by customer</option></select></label>
    <label class="field">Agent operation<select name="operation" class="control" required><option value="cash_in">Deposit</option><option value="cash_out">Withdrawal</option><option value="send">Send money</option><option value="bill_payment">Pay a bill</option><option value="airtime_sale">Sell airtime or bundles</option><option value="merchant_payment">Merchant payment</option></select></label>
    <label class="field">Effective from (branch-local date)<input type="date" name="effectiveFrom" class="control" required></label>
    <label class="field">Expires (optional)<input type="date" name="expiresAt" class="control"></label>
   </div>
   <label class="field">Provider rate sheet, contract or statement reference<input name="evidenceReference" class="control" minlength="12" maxlength="350" required placeholder="Source document reference, issuer and revision date"><span class="tiny">A source reference records the document's identity; it does not automatically verify a provider-issued tariff.</span></label>
   <label class="field">Amount ranges and rates<textarea name="bands" class="control networkTariffBands" data-rate-editor rows="8" maxlength="30000" required spellcheck="false" placeholder="500, 2500, basis_points, 400&#10;2501, 5000, flat, 110"></textarea><span class="tiny">Enter transaction ranges and choose a fixed commission or percentage. The editor accepts normal currency amounts, checks for valid ranges, and requires independent approval before use. Without JavaScript, enter one line as: minimum minor units, maximum minor units, flat or basis_points, rate.</span></label>
   <div class="networkTariffActions"><button class="btn btnPrimary" type="submit">Submit for review</button><span class="tiny">This does not change customer fees or post any money.</span></div>
  </form>
 </details>
 <% } %>

 <% if(data.postingEnabled||(data.commissions?.records||[]).length){ %>
 <section class="card">
  <div class="cardHead"><div><b>Received provider commissions</b><br><span>Statement-backed receipts, independent review and separate income posting</span></div><span class="tag"><%= data.postingEnabled?'Posting gate enabled':'Posting locked' %></span></div>
  <div class="cardBody workspaceStack">
   <% if(!data.postingEnabled){ %><p class="workspaceNote">Payout posting is disabled until historic wallet commission entries are reconciled and a staging release gate passes. Submissions are stored as evidence only, not treated as cash, float or profit.</p><% } %>
   <% if(data.canSubmitPayout){ %>
   <details class="networkTariffRecord"><summary><b>Record a provider commission credit</b><span class="tag">Requires statement evidence</span></summary>
    <form class="networkTariffRecordBody networkTariffForm" method="post" action="/tenant/mobile-money/tariffs/payouts">
     <input type="hidden" name="_csrf" value="<%= csrfToken %>">
     <div class="networkTariffFields">
      <label class="field">Receiving network wallet<select name="walletAccountId" class="control" data-payout-wallet required><option value="">Choose reconciled wallet</option><% data.commissions.wallets.forEach(wallet=>{ %><option value="<%= wallet._id %>" data-network="<%= wallet.network %>" data-currency="<%= wallet.currency %>" data-time-zone="<%= typeof businessTimeZoneForBranch==='function'?businessTimeZoneForBranch(data.branches.find(b=>String(b._id)===String(wallet.branchId))):tariffZone %>"><%= wallet.name %> · <%= wallet.network==='MTN SSD'?'MTN South Sudan':wallet.network %> · <%= wallet.currency %></option><% }) %></select></label>
      <div class="field"><span>Network and currency</span><div class="networkReadOnly" data-payout-market>Choose a wallet to identify its network and currency</div><input type="hidden" name="network" data-payout-network><input type="hidden" name="currency" data-payout-currency></div>
      <label class="field">Net commission actually credited<input name="amount" class="control" type="text" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" placeholder="0.00" required></label>
      <label class="field">Gross commission before deductions<input name="grossAmount" class="control" type="text" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" placeholder="0.00" required></label>
      <label class="field">Tax withheld by provider<input name="taxWithheld" class="control" type="text" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" value="0" required></label>
      <label class="field">Provider commission deduction / cost<input name="providerCost" class="control" type="text" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" value="0" required></label>
      <label class="field">Provider commission credit reference<input name="providerReference" class="control" minlength="6" maxlength="120" placeholder="Unique credit or statement reference" required></label>
      <label class="field">Actual provider credit time (<span data-credit-time-zone><%= tariffZone %></span> local)<input name="creditedAt" class="control" type="datetime-local" required></label>
     </div>
     <label class="field">Statement evidence and proof reference<input name="statementEvidence" class="control" minlength="12" maxlength="350" placeholder="Statement date, provider, account and trace ID" required></label>
     <div class="networkTariffActions"><button class="btn btnPrimary" type="submit">Submit credit for reconciliation</button><span class="tiny">No balance changes until independent review and a posting-enabled environment.</span></div>
    </form>
   </details>
   <% } %>
   <% if(!data.commissions.records.length){ %><p class="tiny">No commission credits recorded for your permitted wallets.</p><% } %>
   <% data.commissions.records.forEach(payout=>{ %>
    <div class="networkTariffPayout">
     <div class="networkTariffPayoutDetails"><b><%= payout.network==='MTN SSD'?'MTN South Sudan':payout.network %> — <%= data.formatMinor(payout.amountMinor,payout.currency) %></b><span><%= payout.providerReference %> · <%= tariffFormatDate(payout.creditedAt) %> <%= tariffZone %></span><span class="tiny"><%= payout.statementEvidence %></span></div>
     <span class="tag"><%= payout.status==='posted'?'Posted income':payout.status==='rejected'?'Rejected':'Pending review' %></span>
     <% if(data.canReviewPayout&&payout.status==='pending_review'){ %>
     <form class="networkTariffReview" method="post" action="/tenant/mobile-money/tariffs/payouts/<%= payout._id %>/review">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field">Review note (minimum 12 characters)<input class="control" name="note" minlength="12" maxlength="400" placeholder="Compare original provider credit statement and ledger" required></label>
      <div class="networkTariffActions"><button class="btn" name="decision" value="reject">Reject evidence</button>
       <% if(data.postingEnabled){ %><button class="btn btnPrimary" name="decision" value="approve">Approve and post</button><% }else{ %><span class="tiny">Posting requires a verified historical-commission migration and financial release approval.</span><% } %>
      </div>
     </form>
     <% } %>
    </div>
   <% }) %>
  </div>
 </section>

</section>
