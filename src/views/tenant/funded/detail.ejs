<%
  const row=data.execution;
  const directDeposit=data.source?.directDeposit===true;
  const snapshot=row.sourceSnapshot;
  const fundsPath=directDeposit&&typeof visiblePaths!=='undefined'&&visiblePaths.has('/tenant/accounts')
    ? '/tenant/accounts/'+snapshot.customerAccountId : null;
  const depositStatus={pending_review:'Awaiting approval',posted_manual:'Posted',rejected:'Returned'}[row.status];
  const fee=directDeposit?BigInt(snapshot.feeMinor||'0'):0n;
  const depositAmount=value=>formatMoneyMinor(value,snapshot.currency);
%>
<section class="view show">
<% if(directDeposit){ %>
  <section class="card">
    <div class="cardHead">
      <div><b><%= directDeposit?'Customer deposit':row.sourceReference %></b><br><span><%= directDeposit?row.sourceReference:row.action.replaceAll('_',' ') %></span></div>
      <span class="tag"><%= directDeposit?depositStatus:row.status.replaceAll('_',' ') %></span>
    </div>
    <div class="cardBody">
      <div class="summary">
        <% if(directDeposit){ %>
          <div class="sumRow"><span>Customer account</span><b><%= data.source.source.customerName %> · ••••<%= data.source.source.last4 %></b></div>
          <div class="sumRow"><span>Money received in</span><b><%= data.receivingAccountName||snapshot.paymentChannel %></b></div>
          <div class="sumRow"><span>Deposit amount</span><b><%= depositAmount(snapshot.amountMinor) %></b></div>
          <% if(fee>0n){ %>
            <div class="sumRow"><span>Deposit fee</span><b><%= depositAmount(fee) %></b></div>
            <div class="sumRow"><span>Total received</span><b><%= depositAmount(BigInt(snapshot.amountMinor)+fee) %></b></div>
          <% } %>
        <% } %>
        <div class="sumRow"><span><%= directDeposit?'Receipt or statement':'Manual source' %></span><b><%= row.evidenceReference %></b></div>
        <div class="sumRow"><span>Note</span><b><%= row.note %></b></div>
        <% if(row.reviewNote){ %><div class="sumRow"><span>Review note</span><b><%= row.reviewNote %></b></div><% } %>
        <% if(!directDeposit){ %><div class="sumRow"><span>Posted ledger journals</span><b><%= row.journalIds.length %></b></div><% } %>
      </div>
      <div class="rowBtns">
        <% if(fundsPath){ %><a class="btn" href="<%= fundsPath %>#activity">Customer account</a><% } %>
        <a class="btn" href="/tenant/funded">Movement requests</a>
        <% if(!directDeposit){ %><a class="btn" href="/tenant/treasury">Business funds</a><% } %>
      </div>
    </div>
  </section>
<% }else{ %><section class="card"><div class="cardHead"><div><b><%= row.sourceReference %></b><br><span><%= row.action.replaceAll('_',' ') %></span></div><span class="tag"><%= row.status==='posted_manual'?'Final':row.status==='pending_review'?'Not yet finalized':row.status.replaceAll('_',' ') %></span></div><div class="cardBody"><div class="summary"><div class="sumRow"><span>Manual source</span><b><%= row.evidenceReference %></b></div><div class="sumRow"><span>Explanation</span><b><%= row.note %></b></div><div class="sumRow"><span><%= !row.reviewedBy?'Cashier confirmation':'Independent review' %></span><b><%= row.reviewNote||('Awaiting final posting confirmation') %></b></div><div class="sumRow"><span>Posted ledger journals</span><b><%= row.journalIds.length %></b></div></div><p class="tiny">Final ledger postings record actual cashier movements and their supporting evidence. External provider settlement and later physical balance reconciliation are separate facts.</p><div class="rowBtns"><a class="btn" href="/tenant/funded">Manual movements</a><a class="btn" href="/tenant/treasury">Balances &amp; reconciliation</a></div></div></section>
<% } %>
<% if(data.sms){ const notice=data.sms; %><section class="card" style="margin-top:14px" data-transfer-sms-state="<%= notice.state %>"><div class="cardHead"><div><b>Receiver SMS</b><br><span><%= notice.recipientMasked %></span></div><span class="tag"><%= notice.state==='accepted'?'Provider accepted':notice.state.replaceAll('_',' ') %></span></div><div class="cardBody"><p class="tiny"><% if(notice.state==='accepted'){ %>The SMS provider accepted this message. Delivery to the receiver has not been independently confirmed.<% }else if(notice.state==='not_configured'){ %>Receiver SMS is not configured. A platform operator must configure the outbound provider and dedicated encryption key. Use the one-time PIN handoff while it is unavailable.<% }else if(notice.state==='uncertain'){ %>The provider submission outcome is uncertain. Inspect the provider account before sending another message; automatic retry is stopped to prevent duplicate PIN messages.<% }else if(notice.state==='suppressed'){ %><% if(notice.failureCode==='SMS_TRANSFER_PAID'){ %>The transfer was paid out and its queued PIN handoff was cleared. A provider submission already in flight cannot be recalled.<% }else{ %>Sending stopped because the transfer, branch or entitlement is no longer available.<% } %><% }else if(notice.state==='dead'){ %>The provider rejected delivery or retries were exhausted. Correct the provider configuration before requesting an owner retry.<% }else{ %>The receiver message is waiting for provider submission. A PIN message is not proof that cash has been paid out.<% } %></p><% if(notice.failureCode){ %><p class="tiny">Status code: <%= notice.failureCode %></p><% } %><% if(notice.acceptedMessageId){ %><p class="tiny">Provider reference: <%= notice.acceptedMessageId %></p><% } %><% if(data.smsRetryLimited){ %><p class="tiny">The three owner retries are used. Inspect the provider and use the controlled private PIN handoff.</p><% }else if(data.smsRetryCooling){ %><p class="tiny">Wait one minute between owner retries, then refresh this page.</p><% } %><% if(data.canRetrySms){ %><form data-funded-form method="post" action="/tenant/funded/<%= row._id %>/retry-sms"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field">Retry reason<textarea class="control" name="note" minlength="20" maxlength="400" required placeholder="Explain the provider configuration or rejected submission that was corrected"></textarea></label><button class="btn" type="submit">Retry receiver SMS</button></form><% } %></div></section><% } %>
<% if(data.canRevealPin){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Transfer payout PIN</b><span>Shown once</span></div><div class="cardBody"><form data-funded-form method="post" action="/tenant/funded/<%= row._id %>/reveal-pin"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btnPrimary" type="submit">Show payout PIN once</button></form></div></section><% } %>
<% if(data.canFinalizePayout){ %><section class="card" style="margin-top:14px">
 <div class="cardHead"><b>Complete PIN-verified cash payout</b><span>Retry an interrupted same-branch posting without paying twice</span></div>
 <div class="cardBody"><form data-funded-form method="post" action="/tenant/funded/<%= row._id %>/finalize-payout">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if(row.payoutFx){ %><p><strong>Locked receiver cash:</strong> <%= row.payoutFx.targetCurrency %> · <%= typeof formatMoneyMinor==='function'?formatMoneyMinor(row.payoutFx.payoutMinor,row.payoutFx.targetCurrency):row.payoutFx.payoutMinor+' minor units' %></p><% } %>
  <label class="field"><input type="checkbox" name="confirmRecipientVerified" value="yes" required> I independently checked the recipient identity and successful PIN verification.</label>
  <label class="field"><input type="checkbox" name="confirmCashPaid" value="yes" required> The exact cash payout has physically occurred and the original voucher has been checked.</label>
  <button type="submit" class="btn btnPrimary">Finalize actual payout</button>
  <p class="tiny">Never pay the recipient again to retry software posting. This action books the same verified payout reference once.</p>
 </form></div></section><% } %>
<% if(data.canFinalizeCashier){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Finish interrupted final posting</b><span>Idempotent: never repeat a real cash handover</span></div><div class="cardBody"><form data-funded-form method="post" action="/tenant/funded/<%= row._id %>/finalize-cashier"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><input type="checkbox" name="confirmFinalMovement" value="yes" required> The original cash or account movement has already occurred. Post it without moving money a second time.</label><button class="btn btnPrimary" type="submit">Finish final posting</button></form></div></section><% } %>
<% if(data.canFinalizeForex){ %><section class="card" style="margin-top:14px">
 <div class="cardHead"><b>Complete Forex exchange</b><span>Retry an interrupted finalization · no duplicate posting</span></div>
 <div class="cardBody"><form data-funded-form method="post" action="/tenant/funded/<%= row._id %>/finalize-forex">
 <input type="hidden" name="_csrf" value="<%= csrfToken %>">
 <p class="tiny">The original accounts, exchange rate, amount and evidence reference are locked. Confirm the actual money movement before posting.</p>
 <label class="field"><input type="checkbox" name="confirmFundsExchanged" value="yes" required> Both physical currency legs were actually received or paid as agreed.</label>
 <label class="field"><input type="checkbox" name="confirmEvidenceChecked" value="yes" required> I checked the voucher and both actual account balances.</label>
 <button type="submit" class="btn btnPrimary">Finalize Forex exchange</button>
 </form></div></section><% } %>
<% if(data.canReview){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Independent financial review</b></div><div class="cardBody"><form data-funded-form method="post" action="/tenant/funded/<%= row._id %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field">Review evidence<textarea class="control" name="note" minlength="12" maxlength="400" required rows="3"></textarea></label><div class="rowBtns"><button class="btn btnPrimary" name="decision" value="approve" type="submit"><%= directDeposit?'Approve deposit':'Approve and post manual movement' %></button><button class="btn" name="decision" value="reject" type="submit"><%= directDeposit?'Return deposit':'Reject' %></button></div></form></div></section><% } %></section>
