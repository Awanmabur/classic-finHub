<link rel="stylesheet" href="/css/workspace.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/treasury.css?v=<%= assetVersion %>">
<%
 const account=data.account,known=account.openingBalanceMinor!==null;
 const fmt=value=>value===null||value===undefined?'—':data.format(value,account.currency);
 const byBatch=new Map(data.batches.map(batch=>[String(batch._id),batch]));
 const active=account.status!=='archived',owner=user.role==='Tenant Owner';
 const url='/tenant/treasury/accounts/'+account._id;
 const currency=account.currency==='KES'?'KSH':account.currency;
 const ownerCanAdd=owner&&known&&['wallet','cash','bank','forex_stock'].includes(account.kind)&&
   ((account.status==='active'&&account.reconciliationState==='matched')||(account.status==='held'&&account.reconciliationState==='mismatch'));
 const selectingCapital=ownerCanAdd&&data.action==='money';
 const reviewedContribution=data.canRequestContribution&&(!owner||data.action==='reviewed-money');
 const hasPendingEvidence=data.observations.some(row=>row.status==='pending_review');
 const correctableObservation=data.canObserve&&active&&!account.lastObservationStale&&data.observations.find(row=>
   row.status==='approved'&&row.kind==='checkpoint'&&String(account.lastObservationId)===String(row._id)&&
   String(row.varianceMinorAtReview||0)!=='0'&&!data.adjustments.some(adjustment=>String(adjustment.observationId)===String(row._id)));
 const fundingRows=data.fundings||[];
 const pendingFunding=fundingRows.filter(row=>row.status==='pending_review');
 const reviewedFunding=fundingRows.filter(row=>row.status!=='pending_review');
%>
<section class="view show">
 <div class="workspaceStack">
 <section class="card">
  <div class="cardHead">
   <div><b>Current recorded balance</b><br><span><%= account.code %> · <%= account.kind.replaceAll('_',' ') %> · <%= account.network||currency %></span></div>
   <a class="btn" href="/tenant/treasury">All balances</a>
  </div>
  <div class="cardBody workspaceStack">
   <div>
    <div class="treasuryAmount"><%= known?fmt(account.bookBalanceMinor):'Opening balance needed' %></div>
    <% if(account.lastObservationAt){ %><div class="treasurySource">Last actual check <b><%= fmt(account.lastObservedMinor) %></b> · <time datetime="<%= new Date(account.lastObservationAt).toISOString() %>"><%= new Date(account.lastObservationAt).toISOString().slice(0,16).replace('T',' ') %> UTC</time><% if(String(account.lastVarianceMinor||0)!=='0'){ %> · Difference <b><%= fmt(account.lastVarianceMinor) %></b><% } %></div><% } %>
   </div>
   <div class="rowBtns">
    <% if(data.canObserve&&active){ %>
     <% if(ownerCanAdd){ %><a class="btn btnPrimary" href="<%= url %>?action=money#record-balance">Add money</a><% }else if(reviewedContribution){ %><a class="btn btnPrimary" href="<%= url %>?action=money#add-money">Add money</a><% } %>
     <% if(known||!account.pendingOpeningId){ %><a class="btn" href="<%= url %><%= !known&&owner?'#confirm-opening':'?action=check#record-balance' %>"><%= known?'Check balance':'Set opening balance' %></a><% } %>
     <% if(correctableObservation){ %><a class="btn" href="#correct-balance">Correct balance</a><% } %>
     <% if(known&&['wallet','cash','bank'].includes(account.kind)&&account.status==='active'&&account.reconciliationState==='matched'){ %><a class="btn" href="/tenant/treasury?to=<%= account._id %>#add-funds">Transfer existing funds</a><% } %>
    <% } %>
    <% if(data.canManage&&active){ %><a class="btn" href="#edit-account">Edit details</a><% } %>
    <a class="btn" href="#account-activity">Activity</a>
   </div>
  </div>
 </section>
 <% if(account.status==='held'){ %>
 <section class="card" style="margin-top:14px" role="status" aria-label="Resolve held account">
  <div class="cardHead"><div><b>Account on hold — what to check</b><br><span>No spending or closure until this is resolved safely</span></div></div>
  <div class="cardBody">
   <p><strong>Reason:</strong> <%= account.holdReason||'Balance check or ledger review requires attention.' %></p>
   <p class="tiny">Compare the book with the latest real count or statement. If a genuine past transaction was missed or entered incorrectly, use its operation module to record or correct it.</p>
   <p class="tiny">Record a fresh actual balance check below. If a real difference remains, request an independently reviewed reconciliation adjustment. Never change opening capital just to remove a hold.</p>
   <div class="rowBtns"><a class="btn" href="#record-balance">Check actual balance</a><a class="btn" href="/tenant/treasury/review">Review queue</a></div>
  </div>
 </section>
 <% } %>
 <% if(data.canManage&&account.status!=='archived'){ %><details class="card workspaceSecondary" id="edit-account" <%= data.action==='edit'?'open':'' %>><summary>Edit details</summary><form method="post" action="/tenant/treasury/accounts/<%= account._id %>/settings" class="cardBody" data-wallet-settings-form><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row2"><label class="field">Account name<input class="control" name="name" minlength="3" maxlength="120" required value="<%= account.name %>"></label><label class="field">Default for this operation<select class="control" name="isDefault"><option value="true" <%= account.selectionKey?'selected':'' %>>Yes</option><option value="false" <%= !account.selectionKey?'selected':'' %>>No, choose explicitly</option></select></label>
 <% if(account.kind==='wallet'){ %><label class="field">Cash drawer for this network
 <select class="control" name="cashDrawerAccountId">
  <option value="" <%= !account.cashDrawerAccountId?'selected':'' %>>Automatic — use the operator's only approved drawer</option>
  <% (data.cashDrawerOptions||[]).filter(drawer=>!account.operatorId||String(drawer.operatorId)===String(account.operatorId)).forEach(drawer=>{ %>
   <option value="<%= drawer._id %>" <%= String(account.cashDrawerAccountId||'')===String(drawer._id)?'selected':'' %>><%= drawer.name %></option>
  <% }) %>
 </select>
 <span class="tiny">Set this once as Tenant Owner. Only link a drawer that physically holds cash for this provider and operator. When one approved drawer exists, the system resolves it automatically.</span>
</label><label class="field">Fee / commission treatment<select class="control" name="feeTreatment"><% [['record_only','Record only — settle provider commissions separately'],['payment_collected','Verified fee collected from customer — if contract permits']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= (account.feeTreatment||'record_only')===value?'selected':'' %>><%= label %></option><% }) %></select></label><% } %></div><p class="tiny">The default account is selected automatically by operator, network and currency. Provider commission estimates never add spendable float. Customer fees are recognized only when actually collected and contractually permitted. Commission payout destinations are chosen from actual independently reviewed provider-credit evidence under Mobile Money → Agent rate sheets. Historical transactions retain their original policy.</p><button type="submit" class="btn btnPrimary">Save account settings</button></form></details><% } %>
 <% if(data.canManage&&user.role==='Tenant Owner'&&['wallet','cash','bank','forex_stock'].includes(account.kind)&&account.status==='uninitialized'&&!known&&!account.pendingOpeningId&&Number(account.sequence||0)===0&&String(account.bookBalanceMinor||0)==='0'){ %>
 <details class="card" style="margin-top:14px" aria-label="Remove unused account">
  <summary class="cardHead"><b>Remove unused account</b><span>Owner only · reversible archive</span></summary>
  <div class="cardBody">
   <p class="tiny">Created this by mistake? Archive it before its first actual opening or transaction. Its identity and audit history stay saved. Restore it from Quick setup.</p>
   <form method="post" action="/tenant/treasury/accounts/<%= account._id %>/archive">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="confirmCode" value="<%= account.code %>">
    <button class="btn btnDanger" type="submit">Archive this unused account</button>
   </form>
  </div>
 </details>
 <% } %>
 <% if(data.canManage&&user.role==='Tenant Owner'&&['wallet','cash','bank','forex_stock'].includes(account.kind)&&known&&account.status==='active'){ %>
 <details class="card" style="margin-top:14px" aria-label="Close reconciled account">
  <summary class="cardHead"><b>Close this account</b><span>Owner only · keeps all old transactions</span></summary>
  <div class="cardBody">
   <p class="tiny">Settle funds to zero, record a fresh actual zero check, and choose a replacement default. Closure hides this account from NEW transactions but keeps its original IDs, receipts and ledger history.</p>
   <p class="tiny">Book: <b><%= fmt(account.bookBalanceMinor) %></b> · Last actual: <b><%= fmt(account.lastObservedMinor) %></b> · Reconciliation: <b><%= account.reconciliationState %></b></p>
   <form method="post" action="/tenant/treasury/accounts/<%= account._id %>/close" style="display:grid;gap:10px">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="field">Confirm account code <b><%= account.code %></b>
     <input class="control" name="confirmCode" required maxlength="40" autocomplete="off" placeholder="Type exact account code"></label>
    <label class="field">Reason for closing
     <textarea class="control" name="reason" rows="2" minlength="12" maxlength="400" required placeholder="Replaced with a new account after reconciliation"></textarea></label>
    <button class="btn btnDanger" type="submit">Close account · keep history</button>
   </form>
  </div>
 </details>
 <% } %>
 <% if(data.canObserve&&data.canManage&&user.role==='Tenant Owner'&&!known&&account.status==='uninitialized'&&!account.pendingOpeningId){ %>
 <section class="card" id="confirm-opening" style="margin-top:14px">
  <div class="cardHead"><div><b>Confirm starting balance</b><br><span>One owner confirmation · ready immediately</span></div></div>
  <form class="cardBody" method="post" action="/tenant/treasury/accounts/<%= account._id %>/opening">
   <input type="hidden" name="_csrf" value="<%= csrfToken %>">
   <input type="hidden" name="idempotencyKey" value="<%= data.idempotencyKey %>">
   <div class="row2">
    <label class="field">Actual starting money (<%= account.currency==='KES'?'KSH':account.currency %>)
     <input class="control" name="actualBalance" required inputmode="decimal" pattern="<%= account.currency==='UGX'?'[0-9]+':'[0-9]+([.][0-9]{1,2})?' %>" placeholder="Amount counted or verified, including zero"></label>
   </div>
   <p class="tiny">Already have money in this account? Record it here once as the actual opening. Later new business capital can be added separately without another approval.</p>
   <button class="btn btnPrimary" type="submit">Confirm opening and start using</button>
  </form>
 </section><% } %>
 <% if(data.canObserve&&account.status!=='archived'&&known&&user.role==='Tenant Owner'){ %>
 <details class="card workspaceSecondary" id="record-balance" <%= data.action==='check'||selectingCapital?'open':'' %>>
  <summary><%= selectingCapital?'Add new business money':'Record actual balance check' %></summary>
  <form class="cardBody" method="post" action="/tenant/treasury/accounts/<%= account._id %>/record" data-owner-balance-form>
   <input type="hidden" name="_csrf" value="<%= csrfToken %>">
   <input type="hidden" name="idempotencyKey" value="<%= data.idempotencyKey %>">
   <p><strong>Current recorded balance: <%= fmt(account.bookBalanceMinor) %></strong></p>
   <% if(account.status==='held'&&account.reconciliationState==='mismatch'){ %>
   <p role="status" class="tiny"><strong>Balance difference still open.</strong> You can record genuinely new money received, but the account remains held and cannot be used for ordinary transactions until the difference is resolved. The existing book balance and count will not be silently changed.</p>
   <% } %>
   <div class="row2">
    <label class="field">What are you recording?
     <select class="control" name="recordAction" required data-owner-balance-action>
      <option value="check"<%= selectingCapital?'':' selected' %>>Check actual account balance</option>
      <option value="capital" <%= selectingCapital?'selected':ownerCanAdd?'':'disabled' %>>Add new business money</option>
     </select>
    </label>
    <label class="field"><span data-owner-balance-label>Current total actually counted (<%= account.currency==='KES'?'KSH':account.currency %>)</span>
     <input class="control" name="amount" required inputmode="decimal" pattern="<%= account.currency==='UGX'?'[0-9]+':'[0-9]+([.][0-9]{1,2})?' %>" placeholder="Enter amount" data-owner-balance-amount>
    </label>
   </div>
   <p class="tiny" data-owner-balance-hint>Enter the total real balance you counted or checked. A difference will be flagged without inventing or removing money.</p>
   <div class="rowBtns">
    <button class="btn btnPrimary" type="submit" data-owner-balance-submit>Save now</button>
    <% if(data.canRequestContribution&&selectingCapital){ %><a class="btn" href="<%= url %>?action=reviewed-money#add-money">Send a receipt for approval</a><% } %>
   </div>
  </form>
 </details>
 <script src="/js/tenant-owner-balance.js?v=<%= assetVersion %>" defer></script>
 <% }else if(data.canObserve&&!owner&&active&&(known||!account.pendingOpeningId)){ %>
 <details class="card workspaceSecondary" id="record-balance" <%= data.action==='check'||!known?'open':'' %>><summary><%= known?'Record actual balance check':'Submit actual opening balance' %></summary>
 <form method="post" action="/tenant/treasury/accounts/<%= account._id %>/observations" class="cardBody" data-treasury-observation>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="idempotencyKey" value="<%= data.idempotencyKey %>">
  <input type="hidden" name="kind" value="<%= known?'checkpoint':'opening' %>">
  <div class="row2">
   <label class="field">Actual balance shown / counted (<%= account.currency==='KES'?'KSH':account.currency %>)<input class="control" name="actualBalance" inputmode="decimal" required placeholder="Enter the real balance"></label>
   <label class="field">Observed at (UTC)<input class="control" name="observedAt" type="datetime-local" step="0.001" required value="<%= new Date().toISOString().slice(0,-1) %>"></label>
   <label class="field">Evidence type<select class="control" name="evidenceType" required><% ({wallet:['provider_app','provider_statement'],cash:['cash_count'],bank:['bank_statement','provider_app'],forex_stock:['stock_count'],transfer_clearing:['transfer_register','provider_statement']})[account.kind].forEach(type=>{ %><option value="<%= type %>"><%= type.replaceAll('_',' ') %></option><% }) %></select></label>
   <label class="field">Evidence reference<input class="control" name="evidenceReference" minlength="6" maxlength="120" required placeholder="Statement, transaction, stock sheet or count reference"></label>
   <label class="field">Evidence explanation<textarea class="control" name="note" minlength="12" maxlength="400" required rows="2" placeholder="Describe the exact source and how the real balance was checked"></textarea></label>
  </div><button class="btn btnPrimary" type="submit">Submit balance evidence for review</button>
 </form></details><% } %>
 <% if(reviewedContribution){ %>
  <details class="card workspaceSecondary" id="add-money" <%= ['money','reviewed-money'].includes(data.action)?'open':'' %>>
   <summary>Record an owner contribution</summary>
   <form class="cardBody workspaceStack" method="post" action="/tenant/treasury/funding">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="idempotencyKey" value="<%= data.contributionIdempotencyKey %>">
    <input type="hidden" name="sourceKind" value="owner_contribution">
    <input type="hidden" name="destinationAccountId" value="<%= account._id %>">
    <input type="hidden" name="returnToAccount" value="<%= account._id %>">
    <p>Record money received from the owner. A different authorized person approves it before the balance updates.</p>
    <% if(account.kind==='cash'){ %><p class="tiny">Open and verify the <a class="treasuryAccountLink" href="/tenant/cash/shifts">cash day</a> first.</p><% } %>
    <div class="row2">
     <label class="field">Amount (<%= currency %>)<input class="control" name="amount" inputmode="decimal" pattern="<%= account.currency==='UGX'?'[0-9]+':'[0-9]+([.][0-9]{1,2})?' %>" required></label>
     <label class="field">Receipt or statement reference<input class="control" name="evidenceReference" maxlength="120" required></label>
    </div>
    <div><button class="btn btnPrimary" type="submit">Send for approval</button></div>
   </form>
  </details>
 <% } %>
 <% if(pendingFunding.length){ %>
   <section class="card" id="funding-status">
    <div class="cardHead"><b>Funding awaiting approval</b></div>
    <div class="cardBody workspaceStack"><%- include('_funding-history',{fundings:pendingFunding,allowReview:data.canReviewFunding,onAccount:true}) %></div>
   </section>
 <% } %>
 <details class="card workspaceSecondary" id="balance-evidence" <%= hasPendingEvidence||account.status==='held'?'open':'' %>>
  <summary>Actual balance evidence</summary><div class="cardBody">

 <% if(!data.observations.length){ %><p class="tiny">No actual balance evidence has been submitted.</p><% } %>
 <% data.observations.forEach(observation=>{ %><article class="card" style="margin-bottom:12px"><div class="cardHead"><b><%= observation.kind %> · <%= observation.status.replaceAll('_',' ') %></b><span><%= new Date(observation.observedAt).toISOString() %></span></div><div class="cardBody"><div class="summary"><div class="sumRow"><span>Actual balance</span><b><%= fmt(observation.actualMinor) %></b></div><div class="sumRow"><span>Expected at observation</span><b><%= fmt(observation.expectedMinorAtReview??observation.expectedMinorAtRequest) %></b></div><div class="sumRow"><span>Difference</span><b><%= fmt(observation.varianceMinorAtReview??observation.varianceMinorAtRequest) %></b></div><div class="sumRow"><span>Source</span><b><%= observation.evidenceType.replaceAll('_',' ') %> · <%= observation.evidenceReference %></b></div></div><p class="tiny"><%= observation.note %></p><% if(observation.reviewNote){ %><p class="tiny"><%= observation.reviewNote.startsWith('Owner direct balance check')?'Owner record':'Review note' %>: <%= observation.reviewNote %></p><% } %>
 <% if(observation.status==='pending_review'&&data.canReviewBalance?.(observation)){ %><form method="post" action="/tenant/treasury/observations/<%= observation._id %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field">Evidence review note<textarea class="control" name="note" minlength="12" maxlength="400" required rows="2"></textarea></label><div class="rowBtns"><button class="btn btnPrimary" name="decision" value="approve">Approve evidence</button><button class="btn" name="decision" value="reject">Reject evidence</button></div></form><% } %>
 <% if(correctableObservation===observation){ %><form id="correct-balance" method="post" action="/tenant/treasury/observations/<%= observation._id %>/adjustments"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= data.idempotencyKey %>"><label class="field">Why is the correction needed?<textarea class="control" name="reason" minlength="20" maxlength="400" required rows="2" placeholder="Explain what you checked and why the recorded balance needs to change"></textarea></label><button class="btn" type="submit">Send correction for approval</button></form><% } %>
 </div></article><% }) %>
 </div></details>
 <% if(data.adjustments.length){ %><details class="card workspaceSecondary" id="balance-corrections" <%= data.adjustments.some(row=>row.status==='pending_review')?'open':'' %>><summary>Balance corrections</summary><div class="cardBody"><% data.adjustments.forEach(adjustment=>{ %><article class="card" style="margin-bottom:12px"><div class="cardHead"><b><%= adjustment.status %></b><span><%= fmt(adjustment.deltaMinor) %></span></div><div class="cardBody"><p><%= adjustment.reason %></p><% if(adjustment.status==='pending_review'&&data.canReviewAdjustment?.(adjustment)){ %><form method="post" action="/tenant/treasury/adjustments/<%= adjustment._id %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field">Independent adjustment review<textarea class="control" name="note" minlength="20" maxlength="400" required rows="2"></textarea></label><div class="rowBtns"><button class="btn btnPrimary" name="decision" value="approve">Approve visible adjustment</button><button class="btn" name="decision" value="reject">Reject adjustment</button></div></form><% } else { %><p class="tiny"><%= adjustment.reviewNote %></p><% } %></div></article><% }) %></div></details><% } %>
 <details class="card workspaceSecondary" id="account-activity" <%= data.action==='activity'?'open':'' %>>
  <summary>Posted funds activity</summary>
  <div class="cardBody workspaceStack"><div class="tableWrap"><table><thead><tr><th>Recorded UTC</th><th>Actual event UTC</th><th>Source</th><th>Movement</th><th>Book after</th><th>Journal</th></tr></thead><tbody><% if(!data.movements.length){ %><tr><td colspan="6">No funds movements posted.</td></tr><% } %><% data.movements.forEach(movement=>{const batch=byBatch.get(String(movement.batchId)); %><tr data-search-row><td><%= new Date(movement.createdAt).toISOString() %></td><td><%= new Date(movement.occurredAt).toISOString() %></td><td><%= batch?.description||movement.sourceRef %><br><span class="tiny"><%= movement.sourceType %> · <%= movement.sourceRef %><%= batch?.reversesBatchId?' · exact reversal':'' %></span></td><td><%= fmt(movement.deltaMinor) %></td><td><%= fmt(movement.balanceAfterMinor) %></td><td class="mono"><%= movement.journalId %></td></tr><% }) %></tbody></table></div>
  <%- include('_funding-history',{fundings:reviewedFunding,allowReview:()=>false,onAccount:true}) %>
  </div>
 </details>
 </div>
</section>
<script defer src="/js/treasury.js?v=<%= assetVersion %>"></script>
