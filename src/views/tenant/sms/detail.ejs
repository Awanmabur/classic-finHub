<% const item=data.draft, f=item.fields||{}, editable=['parsed','needs_review'].includes(item.state); %>
<section class="view show"><div class="rowBtns"><a class="btn" href="/tenant/sms-capture">Back to SMS inbox</a><a class="btn" href="/tenant/mobile-money">Manual entry</a><span class="tag"><%= item.state.replaceAll('_',' ') %></span></div>
<section class="card" style="margin-top:14px"><div class="cardHead"><b>Captured SMS</b><span><%= item.sender %> · <%= new Date(item.receivedAt).toISOString() %></span></div><div class="cardBody"><pre style="white-space:pre-wrap;overflow-wrap:anywhere"><%= item.body %></pre><p class="tiny">Capture result: <%= item.reasonCode.replaceAll('_',' ') %>. Expires <%= new Date(item.expiresAt).toISOString().slice(0,10) %>.</p>
<% if(item.recordId){ %><a class="btn" href="/tenant/mobile-money/<%= item.recordId %>">Open recorded transaction</a><p class="tiny">Source: SMS. Operational status remains pending verification until independently reviewed.</p><% } %>
<% if(item.dismissalNote){ %><p>Dismissal reason: <%= item.dismissalNote %></p><% } %></div></section>
<% if(editable&&data.canConfirm){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Review and record</b><span>Check every field against provider evidence</span></div><div class="cardBody"><form method="post" action="/tenant/sms-capture/<%= item._id %>/confirm" style="display:grid;grid-template-columns:minmax(0,1fr);min-width:0;gap:12px"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label class="field">Operation<select class="control" name="operation" required><option value="">Choose operation</option><option value="cash_in" <%= f.operation==='cash_in'?'selected':'' %>>Cash in</option><option value="cash_out" <%= f.operation==='cash_out'?'selected':'' %>>Cash out</option></select></label>
<label class="field">Customer<input class="control" name="customer" value="<%= f.customer||'' %>" minlength="2" maxlength="120" required></label>
<label class="field">Network<select class="control" name="network" required><% ['MTN','Airtel','M-Pesa'].forEach(network=>{ %><option value="<%= network %>" <%= f.network===network?'selected':'' %>><%= network %></option><% }) %></select></label>
<label class="field">Provider reference<input class="control" name="networkReference" value="<%= f.networkReference||'' %>" minlength="5" maxlength="100" required></label>
<label class="field">Currency<select class="control" name="currency" required><option value="UGX" <%= f.currency==='UGX'?'selected':'' %>>UGX</option><option value="KES" <%= f.currency==='KES'?'selected':'' %>>KES</option></select></label>
<label class="field">Amount<input class="control" name="amount" value="<%= f.amount||'' %>" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" required></label>
<label class="field">Fee<input class="control" name="fee" value="<%= f.fee||'' %>" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" required></label>
<label class="field">Actual agent wallet balance after transaction<input class="control" name="observedWalletBalance" value="<%= f.observedWalletBalance||'' %>" inputmode="decimal" placeholder="Only the agent wallet balance shown in the original receipt"></label><input type="hidden" name="observationEvidenceReference" value="<%= f.observationEvidenceReference||f.networkReference||'' %>">
<p class="tiny">The transaction uses your account’s operating branch and verified cash shift. Provider reference checks prevent duplicate recordings.</p><button class="btn btnPrimary" type="submit">Record for verification</button></form></div></section><% }else if(editable){ %><p class="tiny">The device’s assigned operator must review and record this SMS using their own verified cash shift.</p><% } %>
<% if(editable){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Dismiss unrelated or invalid SMS</b></div><div class="cardBody"><form method="post" action="/tenant/sms-capture/<%= item._id %>/dismiss" style="display:grid;grid-template-columns:minmax(0,1fr);min-width:0;gap:12px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field">Reason<input class="control" name="note" minlength="8" maxlength="200" required></label><button class="btn" type="submit">Dismiss SMS</button></form></div></section><% } %>
</section>
