NODE_ENV=development
PORT=3000
# Set a real HTTPS URL and SESSION_SECRET (32+ chars) in production.
APP_URL=http://localhost:3000
SESSION_SECRET=
# Default for npm run db:dev:up / npm run dev:local. Existing native MongoDB commonly uses port 27017.
MONGO_PLATFORM_URI=mongodb://127.0.0.1:27018/classicfin_platform_db?replicaSet=rs0&directConnection=true
# Alternative name: PLATFORM_DB_URI. Set one platform variable, or identical
# compatible values for both; clear the local default above when using the alias.
PLATFORM_DB_URI=
# Optional empty-database base for server-only tenant connection links.
# Same deployment/web credential/authSource/TLS/options as the platform URI.
# appName may differ. SRV pairs may omit authSource from both (resolved by DNS).
# Otherwise set the same explicit authSource in both authenticated URIs.
MONGO_URI_BASE=
# Redis is not consumed by this application; sessions/throttles persist in MongoDB.
# Enabled only after a real provider integration and regulatory approvals.
REAL_MONEY_ENABLED=false
TRUST_PROXY=0

# Secure password recovery (HTTPS API, optional for local dev; configure before production launch).
# Resend requires a verified sending domain/address; do not put Purelymail SMTP secrets here.
RESEND_API_KEY=
MAIL_FROM=

# Optional outbound transfer PIN SMS. Web enqueues after independently reviewed
# collection; the separately configured notification worker sends it via Twilio.
# This is separate from inbound Android Mobile Money SMS Capture.
TRANSFER_SMS_PROVIDER=none
# Set a distinct 32-byte/64-hex key before collecting transfers so an encrypted
# handoff is retained for a permitted later SMS retry, even with provider=none.
# Keep this value stable and share privately with the notification worker.
TRANSFER_SMS_ENCRYPTION_KEY=
# Twilio account/token/sender belong in the private notification worker env:
# deploy/notification-worker.env.example (never frontend or source control).

# Mandatory in production. Generate 32 random bytes and write as 64 hexadecimal characters.
MFA_ENCRYPTION_KEY=

# Enable indexing only on the genuine production domain; set false on staging.
# SEO_INDEXING_ENABLED=true

# Separate background process: npm run worker (same database and environment).
# Set a real verified sending domain to enable subscription notification delivery.
OUTBOX_POLL_MS=2000

# For production, supply a separate CLASSICFIN_WORKER_ENV_FILE rather than
# putting a worker database password in the main web application environment.

# Internal trusted gateway keys (two DISTINCT 32-byte hex secrets). Do not expose in frontend.
# These authorize normalized evidence from a provider-verified gateway ONLY; they do
# not authenticate actual payment-provider callbacks or prove bank settlement.
FINANCIAL_GATEWAY_CALLBACK_HMAC_KEY_HEX=
FINANCIAL_GATEWAY_STATEMENT_HMAC_KEY_HEX=

# Trusted edge GeoIP (edge must overwrite/remove client copies).
# Default phone country is South Sudan when no trusted result is available.
GEO_COUNTRY_HEADERS_TRUSTED=false
GEO_COUNTRY_HEADER=cf-ipcountry

# Optional tenant business archives; independent from full replica DR backups.
TENANT_BACKUPS_ENABLED=false
TENANT_BACKUP_ENCRYPTION_KEY=
TENANT_BACKUP_DIR=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Use a dedicated backup worker env; never put its database credential here.
