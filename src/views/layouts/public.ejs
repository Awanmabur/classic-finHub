<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="icon" type="image/png" href="/images/classicfinhub-logo.png">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageMeta.title %></title>
  <meta name="description" content="<%= pageMeta.description %>" />
  <% if(!pageMeta.indexable || !pageMeta.crawlAllowed){ %><meta name="robots" content="noindex,nofollow,noarchive" /><% } %>
  <link rel="canonical" href="<%= pageMeta.canonical %>" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="ClassicFin Hub" />
  <meta property="og:title" content="<%= pageMeta.title %>" />
  <meta property="og:description" content="<%= pageMeta.description %>" />
  <meta property="og:url" content="<%= pageMeta.canonical %>" />
  <meta property="og:image" content="<%= pageMeta.image %>" />
  <meta property="og:image:alt" content="ClassicFin Hub logo" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= pageMeta.title %>" />
  <meta name="twitter:description" content="<%= pageMeta.description %>" />
  <meta name="twitter:image" content="<%= pageMeta.image %>" />
  <% if(pageMeta.indexable){ %><script type="application/ld+json" nonce="<%= cspNonce %>"><%- jsonLd(pageMeta.graph) %></script><% } %>
  <link rel="stylesheet" href="/vendor/inter/inter.css?v=<%= assetVersion %>" />
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= assetVersion %>" />
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/feedback.css?v=<%= typeof assetVersion==='undefined'?'1':assetVersion %>">
</head>
<body>
  <div class="cursor-glow" aria-hidden="true"></div>
  <aside class="side-rail" aria-label="Desktop navigation">
    <a class="rail-logo logo-mark" href="/" aria-label="ClassicFin Hub home"><img src="/images/classicfinhub-logo.png" alt="ClassicFin Hub logo" /></a>
    <nav>
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>"><i class="fa-solid fa-house"></i><span>Home</span></a>
      <a href="/services" class="<%= currentPath === '/services' ? 'active' : '' %>"><i class="fa-solid fa-table-cells-large"></i><span>Modules</span></a>
      <a href="/marketplace" class="<%= currentPath === '/marketplace' ? 'active' : '' %>"><i class="fa-solid fa-store"></i><span>Marketplace</span></a>
      <a href="/book-appointment" class="<%= currentPath === '/book-appointment' ? 'active' : '' %>"><i class="fa-solid fa-calendar-check"></i><span>Book</span></a>
      <a href="/pricing" class="<%= currentPath === '/pricing' ? 'active' : '' %>"><i class="fa-solid fa-tags"></i><span>Pricing</span></a>
      <a href="/price-compare" class="<%= currentPath === '/price-compare' ? 'active' : '' %>"><i class="fa-solid fa-scale-balanced"></i><span>Compare</span></a>
      <a href="/support" class="<%= currentPath === '/support' ? 'active' : '' %>"><i class="fa-solid fa-message"></i><span>Support</span></a>
      <div class="rail-auth">
        <a href="/signin" aria-label="Sign in"><i class="fa-solid fa-right-to-bracket"></i><span>Sign in</span></a>
        <a href="/signup" aria-label="Request setup"><i class="fa-solid fa-user-plus"></i><span>Request setup</span></a>
      </div>
    </nav>
    <button class="rail-theme" id="themeToggle" aria-label="Toggle theme"><i class="fa-solid fa-moon"></i></button>
  </aside>
  <header class="mobile-header">
    <a class="mobile-brand" href="/"><span class="mobile-logo"><img src="/images/classicfinhub-logo.png" alt="ClassicFin Hub logo" /></span><strong>ClassicFin Hub</strong></a>
    <div class="mobile-auth-actions"><a href="/signin">Sign in</a><a href="/signup">Request setup</a></div><button class="mobile-menu-btn" id="menuBtn" aria-label="Open menu"><i class="fa-solid fa-bars-staggered"></i></button>
  </header>
  <nav class="mobile-panel" id="mobilePanel" aria-label="Mobile navigation">
    <a href="/">Home</a><a href="/services">Modules</a><a href="/marketplace">Marketplace</a><a href="/book-appointment">Book demo</a><a href="/pricing">Pricing</a><a href="/price-compare">Price compare</a><a href="/support">Support</a><a href="/product-guide">Product guide</a><a href="/signin">Sign in</a><a href="/signup">Request setup</a><button id="themeToggleMobile"><i class="fa-solid fa-moon"></i> Change theme</button>
  </nav>
  <main class="page smooth-page">
    <%- include('../partials/flash', { flash }) %>
    <%- include(view, { data, modules, plans, tenants, appointments, currentPath }) %>
  </main>
  <footer class="footer" id="contact">
    <div><img src="/images/classicfinhub-logo.png" alt="ClassicFin Hub logo" /><strong>ClassicFin Hub</strong><p>Multi-tenant finance SaaS for Classic Technologies.</p></div>
    <div><a href="/product-guide">Product guide</a><a href="/terms">Terms</a><a href="/privacy">Privacy</a><a href="/cookies">Cookies</a><a href="/refund-policy">Refund policy</a></div>
    <p>© <span id="year"></span> Classic Technologies. All rights reserved.</p>
  </footer>
  <script src="/js/script.js?v=<%= assetVersion %>"></script>
<script src="/js/feedback.js?v=<%= typeof assetVersion==='undefined'?'1':assetVersion %>" defer></script>
</body>
</html>
