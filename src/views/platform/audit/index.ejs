<section class="view show"><section class="card"><div class="cardHead"><b>Platform audit logs</b><span>Every sensitive action is auditable.</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Actor</th><th>Action</th><th>Module</th><th>Record</th><th>Date</th></tr></thead><tbody><% data.auditLogs.forEach(a => { %><tr data-search-row><td><%= a.actor %></td><td><%= a.action %></td><td><%= a.module %></td><td><%= a.record %></td><td><%= a.createdAt %></td></tr><% }) %></tbody></table></div></section></section>
