# Dedicated notification worker, separate least-privilege credential.
NODE_ENV=production
APP_URL=https://replace-with-real-domain.example
MONGO_NOTIFICATION_WORKER_URI=
RESEND_API_KEY=
MAIL_FROM=
NOTIFICATION_POLL_MS=5000
# Same provider/key as web. This worker sends transfer SMS independently of
# the optional staff Notifications or inbound Android SMS Capture subscriptions.
TRANSFER_SMS_PROVIDER=none
TRANSFER_SMS_ENCRYPTION_KEY=
# Configure only when TRANSFER_SMS_PROVIDER=twilio. Never put in web/frontend.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Set exactly one sending identity below, not both.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
