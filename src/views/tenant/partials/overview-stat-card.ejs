<%
// Shared approved stat card. Source data remains server-scoped, and every
// original currency is displayed separately; never sum monetary amounts.
const statRows=Array.isArray(items)?items:[];
const selected=typeof currencyFilter==='string'?currencyFilter:'';
const shownRows=selected?statRows.filter(row=>row.currency===selected):statRows;
const display=value==null?(shownRows.length===1?shownRows[0].formatted:(shownRows.length?'By currency':empty||'—')):value;
%>
<div class="stat" <% if(typeof id==='string'&&id){ %>id="<%= id %>"<% } %> <% if(typeof tooltip==='string'&&tooltip){ %>title="<%= tooltip %>"<% } %>>
 <div class="k"><%= title %></div>
 <div class="v"><%= display %></div>
 <% if(shownRows.length){ %>
 <div class="overviewCurrencyLines" aria-label="<%= title %> amounts by original currency">
  <% shownRows.forEach(row=>{ %>
   <div class="overviewCurrencyLine"><span><%= row.currency==='KES'?'KSH':row.currency %><% if(Number.isInteger(row.count)){ %> · <%= row.count %> transaction<%= row.count===1?'':'s' %><% } %></span><b><%= String(row.formatted||'—').replace(/^KES\s/,'KSH ') %></b></div>
  <% }); %>
 </div>
 <% } %>
 <% if(typeof note==='string'&&note){ %><div class="s"><%= note %></div><% } %>
</div>
