<section class="view show"><section class="card"><div class="cardHead"><b>Regional date and time</b><span>Display preference for this administrator</span></div>
  <div class="cardBody">
   <p class="tiny">Choose the region whose local time you want to see. Timestamps remain stored in UTC for audit, security and reliable event ordering.</p>
   <form method="post" action="/platform/settings/timezone" class="row2">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="field">Admin timezone
      <input class="control" name="timeZone" list="adminZoneSuggestions" value="<%= typeof businessTimeZone==='string'?businessTimeZone:'Africa/Kampala' %>" required maxlength="64" placeholder="Africa/Kampala">
    </label>
    <div class="rowBtns"><button class="btn btnPrimary" type="submit">Save timezone</button></div>
   </form>
   <datalist id="adminZoneSuggestions"><option value="Africa/Kampala"><option value="Africa/Juba"><option value="Africa/Nairobi"><option value="Africa/Kigali"><option value="Africa/Dar_es_Salaam"><option value="Europe/Berlin"><option value="UTC"></datalist>
   <p class="tiny">Current local time: <%= typeof formatLocalDate==='function'?formatLocalDate(new Date()):new Date().toISOString() %> (<%= typeof businessTimeZone==='string'?businessTimeZone:'Africa/Kampala' %>)</p>
  </div></section></section>
