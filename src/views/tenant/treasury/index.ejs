<section class="view show">
 <section class="card"><div class="cardHead"><div><b>Wallets, cash &amp; balances</b><br><span>Expected book and actual evidence</span></div><div class="rowBtns"><% if(data.canCreateAccount){ %><a class="btn" href="#account-setup">Add account</a><% } %><% if(data.canObserve){ %><a class="btn btnPrimary" href="#add-funds">Add funds</a><% } %><% if(data.canReview){ %><a class="btn" href="/tenant/treasury/review">Independent review</a><% } %></div></div><div class="cardBody">
  <p class="tiny"><%= data.snapshot.note %></p>
  <div class="tableWrap"><table><thead><tr><th>Account</th><th>Expected book</th><th>Last actual observation</th><th>Observed at (UTC)</th><th>Difference</th><th>Control</th></tr></thead><tbody>
   <% if(!data.snapshot.accounts.length){ %><tr><td colspan="6">No accounts are configured in this view. Add the wallet, drawer, bank or stock account and confirm its opening balance before using it.</td></tr><% } %>
   <% data.snapshot.accounts.forEach(account=>{ %><tr data-search-row><td><a href="/tenant/treasury/accounts/<%= account._id %>"><b><%= account.name %></b></a><br><span class="tiny"><% if(data.allBranches&&data.branchNames[String(account.branchId)]){ %><%= data.branchNames[String(account.branchId)] %> · <% } %><%= account.code %> · <%= account.kind.replaceAll('_',' ') %><%= account.network?' · '+account.network:'' %></span></td><td><%= account.expectedFormatted %></td><td><%= account.observedFormatted %><% if(account.pendingObservation){ %><br><span class="tiny">Pending actual: <%= account.pendingObservation.actualFormatted %> at <%= new Date(account.pendingObservation.observedAt).toISOString() %></span><% } %></td><td><%= account.lastObservationAt?new Date(account.lastObservationAt).toISOString().slice(0,16).replace('T',' '):'Not observed' %></td><td><%= account.varianceFormatted %></td><td><span class="tag"><%= account.status %> · <%= account.reconciliationState==='matched'?'matched at last reviewed observation':account.reconciliationState %></span></td></tr><% }) %>
  </tbody></table></div>
 </div></section>
 <%- include('_funding') %>
 <% if(data.canCreateAccount){ %><section class="card" style="margin-top:14px" id="account-setup"><div class="cardHead"><b>Add wallet / funds account</b><span><%= data.setupBranch.name %></span></div><form class="cardBody" method="post" action="/tenant/treasury/accounts"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row2">
  <label class="field">Account code<input class="control" name="code" required pattern="[A-Za-z][A-Za-z0-9_]{2,39}" maxlength="40" placeholder="MTN_MAIN"></label><label class="field">Account name<input class="control" name="name" required minlength="3" maxlength="120" placeholder="Actual wallet or drawer name"></label>
  <label class="field">Account kind<select class="control" name="kind" required><% data.kinds.forEach(kind=>{ %><option value="<%= kind %>"><%= kind.replaceAll('_',' ') %></option><% }) %></select></label><label class="field">Currency<select class="control" name="currency" required><% (data.setupBranch.currencies||['UGX','USD','SSP','KES']).forEach(currency=>{ %><option value="<%= currency %>"><%= currency==='KES'?'KSH':currency %></option><% }) %></select></label>
  <label class="field">Wallet network (wallet accounts only)<select class="control" name="network"><option value="">Not a mobile wallet</option><% data.networks.forEach(network=>{ %><option><%= network %></option><% }) %></select></label><label class="field">Assigned operator (required for cash)<select class="control" name="operatorId"><option value="">Shared branch account</option><% data.operators.forEach(operator=>{ %><option value="<%= operator._id %>"><%= operator.name %> · <%= operator.role %></option><% }) %></select></label>
  <label class="field">Wallet / bank identifier<input class="control" name="accountReference" maxlength="80" placeholder="Identifier for the real account; never a PIN or API key"></label><label class="field">Default for this operation<select class="control" name="isDefault"><option value="true">Yes</option><option value="false">No, select this account explicitly</option></select></label>
 </div><p class="tiny">This account will belong to <b><%= data.setupBranch.name %></b>. Creating an account does not create any funds.</p><button class="btn btnPrimary" type="submit">Create account</button></form></section><% }else if(data.canManage){ %><section class="card" style="margin-top:14px" id="account-setup"><div class="cardHead"><b>Add wallet / funds account</b></div><div class="cardBody"><p class="tiny">Choose a branch in the viewing control to add an account.</p></div></section><% } %>
 <% if(data.canReview){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Actual balance review queue</b><span>Different person required</span></div><div class="cardBody">
  <% if(!data.queue.length){ %><p class="tiny">No evidence awaits your independent review.</p><% } %>
  <% data.queue.forEach(observation=>{ %><div class="tx"><div class="txMeta"><b><a href="/tenant/treasury/accounts/<%= observation.accountId %>"><%= observation.account.name %> · <%= observation.kind %></a></b><span><%= observation.evidenceType.replaceAll('_',' ') %> · <%= observation.evidenceReference %> · <%= new Date(observation.observedAt).toISOString() %></span></div><b><%= data.format(observation.actualMinor,observation.account.currency) %></b></div><% }) %>
 </div></section><% } %>
 <%- include('_funding-history') %>
</section>
