<section class="view show"><div class="grid3"><% data.modules.forEach(m => { const active = tenant.enabledModules.includes(m.key); %><article class="card" data-search-row><div class="cardHead"><b><i class="fa-solid <%= m.icon %>"></i> <%= m.name %></b><span><%= active ? 'Enabled' : 'Available' %></span></div><div class="cardBody"><p class="tiny"><%= m.description %></p><div class="seg"><% m.permissions.forEach(p => { %><span class="chip <%= active ? 'active' : '' %>"><%= p %></span><% }) %></div><% if (!active) { %><form method="post" action="/tenant/modules/request" style="margin-top:12px"><input type="hidden" name="moduleKey" value="<%= m.key %>" /><button class="btn btnPrimary">Request module</button></form><% } %></div></article><% }) %></div></section>
