<section class="view show">
  <section class="card">
    <div class="cardHead">
      <form method="get" action="/tenant/accounts" class="rowBtns">
        <label class="field">Find an account
          <input class="control" type="search" name="q" value="<%= data.records.q %>" maxlength="100" placeholder="Account number">
        </label>
        <button class="btn" type="submit">Search</button>
      </form>
      <div class="rowBtns">
        <a class="btn" href="/tenant/accounts/movements">All activity</a>
        <% if(data.canManageAccount){ %><a class="btn btnPrimary" href="/tenant/accounts/new" data-directory-open>New account</a><% } %>
      </div>
    </div>
    <div class="cardBody">
      <% if(!data.records.items.length){ %><p>No accounts found.</p><% }else{ %>
        <ul class="customerAccountList">
          <% data.records.items.forEach(account=>{ const href='/tenant/accounts/'+account._id; %>
            <li class="customerAccountRow" data-search-row>
              <div class="customerAccountIdentity">
                <a href="<%= href %>"><b><%= account.customer?.name||'Customer unavailable' %></b></a>
                <span class="tiny"><%= account.accountNumber %><%= account.status!=='active'?' · '+account.status:'' %></span>
              </div>
              <b class="customerAccountBalance"><%= data.formatMinor(account.balance?.minor,account.currency) %></b>
              <div class="rowBtns">
                <a class="btn" href="<%= href %>">Open</a>
                <% if(data.canDeposit&&String(account.branchId)===data.operatingBranchId&&account.status==='active'&&account.customer?.status==='active'){ %>
                  <a class="btn" href="<%= href %>?action=deposit#deposit">Deposit</a>
                <% } %>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
      <% if(data.records.nextCursor){ %><a class="btn" href="/tenant/accounts?q=<%= encodeURIComponent(data.records.q) %>&amp;cursor=<%= encodeURIComponent(data.records.nextCursor) %>">Next accounts</a><% } %>
    </div>
  </section>
  <% if(data.canManageAccount){ %><%- include('modal',{data,user}) %><% } %>
</section>
