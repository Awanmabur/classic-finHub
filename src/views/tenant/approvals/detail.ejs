<section class="view show"><section class="card"><div class="cardHead"><b><%= data.request.reference %></b><span><%= data.request.status.replaceAll('_',' ') %></span></div>
 <div class="cardBody" style="display:grid;gap:10px"><h3><%= data.request.subject %></h3><p><%= data.request.justification %></p>
 <p class="tiny">Policy: <%= data.request.policyName %> · version <%= data.request.policyVersion %> · Category: <%= data.request.category.replaceAll('_',' ') %></p>
 <p class="tiny">Deadline (UTC): <%= new Date(data.request.expiresAt).toISOString().slice(0,16).replace('T',' ') %></p>
 <p class="tiny"><strong>INTERNAL DECISION ONLY.</strong> Approval does not initiate payments, transfers, refunds, account changes, or any financial module's mandatory approval.</p>
 <div class="rowBtns"><a class="btn" href="/tenant/approvals">Back to Approval Workflows</a></div></div></section>
 <section class="card" style="margin-top:14px"><div class="cardHead"><b>Approval chain</b><span>Each reviewer must be a different person</span></div><div class="cardBody"><ol><% data.request.steps.forEach((role,i)=>{const d=data.request.decisions?.find(x=>x.stepIndex===i); %><li><b><%= role %></b> — <%= d?(d.decision+' · '+new Date(d.at).toISOString().slice(0,16).replace('T',' ')+' UTC'):data.request.status==='pending'&&data.request.currentStep===i?'Awaiting review':'Not reached' %>
 <% if(d){ %><p class="tiny"><%= d.note %></p><% } %></li><% }) %></ol></div></section>
 <% if(data.canDecide){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Independent decision</b><span>Step <%= data.request.currentStep+1 %> of <%= data.request.steps.length %></span></div><div class="cardBody">
 <form method="post" action="/tenant/approvals/<%= data.request._id %>/decide" style="display:grid;gap:12px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field">Documented decision reason<textarea class="control" name="note" required minlength="12" maxlength="400" rows="3"></textarea></label><div class="rowBtns"><button class="btn btnPrimary" name="decision" value="approve" type="submit">Approve this step</button><button class="btn" name="decision" value="reject" type="submit">Reject request</button></div></form>
 </div></section><% } %>
 <% if(data.canCancel){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Cancel pending request</b></div><div class="cardBody"><form method="post" action="/tenant/approvals/<%= data.request._id %>/cancel" style="display:grid;gap:12px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field">Reason<textarea class="control" name="note" required minlength="12" maxlength="400" rows="2"></textarea></label><button class="btn" type="submit">Cancel and retain history</button></form></div></section><% } %>
</section>
