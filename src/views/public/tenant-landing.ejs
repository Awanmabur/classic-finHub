<%
const landing=data.landing,tenant=data.tenant,d=landing.details||{};
const businessName=landing.name||tenant.name;
const brandPrimary=/^#[a-fA-F0-9]{6}$/.test(landing.primary||'')?landing.primary:'#082c52';
const brandSecondary=/^#[a-fA-F0-9]{6}$/.test(landing.secondary||'')?landing.secondary:'#0d4f91';
const businessPhone=String(landing.supportPhone||'').replace(/[^+0-9]/g,'');
const whatsapp=String(d.whatsapp||'').replace(/[^0-9]/g,'');
const reviews=data.reviews||{rows:[],summary:{count:0,avg:0}};
const rates=Array.isArray(data.rates)?data.rates:[];
const published=Boolean(landing.publishedAt);
const cityParts=[d.city,d.region,landing.country].filter(Boolean).join(', ');
%>
<article class="publicBusinessProfile" style="--pbPrimary:<%= brandPrimary %>;--pbSecondary:<%= brandSecondary %>">
  <nav class="businessDirCrumbs" aria-label="Breadcrumb"><a href="/">Home</a><i class="fa-solid fa-chevron-right" aria-hidden="true"></i><a href="/businesses">Businesses</a><i class="fa-solid fa-chevron-right" aria-hidden="true"></i><span aria-current="page"><%= businessName %></span></nav>
  <header class="publicBusinessHero">
    <div class="publicBusinessCover">
      <% if(d.coverUrl){ %><img class="publicBusinessCoverImage" src="<%= d.coverUrl %>" alt="Cover image published by <%= businessName %>" loading="eager" decoding="async"><% } %>
    </div>
    <div class="publicBusinessHeading">
      <div class="publicBusinessIdentity">
        <div class="publicBusinessAvatar">
          <% if(d.logoUrl){ %><img src="<%= d.logoUrl %>" alt="<%= businessName %> logo" loading="eager" decoding="async"><% }else{ %><span aria-hidden="true"><%= businessName.trim().slice(0,1).toUpperCase() %></span><% } %>
        </div>
        <div>
          <span class="publicBusinessEyebrow"><i class="fa-solid fa-building" aria-hidden="true"></i> <%= published?'Public business website':'ClassicFin Hub business' %></span>
          <h1><%= businessName %></h1>
          <% if(d.category){ %><p class="publicBusinessCategory"><%= d.category %></p><% } %>
          <% if(cityParts){ %><p class="publicBusinessLocation"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> <%= cityParts %></p><% } %>
        </div>
      </div>
      <div class="publicBusinessHeroActions">
        <% if(businessPhone){ %><a class="btn btn-dark" href="tel:<%= businessPhone %>"><i class="fa-solid fa-phone" aria-hidden="true"></i> Call business</a><% } %>
        <% if(whatsapp){ %><a class="btn btn-light" href="https://wa.me/<%= whatsapp %>" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> WhatsApp</a><% } %>
        <% if(d.website){ %><a class="btn btn-light" href="<%= d.website %>" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-globe" aria-hidden="true"></i> Website</a><% } %>
      </div>
    </div>
    <div class="publicBusinessIntro">
      <% if(landing.headline){ %><h2><%= landing.headline %></h2><% }else{ %><h2>Business overview</h2><p>Additional business information has not been published yet.</p><% } %>
      <% if(landing.subtitle){ %><p><%= landing.subtitle %></p><% } %>
      <div class="publicBusinessQuickLinks">
        <% if(landing.services?.length){ %><a href="#services">Services</a><% } %>
        <% if(d.about){ %><a href="#about">About</a><% } %>
        <% if(rates.length){ %><a href="#business-rates">Exchange rates</a><% } %>
        <% if(d.gallery?.length){ %><a href="#gallery">Gallery</a><% } %>
        <% if(d.address||d.hours||businessPhone||d.publicEmail){ %><a href="#business-contact">Contact & hours</a><% } %>
        <a href="#business-reviews">Reviews</a>
      </div>
    </div>
  </header>
  <% if(d.about||rates.length){ %>
  <div class="publicBusinessAboutRates">
    <% if(d.about){ %><section class="publicBusinessSection" id="about">
      <div class="publicBusinessSectionHead"><span>Who we are</span><h2>About <%= businessName %></h2></div>
      <div class="publicBusinessAbout"><p><%= d.about %></p></div>
    </section><% } %>
    <% if(rates.length){ %><section class="publicBusinessSection publicBusinessRateSection" id="business-rates">
      <div class="publicBusinessSectionHead"><span>Business prices</span><h2>Exchange rate board</h2></div>
      <div class="publicBusinessRateCard"><p class="publicBusinessRateDisclaimer">Approved rates set by this business, not independent market prices. Confirm the final price before exchanging money.</p>
        <div class="publicBusinessRateScroll"><table><thead><tr><th scope="col">Branch</th><th scope="col">Exchange</th><th scope="col">Type</th><th scope="col">Quoted amount</th></tr></thead><tbody>
        <% rates.forEach(rate=>{ %><tr><td><%= rate.branch %></td><td><strong><%= rate.base %></strong><small>to <%= rate.to %></small></td><td><%= rate.side==='buy'?'Buy':rate.side==='sell'?'Sell':'Indicative' %></td><td><strong><%= rate.price %> <%= rate.to %></strong><small>Valid until <%= new Date(rate.expiresAt).toLocaleString('en-GB',{timeZone:'UTC',timeZoneName:'short'}) %></small></td></tr><% }) %>
        </tbody></table></div>
      </div>
    </section><% } %>
  </div>
  <% } %>
  <% if(landing.services?.length){ %>
  <section class="publicBusinessSection" id="services">
    <div class="publicBusinessSectionHead"><span>Our expertise</span><h2>Services & offerings</h2></div>
    <div class="publicBusinessServices">
      <% landing.services.forEach(service=>{ %><article><span class="publicBusinessServiceIcon"><i class="fa-solid fa-briefcase" aria-hidden="true"></i></span><h3><%= service %></h3></article><% }) %>
    </div>
  </section>
  <% } %>
  <% if(landing.sections?.length){ %>
  <section class="publicBusinessSection" id="more-info">
    <div class="publicBusinessSectionHead"><span>Explore more</span><h2>Business information</h2></div>
    <div class="publicBusinessDetails">
      <% landing.sections.forEach(section=>{ %><article><h3><%= section.name %></h3><p><%= section.description %></p></article><% }) %>
    </div>
  </section>
  <% } %>
  <% if(d.gallery?.length){ %>
  <section class="publicBusinessSection" id="gallery">
    <div class="publicBusinessSectionHead"><span>See our business</span><h2>Photo gallery</h2></div>
    <div class="publicBusinessGallery"><% d.gallery.forEach((src,i)=>{ %><a href="<%= src %>" rel="noopener noreferrer" target="_blank" aria-label="View business gallery photo <%= i+1 %>"><img loading="lazy" decoding="async" src="<%= src %>" alt="<%= businessName %> photo <%= i+1 %>"></a><% }) %></div>
  </section>
  <% } %>
  <% if(d.address||d.city||d.hours||businessPhone||d.publicEmail||d.whatsapp||d.facebook||d.instagram||d.linkedin){ %>
  <section class="publicBusinessSection" id="business-contact">
    <div class="publicBusinessSectionHead"><span>Get in touch</span><h2>Visit or contact us</h2></div>
    <div class="publicBusinessDetails">
      <% if(d.address||cityParts){ %><article><h3><i class="fa-solid fa-location-dot" aria-hidden="true"></i> Location</h3><p><%= [d.address,cityParts].filter(Boolean).join(', ') %></p></article><% } %>
      <% if(d.hours){ %><article><h3><i class="fa-regular fa-clock" aria-hidden="true"></i> Opening hours</h3><p><%= d.hours %></p></article><% } %>
      <% if(businessPhone||d.publicEmail||whatsapp){ %><article><h3>Public contact</h3><div class="publicBusinessContactLinks">
        <% if(businessPhone){ %><a href="tel:<%= businessPhone %>"><i class="fa-solid fa-phone" aria-hidden="true"></i> <%= landing.supportPhone %></a><% } %>
        <% if(d.publicEmail){ %><a href="mailto:<%= d.publicEmail %>"><i class="fa-solid fa-envelope" aria-hidden="true"></i> <%= d.publicEmail %></a><% } %>
        <% if(whatsapp){ %><a href="https://wa.me/<%= whatsapp %>" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> WhatsApp</a><% } %>
      </div></article><% } %>
      <% if(d.facebook||d.instagram||d.linkedin){ %><article><h3>Follow our business</h3><div class="publicBusinessContactLinks">
        <% if(d.facebook){ %><a href="<%= d.facebook %>" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-facebook" aria-hidden="true"></i> Facebook</a><% } %>
        <% if(d.instagram){ %><a href="<%= d.instagram %>" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-instagram" aria-hidden="true"></i> Instagram</a><% } %>
        <% if(d.linkedin){ %><a href="<%= d.linkedin %>" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-linkedin" aria-hidden="true"></i> LinkedIn</a><% } %>
      </div></article><% } %>
    </div>
  </section>
  <% } %>
  <section class="publicBusinessSection publicBusinessReviews" id="business-reviews">
    <div class="publicBusinessSectionHead"><span>Customer experience</span><h2>Customer ratings & reviews</h2></div>
    <p class="publicBusinessReviewSummary"><% if(reviews.summary.count){ %><strong><%= reviews.summary.avg.toFixed(1) %> / 5</strong> from <%= reviews.summary.count %> published <%= reviews.summary.count===1?'review':'reviews' %>.<% }else{ %>No published customer reviews yet.<% } %> Reviews appear immediately and may be removed if abusive or fraudulent; they do not verify a transaction or imply endorsement by ClassicFin Hub.</p>
    <% if(reviews.rows.length){ %>
      <div class="publicBusinessReviewGrid"><% reviews.rows.forEach(review=>{ %>
        <article class="publicBusinessReviewCard"><div class="publicBusinessReviewStars" aria-label="<%= review.rating %> out of 5 stars"><%= '★'.repeat(review.rating)+'☆'.repeat(5-review.rating) %></div>
          <h3><%= review.authorName %></h3><p><%= review.comment %></p>
          <% if(review.ownerReply){ %><div class="publicBusinessOwnerReply"><strong>Business response</strong><p><%= review.ownerReply %></p></div><% } %>
        </article>
      <% }) %></div>
    <% } %>
    <div class="publicBusinessReviewForm">
      <h3>Share your experience</h3>
      <p>Genuine customer feedback helps others understand this business. Reviews appear immediately. Customers can edit or withdraw reviews from their original browser, and abusive content can be removed.</p>
      <div class="publicBusinessHeroActions">
        <a class="btn btn-dark" href="/t/<%= encodeURIComponent(tenant.slug) %>/review"><i class="fa-solid fa-star" aria-hidden="true"></i> Write a review</a>
        <% if(data.myReview){ %><a class="btn btn-light" href="/t/<%= encodeURIComponent(tenant.slug) %>/my-review">Edit or withdraw my review</a><% } %>
      </div>
    </div>
  </section>
  <div class="publicBusinessShare"><span>Share this business</span><a class="btn btn-light" href="/t/<%= encodeURIComponent(tenant.slug) %>"><i class="fa-solid fa-link" aria-hidden="true"></i> Permanent profile link</a><button type="button" class="btn btn-dark" data-business-copy-url>Copy link</button></div>
</article>
<script src="/js/business-profile.js?v=<%= assetVersion %>" defer></script>
