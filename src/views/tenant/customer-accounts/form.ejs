<% const editing=!!data.formRecord, r=data.formRecord||{}, kind=data.formKind, customer=kind==='customer', action=customer?(editing?'/tenant/customers/'+r._id+'/update':'/tenant/customers'):(editing?'/tenant/accounts/'+r._id+'/update':'/tenant/accounts'), val=k=>r[k]||''; %>
<form id="directoryForm" method="post" action="<%= action %>" autocomplete="off">
 <input type="hidden" name="_csrf" value="<%= csrfToken %>">
 <% if(editing){ %><input type="hidden" name="revision" value="<%= r.revision %>"><% }else{ %><input type="hidden" name="idempotencyKey" value="<%= data.idempotencyKey %>"><% } %>
 <% if(customer){ %>
 <div class="formSection"><div class="formSectionTitle">Customer identity</div>
  <div class="row2"><label class="field">Full name<input class="control" name="name" value="<%= val('name') %>" placeholder="Customer full name" minlength="2" maxlength="120" required></label><label class="field">Phone<input class="control" name="phone" value="<%= val('phone') %>" placeholder="+256..." type="tel" maxlength="40" required></label></div>
  <div class="row2"><label class="field">Email<input class="control" name="email" value="<%= val('email') %>" placeholder="Optional email" type="email" maxlength="254"></label><label class="field">ID / Passport No.<input class="control" name="identityNumber" value="<%= val('identityNumber') %>" placeholder="National ID or passport" maxlength="60"></label></div>
  <div class="row2"><label class="field">Customer type<select class="control" name="type"><% ['Individual','Business','Agent'].forEach(type=>{ %><option <%= r.type===type?'selected':'' %>><%= type %></option><% }) %></select></label><label class="field">Customer reference<input class="control" name="reference" value="<%= val('reference') %>" placeholder="Auto-generated if empty" maxlength="32" <%= editing?'readonly':'' %>></label></div>
 </div>
 <div class="formSection"><div class="formSectionTitle">Next of kin / emergency contact</div><div class="row3">
  <label class="field">Next of kin name<input class="control" name="nextOfKinName" value="<%= val('nextOfKinName') %>" placeholder="Full name" maxlength="120"></label><label class="field">Next of kin phone<input class="control" name="nextOfKinPhone" value="<%= val('nextOfKinPhone') %>" placeholder="+256..." type="tel" maxlength="40"></label><label class="field">Relationship<input class="control" name="relationship" value="<%= val('relationship') %>" placeholder="Parent, spouse, sibling..." maxlength="60"></label>
 </div></div>
 <div class="formSection"><div class="formSectionTitle">Address and notes</div><div class="row2"><label class="field">Country<input class="control" name="country" value="<%= val('country') %>" placeholder="Country" maxlength="80"></label><label class="field">City / area<input class="control" name="city" value="<%= val('city') %>" placeholder="City or area" maxlength="100"></label></div><label class="field">Address / notes<textarea class="control" name="note" placeholder="Optional address or note" maxlength="500" rows="2"><%= val('note') %></textarea></label></div>
 <% }else{ %>
 <div class="formSection"><div class="formSectionTitle">Account owner</div>
 <% if(editing){ %><label class="field">Customer<span class="control"><%= r.customer?.name||'Customer unavailable' %> · <%= r.customer?.reference||'' %></span></label><% }else{ %>
  <label class="field">Find customer<input class="control" type="search" data-customer-lookup placeholder="Search full name, phone or customer reference" maxlength="100" aria-describedby="customerSearchHelp"></label><p class="tiny" id="customerSearchHelp">Search all active customers in your operating branch. Up to 50 matching customers are shown.</p>
  <label class="field">Customer<select class="control" name="customerId" data-customer-choices required><option value="">Select customer</option><% (data.customerChoices||[]).forEach(c=>{ %><option value="<%= c._id %>"><%= c.name %> · <%= c.phone %> · <%= c.reference %></option><% }) %></select></label><p class="tiny" data-customer-search-status aria-live="polite"></p>
 <% } %>
 <div class="row2"><label class="field">Account number<input class="control" name="accountNumber" value="<%= val('accountNumber') %>" placeholder="Auto-generated if empty" maxlength="32" <%= editing?'readonly':'' %>></label><label class="field">Account type<select class="control" name="type"><% ['Current Account','Savings Account','Agent Account','Business Account'].forEach(type=>{ %><option <%= r.type===type?'selected':'' %>><%= type %></option><% }) %></select></label></div>
 <div class="row2"><label class="field">Status<select class="control" name="status"><% ['active','pending','suspended',...(editing?['closed']:[])].forEach(status=>{ %><option value="<%= status %>" <%= r.status===status?'selected':'' %>><%= status[0].toUpperCase()+status.slice(1) %></option><% }) %></select></label><label class="field">Overdraft limit<input class="control" name="overdraftLimit" value="0" readonly aria-describedby="overdraftHelp"></label></div><p class="tiny" id="overdraftHelp">Overdraft facilities are unavailable. Account status records the directory state; it does not authorize a payment.</p>
 </div>
 <div class="formSection"><div class="formSectionTitle">Account intelligence</div><div class="row2"><label class="field">Account branch<span class="control"><%= typeof operationBranch!=='undefined'&&operationBranch&&!editing?operationBranch.name:'Assigned when the account was created' %></span></label><label class="field">Account officer<input class="control" name="officer" value="<%= editing?val('officer'):user.name %>" placeholder="Officer / teller name" maxlength="120"></label></div><div class="row2"><label class="field">Purpose / source of funds<input class="control" name="purpose" value="<%= val('purpose') %>" placeholder="Salary, business, agent float..." maxlength="240"></label><label class="field">KYC risk level<select class="control" name="risk"><% ['Low','Medium','High'].forEach(risk=>{ %><option <%= r.risk===risk?'selected':'' %>><%= risk %></option><% }) %></select></label></div></div>
 <% if(!editing){ %><div class="formSection"><div class="formSectionTitle">Opening balances</div><div class="row2"><label class="field">Opening UGX<input class="control" name="openingUGX" value="0" readonly></label><label class="field">Opening USD<input class="control" name="openingUSD" value="0" readonly></label></div><div class="row2"><label class="field">Opening SSP<input class="control" name="openingSSP" value="0" readonly></label><label class="field">Opening KSH<input class="control" name="openingKES" value="0" readonly></label></div><p class="tiny">New accounts start with no ledger postings. Balances come from verified ledger journals in the branch currency.</p></div><% } %>
 <% } %>
 <div class="rowBtns"><button type="submit" class="btn btnPrimary"><%= editing?(customer?'Save customer':'Save account'):(customer?'Create customer':'Create account') %></button></div>
</form>
