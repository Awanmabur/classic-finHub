<section class="view show">
  <p class="tiny"><a class="btn" href="/tenant/mobile-money/<%= data.record._id %>/acknowledgement">Print internal acknowledgement</a> Not proof of payment or settlement.</p>
  <section class="card"><div class="cardHead"><b>Recorded operation</b><span>Original financial details are retained</span><a class="btn" href="/tenant/mobile-money/history">History</a></div>
  <div class="cardBody"><div class="row3">
    <p><b>Network:</b> <%= data.record.network %></p>
    <p><b>Entry source:</b> <%= data.record.entrySource==='sms'?'SMS capture':'Manual entry' %></p>
    <p><b>Wallet / agent float reference:</b> <%= data.record.networkReference %></p>
    <p><b>Operation:</b> <%= data.record.operation === 'cash_in' ? 'Cash-in' : 'Cash-out' %></p>
    <p><b>Customer name:</b> <%= data.record.customer %></p>
    <p><b>Customer phone:</b> <%= data.record.customerPhone || 'Not provided' %></p>
    <p><b>Customer ID / note:</b> <%= data.record.customerNote || 'Not provided' %></p>
    <p><b>Payment method:</b> <%= data.record.paymentMethod || 'Cash' %></p>
    <p><b>Amount:</b> <%= money(data.record.currency,amountFromMinor(data.record.amountMinor,data.record.currency)) %></p>
    <p><b>Fee / commission:</b> <%= money(data.record.currency,amountFromMinor(data.record.feeMinor,data.record.currency)) %></p>
    <p><b>Recorded (UTC):</b> <%= new Date(data.record.createdAt).toISOString() %></p>
    <p><b>Internal review:</b> <%= (data.record.reviewState||'awaiting_review').replaceAll('_',' ') %></p>
    <p><b>Correction:</b> <%= (data.record.correctionState||'none').replaceAll('_',' ') %></p>
    <p><b>Record status:</b> <%= data.record.status.replaceAll('_',' ') %></p>
  </div><p class="tiny">An internally voided entry is retained for investigation and reporting. It does not reverse any provider transaction, refund a customer or settle a balance.</p></div></section>
  <% if(data.record.agentCommissionEstimate||data.record.customerNetworkFeeEstimate){ %>
  <section class="card" style="margin-top:14px"><div class="cardHead"><div><b>Saved network rate estimates</b><br><span>Captured from the approved schedule version at transaction time</span></div><a class="btn" href="/tenant/mobile-money/tariffs">Rate sheets</a></div>
   <div class="cardBody"><div class="summary">
    <div class="sumRow"><span>Agent commission estimate</span><b><%= data.record.agentCommissionEstimate?data.formatMoneyMinor(data.record.agentCommissionEstimate.amountMinor,data.record.currency):'No verified matching rate' %></b></div>
    <% if(data.record.agentCommissionEstimate){ %><div class="sumRow"><span>Agent rate sheet version</span><b><%= data.record.agentCommissionEstimate.version %> · Expected only</b></div><% } %>
    <div class="sumRow"><span>Customer network charge estimate</span><b><%= data.record.customerNetworkFeeEstimate?data.formatMoneyMinor(data.record.customerNetworkFeeEstimate.amountMinor,data.record.currency):'No verified matching rate' %></b></div>
    <% if(data.record.customerNetworkFeeEstimate){ %><div class="sumRow"><span>Customer charge sheet version</span><b><%= data.record.customerNetworkFeeEstimate.version %> · Provider charge, not agent earnings</b></div><% } %>
    <div class="sumRow"><span>Commission actually received</span><b>Requires separate provider settlement evidence</b></div>
   </div><p class="tiny">Neither estimate changed the customer transaction amount, cash drawer, provider float, journal, profit or income. The signed provider statement and independent settlement review determine actual earnings.</p></div>
  </section>
  <% } %>
  <% if(data.canViewFunds){ const observation=data.walletObservation; %>
  <section class="card" style="margin-top:14px"><div class="cardHead"><div><b>Wallet balance and evidence</b><br><span>Book amounts at this entry and the reported network balance</span></div><a class="btn" href="/tenant/treasury">Balances &amp; reconciliation</a></div><div class="cardBody">
    <% if(data.record.fundingState==='book_recorded'){ %><div class="summary">
      <div class="sumRow"><span>Book wallet balance before</span><b><%= data.formatMoneyMinor(data.record.walletBalanceBeforeMinor,data.record.currency) %></b></div>
      <div class="sumRow"><span>Book wallet balance after this entry</span><b><%= data.formatMoneyMinor(data.record.walletBalanceAfterMinor,data.record.currency) %></b></div>
      <div class="sumRow"><span>Fee treatment</span><b><%= (data.record.feeTreatment||'record_only').replaceAll('_',' ') %></b></div>
      <% if(observation){ const variance=observation.varianceMinorAtReview??observation.varianceMinorAtRequest; %>
      <div class="sumRow"><span>Reported actual wallet balance</span><b><%= data.formatMoneyMinor(observation.actualMinor,data.record.currency) %></b></div>
      <div class="sumRow"><span>Difference at observation</span><b><%= variance===null?'Not yet calculated':data.formatMoneyMinor(variance,data.record.currency) %></b></div>
      <div class="sumRow"><span>Observed (UTC)</span><b><%= new Date(observation.observedAt).toISOString() %></b></div>
      <div class="sumRow"><span>Evidence</span><b><%= observation.evidenceType.replaceAll('_',' ') %> · <%= observation.evidenceReference %></b></div>
      <div class="sumRow"><span>Evidence review</span><b><%= observation.status.replaceAll('_',' ') %><%= observation.reviewedAt?' · '+new Date(observation.reviewedAt).toISOString():'' %></b></div>
      <% }else{ %><div class="sumRow"><span>Actual wallet evidence</span><b>No balance observation attached</b></div><% } %>
      <div class="sumRow"><span>Balanced book journals</span><b><%= (data.record.fundJournalIds||[]).length %></b></div>
    </div><p class="tiny">The actual balance is dated evidence from the network app, statement or SMS. Independent review confirms that observation; it does not provide a live provider balance. An internal void posts inverse book movements while retaining this original evidence.</p>
    <% }else{ %><p class="tiny">This historical entry predates the funded book. It does not establish an accurate wallet balance. Start from a dated, independently reviewed opening balance.</p><% } %>
  </div></section><% } %>
  <% if(data.canRequestCorrection){ %>
  <section class="card" style="margin-top:14px"><div class="cardHead"><b>Request a correction</b><span>Original entry is preserved</span></div>
    <div class="cardBody"><form method="post" action="/tenant/mobile-money/<%= data.record._id %>/request-void">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field">Explain the recording error (12–400 characters)
        <textarea class="control" name="note" minlength="12" maxlength="400" rows="3" required></textarea></label>
      <div class="rowBtns"><button class="btn btnPrimary" type="submit">Submit void request</button></div>
    </form></div>
  </section><% } %>
  <% if(data.canReviewCorrection){ %>
  <section class="card" style="margin-top:14px"><div class="cardHead"><b>Decide correction request</b><span>Must be a second person</span></div>
    <div class="cardBody"><p class="tiny">Submitted reason: <%= data.record.correctionReason %></p>
    <form method="post" action="/tenant/mobile-money/<%= data.record._id %>/decide-void">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field">Your supporting evidence (12–400 characters)
        <textarea class="control" name="note" minlength="12" maxlength="400" rows="3" required></textarea></label>
      <div class="rowBtns"><button class="btn btnPrimary" name="decision" value="approve">Approve internal void</button>
        <button class="btn" name="decision" value="deny">Deny request</button></div>
    </form></div>
  </section><% } %>
  <section class="card" style="margin-top:14px"><div class="cardHead"><b>Correction decisions</b><span>Chronological evidence history</span></div>
    <div class="cardBody tableWrap"><table><thead><tr><th>Time (UTC)</th><th>Action</th><th>Decision note</th></tr></thead><tbody>
      <% if(!(data.record.correctionHistory||[]).length){ %><tr><td colspan="3">No corrections requested.</td></tr><% } %>
      <% (data.record.correctionHistory||[]).forEach(entry=>{ %><tr><td><%= new Date(entry.at).toISOString() %></td><td><%= entry.action %></td><td><%= entry.note %></td></tr><% }) %>
    </tbody></table></div>
  </section>
</section>
