<% const funds=data.funds||{wallets:[],customerAccounts:[]};
   const walletOptions=funds.wallets||[],customerOptions=funds.customerAccounts||[]; %>
<div class="row2" data-mobile-funds>
 <input type="hidden" name="walletFeePolicy" data-wallet-fee-policy disabled>
 <label class="field">Wallet<select class="control" name="walletAccountId" required data-wallet-account><option value="">Select wallet</option><% walletOptions.forEach(wallet=>{ %><option value="<%= wallet.id %>" data-network="<%= wallet.network %>" data-currency="<%= wallet.currency %>" data-expected-minor="<%= wallet.expectedMinor??'' %>" data-state="<%= wallet.state %>" data-default="<%= wallet.isDefault?'true':'false' %>" data-assigned="<%= wallet.assignedToOperator?'true':'false' %>" data-fee-treatment="<%= wallet.feeTreatment||'record_only' %>" <%= wallet.state!=='active'||wallet.expectedMinor===null?'disabled':'' %>><%= wallet.name %></option><% }) %></select><% if(!walletOptions.length){ %><span class="tiny">No wallet configured. Your administrator can add one on the Wallets page.</span><% } %></label>
 <label class="field" data-customer-wallet-field hidden>Customer account<select class="control" name="customerAccountId" required data-customer-wallet disabled><option value="">Select customer account</option><% customerOptions.forEach(account=>{ %><option value="<%= account.id %>" data-currency="<%= account.currency %>"><%= account.name %> · ****<%= account.last4 %> · <%= account.currency==='KES'?'KSH':account.currency %></option><% }) %></select></label>
 <label class="field" data-payment-account-field hidden>Operating cash or bank account<select class="control" name="paymentAccountId" data-payment-account disabled><option value="">Choose the actual account</option><% (funds.paymentAccounts||[]).forEach(account=>{ %><option value="<%= account.id %>" data-method="<%= account.kind==='cash'?'Cash':'Bank' %>" data-currency="<%= account.currency %>" data-state="<%= account.state %>" data-opened="<%= account.expectedMinor!==null?'true':'false' %>" data-default="<%= account.isDefault?'true':'false' %>" <%= account.state!=='active'||account.expectedMinor===null?'disabled':'' %>><%= account.name %> · <%= account.currency %></option><% }) %></select><span class="tiny">Only an approved account for this payment method and currency can be used. When there is exactly one eligible account, the system selects it automatically.</span></label>
</div>
