<section class="view show platformAppointmentPage">
  <section class="card">
    <div class="cardHead"><div><b>Appointment requests</b><br><span>Review and schedule onboarding requests</span></div></div>
    <div class="cardBody">
      <form method="get" action="/platform/appointments" class="row3 appointmentFilters">
        <label class="field">Status<select class="control" name="status"><option value="">All statuses</option><% ['pending','confirmed','completed','cancelled'].forEach(status=>{ %><option value="<%= status %>" <%= data.filters.status===status?'selected':'' %>><%= status %></option><% }) %></select></label>
        <label class="field">Business, contact or email<input class="control" name="q" maxlength="80" value="<%= data.filters.q %>" placeholder="Search appointments"></label>
        <div class="rowBtns"><button class="btn btnPrimary" type="submit">Apply filters</button><a class="btn" href="/platform/appointments">Clear</a></div>
      </form>
    </div>
  </section>
  <section class="card platformAppointmentDirectory">
    <div class="cardHead"><b>Appointments</b><span><%= data.appointments.length %> displayed</span></div>
    <div class="cardBody tableWrap">
      <table class="denseDirectory appointmentTable">
        <thead><tr><th>Business</th><th>Contact</th><th>Preferred date</th><th>Status</th><th>Action</th></tr></thead>
        <tbody>
          <% if(!data.appointments.length){ %><tr><td colspan="5">No appointments match these filters.</td></tr><% } %>
          <% data.appointments.forEach(a=>{ %>
          <tr data-search-row>
            <td><strong><%= a.businessName %></strong></td>
            <td><%= a.contactName %></td>
            <td><%= a.preferredDate?new Date(a.preferredDate).toISOString().slice(0,10):'Flexible' %></td>
            <td><span class="tag"><%= a.status %></span></td>
            <td><a class="btn" href="/platform/appointments/<%= a._id %>">Preview</a></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
  <% if(data.nextCursor){const params=new URLSearchParams({...data.filters,cursor:data.nextCursor}); %><div class="rowBtns appointmentPagination"><a class="btn" href="/platform/appointments?<%= params.toString() %>">Older requests</a></div><% } %>
</section>
