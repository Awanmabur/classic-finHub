      {'@type':'ListItem','position':1,'name':'Home','item':appUrl+'/'},
      {'@type':'ListItem','position':2,'name':'Pricing','item':appUrl+'/pricing'}
    ]
  }).replace(/</g,'\\u003c') %></script>
</head>
<body class="legal-body" id="top">
