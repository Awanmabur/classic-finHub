<section class="view show"><section class="card"><div class="cardHead"><b>Money Transfer history</b><span>Requests and independent decisions</span><a class="btn" href="/tenant/money-transfer">Module overview</a></div><div class="cardBody">
<form method="get" action="/tenant/money-transfer/history" class="row2"><label class="field">Status<select class="control" name="status"><option value="">All statuses</option><% ['requested','approved_pending_provider','collected_manual','paid_out_manual','rejected','cancelled','expired'].forEach(s=>{ %><option value="<%= s %>" <%= data.status===s?'selected':'' %>><%= s.replaceAll('_',' ') %></option><% }) %></select></label><div class="rowBtns"><button class="btn btnPrimary" type="submit">Filter</button></div></form>
<p class="tiny">Results are paginated and scoped by tenant, branch and operator. Sender and receiver details are preserved as recorded when each request was created.</p></div></section>
<section class="card" style="margin-top:14px"><div class="cardHead"><b>Request records</b><span><%= data.records.items.length %> this page</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Created UTC</th><th>Reference</th><th>Beneficiary</th><th>Requested amount</th><th>Status</th><th>Expiry UTC</th></tr></thead><tbody>
<% if(!data.records.items.length){ %><tr><td colspan="6">No request records in this scope.</td></tr><% } %>
<% data.records.items.forEach(t=>{ %><tr data-search-row><td><%= new Date(t.createdAt).toISOString().slice(0,16).replace('T',' ') %></td><td><a href="/tenant/money-transfer/<%= t._id %>"><%= t.reference %></a></td><td><%= t.beneficiary.name %></td><td><%= data.formatMoneyMinor(t.amountMinor,t.currency) %></td><td><%= t.status.replaceAll('_',' ') %></td><td><%= new Date(t.expiresAt).toISOString().slice(0,16).replace('T',' ') %></td></tr><% }) %>
</tbody></table></div>
<% if(data.records.nextCursor){ %><div class="cardBody"><a class="btn" href="/tenant/money-transfer/history?status=<%= encodeURIComponent(data.status) %>&amp;cursor=<%= encodeURIComponent(data.records.nextCursor) %>">Next page</a></div><% } %>
</section></section>
