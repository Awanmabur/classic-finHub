<section class="view show">
 <section class="card"><div class="cardHead"><b>My notification inbox</b><span>Messages for your account only</span></div>
 <div class="cardBody tableWrap"><table><thead><tr><th>Subject</th><th>Created (UTC)</th><th>Read</th><th>Email</th></tr></thead><tbody>
 <% data.inbox.items.forEach(n=>{ %><tr data-search-row><td><a href="/tenant/notifications/<%= n._id %>"><%= n.subject %></a></td>
 <td><%= new Date(n.createdAt).toISOString().slice(0,16).replace('T',' ') %></td><td><%= n.readAt?'Read':'Unread' %></td><td><%= n.emailState.replaceAll('_',' ') %></td></tr><% }) %>
 </tbody></table><% if(!data.inbox.items.length){ %><p class="tiny">No notifications have been sent to your account.</p><% } %>
 <% if(data.inbox.nextCursor){ %><a class="btn" href="/tenant/notifications?cursor=<%= encodeURIComponent(data.inbox.nextCursor) %>">Older messages</a><% } %></div></section>
 <section class="card" style="margin-top:14px"><div class="cardHead"><b>My delivery preferences</b><span>In-app is always available</span></div><div class="cardBody">
 <p class="tiny">Email requires your opt-in and a separately configured delivery provider. Provider acceptance is not a read or delivery receipt. Essential account-security notices are handled by the platform independently of this module.</p>
 <form method="post" action="/tenant/notifications/preferences" class="rowBtns"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
 <label class="field"><input type="checkbox" name="emailOptIn" value="on" <%= data.prefs.emailOptIn?'checked':'' %>> Also request email delivery to my registered account email</label>
 <button class="btn btnPrimary" type="submit">Save preference</button></form></div></section>
 <% if(data.canSend){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Send staff notification</b><span>One active, authorized recipient per request</span></div><div class="cardBody">
 <form method="get" action="/tenant/notifications" class="rowBtns"><label class="field">Find recipient by name<input class="control" name="search" value="<%= data.search %>" maxlength="80" placeholder="Type staff name"></label><button class="btn" type="submit">Search</button></form>
 <form method="post" action="/tenant/notifications/send" autocomplete="off" style="display:grid;gap:12px">
 <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= data.requestKey %>">
 <label class="field">Recipient<select class="control" name="recipientId" required><option value="">Choose active staff</option><% data.recipients.forEach(r=>{ %><option value="<%= r._id %>"><%= r.name %> · <%= r.role %></option><% }) %></select></label>
 <label class="field">Approved template<select class="control" name="templateCode" required><option value="">Choose a template</option><% data.templates.forEach(t=>{ %><option value="<%= t.code %>"><%= t.name %> (v<%= t.version %>)</option><% }) %></select></label>
 <button class="btn btnPrimary" type="submit" <%= data.recipients.length&&data.templates.length?'':'disabled' %>>Create notification</button></form>
 <% if(!data.templates.length){ %><p class="tiny">There are no active templates. Ask the Tenant Owner to publish one.</p><% } %>
 </div></section><% } %>
 <% if(data.canManage){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Publish a template</b><span>New versions never rewrite old messages</span></div><div class="cardBody">
 <form method="post" action="/tenant/notifications/templates" autocomplete="off" style="display:grid;gap:12px"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
 <label class="field">Template code (select an existing code or enter a new one)<input class="control" name="code" list="existingNotificationTemplateCodes" pattern="[a-z][a-z0-9_]{2,39}" placeholder="team_update" required><datalist id="existingNotificationTemplateCodes"><% data.templates.forEach(t=>{ %><option value="<%= t.code %>"><%= t.name %></option><% }) %></datalist></label>
 <label class="field">Name<input class="control" name="name" minlength="3" maxlength="100" required></label>
 <label class="field">Subject<input class="control" name="subject" minlength="3" maxlength="120" required></label>
 <label class="field">Message body<textarea class="control" name="body" rows="4" minlength="5" maxlength="1000" required></textarea></label>
 <p class="tiny">Allowed text variables: <code>{{recipient_name}}</code>, <code>{{tenant_name}}</code>, <code>{{sender_name}}</code>. No HTML or arbitrary URLs are interpreted.</p>
 <label class="field"><input type="checkbox" name="emailAvailable" value="on"> Allow optional email when the recipient opted in</label>
 <button type="submit" class="btn btnPrimary">Publish template version</button></form></div></section>
 <section class="card" style="margin-top:14px"><div class="cardHead"><b>Active templates</b><span>Owner-controlled</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Template</th><th>Version</th><th>Email permitted</th><th>Action</th></tr></thead><tbody>
 <% data.templates.forEach(t=>{ %><tr><td><%= t.name %> <span class="tiny">(<%= t.code %>)</span></td><td><%= t.version %></td><td><%= t.emailAvailable?'Yes':'No' %></td><td><form method="post" action="/tenant/notifications/templates/<%= t.code %>/retire"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Retire</button></form></td></tr><% }) %>
 </tbody></table></div></section><% } %>
 <% if(data.logs.length){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Authorized delivery log</b><span>Email acceptance, retry and suppression states only</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Template</th><th>Created (UTC)</th><th>Email state</th><th>Attempts</th><th>Failure code</th><% if(data.canManage){ %><th>Recovery</th><% } %></tr></thead><tbody>
 <% data.logs.forEach(n=>{ %><tr><td><%= n.templateCode %></td><td><%= new Date(n.createdAt).toISOString().slice(0,16).replace('T',' ') %></td><td><%= n.emailState %></td><td><%= n.attempts %></td><td><%= n.failureCode||'—' %></td><% if(data.canManage){ %><td>
 <% if(n.emailState==='dead'){ %><form method="post" action="/tenant/notifications/<%= n._id %>/requeue">
 <input type="hidden" name="_csrf" value="<%= csrfToken %>">
 <label class="field">Retry reason<input class="control" name="reason" required minlength="20" maxlength="400" placeholder="Document why retry is safe"></label>
 <button class="btn" type="submit">Retry dead-letter email</button></form><% }else{ %>—<% } %></td><% } %></tr><% }) %>
 </tbody></table></div></section><% } %>
</section>
