<% const regionalZone=typeof businessTimeZone==='string'?businessTimeZone:'UTC';
 const regionalTime=typeof formatLocalDate==='function'?formatLocalDate:(v=>new Date(v).toISOString()); %>
<% const cashLabel=(value,currency)=>typeof formatMoneyMinor==='function'?formatMoneyMinor(value,currency):money(currency,amountFromMinor(value,currency)); %>
<% const currentBranch = typeof operationBranch !== 'undefined' ? operationBranch : (data.branches || []).find(b => String(b._id) === String(user.transactionBranchId || user.branchId || data.selectedBranchId || '') && b.status !== 'archived');
   const currentBranchId = currentBranch ? String(currentBranch._id) : null;
   const branchProblem = typeof operationBranchError === 'string' && operationBranchError ? operationBranchError : 'An active operating branch must be assigned to your account before creating records.';
   const selectedShiftCurrency=data.selectedCurrency||currentBranch?.currency||'';
   const unfinishedShift=(data.shifts?.items||[]).find(shift=>String(shift.operatorId)===String(user.id)&&String(shift.branchId)===String(currentBranchId)&&shift.currency===selectedShiftCurrency&&['pending_open','open','submitted','disputed'].includes(shift.status));
   const shiftStateLabel=state=>({pending_open:'Waiting for verification',open:'Open · recording',submitted:'Closing cash to check',approved:'Closed and reconciled',opening_rejected:'Opening rejected',disputed:'Count disputed'})[state]||String(state).replaceAll('_',' '); %>
<section class="view show">
 <%- include('../../partials/operation-branch', {currentBranch, branchProblem, user}) %>
  <section class="card">
    <div class="cardHead"><b>Start cash shift</b><span>Only when you are taking responsibility for physical cash</span></div>
    <div class="cardBody">
      <p class="tiny">Count the cash in your drawer. If it matches the amount below, confirm and start. The system does not create or add money by starting a shift.</p>
      <details class="logicNote"><summary>What do the cash control amounts mean?</summary>
       <p><b>Cash drawer:</b> Your assigned physical cash account, not the provider's electronic float.</p>
       <p><b>Opening cash:</b> Physical money counted at the start, checked against the existing cash book.</p>
       <p><b>Cash movement:</b> Deposits increase cash; withdrawals and paid expenses decrease it.</p>
       <p><b>Expected closing:</b> Opening count plus posted cash movements, not commission estimates.</p>
       <p><b>Count variance:</b> The difference between real closing cash and the expected cash. A supervisor reviews it.</p>
      </details>
      <% if(data.canOpen&&currentBranch){ %>
      <% const books=data.openingBooks||[]; %>
      <% if(books.length){ %>
       <% books.forEach(account=>{const existing=(data.shifts?.items||[]).find(shift=>String(shift.operatorId)===String(user.id)&&String(shift.branchId)===String(currentBranchId)&&shift.currency===account.currency&&['pending_open','open','submitted','disputed'].includes(shift.status)); %>
       <div class="summary">
        <div class="sumRow"><span><%= account.name %> · <%= account.currency==='KES'?'KSH':account.currency %></span><b><%= cashLabel(account.bookBalanceMinor,account.currency) %></b></div>
       </div>
       <% if(existing){ %>
        <a class="btn" href="/tenant/cash/shifts/<%= existing._id %>">Continue current <%= account.currency %> shift</a>
       <% }else{ %>
        <form method="post" action="/tenant/day/open" data-cash-open-form>
         <input type="hidden" name="_csrf" value="<%= csrfToken %>">
         <input type="hidden" name="currency" value="<%= account.currency %>">
         <input type="hidden" name="openingFromBook" value="on">
         <label class="field"><input type="checkbox" name="physicalCountConfirmed" value="on" required> I counted the cash and it matches.</label>
         <div class="rowBtns"><button class="btn btnPrimary" type="submit"><%= user.role==='Tenant Owner'?'Start shift':'Submit opening count' %></button></div>
        </form>
       <% } %>
       <% }) %>
      <% }else if(unfinishedShift){ %>
       <p class="tiny">Your existing shift is available below; you do not need to open another one.</p>
       <a class="btn" href="/tenant/cash/shifts/<%= unfinishedShift._id %>">View current shift</a>
      <% }else{ %>
       <p class="tiny">No active reconciled physical cash drawer is assigned to your operator account. Open and verify a real cash account in Treasury first; do not enter an invented starting amount.</p>
       <a class="btn" href="/tenant/treasury">Prepare cash drawer</a>
      <% } %>
      <% } %>
    </div>
  </section>
  <details class="card" style="margin-top:14px">
    <summary class="cardHead"><b>Past cash shifts</b><span>Open only when you need old records</span></summary>
    <div class="cardBody tableWrap"><table><thead><tr><th>Opened (local)</th><th>Branch</th><th>Operator</th><th>Status</th><th>Currency</th><th>Opening cash</th><th>Records</th><th>Details</th></tr></thead><tbody>
      <% if(!data.shifts.items.length){ %><tr><td colspan="8">No cash shifts in your permitted scope.</td></tr><% } %>
      <% data.shifts.items.forEach(shift=>{ %><tr data-search-row>
        <td><%= regionalTime(shift.createdAt,shift.branchId) %></td><td><%= data.branchNames?.[String(shift.branchId)] || shift.branchId %></td><td><%= data.operatorNames?.[String(shift.operatorId)] || shift.operatorId %></td>
        <td><span class="tag"><%= shiftStateLabel(shift.status) %></span></td><td><%= shift.currency %></td>
        <td><%= cashLabel(shift.openingMinor,shift.currency) %></td><td><%= shift.recordCount %></td>
        <td><a class="btn" href="/tenant/cash/shifts/<%= shift._id %>"><%= ['open','disputed','submitted','pending_open'].includes(shift.status)?'Continue':'View cash record' %></a></td>
      </tr><% }) %>
    </tbody></table></div>
    <% if(data.shifts.nextCursor){ %><div class="cardBody"><a class="btn" href="/tenant/cash/shifts?cursor=<%= encodeURIComponent(data.shifts.nextCursor) %>">Next page</a></div><% } %>
  </details>
</section>
