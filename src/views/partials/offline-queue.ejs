<dialog id="offlineQueueDialog" class="transactionDialog" aria-labelledby="offlineQueueTitle">
 <div class="sheet">
  <header class="sheetHead"><b id="offlineQueueTitle">Saved entries</b><button class="btn btnIcon" type="button" data-offline-close aria-label="Close saved entries">×</button></header>
  <div class="sheetBody"><p class="tiny">Reconnect to submit entries saved on this device. Open an accepted record to check its result.</p><p id="offlineStatus" role="status" aria-live="polite"></p><details id="offlineAvailability"><summary>Offline availability</summary><p class="tiny">Visited pages are saved automatically. Save more workspace pages before disconnecting.</p><div class="rowBtns"><button class="btn" id="offlinePrepare" type="button">Save workspace pages</button><button class="btn" id="offlinePrepareStop" type="button" hidden>Stop preparation</button></div></details><div id="offlineQueue" class="offlineQueue"></div></div>
  <footer class="sheetFoot"><button class="btn btnPrimary" id="offlineSync" type="button">Sync now</button><button class="btn" type="button" data-offline-close>Close</button></footer>
 </div>
</dialog>
