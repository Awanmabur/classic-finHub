<section class="view show"><div class="grid3"><% data.modules.forEach(m => { const active = tenant.enabledModules.includes(m.key); %><article class="card" data-search-row><div class="cardHead"><b><i class="fa-solid <%= m.icon %>"></i> <%= m.name %></b><span><%= active ? 'Enabled' : '$' + m.priceMonthly + '/mo' %></span></div><div class="cardBody"><p class="tiny"><%= m.description %></p><div class="summary"><div class="sumRow"><span>Category</span><b><%= m.category %></b></div><div class="sumRow"><span>Access</span><b><%= active ? 'Active' : 'Request approval' %></b></div></div><% if (!active) { %><form method="post" action="/tenant/modules/request" style="margin-top:12px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="moduleKey" value="<%= m.key %>" /><input type="hidden" name="reason" value="Requested from tenant marketplace" /><button class="btn btnPrimary">Request module</button></form><% } else { %><a class="btn" href="/tenant/modules">View permissions</a><% } %></div></article><% }) %></div></section>
