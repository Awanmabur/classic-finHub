<section class="view show"><section class="card"><div class="cardHead"><b>Subscriptions and trials</b><span>Trial reminders, grace period, suspension, and reactivation.</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Tenant</th><th>Plan</th><th>Status</th><th>Trial ends</th><th>Access</th></tr></thead><tbody><% data.tenants.forEach(t => { %><tr data-search-row><td><%= t.name %></td><td><%= t.plan %></td><td><span class="tag"><%= t.status %></span></td><td><%= t.trialEndsAt || 'No active trial' %></td><td><%= t.status === 'suspended' ? 'Billing only' : 'Full enabled modules' %></td></tr><% }) %></tbody></table></div></section></section>
