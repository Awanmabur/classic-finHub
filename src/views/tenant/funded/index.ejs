<section class="view show"><section class="card"><div class="cardHead"><div><b>Manual financial movements</b><br><span>Source instructions, review status and posted books</span></div><a class="btn" href="/tenant/treasury">Balances &amp; reconciliation</a></div><div class="cardBody"><div class="tableWrap"><table><thead><tr><th>Date</th><th>Module</th><th>Operation</th><th>Reference</th><th>Status</th><th>Details</th></tr></thead><tbody>
<% if(!data.items.length){ %><tr><td colspan="6">No manual movements in your permitted scope. Open a banking instruction, transfer or Buy/Sell forex quote to record its actual movement.</td></tr><% } %>
<% data.items.forEach(row=>{ %><tr data-search-row><td><%= new Date(row.createdAt).toISOString().slice(0,16).replace('T',' ') %></td><td><%= row.sourceType.replaceAll('_',' ') %></td><td><%= row.action.replaceAll('_',' ') %></td><td><%= row.sourceReference %></td><td><%= row.status.replaceAll('_',' ') %></td><td><a class="btn" href="/tenant/funded/<%= row._id %>">Open</a></td></tr><% }) %></tbody></table></div></div></section></section>
