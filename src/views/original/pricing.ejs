<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="icon" type="image/png" href="/images/classicfinhub-logo.png">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ClassicFin Hub pricing | Plans, trials, modules and addons</title>
  <meta name="description" content="Compare current ClassicFin Hub plans, manual and SMS-assisted entry, prices, included modules and workspace limits." />
  <link rel="stylesheet" href="/vendor/inter/inter.css?v=<%= assetVersion %>" />
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= assetVersion %>" />
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="ClassicFin Hub" />
  <meta property="og:title" content="ClassicFin Hub pricing | Plans, trials, modules and addons" />
  <meta property="og:description" content="Compare current ClassicFin Hub plans, manual and SMS-assisted entry, prices, included modules and workspace limits." />
  <meta property="og:image" content="<%= appUrl %>/images/classicfinhub-logo.png" />
  <meta property="og:image:alt" content="ClassicFin Hub logo" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="ClassicFin Hub pricing | Plans, trials, modules and addons" />
  <meta name="twitter:description" content="Compare current ClassicFin Hub plans, manual and SMS-assisted entry, prices, included modules and workspace limits." />
  <meta name="twitter:image" content="<%= appUrl %>/images/classicfinhub-logo.png" />
  <link rel="canonical" href="<%= appUrl %>/pricing">
  <meta property="og:url" content="<%= appUrl %>/pricing">
  <script type="application/ld+json" nonce="<%= cspNonce %>"><%- JSON.stringify({
    '@context':'https://schema.org','@type':'BreadcrumbList','itemListElement':[
      {'@type':'ListItem','position':1,'name':'Home','item':appUrl+'/'},
      {'@type':'ListItem','position':2,'name':'Pricing','item':appUrl+'/pricing'}
    ]
  }).replace(/</g,'\\u003c') %></script>
</head>
<body class="legal-body" id="top">
  <div class="cursor-glow" aria-hidden="true"></div>
  <aside class="side-rail" aria-label="Desktop navigation">
    <a class="rail-logo logo-mark" href="/#home" aria-label="ClassicFin Hub home">
      <img src="/images/classicfinhub-logo.png?v=<%= assetVersion %>" alt="ClassicFin Hub logo" />
    </a>
    <nav>
      <a href="/#home"><i class="fa-solid fa-house"></i><span>Home</span></a>
      <a href="/services"><i class="fa-solid fa-table-cells-large"></i><span>Modules</span></a>
      <a href="/#book"><i class="fa-solid fa-calendar-check"></i><span>Book</span></a>
      <a href="/about"><i class="fa-solid fa-building-columns"></i><span>Company</span></a>
      <a href="/pricing" class="active"><i class="fa-solid fa-tags"></i><span>Pricing</span></a>
      <a href="/price-compare"><i class="fa-solid fa-scale-balanced"></i><span>Compare</span></a>
      <a href="/support"><i class="fa-solid fa-message"></i><span>Support</span></a>
      <div class="rail-auth">
        <a href="/signin" aria-label="Sign in"><i class="fa-solid fa-right-to-bracket"></i><span>Sign in</span></a>
        <a href="/signup" aria-label="Request setup"><i class="fa-solid fa-user-plus"></i><span>Request setup</span></a>
      </div>
    </nav>
    <button class="rail-theme" id="themeToggle" aria-label="Toggle theme"><i class="fa-solid fa-moon"></i></button>
  </aside>

  <header class="mobile-header">
    <a class="mobile-brand" href="/#home"><span class="mobile-logo"><img src="/images/classicfinhub-logo.png?v=<%= assetVersion %>" alt="ClassicFin Hub logo" /></span><strong>ClassicFin Hub</strong></a>
    <div class="mobile-auth-actions"><a href="/signin">Sign in</a><a href="/signup">Request setup</a></div><button class="mobile-menu-btn" id="menuBtn" aria-label="Open menu"><i class="fa-solid fa-bars-staggered"></i></button>
  </header>

  <nav class="mobile-panel" id="mobilePanel" aria-label="Mobile navigation">
    <a href="/#home">Home</a>
    <a href="/services">Modules</a>
    <a href="/#book">Book demo</a>
    <a href="/about">Company</a>
    <a href="/pricing">Pricing</a>
    <a href="/price-compare">Price compare</a>
    <a href="/support">Support</a>
    <a href="/signin">Sign in</a>
    <a href="/signup">Request setup</a>
    <button id="themeToggleMobile"><i class="fa-solid fa-moon"></i> Change theme</button>
  </nav>

  <main class="page legal-shell smooth-page">
    <header class="legal-hero pricing-hero reveal">
      <p class="kicker">ClassicFin Hub pricing</p>
      <h1>Plans for the way your team works.</h1>
      <p>Compare manual and SMS-assisted recording, included services and workspace capacity. Choose a current plan or contact the team for a configuration that fits your operation.</p>
      <div class="hero-actions">
        <a class="btn btn-dark" href="/#book">Book pricing demo</a>
        <a class="btn btn-light" href="/price-compare">Compare all prices</a>
        <a class="btn btn-light" href="/signup">Request tenant setup</a>
      </div>
    </header>

    <p class="tiny" style="margin:16px auto;max-width:1050px">Published subscription terms, not a payment checkout. Manual recording remains available with SMS-assisted plans. Financial records and SMS confirmations do not by themselves establish provider settlement.</p>
    <% if(!plans.length){ %><section class="pricing-page-grid reveal"><article class="plan-card"><h2>Plans are being prepared</h2><p>Contact the team for current setup options. No subscription prices are currently published.</p><a class="btn btn-light" href="/signup">Request plan details</a></article></section><% } else { %>
    <section class="pricing-page-grid reveal">
      <% plans.forEach(plan=>{const auto=plan.entryMode==='sms_assisted';const labels=plan.moduleLabels||plan.modules.map(key=>key.replaceAll('_',' ')); %>
      <article class="plan-card<%= auto?' featured':'' %>" data-plan-code="<%= plan.code %>">
        <div class="plan-top"><span><%= plan.name %></span><strong><%= plan.currency %> $<%= Number(plan.priceMonthly).toFixed(2) %>/mo</strong></div>
        <div class="price-amount"><sup>$</sup><%= Number(plan.priceMonthly).toFixed(2) %><span>/month</span></div>
        <h3><%= auto?'SMS-assisted + manual entry':'Manual entry' %></h3>
        <p><%= plan.description %></p>
        <ul>
          <li><%= plan.currency %> $<%= Number(plan.priceYearly).toFixed(2) %> / year</li>
          <li><%= plan.limits.branches.toLocaleString('en-US') %> branches and <%= plan.limits.users.toLocaleString('en-US') %> users included</li>
          <li><%= plan.limits.transactionsPerMonth.toLocaleString('en-US') %> transaction records / month</li>
          <% if(auto){ %><li><%= plan.limits.smsPerMonth.toLocaleString('en-US') %> SMS imports / month; manual entry included</li><% } %>
          <li><%= plan.trialMonths?plan.trialMonths+' month'+(plan.trialMonths===1?'':'s')+' trial':'No trial' %></li>
          <li><%= labels.length?'Included: '+labels.join(', '):'Add services to your workspace as needed' %></li>
        </ul>
        <a class="btn <%= auto?'btn-dark':'btn-light' %>" href="/signup">Request <%= plan.name %></a>
      </article>
      <% }) %>
    </section>
    <% } %>
    <section class="addon-grid reveal">
      <article><h2>Choose how records arrive</h2><p>Manual plans support staff entry. SMS-assisted plans add a registered, branch-bound SMS relay and capture inbox while retaining the same manual workflows. Automatic capture has a higher subscription price than its matching manual plan.</p></article>
      <article><h2>Know what is included</h2><p>The modules, staff seats, branch capacity and import quotas shown here follow the current published plan. Future plan revisions do not silently change existing subscriber terms.</p><a class="btn btn-light" href="/price-compare">Compare current plans</a></article>
    </section>

    <section class="final-cta reveal">
      <div>
        <p class="kicker">Ready to choose?</p>
        <h2>Compare plans side by side before setup.</h2>
        <p>Use the price comparison page to review included modules, limits, branches, users, support level, and addons.</p>
      </div>
      <a class="btn btn-dark" href="/price-compare">Open price compare</a>
    </section>

    <footer class="footer reveal">
      <div class="footer-inner">
        <div class="footer-brand">
          <strong>ClassicFin Hub</strong>
          <span>Classic Technologies</span>
          <p>Multi-tenant finance SaaS for money transfer, mobile money, banking, forex, tenant onboarding, pricing, reports, billing, and secure operations.</p>
          <div class="footer-socials">
            <a href="mailto:info@classicfinhub.com" aria-label="Email ClassicFin Hub"><i class="fa-solid fa-envelope"></i></a>
            <a href="https://api.whatsapp.com/send?phone=211921789914" aria-label="WhatsApp ClassicFin Hub"><i class="fa-brands fa-whatsapp"></i></a>
            <a href="tel:211921789914" aria-label="Call ClassicFin Hub"><i class="fa-solid fa-phone"></i></a>
          </div>
        </div>
        <div class="footer-column">
          <h3>Product</h3>
          <a href="/services">Modules</a>
          <a href="/pricing">Pricing</a>
          <a href="/price-compare">Price compare</a>
          <a href="/signin">Dashboard sign in</a>
        </div>
        <div class="footer-column">
          <h3>Solutions</h3>
          <a href="/services#money-transfer">Money transfer</a>
          <a href="/services#mobile-money">Mobile money</a>
          <a href="/services#banking">Banking operation</a>
          <a href="/services#forex">Forex operation</a>
        </div>
        <div class="footer-column">
          <h3>Company</h3>
          <a href="/about">About</a>
          <a href="/support">Support</a>
          <a href="/faq">FAQs</a>
          <a href="/#book">Book demo</a>
        </div>
        <div class="footer-column">
          <h3>Legal & access</h3>
          <a href="/terms">Terms</a>
          <a href="/privacy">Privacy</a>
          <a href="/cookies">Cookies</a>
          <a href="/refund-policy">Refund policy</a>
          <a href="/signin">Sign in</a>
          <a href="/signup">Request setup</a>
        </div>
      </div>
      <div class="footer-note"><p>© <span id="year"></span> ClassicFin Hub by Classic Technologies. All rights reserved.</p><a href="#top">Back to top</a></div>
    </footer>
  </main>
  <script src="/js/script.js?v=<%= assetVersion %>"></script>
</body>
</html>
