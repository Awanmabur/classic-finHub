<div class="formSection"><div class="formSectionTitle">Operation details</div>
 <div class="row2">
  <% if(data.workspaceOperation){ %><input type="hidden" name="kind" value="<%= data.workspaceOperation %>"><label class="field">Operation<input class="control" value="<%= data.workspaceTitle %>" readonly></label><% }else{ %><label class="field">Operation<select name="kind" class="control" required><option value="deposit_request">Deposit</option><option value="withdrawal_request">Withdraw</option><option value="transfer_request">Account transfer</option></select></label><% } %>
  <label class="field">Currency<select class="control" name="currency" required><% (data.currencyChoices||(typeof currencyOptions==='undefined'?[]:currencyOptions).filter(option=>!currentBranch.currencies||currentBranch.currencies.includes(option.code))).forEach(option=>{ %><option value="<%= option.code %>" <%= option.code===(data.selectedCurrency||currentBranch.currency)?'selected':'' %>><%= option.label %></option><% }) %></select></label>
 </div>
 <div class="row2"><label class="field">Customer account<select name="sourceId" class="control" required><option value="">Select account</option><% data.references.forEach(a=>{ %><option value="<%= a._id %>" data-account-currency="<%= a.currency %>"><%= a.customerName %> · <%= a.currency==='KES'?'KSH':a.currency %> · <%= a.institutionName %> · ****<%= a.last4 %></option><% }) %></select></label>
 <% if(!data.workspaceOperation||data.workspaceOperation==='transfer_request'){ %><label class="field" data-banking-destination-field>To account<select name="destinationId" class="control" <%= data.workspaceOperation==='transfer_request'?'required':'' %>><option value="">Select a different account</option><% data.references.forEach(a=>{ %><option value="<%= a._id %>" data-account-currency="<%= a.currency %>"><%= a.customerName %> · <%= a.currency==='KES'?'KSH':a.currency %> · <%= a.institutionName %> · ****<%= a.last4 %></option><% }) %></select></label><% } %>
 </div>
 <div class="row2"><label class="field">Amount<input name="amount" inputmode="decimal" class="control" placeholder="0" pattern="[0-9]+([.][0-9]{1,2})?" required></label><label class="field">Payment channel<select class="control" name="paymentChannel"><% (data.workspaceOperation==='transfer_request'?['Internal transfer']:data.workspaceOperation?['Cash','Bank settlement','Mobile money']:['Cash','Bank settlement','Mobile money','Internal transfer']).forEach(channel=>{ %><option data-banking-channel="<%= channel==='Internal transfer'?'transfer':'settlement' %>"><%= channel %></option><% }) %></select></label></div>
</div>
<details class="logicNote"><summary>Additional details</summary><div class="formSection">
 <div class="row2"><label class="field">Customer phone / contact<input class="control" name="customerPhone" type="tel" maxlength="16" placeholder="Optional phone override"></label><label class="field">External reference<input class="control" name="externalReference" maxlength="120" placeholder="Cheque, slip, bank ref, optional"></label></div>
 <label class="field">Note / narration<input name="note" class="control" maxlength="400" placeholder="Optional operation note"></label>
</div></details>
<%- include('../partials/operation-pricing',{pricingOperation:'banking.'+(data.workspaceOperation==='withdrawal_request'?'withdrawal':data.workspaceOperation==='transfer_request'?'transfer':'deposit'),pricingField:'fee'}) %>
<div class="summary"><div class="sumRow"><span>Reference</span><b class="mono"><%= data.idempotencyKey %></b></div><div class="sumRow"><span>Handled by</span><b class="mono"><%= user.name||user.id||'Assigned operator' %></b></div></div>
<input type="hidden" name="validDays" value="7">
<% if(!data.references.length){ %><p class="logicNote">Create a customer account or a masked bank reference for your operating branch before starting a request.</p><% } %>
<p class="tiny" data-banking-choices-status role="status" aria-live="polite"></p>
<button type="submit" class="btn btnPrimary" data-banking-submit <%= !data.references.length?'disabled':'' %>>Post banking operation</button>
