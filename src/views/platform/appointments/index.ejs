<section class="view show">
 <section class="card"><div class="cardHead"><b>Appointment requests</b><span>Review, schedule and record the outcome</span></div><div class="cardBody">
  <form method="get" action="/platform/appointments" class="row3"><label class="field">Status<select class="control" name="status"><option value="">All statuses</option><% ['pending','confirmed','completed','cancelled'].forEach(status=>{ %><option value="<%= status %>" <%= data.filters.status===status?'selected':'' %>><%= status %></option><% }) %></select></label><label class="field">Business, contact or email<input class="control" name="q" value="<%= data.filters.q %>" maxlength="80" placeholder="Search by starting text"></label><div class="rowBtns"><button class="btn btnPrimary">Apply filters</button><a class="btn" href="/platform/appointments">Clear</a></div></form>
 </div></section>
 <% if(!data.appointments.length){ %><section class="card" style="margin-top:14px"><div class="cardBody">No appointment requests match these filters.</div></section><% } %>
 <% data.appointments.forEach(a=>{ %><section class="card" style="margin-top:14px"><div class="cardHead"><b><%= a.businessName %></b><span class="tag"><%= a.status %></span></div><div class="cardBody">
  <div class="summary"><div class="sumRow"><span>Contact</span><b><%= a.contactName %> · <%= a.email||a.phone %></b></div><div class="sumRow"><span>Preferred date</span><b><%= a.preferredDate?new Date(a.preferredDate).toISOString().slice(0,10):'Flexible' %></b></div><div class="sumRow"><span>Requested modules</span><b><%= a.modules.map(key=>data.moduleLabels[key]||key).join(', ')||'Needs discovery' %></b></div><div class="sumRow"><span>Scheduled (UTC)</span><b><%= a.scheduledAt?new Date(a.scheduledAt).toISOString():'Not scheduled' %></b></div><div class="sumRow"><span>Meeting link</span><b><%= a.meetingLink||'Not provided' %></b></div><div class="sumRow"><span>Request notes</span><b><%= a.notes||'—' %></b></div><div class="sumRow"><span>Latest decision</span><b><%= a.reviewNote||'Not reviewed' %></b></div></div>
  <% if(!['completed','cancelled'].includes(a.status)){ %><form method="post" action="/platform/appointments/<%= a._id %>/decision" style="margin-top:14px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= a.revision %>"><div class="row2"><label class="field">Scheduled date and time (UTC)<input class="control" type="datetime-local" name="scheduledAt" value="<%= a.scheduledAt?new Date(a.scheduledAt).toISOString().slice(0,16):'' %>"></label><label class="field">Meeting link (optional)<input class="control" type="url" name="meetingLink" maxlength="500" placeholder="https://" value="<%= a.meetingLink||'' %>"></label></div><label class="field">Decision note<textarea class="control" name="note" minlength="12" maxlength="400" required rows="2"></textarea></label><div class="rowBtns"><button class="btn btnPrimary" name="action" value="confirm">Confirm / reschedule</button><% if(a.status==='confirmed'){ %><button class="btn" name="action" value="complete" <%= !a.scheduledAt||new Date(a.scheduledAt)>new Date()?'disabled':'' %>>Mark completed</button><% if(!a.scheduledAt||new Date(a.scheduledAt)>new Date()){ %><span class="tiny">Completion is available after the scheduled start.</span><% } %><% } %><button class="btn" name="action" value="cancel">Cancel request</button></div></form><% } %>
  <% if(a.status==='completed'){ %><a class="btn" style="margin-top:12px" href="/platform/tenants/create">Create tenant</a><% } %>
 </div></section><% }) %>
 <% if(data.nextCursor){ const params=new URLSearchParams({...data.filters,cursor:data.nextCursor}); %><div class="rowBtns" style="margin-top:14px"><a class="btn" href="/platform/appointments?<%= params.toString() %>">Older requests</a></div><% } %>
</section>
