<section class="pricing" id="pricing">
  <div class="section-head reveal"><p>Plan-driven SaaS</p><h2>Plan versions control modules, limits, trials, billing, and tenant access.</h2></div>
  <div class="pricing-grid">
    <% plans.forEach(plan => { %>
      <article class="price-card reveal">
        <span class="plan-badge"><%= plan.trialMonths %> month trial</span>
        <h3><%= plan.name %></h3>
        <p><%= plan.description %></p>
        <h4><%= plan.currency %> <%= plan.priceMonthly %><small>/month</small></h4>
        <ul>
          <li><i class="fa-solid fa-check"></i> <%= plan.limits.users %> users</li>
          <li><i class="fa-solid fa-check"></i> <%= plan.limits.branches %> branches</li>
          <li><i class="fa-solid fa-check"></i> <%= plan.limits.transactionsPerMonth.toLocaleString() %> monthly transactions</li>
          <li><i class="fa-solid fa-check"></i> Modules: <%= plan.modules.join(', ') %></li>
        </ul>
        <a href="/book-appointment" class="btn btn-dark">Start onboarding</a>
      </article>
    <% }) %>
  </div>
</section>
