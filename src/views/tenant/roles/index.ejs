<section class="view show"><section class="card"><div class="cardHead"><b>Roles and permissions</b><span>Permission editor checks tenant module enabled + role permission.</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Role</th><th>Users</th><th>Permissions</th></tr></thead><tbody><% data.roles.forEach(r => { %><tr data-search-row><td><b><%= r.name %></b></td><td><%= r.users %></td><td><div class="seg"><% r.permissions.forEach(p => { %><span class="chip active"><%= p %></span><% }) %></div></td></tr><% }) %></tbody></table></div></section></section>
