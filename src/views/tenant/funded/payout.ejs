<% const verified=!!data.verification; %><section class="view show"><section class="card"><div class="cardHead"><div><b>Payout by PIN</b><br><span>Verify the receiver before requesting cash payout</span></div></div><div class="cardBody"><form method="post" action="/tenant/funded/payout" autocomplete="off" data-payout-form>
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="phase" value="<%= verified?'request':'check' %>"><input type="hidden" name="idempotencyKey" value="<%= data.idempotencyKey %>"><% if(verified){ %><input type="hidden" name="verificationToken" value="<%= data.verificationToken %>"><% } %>
<div class="formSection"><div class="formSectionTitle">Payout verification</div><div class="row2"><label class="field">PIN<input class="control" name="pin" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="<%= verified?'PIN matched':'6-digit PIN' %>" <%= verified?'readonly':'required' %>></label><label class="field"><%= data.verification?.lookupVersion==='receiver_v1'?'Receiver phone (older transfer)':'Sender phone' %><input class="control" name="senderPhone" type="tel" maxlength="16" placeholder="Sender international phone, +256…" value="<%= data.verification?.lookupPhone||'' %>" <%= verified?'readonly':'' %>><span class="tiny">Enter the sender number shown in the receiver SMS.</span></label><label class="field">Receiver name check<input class="control" name="receiverNameCheck" maxlength="120" placeholder="Optional name check" value="<%= data.verification?.receiverNameCheck||'' %>" <%= verified?'readonly':'' %>></label><label class="field">ID / Passport presented<input class="control" name="identityDocument" maxlength="80" placeholder="Optional verification document" value="<%= data.verification?.identityDocument||'' %>" <%= verified?'readonly':'' %>></label></div><% if(!verified){ %><details class="workspaceSecondary"><summary>Claim an older transfer</summary><label class="field">Receiver phone (older transfer)<input class="control" type="tel" name="legacyReceiverPhone" maxlength="16" placeholder="Original receiver international phone"><span class="tiny">Only for older PINs issued with receiver-phone verification. Leave Sender phone empty.</span></label></details><% } %><label class="field">Payout note<textarea class="control" name="note" maxlength="400" minlength="12" <%= verified?'required':'' %> placeholder="Record the physical receiver verification and cash count"></textarea></label><% if(verified){ %><label class="field">Counted cash / statement reference<input class="control" name="evidenceReference" minlength="5" maxlength="120" required placeholder="Payout cash voucher or receipt reference"></label><% } %></div>
<div class="summary"><div class="sumRow"><span>Match</span><b><%= data.verification?.receiverName||'—' %></b></div><div class="sumRow"><span>Amount</span><b><%= data.source?(typeof formatMoneyMinor==='function'?formatMoneyMinor(data.source.amountMinor,data.source.currency):data.source.amountMinor+' '+data.source.currency):'—' %></b></div><div class="sumRow"><span>Status</span><b><%= verified?'Matched · independent payout review required':'Check PIN and sender phone' %></b></div></div>
<div class="row2"><button class="btn btnPrimary" type="submit" <%= verified?'disabled':'' %>>Check PIN</button><button class="btn" type="submit" <%= verified?'':'disabled' %>>Pay out cash</button></div></form>
<% if(verified){ %><form method="post" action="/tenant/funded/payout/reset" class="rowBtns" style="margin-top:12px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Check a different PIN</button></form><% } %>
</div></section></section>
