<section class="view show"><section class="card"><div class="cardHead"><b>Module requests</b><span>Approve/reject, invoice addons, activate module, refresh permissions/sidebar.</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Tenant</th><th>Module</th><th>Reason</th><th>Status</th><th>Actions</th></tr></thead><tbody><% data.moduleRequests.forEach(r => { %><tr data-search-row><td><%= r.tenantName %><br><span class="tiny"><%= r.requestedBy %></span></td><td><b><%= r.moduleName %></b></td><td><%= r.reason %></td><td><span class="tag"><%= r.status %></span></td><td><form method="post" action="/platform/module-requests/<%= r.id %>/approve" style="display:inline"><button class="btn btnPrimary">Approve</button></form> <form method="post" action="/platform/module-requests/<%= r.id %>/reject" style="display:inline"><button class="btn btnDanger">Reject</button></form></td></tr><% }) %></tbody></table></div></section></section>
