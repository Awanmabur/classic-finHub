<section class="view show"><section class="card"><div class="cardHead"><b>Forex quote history</b><span>Not a currency settlement record</span></div><div class="cardBody"><form method="get" action="/tenant/forex/history" class="rowBtns"><label class="field">Status<select class="control" name="status"><option value="">All</option><% ['quoted','approved_pending_execution','rejected','cancelled','expired'].forEach(s=>{ %><option value="<%= s %>" <%= data.status===s?'selected':'' %>><%= s.replaceAll('_',' ') %></option><% }) %></select></label><button class="btn" type="submit">Filter</button></form></div>
<div class="cardBody tableWrap"><table><thead><tr><th>Reference</th><th>Pair</th><th>Source</th><th>Target quote</th><th>Status</th><th>Date UTC</th></tr></thead><tbody><% data.records.items.forEach(q=>{ %><tr><td><a href="/tenant/forex/<%= q._id %>"><%= q.reference %></a></td><td><%= q.fromCurrency %> → <%= q.toCurrency %></td><td><%= data.amountLabel(q.sourceMinor,q.fromCurrency) %></td><td><%= data.amountLabel(q.targetMinor,q.toCurrency) %></td><td><%= q.status.replaceAll('_',' ') %></td><td><%= new Date(q.createdAt).toISOString().slice(0,16).replace('T',' ') %></td></tr><% }) %></tbody></table><% if(!data.records.items.length){ %><p class="tiny">No quotations match.</p><% } %></div>
<% if(data.records.nextCursor){ %><div class="cardBody"><a class="btn" href="/tenant/forex/history?status=<%= encodeURIComponent(data.status) %>&cursor=<%= encodeURIComponent(data.records.nextCursor) %>">Older quotes</a></div><% } %>
</section><div class="rowBtns" style="margin-top:12px"><a class="btn" href="/tenant/forex">Rate board</a></div></section>
