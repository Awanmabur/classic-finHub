<section class="view show"><div class="grid"><section class="card"><div class="cardHead"><b>Tenant billing</b><span>Trial, invoices, payments, grace period, suspension.</span></div><div class="cardBody summary"><div class="sumRow"><span>Plan</span><b><%= tenant.plan %></b></div><div class="sumRow"><span>Status</span><b><%= tenant.status %></b></div><div class="sumRow"><span>Trial ends</span><b><%= tenant.trialEndsAt || 'No active trial' %></b></div><div class="sumRow"><span>Enabled modules</span><b><%= tenant.enabledModules.length %></b></div></div></section><section class="card"><div class="cardHead"><b>Invoices</b><span>Tenant visible billing remains accessible when suspended.</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Invoice</th><th>Amount</th><th>Status</th><th>Due</th></tr></thead><tbody><% data.invoices.forEach(i => { %><tr data-search-row><td><%= i.number %></td><td><%= i.currency %> <%= i.amount %></td><td><span class="tag"><%= i.status %></span></td><td><%= i.dueDate %></td></tr><% }) %></tbody></table></div></section></div></section>
