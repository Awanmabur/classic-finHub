<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= pageTitle %> — ClassicFin Hub</title>
  <meta name="description" content="ClassicFin Hub dashboard for platform and tenant operations." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
  <link rel="stylesheet" href="/css/dashboard.css" />
</head>
<body>
  <div class="grain"></div>
  <div class="wrap"><div class="shell">
    <%- include('../partials/dashboard-sidebar', { context, menu, currentPath, tenant, user }) %>
    <main class="panel main">
      <div class="topbar">
        <div class="title"><h2 id="pageTitle"><%= pageTitle %></h2><p id="pageSub"><%= pageSub %></p></div>
        <div class="topActions">
          <button class="btn btnIcon mobileOnly" id="menuBtn" aria-label="Open menu"><i class="fa-solid fa-bars-staggered"></i></button>
          <% if (context === 'tenant') { %>
            <div class="ctrl"><select id="branchSelect"><option>Main Branch</option><option>Forex Desk</option><option>Juba Desk</option></select></div>
            <div class="ctrl"><select id="currencySelect"><option>UGX</option><option>USD</option><option>SSP</option><option>KSH</option></select></div>
          <% } %>
          <div class="ctrl" style="min-width:260px"><input id="search" placeholder="Search page records…"></div>
          <% if (context === 'platform') { %><a class="btn btnPrimary" href="/platform/tenants/create"><i class="fa-solid fa-plus"></i> Create tenant</a><% } %>
          <% if (context === 'tenant') { %><a class="btn btnPrimary" href="/tenant/marketplace"><i class="fa-solid fa-store"></i> Add module</a><% } %>
        </div>
      </div>
      <%- include('../partials/flash', { flash }) %>
      <%- include(view, { data, money, tenant, user, context }) %>
    </main>
  </div></div>
  <div class="menuOverlay" id="menuOverlay"></div>
  <div class="toasts"><% if (flash) { %><div class="toast"><i class="fa-solid fa-circle-info"></i><div><b><%= flash.type === 'bad' ? 'Check this' : 'Success' %></b><p><%= flash.message %></p></div></div><% } %></div>
  <script src="/js/dashboard.js"></script>
</body>
</html>
