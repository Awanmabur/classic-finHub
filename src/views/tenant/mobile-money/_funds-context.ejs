<% const funds=data.funds||{wallets:[],customerAccounts:[]};
   const walletOptions=funds.wallets||[],customerOptions=funds.customerAccounts||[]; %>
<div class="row2" data-mobile-funds>
 <input type="hidden" name="walletFeePolicy" data-wallet-fee-policy disabled>
 <label class="field">Wallet<select class="control" name="walletAccountId" required data-wallet-account><option value="">Select wallet</option><% walletOptions.forEach(wallet=>{ %><option value="<%= wallet.id %>" data-network="<%= wallet.network %>" data-currency="<%= wallet.currency %>" data-expected-minor="<%= wallet.expectedMinor??'' %>" data-state="<%= wallet.state %>" data-default="<%= wallet.isDefault?'true':'false' %>" data-assigned="<%= wallet.assignedToOperator?'true':'false' %>" data-fee-treatment="<%= wallet.feeTreatment||'record_only' %>" <%= wallet.state!=='active'||wallet.expectedMinor===null?'disabled':'' %>><%= wallet.name %></option><% }) %></select><% if(!walletOptions.length){ %><span class="tiny">No wallet configured. Your administrator can add one on the Wallets page.</span><% } %></label>
 <label class="field" data-customer-wallet-field hidden>Customer account<select class="control" name="customerAccountId" required data-customer-wallet disabled><option value="">Select customer account</option><% customerOptions.forEach(account=>{ %><option value="<%= account.id %>"><%= account.name %> · ****<%= account.last4 %></option><% }) %></select></label>
</div>
