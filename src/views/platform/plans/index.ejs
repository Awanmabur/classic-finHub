<section class="view show">
  <p class="tiny">Published plan versions are immutable. The public prices below are a catalogue reference, not evidence of a paid invoice or a live payment processor.</p>
  <% if(!data.published.length){ %><section class="card" style="margin-bottom:14px"><div class="cardHead"><b>Set up plans</b><span>Required before tenant creation</span></div><div class="cardBody"><p>No plans have been published yet. Make the standard plans available to create your first tenant.</p><form method="post" action="/platform/plans/publish-initial"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btnPrimary" type="submit">Set up plans and continue</button></form></div></section><% } %>
  <section class="card"><div class="cardHead"><b>Published versions</b><span><%= data.published.length %> records</span></div><div class="cardBody tableWrap">
    <table><thead><tr><th>Plan</th><th>Version</th><th>Price/month</th><th>Branch limit</th><th>Seat limit</th><th>Published</th></tr></thead><tbody>
    <% data.published.forEach(p=>{ %><tr data-search-row><td><%= p.name %> (<%= p.code %>)</td><td>v<%= p.version %></td><td><%= p.currency %> <%= (p.priceMonthlyMinor/100).toFixed(2) %></td><td><%= p.limits.branches %></td><td><%= p.limits.users %></td><td><%= new Date(p.publishedAt).toISOString().slice(0,10) %></td></tr><% }) %>
    <% if(!data.published.length){ %><tr><td colspan="6">No published catalogue versions. Publishing is required before tenant creation or manual grants.</td></tr><% } %>
    </tbody></table></div></section>
  <div class="grid3" style="margin-top:14px"><% data.plans.forEach(p=>{ %><article class="card" data-search-row><div class="cardHead"><b><%= p.name %></b><span>Catalogue reference</span></div><div class="cardBody"><div class="stat"><div class="k">Indicative monthly price</div><div class="v"><%= p.currency %> <%= p.priceMonthly %></div></div><p class="tiny"><%= p.description %></p><p class="tiny">Users: <%= p.limits.users %> · Branches: <%= p.limits.branches %> · Monthly records: <%= p.limits.transactionsPerMonth %></p></div></article><% }) %></div>
</section>
