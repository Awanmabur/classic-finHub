<% const snapshot=data.workspaceSnapshot||{};
   const volumes=snapshot.todayVolumes||{};
   const financialActions=quickActions.filter(action=>['transfer','mobile_money','forex_buy','banking_deposit'].includes(action.kind));
   const opener=quickActions.find(action=>action.kind==='cash_shift_open');
   const overviewCurrencies=typeof currencyOptions==='undefined'?[{code:'UGX',label:'UGX'},{code:'USD',label:'USD'},{code:'SSP',label:'SSP'},{code:'KES',label:'KSH'}]:currencyOptions;
   const currencyRows=data.hasMobileMoney&&!data.hasTransfer&&!data.hasBanking&&!data.hasForex&&data.mobileMarkets?.length?
    [...new Set(data.mobileMarkets.map(m=>m.currency))].map(code=>({code,label:code==='KES'?'KSH':code})):overviewCurrencies;
   const cards=[['hasTransfer','money_transfer','Money transfer volume','ovTransfer','Send + payout'],['hasMobileMoney','mobile_money','Mobile money volume','ovMobile','Deposits + withdrawals'],['hasBanking','banking','Banking volume','ovBanking','Deposit/withdraw/transfer'],['hasForex','forex','Forex volume','ovForex','Buy + sell exchange']];
   const hasSources=cards.some(([flag])=>data[flag]);
   const canConfigureFunds=(user.permissions||[]).some(p=>p==='*'||p==='treasury.view');
   const cashFunds=(data.mobileFunds?.paymentAccounts||[]).filter(a=>a.kind==='cash'&&(!data.mobileMarket||(data.mobileDisplayCashIds||[]).includes(a.id)));
   const floatFunds=(data.mobileFunds?.wallets||[]).filter(a=>!data.mobileMarket||(a.network===data.mobileMarket.network&&a.currency===data.mobileMarket.currency));
   const fundsVisibility=data.mobileFundsState==='all_branches'?'Choose a viewing branch for balance details':data.mobileFundsState==='branch_required'?'No operating branch is selected':data.mobileFunds?.visibilityRestricted?'Restricted by role':null;
   const canSeeCash=visiblePaths.has('/tenant/treasury'); %>
<section class="view show" id="view-overview">
  <div class="card"><div class="cardHead"><div><b>Today snapshot</b><br><span>Core modules plus daily control</span></div><span class="mono" id="terminalCode"><%= snapshot.terminalCode||tenant.slug||'—' %></span></div>
    <div class="cardBody">
      <% if(hasSources){ %><div class="grid3">
        <% cards.forEach(([flag,key,label,id,sub])=>{if(!data[flag])return;const value=volumes[key]; %><div class="stat" title="Today's active recorded <%= key.replaceAll('_',' ') %> operations and instructions. This total is separate from verified external balances."><div class="k"><%= label %></div><div class="v" id="<%= id %>"><%= value?.formatted||'—' %></div><div class="s"><span class="dot <%= key==='forex'?'warn':'' %>"></span><span><%= key==='mobile_money'&&data.mobileMarket?data.mobileMarket.label+' · '+data.mobileMarket.currency:sub %></span></div></div><% }) %>
        <% if(data.hasMobileMoney){ %>
        <% [['cash',cashFunds,'Physical cash · book balance','ovCash'],['float',floatFunds,'Electronic float · wallet balance','ovFloat']].forEach(([type,accounts,label,id])=>{const totals=(data.mobileBookTotals?.[type]||[]);const unapproved=accounts.filter(a=>a.expectedMinor===null||a.expectedMinor===undefined); %>
        <div class="stat" data-dashboard-fund-stat="<%= type %>" title="Approved opening balances plus recorded internal funds movements, not live provider balances.">
          <div class="k"><%= label %></div>
          <% if(fundsVisibility){ %><div class="v" id="<%= id %>"><%= fundsVisibility %></div>
          <% }else if(type==='cash'&&data.cashMappingRequired&&!accounts.length){ %><div class="v" id="<%= id %>">Cash assignment needed</div><div class="s"><a href="/tenant/treasury">Map this provider wallet to its actual cash drawer</a></div>
          <% }else if(!accounts.length){ %><div class="v" id="<%= id %>">Not configured</div>
          <% }else{ %>
             <div class="v" id="<%= id %>"><%= accounts.length===1?(accounts[0].expected||'Opening approval pending'):totals.length===1?totals[0].formatted:accounts.length+' accounts across currencies' %></div>
             <% if(accounts.length>1&&totals.length>1){ %><div class="s"><span>Approved books by currency: <% totals.forEach(total=>{ %><%= total.formatted %> · <% }) %></span></div><% } %>
             <% if(unapproved.length){ %><div class="s"><span><%= unapproved.length %> account(s) awaiting approved opening balance</span></div><% } %>
             <% if(type==='cash'&&data.cashMappingRequired){ %><div class="s">Additional drawers require owner mapping before they can be attributed to this network.</div><% } %>
             <% accounts.slice(0,3).forEach(account=>{ %><div class="s"><span><%= account.name %> · <%= account.currency %>: <%= account.expected||'Opening approval pending' %></span></div><% }) %>
             <% if(accounts.length>3){ %><div class="s"><span>+<%= accounts.length-3 %> more accounts in the funds register</span></div><% } %>
          <% } %>
          <div class="s"><span class="dot <%= type==='float'?'warn':'' %>"></span>
            <% if(canConfigureFunds){ %><a href="/tenant/treasury"><%= accounts.length?'View accounts / reconcile':'Set up '+(type==='cash'?'cash drawer':'provider wallet') %></a>
            <% }else if(['Tenant Owner','Mobile Money Operator','Branch Manager','Reconciliation Officer','Auditor'].includes(user.role)){ %><a href="/tenant/mobile-money/readiness">Check readiness</a>
            <% }else{ %><span>Branch-scoped funds only</span><% } %>
          </div>
        </div>
        <% }) %>
        <% } %>
      </div><% } else { %><p>Your workspace is ready.</p><p class="tiny"><%= visiblePaths.has('/tenant/modules')?'Choose the modules your team needs to start recording activity.':'Your administrator can enable the modules you need to get started.' %></p><% if(visiblePaths.has('/tenant/modules')){ %><a class="btn" href="/tenant/modules">Explore modules</a><% } %><% } %>
      <% if(financialActions.length||visiblePaths.has('/tenant/reports')||visiblePaths.has('/tenant/cash/shifts')){ %><div class="rowBtns" style="margin-top:12px">
        <% financialActions.forEach((action,index)=>{ %><a class="btn <%= index===0?'btnPrimary':'' %>" href="<%= action.href %>" data-transaction-kind="<%= action.kind %>"><%= action.label %></a><% }) %>
        <% if(visiblePaths.has('/tenant/reports')){ %><a class="btn" href="/tenant/reports">View reports</a><% } %>
        <% if(opener){ %><a class="btn" href="<%= opener.href %>" id="openDayBtn" data-transaction-kind="cash_shift_open">Open day</a><% } %>
        <% if(visiblePaths.has('/tenant/cash/shifts')&&snapshot.currentCashShift){ %><a class="btn" href="<%= snapshot.currentCashShift.href %>" id="closeDayBtn" data-transaction-kind="cash_shift_close">Close day</a><% } %>
      </div><% } %>
    </div>
  </div>
  <div class="<%= canSeeCash?'grid':'' %>" style="margin-top:14px">
    <div class="card"><div class="cardHead"><div><b>Recent activity</b><br><span>Click any row to open receipt</span></div></div><div class="cardBody"><div class="txList" id="recentList">
      <% if(!(snapshot.recentActivity||[]).length){ %><div class="tiny">No records yet.</div><% } %>
      <% (snapshot.recentActivity||[]).forEach(row=>{ %><a class="tx" data-search-row href="<%= row.href %>"><div class="txLeft"><span class="txDot <%= /voided|rejected|disputed|failed/.test(row.status||'')?'bad':/pending|requested|quoted|awaiting/.test(row.status||'')?'warn':'good' %>"></span><div class="txMeta"><b><%= row.label %></b><span><%= row.subtitle %><% if(row.createdAt){ %> • <%= new Date(row.createdAt).toISOString().slice(0,16).replace('T',' ') %><% } %></span></div></div><div class="txAmt"><%= row.amountLabel %><small><%= row.status||'' %></small></div></a><% }) %>
    </div></div></div>
    <% if(canSeeCash){ %><div class="card"><div class="cardHead"><div><b>Cash drawer by currency</b><br><span>Automatically updated by operations</span></div></div><div class="cardBody"><div class="summary" id="cashSummary" title="Provisional physical cash from independently verified opening counts and recorded drawer movements.">
      <% currencyRows.forEach(option=>{const row=(snapshot.cash||[]).find(value=>value.currency===option.code); %><div class="sumRow" <% if(row){ %>title="<%= row.shiftCount %> open shift<%= row.shiftCount===1?'':'s' %>"<% } %>><span><%= option.label %></span><b><%= row?.expectedFormatted?.replace(/^KES\s/,'KSH ')||'—' %></b></div><% }) %>
    </div><p class="tiny">Expected cash uses verified opening counts and recorded cash movements. Compare against the physical count before closing.</p></div></div><% } %>
  </div>
</section>
