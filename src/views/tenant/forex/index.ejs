<% const currentBranch = typeof operationBranch !== 'undefined' ? operationBranch : (data.branches || []).find(b => String(b._id) === String(user.transactionBranchId || user.branchId || data.selectedBranchId || '') && b.status !== 'archived');
   const currentBranchId = currentBranch ? String(currentBranch._id) : null;
   const branchProblem = typeof operationBranchError === 'string' && operationBranchError ? operationBranchError : 'An active operating branch must be assigned to your account before creating records.'; %>
<section class="view show">
 <%- include('../../partials/operation-branch', {currentBranch, branchProblem, user}) %>
 <section class="card"><div class="cardHead"><b><%= data.workspaceTitle||'Forex rate board and quotations' %></b><span>Approved rates · reviewed manual posting</span></div>
  <div class="cardBody"><p class="tiny">Use an approved rate to record a quotation, then record the actual exchange against opened foreign currency and settlement accounts for independent review.</p>
   <div class="rowBtns"><a class="btn" href="/tenant/funded">Manual movements &amp; review</a><a class="btn" href="/tenant/treasury">Balances &amp; reconciliation</a><a class="btn" href="/tenant/forex/buy">Buy forex from customer</a><a class="btn" href="/tenant/forex/sell">Sell forex to customer</a><a class="btn" href="/tenant/forex/rates">Active rate board</a><a class="btn" href="/tenant/forex/cash-impact">Forex cash impact</a><a class="btn" href="/tenant/forex/records">Forex operation records</a><a class="btn" href="/tenant/forex/report">Forex report summary</a></div>

  </div></section>
 <div class="grid" style="margin-top:14px">
 <% if(data.canPropose && currentBranchId && !['buy','sell'].includes(data.workspaceOperation)){ %><form method="post" action="/tenant/forex/rates" class="card" autocomplete="off"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="cardHead"><b>Propose an indicative rate</b><span>Requires a different reviewer</span></div><div class="cardBody" style="display:grid;gap:12px">
   <div class="row2"><label class="field">Source currency<select class="control" name="fromCurrency" required><% (typeof forexCurrencyCodes!=='undefined'?forexCurrencyCodes:['UGX','USD','SSP','KES','EUR']).forEach(c=>{ %><option value="<%= c %>"><%= typeof currencyLabel==='function'?currencyLabel(c):(c==='KES'?'KSH':c) %></option><% }) %></select></label><label class="field">Target currency<select class="control" name="toCurrency" required><% (typeof forexCurrencyCodes!=='undefined'?forexCurrencyCodes:['UGX','USD','SSP','KES','EUR']).forEach(c=>{ %><option value="<%= c %>"><%= typeof currencyLabel==='function'?currencyLabel(c):(c==='KES'?'KSH':c) %></option><% }) %></select></label></div>
   <label class="field">Target units per 1 source unit<input name="rateDecimal" class="control" inputmode="decimal" placeholder="0.00027500" required></label>
   <label class="field">Rate validity<select name="validHours" class="control" required><% for(let hours=1;hours<=72;hours++){ %><option value="<%= hours %>" <%= hours===24?'selected':'' %>><%= hours %> hour<%= hours===1?'':'s' %></option><% } %></select></label>
   <label class="field">Source and justification (12–400 characters)<textarea name="note" class="control" rows="2" minlength="12" maxlength="400" required></textarea></label>
   <button class="btn btnPrimary" type="submit">Submit rate for independent review</button>
  </div></form><% } %>
 <section class="card"><div class="cardHead"><b>Approved rate board</b><span>No external-rate verification</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Pair</th><th>Rate</th><th>State</th><th>Expires UTC</th></tr></thead><tbody><% data.rates.filter(r=>r.status==='active' && new Date(r.expiresAt)>new Date()).forEach(r=>{ %><tr><td><%= r.fromCurrency %> → <%= r.toCurrency %></td><td><%= r.rateDecimal %></td><td><%= r.status %></td><td><%= new Date(r.expiresAt).toISOString().slice(0,16).replace('T',' ') %></td></tr><% }) %></tbody></table></div></section>
 </div>
 <div class="grid" style="margin-top:14px">
 <% if(data.canQuote && currentBranchId && data.workspaceOperation!=='rates'){ %><form class="card" method="post" action="/tenant/forex/quotes" autocomplete="off" data-forex-form><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= data.idempotencyKey %>"><input type="hidden" name="operation" value="<%= ['buy','sell'].includes(data.workspaceOperation)?data.workspaceOperation:'quote' %>">
  <div class="cardHead"><b><%= data.workspaceOperation==='buy'?'Forex Operations - Buy':data.workspaceOperation==='sell'?'Forex Operations - Sell':'Create a customer quote' %></b><span>Locked rate snapshot · internal quotation</span></div><div class="cardBody" style="display:grid;gap:12px">
   <%- include('_entry-form',{currentBranchId}) %>
  </div></form><% } %>
 <section class="card"><div class="cardHead"><b>Recent quotations</b><span>Branch and role scoped</span></div><div class="cardBody txList"><% if(!data.records.items.length){ %><p class="tiny">No quotes in your permitted scope.</p><% } %><% data.records.items.slice(0,12).forEach(q=>{ %><div class="tx"><div class="txMeta"><b><a href="/tenant/forex/<%= q._id %>"><%= q.reference %></a></b><span><%= q.fromCurrency %> → <%= q.toCurrency %> · <%= q.status.replaceAll('_',' ') %></span></div><b><%= data.amountLabel(q.sourceMinor,q.fromCurrency) %></b></div><% }) %></div><div class="cardBody"><a class="btn" href="/tenant/forex/history">All quotes</a></div></section>
 </div>
 <% if(data.canRateReview){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Rate approval queue</b><span>No self-approval</span></div><div class="cardBody"><% if(!data.rateQueue.length){ %><p class="tiny">No outstanding rates for review.</p><% } %><% data.rateQueue.forEach(r=>{ %><form method="post" action="/tenant/forex/rates/<%= r._id %>/review" class="card" style="padding:12px;margin-bottom:12px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><b><%= r.fromCurrency %> → <%= r.toCurrency %>: <%= r.rateDecimal %></b><p class="tiny"><%= r.note %></p><label class="field">Independent justification<textarea name="note" class="control" minlength="12" maxlength="400" rows="2" required></textarea></label><div class="rowBtns"><button class="btn btnPrimary" name="decision" value="approve">Approve indicative rate</button><button class="btn" name="decision" value="reject">Reject</button></div></form><% }) %></div></section><% } %>
 <% if(data.canQuoteReview){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Quote approval queue</b><span>Not a trade-execution queue</span></div><div class="cardBody"><% if(!data.quoteQueue.length){ %><p class="tiny">No quotes awaiting independent review.</p><% } %><% data.quoteQueue.forEach(q=>{ %><form method="post" action="/tenant/forex/<%= q._id %>/review" class="card" style="padding:12px;margin-bottom:12px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><b><a href="/tenant/forex/<%= q._id %>"><%= q.reference %></a></b><p class="tiny"><%= data.amountLabel(q.sourceMinor,q.fromCurrency) %> → <%= data.amountLabel(q.targetMinor,q.toCurrency) %></p><label class="field">Review reason<textarea name="note" class="control" minlength="12" maxlength="400" rows="2" required></textarea></label><div class="rowBtns"><button class="btn btnPrimary" name="decision" value="approve">Approve pending execution</button><button class="btn" name="decision" value="reject">Reject</button></div></form><% }) %></div></section><% } %>
</section>
