<section class="view show mobileMoneyPage">
 <section class="card">
  <div class="cardHead"><div><b>Cross-currency Mobile Money</b><br><span>Real provider wallet and physical cash drawer · approved branch Buy/Sell rates</span></div><a class="btn" href="/tenant/mobile-money">Back to Mobile Money</a><a class="btn" href="/tenant/mobile-money/fx/history">Transaction history</a><a class="btn" href="/tenant/mobile-money/fx/authorizations">Provider authorization setup</a></div>
  <div class="cardBody">
   <p class="tiny">This is an exact calculation preview, not a completed transfer. Provider confirmation and legally permitted settlement are required before balances can be posted. All money shown is in its own currency.</p>
   <% if(data.error){ %><p role="alert"><%= data.error %></p><% } %>
   <% if(!data.wallets.length || !data.drawers.length){ %>
    <p>Set up and reconcile an actual electronic wallet and physical cash drawer before quoting.</p>
    <a class="btn" href="/tenant/treasury">Manage cash and float</a>
   <% }else{ %>
   <form method="GET" action="/tenant/mobile-money/fx">
    <div class="formGrid">
     <label>Transaction direction
      <select name="operation" required>
       <option value="withdraw_provider_receive_cash" <%= data.input.operation==='withdraw_provider_receive_cash'?'selected':'' %>>Customer withdraws electronic money and receives cash</option>
       <option value="deposit_cash_send_provider" <%= data.input.operation==='deposit_cash_send_provider'?'selected':'' %>>Customer deposits cash and receives electronic money</option>
      </select>
     </label>
     <label>Provider wallet
      <select name="walletAccountId" required>
       <option value="">Select actual provider wallet</option>
       <% data.wallets.forEach(wallet=>{ %>
        <option value="<%= wallet.id %>" <%= data.input.walletAccountId===wallet.id?'selected':'' %>><%= wallet.name %> — <%= wallet.network %> · <%= wallet.currency %></option>
       <% }); %>
      </select>
     </label>
     <label>Physical cash drawer
      <select name="cashAccountId" required>
       <option value="">Select actual cash drawer</option>
       <% data.drawers.forEach(drawer=>{ %>
        <option value="<%= drawer.id %>" <%= data.input.cashAccountId===drawer.id?'selected':'' %>><%= drawer.name %> · <%= drawer.currency %></option>
       <% }); %>
      </select>
     </label>
     <label>Provider amount (in selected wallet currency)
      <input name="providerAmount" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" value="<%= data.input.providerAmount||'' %>" required>
     </label>
    </div>
    <button class="btn primary" type="submit">Calculate approved quote</button>
   </form>
   <% } %>
   <% if(data.result){ const q=data.result; %>
    <section class="card" aria-label="Cross-currency preview">
     <div class="cardHead"><b>Approved Buy/Sell preview</b><span><%= q.rateSide.toUpperCase() %> · rate <%= q.rateDecimal %> <%= q.cashCurrency %> per 1 <%= q.providerCurrency %></span></div>
     <div class="cardBody">
      <p><strong>Provider wallet:</strong> <%= q.walletName %> (<%= q.providerCurrency %>) · signed change <%= data.formatMoneyMinor(q.walletDeltaMinor,q.providerCurrency) %></p>
      <p><strong>Physical drawer:</strong> <%= q.cashName %> (<%= q.cashCurrency %>) · signed change <%= data.formatMoneyMinor(q.cashDeltaMinor,q.cashCurrency) %></p>
      <p><strong>Customer cash amount:</strong> <%= data.formatMoneyMinor(q.cashAmountMinor,q.cashCurrency) %></p>
      <p><strong>Rate expiration:</strong> <%= formatLocalDate(q.rateExpiresAt,data.selectedBranchId) %></p>
      <p class="tiny">Preview only: no provider settlement, bank or cash movement has been posted. No profit is inferred from this exchange quote.</p>
     </div>
    </section>
    <% if(data.canExecute){ %>
     <form class="card" method="POST" action="/tenant/mobile-money/fx/record" autocomplete="off">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="idempotencyKey" value="<%= data.idempotencyKey %>">
      <% ['operation','network','walletAccountId','cashAccountId','providerCurrency','cashCurrency','providerAmountMinor','cashAmountMinor','rateId','rateVersion','rateDecimal'].forEach(field=>{ %>
       <input type="hidden" name="<%= field %>" value="<%= q[field] %>">
      <% }); %>
      <div class="cardBody">
       <p><strong>Record the actual exchange</strong></p>
       <label class="field">Provider transaction reference
        <input class="control" name="providerReference" pattern="[A-Za-z0-9._:/\\-]{6,120}" minlength="6" maxlength="120" required placeholder="Reference shown in the provider app">
       </label>
       <label class="field"><input type="checkbox" name="providerAppConfirmed" value="yes" required> I personally confirmed the provider transaction in the actual provider app.</label>
       <label class="field"><input type="checkbox" name="cashHandoverConfirmed" value="yes" required> The displayed physical cash amount was actually received or handed over.</label>
       <p class="tiny">This posts one internally final financial record and updates both funds books. It does not claim the provider independently reconciled its settlement. Missing FX cost basis remains unmeasured.</p>
       <button class="btn primary" type="submit">Finalize actual exchange</button>
      </div>
     </form>
    <% }else{ %>
     <p class="tiny" role="status">Financial posting is unavailable until this branch, provider and currency pair pass the required authorization checks and cross-currency release gate. This preview does not move any money.</p>
    <% } %>
   <% } %>
  </div>
 </section>
</section>
