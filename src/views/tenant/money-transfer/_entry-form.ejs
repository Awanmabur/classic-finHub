<% const senders=data.contacts.filter(c=>c.kind==='sender'); const beneficiaries=data.contacts.filter(c=>c.kind==='beneficiary'); %>
<div class="formSection"><div class="formSectionTitle">Sender details</div><div class="row2">
<label class="field">Sender name<select class="control" name="senderId" required data-party-select="sender"><option value="">Select sender</option><% senders.forEach(c=>{ %><option value="<%= c._id %>" data-phone="<%= c.phone %>" data-country="<%= c.country %>"><%= c.fullName %></option><% }) %></select></label>
<label class="field">Sender phone<input class="control" data-party-phone="sender" placeholder="+256..." readonly></label>
<label class="field">Sender ID / document no.<input class="control" name="senderDocument" maxlength="80" placeholder="National ID, passport, or optional"></label>
<label class="field">Source country / branch<input class="control" data-party-country="sender" data-branch-name="<%= currentBranch.name %>" value="<%= currentBranch.name %>" readonly></label>
</div></div>
<div class="formSection"><div class="formSectionTitle">Receiver details</div><div class="row2">
<label class="field">Receiver name<select class="control" name="beneficiaryId" required data-party-select="receiver"><option value="">Select beneficiary</option><% beneficiaries.forEach(c=>{ %><option value="<%= c._id %>" data-phone="<%= c.phone %>" data-country="<%= c.country %>"><%= c.fullName %></option><% }) %></select></label>
<label class="field">Receiver phone<input class="control" data-party-phone="receiver" placeholder="+256..." readonly></label>
<label class="field">Receiver ID / document no.<input class="control" name="receiverDocument" maxlength="80" placeholder="Optional verification ID"></label>
<label class="field">Payout branch<input class="control" value="<%= currentBranch.name %>" readonly><span class="tiny">Your operating branch is assigned automatically.</span></label>
</div></div>
<div class="formSection"><div class="formSectionTitle">Transfer details</div><div class="row2">
<label class="field">Transfer method<select class="control" name="transferMethod"><% ['Cash','Bank','Mobile Money','Online'].forEach(method=>{ %><option><%= method %></option><% }) %></select></label>
<label class="field">Purpose / narration<input class="control" name="purpose" maxlength="400" placeholder="Family support, trade, school fees..."></label>
<label class="field">Currency<input type="hidden" name="currency" value="<%= currentBranch.currency %>"><input class="control" value="<%= typeof currencyLabel==='function'?currencyLabel(currentBranch.currency):currentBranch.currency %>" readonly></label>
<label class="field">Amount<input class="control" name="amount" inputmode="decimal" required pattern="[0-9]+([.][0-9]{1,2})?" placeholder="0"></label>
<label class="field">Exchange rate<input class="control" name="exchangeRate" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,8})?" placeholder="Optional indicative rate"><span class="tiny">Reference only; the request does not perform a currency conversion.</span></label>
<label class="field">Transfer fee<input class="control" name="fee" inputmode="decimal" required pattern="[0-9]+([.][0-9]{1,2})?" value="0"></label>
</div></div>
<div class="summary"><div class="sumRow"><span>Generated PIN</span><b>Awaiting verified payout integration</b></div><div class="sumRow"><span>Total sender pays</span><b data-transfer-total>—</b></div><div class="sumRow"><span>Reference</span><b class="mono"><%= data.idempotencyKey %></b></div></div>
<label class="field">Request validity<select class="control" name="validDays" required><% for(let days=1;days<=30;days++){ %><option value="<%= days %>" <%= days===7?'selected':'' %>><%= days %> day<%= days===1?'':'s' %></option><% } %></select></label>
<% if(!senders.length||!beneficiaries.length){ %><p class="tiny">Create an active sender and beneficiary contact in this branch before submitting a request. <a href="/tenant/money-transfer/contacts">Manage contacts</a></p><% } %>
<div class="rowBtns"><button class="btn btnPrimary" type="submit" <%= !senders.length||!beneficiaries.length?'disabled':'' %>>Save transfer &amp; open receipt</button></div>
