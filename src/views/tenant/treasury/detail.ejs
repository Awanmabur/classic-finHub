<link rel="stylesheet" href="/css/workspace.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/treasury.css?v=<%= assetVersion %>">
<%
  const {account}=data;
  const known=account.openingBalanceMinor!==null;
  const active=account.status!=='archived';
  const canCheck=data.canObserve&&active&&!account.pendingOpeningId;
  const canEdit=data.canManage&&active;
  const pending=data.pendingObservations.length||data.pendingAdjustments.length||data.pendingFunding.length;
  const accountUrl='/tenant/treasury/accounts/'+account._id;
  const fmt=value=>value===null||value===undefined?'—':data.format(value,account.currency);
  const currencyLabel=account.currency==='KES'?'KSH':account.currency;
  const sourceLabel={wallet:'Provider app',cash:'Cash count',bank:'Bank statement',forex_stock:'Stock count',transfer_clearing:'Transfer register'};
  const sourceValue={wallet:'provider_app',cash:'cash_count',bank:'bank_statement',forex_stock:'stock_count',transfer_clearing:'transfer_register'};
  const byBatch=new Map(data.batches.map(batch=>[String(batch._id),batch]));
%>
<section class="view show">
  <div class="workspaceStack">
    <div><a class="btn" href="/tenant/treasury">All business accounts</a></div>
    <section class="card">
      <div class="cardHead"><b>Recorded balance</b><span><%= data.status %></span></div>
      <div class="cardBody workspaceStack">
        <div>
          <div class="treasuryAmount"><%= known?fmt(account.bookBalanceMinor):'Opening balance needed' %></div>
          <div class="treasurySource"><%= account.kind.replaceAll('_',' ') %> · <%= currencyLabel %><%= account.network?' · '+account.network:'' %></div>
        </div>
        <% if (account.lastObservationAt) { %>
          <div class="treasurySource">Last confirmed actual balance <b><%= fmt(account.lastObservedMinor) %></b> on <time datetime="<%= new Date(account.lastObservationAt).toISOString() %>"><%= new Date(account.lastObservationAt).toISOString().slice(0,16).replace('T',' ') %> UTC</time><% if (account.lastVarianceMinor&&String(account.lastVarianceMinor)!=='0') { %> · Difference <b><%= fmt(account.lastVarianceMinor) %></b><% } %></div>
        <% } %>
        <% if (account.holdReason) { %><p class="treasuryNotice" role="status"><%= account.holdReason %></p><% } %>
        <div class="rowBtns">
          <% if (data.canFund) { %><a class="btn btnPrimary" href="<%= accountUrl %>?action=money#add-money">Add money</a><% } %>
          <% if (canCheck) { %><a class="btn <%= known?'':'btnPrimary' %>" href="<%= accountUrl %>?action=check#check-balance"><%= known?'Check balance':'Set opening balance' %></a><% } %>
          <% if (data.canAdjust) { %><a class="btn" href="<%= accountUrl %>?action=correct#correct-balance">Correct balance</a><% } %>
          <% if (canEdit) { %><a class="btn" href="<%= accountUrl %>?action=edit#edit-account">Edit details</a><% } %>
          <a class="btn" href="<%= accountUrl %>?action=activity#account-activity">Activity</a>
        </div>
      </div>
    </section>

    <% if (data.canFund) { %>
      <details class="card workspaceSecondary" id="add-money" <%= data.action==='money'?'open':'' %>>
        <summary>Add money</summary>
        <div class="cardBody workspaceStack">
          <form class="workspaceStack" action="/tenant/treasury/funding" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="idempotencyKey" value="<%= data.contributionIdempotencyKey %>">
            <input type="hidden" name="sourceKind" value="owner_contribution">
            <input type="hidden" name="destinationAccountId" value="<%= account._id %>">
            <input type="hidden" name="returnToAccount" value="true">
            <div>
              <b>Owner contribution</b>
              <p class="tiny">Record money the owner has already put into this account. A second person approves it before the balance updates.<% if (account.kind==='cash') { %> The cash drawer needs a <a class="treasuryAccountLink" href="/tenant/cash/shifts">verified open day</a>.<% } %></p>
            </div>
            <div class="row2">
              <label class="field">Amount (<%= currencyLabel %>)<input class="control" name="amount" inputmode="decimal" required pattern="[0-9]+([.][0-9]{1,2})?" placeholder="0"></label>
              <label class="field">Receipt or statement reference<input class="control" name="evidenceReference" required maxlength="120"></label>
            </div>
            <div class="rowBtns"><button class="btn btnPrimary" type="submit">Send for approval</button></div>
          </form>
          <% if (data.fundingAccounts.length) { %>
            <details class="workspaceSecondary">
              <summary>Move money from another business account</summary>
              <%- include('_funding',{destination:account}) %>
            </details>
          <% } %>
        </div>
      </details>
    <% } %>

    <% if (canCheck) { %>
      <details class="card workspaceSecondary" id="check-balance" <%= data.action==='check'||!known?'open':'' %>>
        <summary><%= known?'Check balance':'Set opening balance' %></summary>
        <form class="cardBody workspaceStack" method="post" action="<%= accountUrl %>/observations" data-treasury-observation>
          <p class="tiny"><%= known?'Count the cash or check the account statement. Any difference stays visible for review.':'Enter the amount already in the account. A second person confirms the opening balance.' %></p>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="idempotencyKey" value="<%= data.idempotencyKey %>">
          <input type="hidden" name="kind" value="<%= known?'checkpoint':'opening' %>">
          <div class="row2">
            <label class="field">Actual balance (<%= currencyLabel %>)<input class="control" name="actualBalance" inputmode="decimal" required placeholder="0"></label>
            <label class="field"><%= sourceLabel[account.kind] %> reference<input class="control" name="evidenceReference" minlength="6" maxlength="120" required></label>
          </div>
          <label class="field">How did you check?<textarea class="control" name="note" minlength="12" maxlength="400" required rows="2" placeholder="Example: Counted cash with the drawer receipt"></textarea></label>
          <details class="logicNote">
            <summary>Source and time</summary>
            <div class="row2">
              <label class="field">Observation source<select class="control" name="evidenceType" required>
                <option value="<%= sourceValue[account.kind] %>"><%= sourceLabel[account.kind] %></option>
                <% if (account.kind==='wallet'||account.kind==='transfer_clearing') { %><option value="provider_statement">Provider statement</option><% } %>
                <% if (account.kind==='bank') { %><option value="provider_app">Bank app</option><% } %>
              </select></label>
              <label class="field">Observed at (UTC)<input class="control" name="observedAt" type="datetime-local" step="0.001" required value="<%= new Date().toISOString().slice(0,-1) %>"></label>
            </div>
          </details>
          <div class="rowBtns"><button class="btn btnPrimary" type="submit">Send balance for review</button></div>
        </form>
      </details>
    <% } %>

    <% if (data.canAdjust) { %>
      <details class="card workspaceSecondary" id="correct-balance" <%= data.action==='correct'?'open':'' %>>
        <summary>Correct balance</summary>
        <form class="cardBody workspaceStack" method="post" action="/tenant/treasury/observations/<%= data.nextAdjustment._id %>/adjustments">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="idempotencyKey" value="<%= data.idempotencyKey %>">
          <p>Confirmed difference <b><%= fmt(data.nextAdjustment.varianceMinorAtReview) %></b>. Investigate its source before requesting a correction. Approval records a separate adjustment against the existing history.</p>
          <label class="field">Why is the correction needed?<textarea class="control" name="reason" minlength="20" maxlength="400" rows="2" required></textarea></label>
          <div class="rowBtns"><button class="btn btnPrimary" type="submit">Send correction for approval</button></div>
        </form>
      </details>
    <% } %>

    <% if (pending) { %>
      <section class="card" id="money-review">
        <div class="cardHead"><b>Awaiting approval</b></div>
        <div class="cardBody workspaceStack">
          <%- include('_funding-history',{fundings:data.pendingFunding,allowReview:data.canReviewFunding,onAccount:true}) %>
          <% for (const row of data.pendingObservations) { %><%- include('_balance-review',{row,account,isAdjustment:false,allowReview:data.canReviewBalance(row),accountLink:false}) %><% } %>
          <% for (const row of data.pendingAdjustments) { %><%- include('_balance-review',{row,account,isAdjustment:true,allowReview:data.canReviewBalance(row),accountLink:false}) %><% } %>
        </div>
      </section>
    <% } %>

    <% if (canEdit) { %>
      <details class="card workspaceSecondary" id="edit-account" <%= data.action==='edit'?'open':'' %>>
        <summary>Edit details</summary>
        <form class="cardBody workspaceStack" method="post" action="<%= accountUrl %>/settings" data-wallet-settings-form>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="field">Account name<input class="control" name="name" minlength="3" maxlength="120" required value="<%= account.name %>"></label>
          <details class="logicNote">
            <summary>Defaults for future transactions</summary>
            <div class="row2">
              <label class="field">Use as the default<select class="control" name="isDefault"><option value="true" <%= account.selectionKey?'selected':'' %>>Yes</option><option value="false" <%= !account.selectionKey?'selected':'' %>>No</option></select></label>
              <% if (account.kind==='wallet') { %>
                <label class="field">Fee / commission treatment<select class="control" name="feeTreatment">
                  <% for (const [value,label] of [['record_only','Record fee only'],['payment_collected','Fee collected from customer'],['wallet_commission','Commission credited to wallet']]) { %><option value="<%= value %>" <%= (account.feeTreatment||'record_only')===value?'selected':'' %>><%= label %></option><% } %>
                </select></label>
              <% } %>
            </div>
          </details>
          <div class="rowBtns"><button class="btn btnPrimary" type="submit">Save details</button></div>
        </form>
      </details>
    <% } %>

    <details class="card workspaceSecondary" id="account-activity" <%= data.action==='activity'?'open':'' %>>
      <summary>Activity</summary>
      <div class="cardBody workspaceStack">
        <section>
          <b>Posted money movements</b>
          <div class="tableWrap">
            <table>
              <thead><tr><th>When (UTC)</th><th>Source</th><th>Movement</th><th>Balance after</th><th>Journal</th></tr></thead>
              <tbody>
                <% if (!data.movements.length) { %><tr><td colspan="5">No money movements posted.</td></tr><% } %>
                <% for (const movement of data.movements) { const batch=byBatch.get(String(movement.batchId)); %>
                  <tr data-search-row><td><%= new Date(movement.occurredAt).toISOString() %></td><td><%= batch?.description||movement.sourceRef %><br><span class="tiny"><%= movement.sourceRef %><%= batch?.reversesBatchId?' · reversal':'' %></span></td><td><%= fmt(movement.deltaMinor) %></td><td><%= fmt(movement.balanceAfterMinor) %></td><td class="mono"><%= movement.journalId %></td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
        <% for (const row of data.observations.filter(row=>row.status!=='pending_review')) { %><%- include('_balance-review',{row,account,isAdjustment:false,allowReview:false,accountLink:false}) %><% } %>
        <% for (const row of data.adjustments.filter(row=>row.status!=='pending_review')) { %><%- include('_balance-review',{row,account,isAdjustment:true,allowReview:false,accountLink:false}) %><% } %>
        <%- include('_funding-history',{fundings:data.fundings.filter(row=>row.status!=='pending_review'),allowReview:()=>false,onAccount:true}) %>
      </div>
    </details>
  </div>
</section>
<script defer src="/js/treasury.js?v=<%= assetVersion %>"></script>
