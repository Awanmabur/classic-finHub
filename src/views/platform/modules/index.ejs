<section class="view show"><div class="grid3"><% data.modules.slice(0,4).forEach(m => { %><div class="stat"><div class="k"><%= m.category %></div><div class="v"><%= m.name %></div><div class="s"><span class="dot"></span><%= m.status %></div></div><% }) %></div><section class="card" style="margin-top:14px"><div class="cardHead"><b>Module registry</b><span>Core modules and addons with permissions.</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Module</th><th>Category</th><th>Price</th><th>Permissions</th><th>Status</th><th></th></tr></thead><tbody><% data.modules.forEach(m => { %><tr data-search-row><td><i class="fa-solid <%= m.icon %>"></i> <b><%= m.name %></b><br><span class="tiny"><%= m.description %></span></td><td><%= m.category %></td><td>$<%= m.priceMonthly %>/mo</td><td><%= m.permissions.join(', ') %></td><td><span class="tag"><%= m.status %></span></td><td><form method="post" action="/platform/modules/<%= m.key %>/toggle"><button class="btn">Toggle</button></form></td></tr><% }) %></tbody></table></div></section></section>
