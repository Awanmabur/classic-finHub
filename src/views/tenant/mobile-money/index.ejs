<% const currentBranch = typeof operationBranch !== 'undefined' ? operationBranch : (data.branches || []).find(b => String(b._id) === String(user.transactionBranchId || user.branchId || data.selectedBranchId || '') && b.status !== 'archived');
   const currentBranchId = currentBranch ? String(currentBranch._id) : null;
   const branchProblem = typeof operationBranchError === 'string' && operationBranchError ? operationBranchError : 'An active operating branch must be assigned to your account before creating records.';
   const canSetupFunds=(user.permissions||[]).includes('*')||(user.permissions||[]).includes('treasury.manage');
   const canObserveFunds=(user.permissions||[]).includes('*')||(user.permissions||[]).includes('treasury.observe');
   const canReviewFunds=(user.permissions||[]).includes('*')||(user.permissions||[]).includes('treasury.review');
   const visibleCashAccounts=(data.funds?.paymentAccounts||[]).filter(a=>a.kind==='cash');
   const visibleWalletAccounts=data.funds?.wallets||[];
   const pendingFunds=[...visibleCashAccounts,...visibleWalletAccounts].filter(a=>a.expectedMinor===null||a.expectedMinor===undefined||a.state!=='active'||a.reconciliation!=='matched');
   const needsOnboarding=!currentBranch||!visibleCashAccounts.length||!visibleWalletAccounts.length||pendingFunds.length>0; %>
<section class="view show mobileMoneyPage">
 <%- include('../../partials/operation-branch', {currentBranch, branchProblem, user}) %>

 <section class="card" data-mobile-onboarding aria-label="Mobile Money start and opening checklist">
  <div class="cardHead"><div><b><%= needsOnboarding?'Start Mobile Money — cash and float setup':'Mobile Money operational setup' %></b><br><span><%= currentBranch?'Operating branch: '+currentBranch.name:'Operating branch not assigned' %> · actual balances only</span></div><a class="btn" href="/tenant/mobile-money/readiness">Check readiness</a></div>
  <div class="cardBody">
    <% if(needsOnboarding){ %>
      <% if(!currentBranch){ %><p role="status">First, assign an active operating branch. Account balances and financial records cannot be linked to a branch until that assignment is resolved. <a href="/tenant/branches">Review branch assignments</a>.</p><% } %>
      <p class="tiny">Complete these real steps before expecting cash or electronic float amounts. An opened shift is not a provider wallet, and saved agent rate sheets are not money.</p>
      <ol class="setupSteps">
        <li><strong>1. Set up the cash drawer and network wallet</strong><p><%= visibleCashAccounts.length?'Cash drawer exists.':'No physical cash account is available for this branch.' %> <%= visibleWalletAccounts.length?'Wallet account exists.':'No mobile network float wallet is available for this branch.' %> Create a separate wallet for each network, market and currency.</p>
          <% if(canSetupFunds){ %><a class="btn" href="/tenant/treasury#account-setup">Create cash / wallet account</a><% }else{ %><span class="tiny">Ask the Tenant Owner or an authorized Treasury Manager to configure the accounts.</span><% } %></li>
        <li><strong>2. Submit and independently approve real opening balances</strong><p><%= pendingFunds.length?pendingFunds.length+' visible account(s) need opening approval, activation or reconciliation.':'Each account needs dated cash-count or provider-balance evidence, reviewed by a different authorized person.' %></p>
          <% if(canObserveFunds){ %><a class="btn" href="/tenant/treasury">Open accounts to submit balance evidence</a><% } %>
          <% if(canReviewFunds){ %><a class="btn" href="/tenant/treasury/review">Review opening evidence</a><% } %></li>
        <li><strong>3. Open the physical cash day</strong><p>Count starting cash in the operating currency; an independent supervisor verifies the cash shift. This does not manufacture electronic float.</p>
          <% if(['Tenant Owner','Mobile Money Operator','Branch Manager','Reconciliation Officer'].includes(user.role)){ %><a class="btn" href="/tenant/cash/shifts">Open or review cash shift</a><% } %></li>
        <li><strong>4. Record and reconcile</strong><p>Once the required accounts and shift are approved, record a real deposit or withdrawal and compare book balances to physical counts and provider evidence.</p></li>
      </ol>
    <% }else{ %>
      <p class="tiny">Cash drawers and provider wallets are configured for this operating branch. Check that your cash shift is open and reconciled before processing cash. Balances are internal book figures, not live provider balances.</p>
      <div class="rowBtns"><a class="btn" href="/tenant/cash/shifts">Cash shift</a><a class="btn" href="/tenant/mobile-money/readiness">Review funds readiness</a></div>
    <% } %>
  </div>
 </section>
  <% const overviewAccounts=[...(data.funds?.paymentAccounts||[]).filter(a=>a.kind==='cash'),...(data.funds?.wallets||[])]; %>
  <section class="card mobileAgentBalances" aria-label="Agent cash and electronic float">
   <div class="cardHead"><div><b>Cash and float balances</b><br><span>Book balances for your assigned branch; verify against physical cash and provider records</span></div><% if((user.permissions||[]).some(p=>p==='*'||p==='treasury.view')){ %><a class="btn" href="/tenant/treasury">Reconcile accounts</a><% } %></div>
   <div class="cardBody">
    <% if(data.funds?.visibilityRestricted){ %>
     <p class="tiny">Your role can view Mobile Money activity but not private cash or provider float account balances.</p>
    <% }else if(overviewAccounts.length){ %>
    <div class="networkBalanceGrid">
     <% overviewAccounts.forEach(account=>{ %>
      <div class="networkBalanceStat">
       <span><%= account.kind==='cash'?'Physical cash': 'Electronic float · '+(account.network==='MTN SSD'?'MTN South Sudan':account.network) %></span>
       <strong><%= account.expected||'Opening balance not approved' %></strong>
       <small><%= account.name %> · <%= account.currency %> · <%= account.reconciliation||'Not reconciled' %></small>
      </div>
     <% }) %>
    </div>
    <% }else{ %><p class="tiny">No active cash drawer or mobile network wallet is assigned to this operating branch. Configure accounts and approve their opening balances in Treasury. Opening a cash shift alone does not create a treasury wallet.</p><% } %>
   </div>
  </section>
  <div class="richActions" style="margin-top:14px">
    <% if(user.permissions.includes('*') || user.permissions.includes('mobile_money.cash_in')){ %><a class="btn" href="/tenant/mobile-money/cash-in" data-transaction-kind="cash_in">Deposit</a><% } %>
    <% if(user.permissions.includes('*') || user.permissions.includes('mobile_money.cash_out')){ %><a class="btn" href="/tenant/mobile-money/cash-out" data-transaction-kind="cash_out">Withdrawal</a><% } %>
    <a class="btn" href="/tenant/mobile-money/network-activity">Network activity</a><a class="btn" href="/tenant/mobile-money/cash-impact">Cash impact</a><% if((user.permissions||[]).includes('*')||(user.permissions||[]).includes('treasury.view')){ %><a class="btn" href="/tenant/mobile-money/tariffs">Agent rate sheets</a><% } %><% if((user.permissions||[]).some(permission=>['*','mobile_money.report','reports.view'].includes(permission))){ %><a class="btn" href="/tenant/mobile-money/report">Mobile money report</a><% } %>
  </div>
  <div class="grid">
    <% if (data.canRecord && currentBranch) { %>
    <%- include('_entry-form',{currentBranch,operation:(user.permissions.includes('*') || user.permissions.includes('mobile_money.cash_in')) ? 'cash_in' : 'cash_out'}) %>
    <% } %>

    <section class="card"><div class="cardHead"><b>Network activity</b><span><%= data.summary.total %> records today (UTC)</span><a class="btn" href="/tenant/mobile-money/history">All history</a></div><div class="cardBody txList">
      <% if (!data.summary.recent.length) { %><p class="tiny">No records yet. The list uses this tenant's database, not demonstration data.</p><% } %>
      <% data.summary.recent.forEach(t => { %>
        <div class="tx" data-search-row>
          <div class="txMeta"><b><a href="/tenant/mobile-money/<%= t._id %>"><%= t.network %> · <%= t.networkReference %></a></b>
            <span><%= t.customer %> · <%= t.entrySource === 'sms' ? 'SMS capture' : 'Manual' %> · <%= t.operation === 'cash_in' ? 'Deposit' : 'Withdrawal' %> · <%= t.status.replace(/_/g,' ') %> · Internal review: <%= (t.reviewState || 'awaiting_review').replace(/_/g,' ') %> · Correction: <%= (t.correctionState || 'none').replace(/_/g,' ') %></span>
          </div><b><%= money(t.currency, amountFromMinor(t.amountMinor,t.currency)) %></b>
        </div>
        <% if(data.canRecord && String(t.operatorId)===String(user.id) && t.status==='pending_verification' && ['none','denied',null,undefined].includes(t.correctionState) && (t.correctionAttempts||0)<5){ %>
          <details style="margin:8px 0 12px"><summary class="tiny">Request correction</summary>
          <form method="post" action="/tenant/mobile-money/<%= t._id %>/request-void" class="row2" style="margin:10px 0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label class="field">Request correction to this record (reason, 12–400 characters)
              <input class="control" name="note" minlength="12" maxlength="400" required placeholder="Explain the recording error without sensitive details">
            </label><div class="rowBtns"><button class="btn" type="submit">Request void review</button></div>
          </form></details>
        <% } %>
      <% }) %>
    </div></section>
  </div>
  <% if (data.canReview) { %>
  <section class="card" style="margin-top:14px">
    <div class="cardHead"><b>Correction requests</b><span>Separate reviewer · full audit trail</span></div>
    <div class="cardBody"><p class="tiny">Approve an internal void only after examining supporting evidence. The original entry and reference are retained. This action never refunds money or reverses a settled journal.</p>
      <% if (!(data.voidQueue||[]).length) { %><p class="tiny">No pending correction requests.</p><% } %>
      <% (data.voidQueue||[]).forEach(t=>{ %>
        <form method="post" action="/tenant/mobile-money/<%= t._id %>/decide-void" class="card" style="margin:12px 0;padding:12px">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="cardHead"><b><%= t.network %> · <%= t.networkReference %></b><span><%= money(t.currency,amountFromMinor(t.amountMinor,t.currency)) %></span></div>
          <p class="tiny">Operator reason: <%= t.correctionReason %></p>
          <label class="field">Review decision evidence (12–400 characters)
            <textarea class="control" name="note" minlength="12" maxlength="400" required rows="2" placeholder="Why is this correction approved or denied?"></textarea>
          </label>
          <div class="rowBtns"><button class="btn btnPrimary" name="decision" value="approve">Approve internal void</button><button class="btn" name="decision" value="deny">Deny request</button></div>
        </form>
      <% }) %>
    </div>
  </section>
  <section class="card" style="margin-top:14px">
    <div class="cardHead"><b>Independent internal review</b><span>Two-person control · no provider settlement</span></div>
    <div class="cardBody">
      <p class="tiny">Review the network receipt or supporting evidence outside this platform. You cannot review an entry you recorded. Accepting a record does not make the provider status verified and does not move money.</p>
      <% if (!data.reviewQueue.length) { %><p class="tiny">No records are awaiting internal review.</p><% } %>
      <% data.reviewQueue.forEach(t => { %>
        <form method="post" action="/tenant/mobile-money/<%= t._id %>/review" class="card" style="margin:12px 0;padding:12px">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="cardHead"><b><%= t.network %> · <%= t.networkReference %></b><span><%= t.customer %> · <%= t.entrySource === 'sms' ? 'SMS capture' : 'Manual' %> · <%= t.operation.replace('_',' ') %> · <%= money(t.currency,amountFromMinor(t.amountMinor,t.currency)) %></span></div>
            <label class="field">Evidence or dispute explanation (12–400 characters)
              <textarea class="control" name="note" minlength="12" maxlength="400" required rows="2" placeholder="State what evidence was checked or why this record is disputed"></textarea>
            </label>
            <div class="rowBtns"><button class="btn btnPrimary" name="decision" value="accepted">Accept internal record</button>
            <button class="btn" name="decision" value="disputed">Mark disputed</button></div>
        </form>
      <% }) %>
    </div>
  </section>
  <% } %>
</section>
