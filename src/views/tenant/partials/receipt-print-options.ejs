<section class="receiptPrintControls" data-receipt-print-controls aria-label="Small thermal printer settings">
 <label for="receiptPaperWidth">Paper width
  <select id="receiptPaperWidth"><option value="58">58 mm</option><option value="80">80 mm</option></select>
 </label>
 <label class="receiptAutoOption" for="receiptAutoPrintToggle">
  <input id="receiptAutoPrintToggle" type="checkbox" checked>
  Automatically open print sheet after a newly posted receipt
 </label>
 <p class="receiptPrintStatus" id="receiptPrintStatus" role="status">Choose your paired thermal printer in your phone's print service. Browser printing may require confirmation.</p>
</section>