<section class="view show">
  <section class="card">
    <div class="cardHead">
      <b>Posted activity</b>
      <% if(data.records.accountId){ %>
        <a class="btn" href="/tenant/accounts/<%= data.records.accountId %>#activity">Back to account</a>
      <% }else{ %>
        <a class="btn" href="/tenant/accounts">Back to accounts</a>
      <% } %>
    </div>
    <div class="cardBody"><%- include('_activity',{records:data.records,formatMinor:data.formatMinor,showAccount:!data.records.accountId}) %></div>
  </section>
</section>
