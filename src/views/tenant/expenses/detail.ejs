<% const record=data.record; %>
<section class="view show"><section class="card"><div class="cardHead"><div><b>Expense details</b><br><span><%= record.recordReference %></span></div><a class="btn" href="/tenant/expenses">Expenses</a></div>
 <div class="cardBody"><div class="grid"><div class="summary"><div class="sumRow"><span>Expense type</span><b><%= record.expenseType %></b></div><div class="sumRow"><span>Amount</span><b><%= data.format(record.amountMinor,record.currency) %></b></div><div class="sumRow"><span>Payment method</span><b><%= record.paymentMethod %></b></div><div class="sumRow"><span>Paid to / vendor</span><b><%= record.vendor||'—' %></b></div></div>
 <div class="summary"><div class="sumRow"><span>Status</span><b><%= record.status.replaceAll('_',' ') %></b></div><div class="sumRow"><span>Reference</span><b><%= record.reference||'—' %></b></div><div class="sumRow"><span>Recorded (UTC)</span><b><%= new Date(record.createdAt).toISOString() %></b></div><div class="sumRow"><span>Correction</span><b><%= record.correctionState %></b></div></div></div>
 <p><b>Description:</b> <%= record.description||'—' %></p><% if(record.reviewNote){ %><p><b>Review note:</b> <%= record.reviewNote %></p><% } %>
 <p class="tiny">The original record is retained. Independent approval records expense evidence; it does not send funds through a network or bank. Only approved cash expenses reduce the linked physical cash estimate.</p></div></section>
 <% if(data.canReview){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Review expense</b><span>Independent decision</span></div><div class="cardBody"><form method="post" action="/tenant/expenses/<%= record._id %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field">Review note<textarea class="control" name="note" minlength="12" maxlength="400" required></textarea></label><div class="rowBtns"><button class="btn btnPrimary" name="decision" value="approve">Approve expense</button><button class="btn" name="decision" value="reject">Reject expense</button></div></form></div></section><% } %>
 <% if(record.pendingChange){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Pending <%= record.pendingChange.kind==='void'?'void':'correction' %> request</b><span>Current record remains in effect until approved</span></div><div class="cardBody"><p><%= record.pendingChange.reason %></p>
 <% if(record.pendingChange.values){ const proposed=record.pendingChange.values; %><div class="summary"><div class="sumRow"><span>Proposed expense type</span><b><%= proposed.expenseType %></b></div><div class="sumRow"><span>Proposed amount</span><b><%= data.format(proposed.amountMinor,record.currency) %></b></div><div class="sumRow"><span>Proposed vendor</span><b><%= proposed.vendor||'—' %></b></div><div class="sumRow"><span>Proposed reference</span><b><%= proposed.reference||'—' %></b></div><div class="sumRow"><span>Proposed description</span><b><%= proposed.description||'—' %></b></div></div><% } %>
 <% if(data.canDecide){ %><form method="post" action="/tenant/expenses/<%= record._id %>/decide-change"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field">Decision note<textarea class="control" name="note" minlength="12" maxlength="400" required></textarea></label><div class="rowBtns"><button class="btn btnPrimary" name="decision" value="approve">Approve request</button><button class="btn" name="decision" value="deny">Deny request</button></div></form><% } %></div></section><% } %>
 <% if(data.canChange&&data.permissions.correct){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Request a correction</b><span>Branch, currency, payment method and original values are preserved</span></div><div class="cardBody"><form method="post" action="/tenant/expenses/<%= record._id %>/correct"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
 <div class="row2"><label class="field">Expense type<input class="control" name="expenseType" value="<%= record.expenseType %>" minlength="2" maxlength="100" required></label><label class="field">Amount<input class="control" name="amount" value="<%= amountFromMinor(record.amountMinor,record.currency) %>" inputmode="decimal" required></label></div>
 <div class="row2"><label class="field">Paid to / vendor<input class="control" name="vendor" value="<%= record.vendor %>" maxlength="120"></label><label class="field">Reference<input class="control" name="reference" value="<%= record.reference %>" maxlength="120"></label></div><label class="field">Description<input class="control" name="description" value="<%= record.description %>" maxlength="400"></label><label class="field">Correction explanation<textarea class="control" name="note" minlength="12" maxlength="400" required></textarea></label><div class="rowBtns"><button class="btn btnPrimary">Request correction</button></div></form></div></section><% } %>
 <% if(data.canChange&&data.permissions.void){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Request expense void</b><span>Preserves the expense and its audit trail</span></div><div class="cardBody"><form method="post" action="/tenant/expenses/<%= record._id %>/void"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field">Void explanation<textarea class="control" name="note" minlength="12" maxlength="400" required></textarea></label><div class="rowBtns"><button class="btn btnDanger">Request void</button></div></form></div></section><% } %>
 <section class="card" style="margin-top:14px"><div class="cardHead"><b>Expense history</b><span>Chronological evidence and decisions</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Time (UTC)</th><th>Action</th><th>Previous amount</th><th>Proposed / corrected amount</th><th>Note</th></tr></thead><tbody><% record.history.forEach(entry=>{ %><tr><td><%= new Date(entry.at).toISOString() %></td><td><%= entry.action.replaceAll('_',' ') %></td><td><%= entry.before?data.format(entry.before.amountMinor,record.currency):'—' %></td><td><%= entry.after?data.format(entry.after.amountMinor,record.currency):'—' %></td><td><%= entry.note %></td></tr><% }) %></tbody></table></div></section>
</section>
