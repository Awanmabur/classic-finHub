<% const report=data.reportData;
   const zone=typeof businessTimeZone==='string'?businessTimeZone:'UTC';
   const totals=report.currencies||[], groups=report.networks||[], cash=report.cashCurrencies||[];
   const positions=report.positions||[], exchanges=report.fxRows||[];
   const out=new URLSearchParams();
   out.set('period',report.window.key);
   if(report.window.key==='custom'){out.set('from',report.window.from);out.set('to',report.window.to);}
   if(data.filters?.network)out.set('network',data.filters.network);
   if(data.filters?.currency)out.set('currency',data.filters.currency);
   const code=value=>value==='KES'?'KSH':value;
   const money=(value,currency)=>data.formatMoneyMinor(String(value??'0'),currency);
   const count=key=>groups.reduce((sum,row)=>sum+Number(row[key]||0),0); %>
<section class="view show mobileMoneyPage workspaceStack financialReportsPage" aria-label="Mobile Money business report">
 <%- include('../partials/module-finance',{moduleKey:'mobile_money'}) %>
 <section class="card">
  <div class="cardHead">
   <div><b>Mobile Money report</b><br><span>Transactions, earnings and balances by currency</span></div>
   <% if(data.canExport){ %><a class="btn" href="/tenant/mobile-money/report/unified.csv?<%= out.toString() %>">Export CSV</a><% } %>
  </div>
  <div class="cardBody workspaceStack">
   <%- include('_filters',{filterAction:'/tenant/mobile-money/report'}) %>
   <div class="summary">
    <div class="sumRow"><span>Period · <%= zone %></span><b><%= report.window.from %> — <%= report.window.to %></b></div>
    <div class="sumRow"><span>Recorded transactions</span><b><%= totals.reduce((s,r)=>s+r.depositCount+r.withdrawalCount,0) %></b></div>
    <div class="sumRow"><span>Cross-currency transactions</span><b><%= exchanges.reduce((s,r)=>s+r.count,0) %></b></div>
   </div>
   <p class="tiny">Money exchanged is volume, not profit. Sheet commissions are expected; only independently posted provider payouts count as received.</p>
  </div>
 </section>

 <section class="card">
  <div class="cardHead"><div><b>Business activity by currency</b><br><span>Provider wallet denomination · no mixing currencies</span></div></div>
  <div class="cardBody workspaceStack">
   <% if(!totals.length){ %><p class="tiny">No activity for these filters.</p><% } %>
   <% totals.forEach(row=>{ %>
    <section class="mobileMoneyCurrencyBlock">
     <h3><%= code(row.currency) %></h3>
     <div class="networkBalanceGrid">
      <div class="networkBalanceStat"><span>Deposit / Withdrawal</span><strong><%= row.depositCount %> / <%= row.withdrawalCount %></strong></div>
      <div class="networkBalanceStat"><span>Transaction volume</span><strong><%= row.volumeMinorFormatted %></strong><small>Customer principal, not income</small></div>
      <div class="networkBalanceStat"><span>Electronic float change</span><strong><%= row.floatMovementMinorFormatted %></strong><small>Net movement during selected period</small></div>
      <div class="networkBalanceStat"><span>Expected network commission</span><strong><%= row.estimatedCommissionMinorFormatted %></strong><small><%= row.commissionMissingCount?row.commissionMissingCount+' transaction(s) without an approved sheet':'From approved provider sheets; not yet received' %></small></div>
      <div class="networkBalanceStat"><span>Commission actually received</span><strong><%= row.receivedCommissionMinorFormatted %></strong><small>Verified provider payout entries</small></div>
     </div>
     <% if(BigInt(String(row.collectedFeeMinor||'0'))!==0n){ %>
      <p class="tiny">Historical separately collected fees: <%= row.collectedFeeMinorFormatted %>. New agent transactions do not require extra customer fees.</p>
     <% } %>
    </section>
   <% }) %>
  </div>
 </section>

 <section class="card">
  <div class="cardHead"><div><b>Physical cash movement</b><br><span>Actual drawer currency, including cross-currency exchanges</span></div></div>
  <div class="cardBody tableWrap" tabindex="0" role="region" aria-label="Physical cash by currency">
   <table>
    <thead><tr><th>Currency</th><th>Transactions</th><th>Cash received</th><th>Cash paid out</th><th>Net cash movement</th></tr></thead>
    <tbody>
     <% if(!cash.length){ %><tr><td colspan="5">No physical cash activity for these filters.</td></tr><% } %>
     <% cash.forEach(row=>{ %>
      <tr><td><b><%= code(row.currency) %></b></td><td><%= row.count %></td><td><%= row.inFormatted %></td><td><%= row.outFormatted %></td><td><%= row.formatted %></td></tr>
     <% }) %>
    </tbody>
   </table>
  </div>
 </section>

 <section class="card">
  <div class="cardHead"><div><b>Cash and float reconciliation</b><br><span>Current book compared with the LAST independently counted balance, not a live provider reading</span></div><a class="btn" href="/tenant/treasury">Reconcile</a></div>
  <div class="cardBody tableWrap" tabindex="0" role="region" aria-label="Actual and expected account balances">
   <% if(!report.positionsAccessible){ %><p class="tiny">Treasury permission is needed to view balances and verification.</p><% } %>
   <table>
    <thead><tr><th>Account</th><th>Currency</th><th>Current expected book</th><th>Actual at last count</th><th>Book at last count</th><th>Difference at last count</th><th>Checked</th><th>State</th></tr></thead>
    <tbody>
     <% if(!positions.length){ %><tr><td colspan="8">No accessible cash or provider wallet balances.</td></tr><% } %>
     <% positions.forEach(row=>{ %>
      <tr><td><b><%= row.kind==='wallet'?'Float · '+(row.network||'Provider'):'Cash drawer' %></b><small><%= row.name %></small></td>
       <td><%= code(row.currency) %></td><td><%= row.bookFormatted %></td><td><%= row.actualFormatted %></td><td><%= row.comparedBookFormatted %></td>
       <td><%= row.varianceFormatted %></td>
       <td><%= row.observedAt?new Date(row.observedAt).toLocaleString('en-GB',{timeZone:zone,day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}):'Not checked' %></td>
       <td><%= row.status %></td></tr>
     <% }) %>
    </tbody>
   </table>
  </div>
 </section>

 <section class="card">
  <div class="cardHead"><b>Network breakdown</b></div>
  <div class="cardBody tableWrap" tabindex="0" role="region" aria-label="Network results">
   <table>
    <thead><tr><th>Network</th><th>Currency</th><th>Deposits</th><th>Withdrawals</th><th>Volume</th><th>Expected commission</th><th>Commission received</th></tr></thead>
    <tbody>
     <% if(!groups.length){ %><tr><td colspan="7">No network activity for these filters.</td></tr><% } %>
     <% groups.forEach(row=>{ %>
      <tr><td><b><%= row.network %></b></td><td><%= code(row.currency) %></td><td><%= row.depositCount %></td><td><%= row.withdrawalCount %></td>
       <td><%= row.volumeMinorFormatted %></td><td><%= row.commissionMissingCount&&String(row.estimatedCommissionMinor)==='0'?'No approved sheet':row.estimatedCommissionMinorFormatted %></td>
       <td><%= row.receivedCommissionMinorFormatted %></td></tr>
     <% }) %>
    </tbody>
   </table>
  </div>
 </section>

 <section class="card">
  <div class="cardHead"><div><b>Linked Mobile Money exchanges</b><br><span>One customer transaction, recorded in Mobile Money and Forex</span></div></div>
  <div class="cardBody tableWrap" tabindex="0" role="region" aria-label="Linked Forex activity">
   <table>
    <thead><tr><th>Network</th><th>Type</th><th>Count</th><th>Electronic float</th><th>Physical cash</th><th>Realized FX profit</th></tr></thead>
    <tbody>
     <% if(!exchanges.length){ %><tr><td colspan="6">No linked cross-currency exchanges for these filters.</td></tr><% } %>
     <% exchanges.forEach(row=>{ %>
      <tr><td><%= row.network %></td><td><%= row.operation==='withdraw_provider_receive_cash'?'Withdrawal':'Deposit' %></td><td><%= row.count %></td>
       <td><%= row.providerFormatted %></td><td><%= row.cashFormatted %></td><td>Not measured · cost basis missing</td></tr>
     <% }) %>
    </tbody>
   </table>
   <p class="tiny">Forex profit requires verified currency acquisition costs. A displayed exchange rate alone cannot establish realized profit.</p>
  </div>
 </section>

 <section class="card">
  <div class="cardHead"><b>Income and expenses</b></div>
  <div class="cardBody workspaceStack">
   <p class="tiny">Realized Forex profit is not available until cost basis is measured. Provider commissions not yet paid are not included as received income. Expenses are shared branch costs, not automatically charged to Mobile Money.</p>
   <% if(report.expensesAccessible&&report.expenses.length){ %>
    <div class="summary"><% report.expenses.forEach(row=>{ %><div class="sumRow"><span>Approved business expenses · <%= code(row.currency) %></span><b><%= row.formatted %></b></div><% }) %></div>
   <% }else{ %><p class="tiny"><%= report.expensesAccessible?'No approved expenses recorded in this period.':'Expenses reporting is not available to this account.' %></p><% } %>
   <div class="rowBtns"><a class="btn" href="/tenant/mobile-money/history">Transactions</a><a class="btn" href="/tenant/mobile-money/tariffs">Commission sheets</a><a class="btn" href="/tenant/reports">All module reports</a></div>
  </div>
 </section>
</section>
