<section class="view show"><div class="rowBtns"><a class="btn" href="/tenant/accounts">Accounts directory</a><a class="btn" href="/tenant/accounts/balances">Account balances</a><% if(data.records.accountId){ %><a class="btn" href="/tenant/accounts/<%= data.records.accountId %>">Account details</a><% } %></div><section class="card" style="margin-top:14px"><div class="cardHead"><div><b>Account movements</b><br><span>Deposits, withdrawals, and transfers</span></div></div><div class="cardBody"><p class="tiny">Only actual ledger postings mapped to customer accounts appear. Unverified bank requests and operational records are separate from posted account movements.</p><div class="tableWrap"><table><thead><tr><th>Account</th><th>Journal reference</th><th>Source</th><th>Movement</th><th>Amount</th><th>Posted</th></tr></thead><tbody><% if(!data.records.items.length){ %><tr><td colspan="6">No posted account movements in your permitted scope.</td></tr><% }data.records.items.forEach(row=>{ %><tr data-search-row><td><a href="/tenant/accounts/<%= row.accountId %>"><%= row.accountNumber %></a></td><td class="mono"><%= row.journal?.sourceRef||row.journalId %></td><td><%= row.journal?.sourceType||'Journal' %></td><td><%= row.side==='credit'?'Credit':'Debit' %></td><td><%= data.formatMinor(row.signedMinor,row.currency) %></td><td><%= new Date(row.createdAt).toLocaleString('en-GB') %></td></tr><% }) %></tbody></table></div><% if(data.records.nextCursor){ %><a class="btn" href="/tenant/accounts/movements?accountId=<%= data.records.accountId||'' %>&amp;cursor=<%= encodeURIComponent(data.records.nextCursor) %>">Next movements</a><% } %></div></section></section>
