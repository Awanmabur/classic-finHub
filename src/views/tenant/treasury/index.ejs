<link rel="stylesheet" href="/css/workspace.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/treasury.css?v=<%= assetVersion %>">
<section class="view show">
  <div class="workspaceStack">
    <section class="card">
      <div class="cardHead">
        <b>Business accounts</b>
        <div class="rowBtns">
          <% if (data.canManage) { %><a class="btn btnPrimary" href="/tenant/treasury/accounts/new#account-setup">Add account</a><% } %>
          <% if (data.canReview) { %><a class="btn" href="/tenant/treasury/review#money-review">Review money and balances</a><% } %>
        </div>
      </div>
      <div class="cardBody treasuryAccounts">
        <% if (!data.accounts.length) { %><p>No accounts in this view. Add a wallet, cash drawer, or bank account to get started.</p><% } %>
        <% for (const account of data.accounts) {
          const href='/tenant/treasury/accounts/'+account._id;
          const opening=account.openingBalanceMinor===null;
          const status=data.accountStatus(account);
        %>
          <article class="treasuryAccountRow" data-search-row>
            <div>
              <a class="treasuryAccountLink" href="<%= href %>"><%= account.name %></a>
              <div class="tiny">
                <% if (data.allBranches&&data.branchNames[String(account.branchId)]) { %><%= data.branchNames[String(account.branchId)] %> · <% } %>
                <%= account.kind.replaceAll('_',' ') %><%= account.network?' · '+account.network:'' %>
              </div>
            </div>
            <div class="treasuryAccountBalance">
              <b><%= opening?'—':account.expectedFormatted %></b>
              <span class="tiny"><%= status %></span>
            </div>
            <div class="rowBtns">
              <% if (data.canObserve&&data.usableForFunding(account)) { %><a class="btn" href="<%= href %>?action=money#add-money">Add money</a><% } %>
              <% if (data.canObserve&&account.status!=='archived'&&!account.pendingOpeningId) { %><a class="btn" href="<%= href %>?action=check#check-balance"><%= opening?'Set opening balance':'Check balance' %></a><% } %>
              <% if (data.canManage&&account.status!=='archived') { %><a class="btn" href="<%= href %>?action=edit#edit-account">Edit details</a><% } %>
            </div>
          </article>
        <% } %>
      </div>
    </section>

    <% if (data.mode==='review') { %>
      <section class="card treasuryFocused" id="money-review">
        <div class="cardHead"><b>Awaiting your review</b></div>
        <div class="cardBody workspaceStack">
          <% if (!data.pendingFunding.length&&!data.queue.observations.length&&!data.queue.adjustments.length) { %><p>Nothing to review.</p><% } %>
          <%- include('_funding-history',{fundings:data.pendingFunding,allowReview:()=>true,onAccount:false}) %>
          <% for (const row of data.queue.observations) { %><%- include('_balance-review',{row,account:row.account,isAdjustment:false,allowReview:true,accountLink:true}) %><% } %>
          <% for (const row of data.queue.adjustments) { %><%- include('_balance-review',{row,account:row.account,isAdjustment:true,allowReview:true,accountLink:true}) %><% } %>
        </div>
      </section>
    <% } %>

    <% if (data.canManage) { %>
      <details class="card workspaceSecondary <%= data.mode==='create'?'treasuryFocused':'' %>" id="account-setup" <%= data.mode==='create'?'open':'' %>>
        <summary>Add account</summary>
        <% if (data.canCreateAccount) { %>
          <form class="cardBody workspaceStack" method="post" action="/tenant/treasury/accounts" data-treasury-create>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="row2">
              <label class="field">Name<input class="control" name="name" required minlength="3" maxlength="120" placeholder="Example: Main cash drawer"></label>
              <label class="field">Account type<select class="control" name="kind" required><option value="">Choose type</option><% for (const kind of data.kinds) { %><option value="<%= kind %>"><%= ({wallet:'Mobile wallet',cash:'Cash drawer',bank:'Bank account',forex_stock:'Forex stock',transfer_clearing:'Transfer clearing'})[kind] %></option><% } %></select></label>
              <label class="field">Currency<select class="control" name="currency" required><% for (const currency of data.setupBranch.currencies||['UGX','USD','SSP','KES']) { %><option value="<%= currency %>" <%= data.setupBranch.currency===currency?'selected':'' %>><%= currency==='KES'?'KSH':currency %></option><% } %></select></label>
              <label class="field" data-kind="wallet">Wallet network<select class="control" name="network"><option value="">Choose network</option><% for (const network of data.networks) { %><option><%= network %></option><% } %></select></label>
              <label class="field" data-operator>Assigned operator<select class="control" name="operatorId"><option value="">Shared branch account</option><% for (const operator of data.operators) { %><option value="<%= operator._id %>"><%= operator.name %> · <%= operator.role %></option><% } %></select></label>
            </div>
            <details class="logicNote">
              <summary>More settings</summary>
              <div class="row2">
                <label class="field">Account code<input class="control" name="code" required pattern="[A-Za-z][A-Za-z0-9_]{2,39}" maxlength="40" value="<%= data.accountCode %>"></label>
                <label class="field">Wallet or bank identifier<input class="control" name="accountReference" maxlength="80"></label>
                <label class="field">Use as the default<select class="control" name="isDefault"><option value="true">Yes</option><option value="false">No</option></select></label>
              </div>
            </details>
            <div class="rowBtns"><button class="btn btnPrimary" type="submit">Create account in <%= data.setupBranch.name %></button></div>
          </form>
        <% } else { %><p class="cardBody">Choose a branch before adding an account.</p><% } %>
      </details>
    <% } %>

    <% if (data.canObserve) { %>
      <details class="card workspaceSecondary" id="add-funds" <%= data.fundingDestination?'open':'' %>>
        <summary>Move money between accounts</summary>
        <%- include('_funding',{destination:null}) %>
      </details>
    <% } %>

    <section class="card <%= data.mode==='history'?'treasuryFocused':'' %>" id="funding-history">
      <% if (data.mode==='history') { %>
        <div class="cardHead"><b>Money added and transferred</b></div>
        <div class="cardBody workspaceStack">
          <% if (!data.fundings.length) { %><p>No funding requests in this view.</p><% } %>
          <%- include('_funding-history',{fundings:data.fundings,allowReview:()=>false,onAccount:false}) %>
        </div>
      <% } else { %>
        <div class="cardBody"><a class="btn" href="/tenant/treasury?view=history#funding-history" data-treasury-history-link>Funding history</a></div>
      <% } %>
    </section>
  </div>
</section>
<script defer src="/js/treasury.js?v=<%= assetVersion %>"></script>
