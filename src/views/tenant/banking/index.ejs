<% const currentBranch = typeof operationBranch !== 'undefined' ? operationBranch : (data.branches || []).find(b => String(b._id) === String(user.transactionBranchId || user.branchId || data.selectedBranchId || '') && b.status !== 'archived');
   const currentBranchId = currentBranch ? String(currentBranch._id) : null;
   const branchProblem = typeof operationBranchError === 'string' && operationBranchError ? operationBranchError : 'An active operating branch must be assigned to your account before creating records.'; %>
<section class="view show">
 <%- include('../../partials/operation-branch', {currentBranch, branchProblem, user}) %>
 <section class="card"><div class="cardHead"><b><%= data.workspaceTitle||'Banking requests' %></b><span>Internal banking requests</span></div>
  <div class="cardBody"><p class="tiny">Record the instruction and send it for independent review. Bank execution remains pending verification.</p>
   <div class="rowBtns"><a class="btn" href="/tenant/banking/deposit">Deposit</a><a class="btn" href="/tenant/banking/withdraw">Withdraw</a><a class="btn" href="/tenant/banking/transfer">Account transfer</a><a class="btn" href="/tenant/banking/accounts">Masked account references</a><a class="btn" href="/tenant/banking/records">Full request history</a><a class="btn" href="/tenant/banking/report">Banking report summary</a></div>

  </div></section>
 <div class="grid" style="margin-top:14px">
  <% if(data.canCreate && currentBranchId){ %><form method="post" action="/tenant/banking/requests" class="card" autocomplete="off">
   <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= data.idempotencyKey %>">
   <div class="cardHead"><b><%= data.workspaceTitle||'Record banking request' %></b><span>Second-person approval</span></div><div class="cardBody" style="display:grid;gap:12px">
    <% if(!data.references.length){ %><p class="tiny">Create a customer account or a masked bank reference for your operating branch before starting a request.</p><% } %>
    <b>Operation details</b>
    <% if(data.workspaceOperation){ %><input type="hidden" name="kind" value="<%= data.workspaceOperation %>"><label class="field">Operation<input class="control" value="<%= data.workspaceTitle %>" readonly></label><% } else { %><label class="field">Operation<select name="kind" class="control" required><option value="deposit_request">Deposit request</option><option value="withdrawal_request">Withdrawal request</option><option value="transfer_request">Bank transfer request</option></select></label><% } %>
    <label class="field">Customer account<select name="sourceId" class="control" required><option value="">Select reference</option><% data.references.forEach(a=>{ %><option value="<%= a._id %>"><%= a.customerName %> · <%= a.institutionName %> · ****<%= a.last4 %></option><% }) %></select></label>
    <% if(!data.workspaceOperation||data.workspaceOperation==='transfer_request'){ %><label class="field">To account<select name="destinationId" class="control" <%= data.workspaceOperation==='transfer_request'?'required':'' %>><option value="">Select destination for a transfer</option><% data.references.forEach(a=>{ %><option value="<%= a._id %>"><%= a.customerName %> · <%= a.institutionName %> · ****<%= a.last4 %></option><% }) %></select></label><% } %>
    <div class="row2"><label class="field">Amount<input name="amount" type="number" class="control" min="1" step="0.01" required></label><div class="field"><span>Currency</span><input type="hidden" name="currency" value="<%= currentBranch.currency %>"><span class="control"><%= currentBranch.currency %></span></div></div>
    <label class="field">Payment channel<select class="control" name="paymentChannel"><% ['Cash','Internal transfer','Bank settlement','Mobile money'].forEach(channel=>{ %><option><%= channel %></option><% }) %></select></label>
    <label class="field">Request validity<select name="validDays" class="control" required><% for(let days=1;days<=30;days++){ %><option value="<%= days %>" <%= days===7?'selected':'' %>><%= days %> day<%= days===1?'':'s' %></option><% } %></select></label>
    <b>Reference and verification</b>
    <div class="row2"><label class="field">Customer phone / contact<input class="control" name="customerPhone" type="tel" maxlength="16" placeholder="Optional phone override"></label><label class="field">External reference<input class="control" name="externalReference" maxlength="120" placeholder="Cheque, slip, bank ref, optional"></label></div>
    <label class="field">Note / narration (12–400 characters)<textarea name="note" class="control" minlength="12" maxlength="400" rows="3" required placeholder="Explain the reason without account numbers or secrets"></textarea></label>
    <div class="summary"><div class="sumRow"><span>Reference</span><b class="mono"><%= data.idempotencyKey %></b></div><div class="sumRow"><span>Handled by</span><b><%= user.name %></b></div></div><p class="tiny">Posts an internal request for independent review. Bank execution remains pending verification.</p>
    <div class="rowBtns"><button type="submit" class="btn btnPrimary" <%= !data.references.length?'disabled':'' %>>Post banking operation</button></div>
   </div>
  </form><% } else if(data.canCreate){ %><section class="card"><div class="cardHead"><b>New request</b></div><div class="cardBody"><p class="tiny">Your account needs an active operating branch before creating a request.</p></div></section><% } %>
  <section class="card"><div class="cardHead"><b>Recent requests</b><span><%= data.records.items.length %> visible</span></div><div class="cardBody txList">
    <% if(!data.records.items.length){ %><p class="tiny">No banking requests in your permitted scope.</p><% } %>
    <% data.records.items.forEach(t=>{ %><div class="tx" data-search-row><div class="txMeta"><b><a href="/tenant/banking/<%= t._id %>"><%= t.reference %></a></b><span><%= t.kind.replaceAll('_',' ') %> · <%= t.status.replaceAll('_',' ') %> · <%= t.source.customerName %></span></div><b><%= data.formatMoneyMinor(t.amountMinor,t.currency) %></b></div><% }) %>
   </div><div class="cardBody"><a class="btn" href="/tenant/banking/history">All banking requests</a></div></section>
 </div>
 <% if(data.canReview){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Independent review queue</b><span>No self-approval</span></div><div class="cardBody">
  <% if(!data.queue.length){ %><p class="tiny">No requests await your review.</p><% } %>
  <% data.queue.forEach(t=>{ %><form method="post" action="/tenant/banking/<%= t._id %>/review" class="card" style="padding:12px;margin-bottom:12px"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="cardHead"><b><a href="/tenant/banking/<%= t._id %>"><%= t.reference %></a></b><span><%= data.formatMoneyMinor(t.amountMinor,t.currency) %></span></div>
    <p class="tiny"><%= t.kind.replaceAll('_',' ') %> · <%= t.source.institutionName %> · ****<%= t.source.last4 %></p>
    <label class="field">Review justification (12–400 characters)<textarea name="note" class="control" minlength="12" maxlength="400" required rows="2"></textarea></label>
    <div class="rowBtns"><button name="decision" value="approve" class="btn btnPrimary">Approve pending bank verification</button><button name="decision" value="reject" class="btn">Reject request</button></div>
   </form><% }) %>
 </div></section><% } %>
</section>
