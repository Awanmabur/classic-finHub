<section class="view show"><section class="card"><div class="cardHead"><b>Receipts</b><span>Transaction receipts, print, email, scheduled exports.</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Number</th><th>Module</th><th>Customer</th><th>Amount</th><th>Fee</th><th>Date</th></tr></thead><tbody><% data.receipts.forEach(r => { %><tr data-search-row><td><b><%= r.number %></b></td><td><%= r.module %></td><td><%= r.customer %></td><td><%= r.amount %></td><td><%= r.fee %></td><td><%= r.createdAt %></td></tr><% }) %></tbody></table></div></section></section>
