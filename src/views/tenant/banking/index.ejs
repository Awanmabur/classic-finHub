<section class="view show"><div class="grid"><form class="card" method="post" action="/tenant/banking/deposit"><div class="cardHead"><b>Banking operation</b><span>Deposit, withdrawal, transfers, ledger entries, statement impact.</span></div><div class="cardBody" style="display:grid;gap:12px"><div class="row2"><label class="field">Customer<input class="control" name="customer" required /></label><label class="field">Account<select class="control" name="account"><% data.accounts.forEach(a => { %><option><%= a.number %> — <%= a.customer %></option><% }) %></select></label></div><div class="row3"><label class="field">Amount<input class="control" type="number" name="amount" required /></label><label class="field">Fee<input class="control" type="number" name="fee" value="1500" /></label><label class="field">Currency<select class="control" name="currency"><option>UGX</option><option>USD</option></select></label></div><div class="rowBtns"><button class="btn btnPrimary" formaction="/tenant/banking/deposit">Deposit</button><button class="btn" formaction="/tenant/banking/withdraw">Withdraw</button></div></div></form><section class="card"><div class="cardHead"><b>Accounts</b><span>Balances and movements</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Account</th><th>Customer</th><th>Type</th><th>Balance</th><th>Status</th></tr></thead><tbody><% data.accounts.forEach(a => { %><tr data-search-row><td><%= a.number %></td><td><%= a.customer %></td><td><%= a.type %></td><td><%= money(a.currency,a.balance) %></td><td><span class="tag"><%= a.status %></span></td></tr><% }) %></tbody></table></div></section></div></section>
