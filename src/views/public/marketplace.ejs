<section class="services marketplace-page">
  <div class="section-head reveal"><p>Module marketplace</p><h1>Choose the modules your team needs</h1></div>
  <div class="pricing-grid">
    <% modules.filter(module=>module.runtimeStatus!=='disabled').forEach(module => { %>
      <article class="price-card reveal">
        <span class="plan-badge"><%= module.runtimeStatus==='recording_only'?(module.key==='sms_capture'?'SMS-assisted capture':'Reviewed manual books'):(module.isCore?'Core module':'Addon') %></span>
        <h3><i class="fa-solid <%= module.icon %>"></i> <%= module.name %></h3>
        <p><%= module.description %></p>
        <h4>$<%= module.priceMonthly %><small>/month indicative</small></h4>
        <a href="/book-appointment" class="btn btn-dark">Discuss module</a>
      </article>
    <% }) %>
  </div>
</section>
