[Unit]
Description=ClassicFin internal Forex quotation expiry sweep
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=classicdeploy
Group=classicdeploy
WorkingDirectory=/srv/classic/apps/classicfin
EnvironmentFile=/srv/classic/secrets/classicfin.env
ExecStart=/usr/bin/node scripts/forex-expiry.js
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
