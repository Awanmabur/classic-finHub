<section class="view show"><div class="grid3"><div class="stat"><div class="k">Tenant</div><div class="v"><%= data.tenant.name %></div><div class="s"><span class="dot"></span><%= data.tenant.status %></div></div><div class="stat"><div class="k">Database</div><div class="v" style="font-size:14px"><%= data.tenant.dbName %></div><div class="s"><span class="dot"></span>Isolated tenant DB</div></div><div class="stat"><div class="k">Modules</div><div class="v"><%= data.tenant.enabledModules.length %></div><div class="s"><span class="dot warn"></span>Sidebar built dynamically</div></div></div><section class="card" style="margin-top:14px"><div class="cardHead"><b>Enabled modules</b><span>Platform can add/remove after billing or approval.</span></div><div class="cardBody"><div class="seg"><% data.modules.forEach(m => { %><span class="chip <%= data.tenant.enabledModules.includes(m.key) ? 'active' : '' %>"><i class="fa-solid <%= m.icon %>"></i> <%= m.name %></span><% }) %></div></div></section></section>
