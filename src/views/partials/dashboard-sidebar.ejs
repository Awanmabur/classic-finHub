<% const activeHref = menu.flatMap(group => group.items).map(item => item.href)
  .filter(href => currentPath === href || currentPath.startsWith(href + '/'))
  .sort((a,b) => b.length - a.length)[0]; %>
<aside class="panel side" id="sidePanel">
  <div class="brand">
    <div class="logo"></div>
    <div><h1><%= context === 'platform' ? 'ClassicFin Platform' : (tenant?.name || 'Tenant Workspace') %></h1><p><%= context === 'platform' ? 'Classic Technologies' : (tenant?.status + ' • ' + tenant?.plan) %></p></div>
  </div>
  <nav class="nav" aria-label="Workspace navigation">
    <% menu.forEach(group => { %>
      <div class="navGroup">
        <a class="item <%= group.items.some(item => item.href === activeHref) ? 'active' : '' %>" href="<%= group.items[0].href %>" aria-label="Open <%= group.label %>"><i class="fa-solid <%= group.items[0].icon %>" aria-hidden="true"></i> <span><%= group.label %></span></a>
        <% group.items.forEach(item => { %>
          <a href="<%= item.href %>" class="subitem <%= activeHref === item.href ? 'active' : '' %>" <%- activeHref === item.href ? 'aria-current="page"' : '' %>><i class="fa-solid <%= item.icon %>" aria-hidden="true"></i><span><%= item.label %></span></a>
        <% }) %>
      </div>
    <% }) %>
  </nav>
  <div class="sideFoot">
    <div class="mini"><div><b><%= user?.name || 'Account' %></b><span><%= user?.role || (context === 'platform' ? 'Super Admin' : 'Tenant Owner') %></span></div></div>
    <div class="accountActions"><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit"><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i> Sign out</button></form><a class="btn" href="/"><i class="fa-solid fa-globe" aria-hidden="true"></i> Public site</a></div>
  </div>
</aside>
