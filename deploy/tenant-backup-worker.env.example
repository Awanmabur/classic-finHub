# Private worker env. Keep outside Git; mount the same persistent directory in
# web + backup worker. This worker serves no HTTP port.
NODE_ENV=production
APP_URL=https://finance.example.com
TENANT_BACKUPS_ENABLED=true
TENANT_BACKUP_ENCRYPTION_KEY=
TENANT_BACKUP_DIR=/var/lib/classicfin/tenant-backups
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Separate Atlas service user: read platform tenants + read all tenant business
# collections; write tenant backup policies/archives and WorkerHeartbeat only.
MONGO_BACKUP_WORKER_URI=
