# CLASSICFIN HUB v1.23 — COMPLETE DEVELOPMENT ENVIRONMENT INVENTORY
# Copy/create .env using setup-classicfin-full-env.cjs. Never commit filled secrets.
# Keys labelled [RESERVED] are included for future adapters/legacy compatibility;
# they DO NOT activate services in v1.23. Keep provider credentials empty until issued.
# Production uses separate restricted env files for web / outbox / notifications / backups / alerts.

# === 01. APPLICATION — ACTIVE ===
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
TRUST_PROXY=0
SEO_INDEXING_ENABLED=false
REAL_MONEY_ENABLED=false

# === 02. GENERATE LOCALLY — ACTIVE SECRET KEYS ===
SESSION_SECRET=
MFA_ENCRYPTION_KEY=
FINANCIAL_GATEWAY_CALLBACK_HMAC_KEY_HEX=
FINANCIAL_GATEWAY_STATEMENT_HMAC_KEY_HEX=

# === 03. GENERATE LOCALLY — [RESERVED], NOT USED BY v1.23 ===
# Retained because your previous configuration included them.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=

# === 04. MONGODB — ACTIVE ===
# npm run db:dev:up starts MongoDB replica set rs0 on local port 27018.
# For Atlas/Contabo production replace with the actual authenticated TLS replica-set URI.
MONGO_PLATFORM_URI=mongodb://127.0.0.1:27018/classicfin_platform_db?replicaSet=rs0&directConnection=true
MONGO_POOL_MAX=30
# Production: use separate least-privilege DB users in separate worker env files.
MONGO_WORKER_URI=
MONGO_NOTIFICATION_WORKER_URI=
# [RESERVED/LEGACY] Tenant databases use the primary MongoDB client; no base URI is read.
MONGO_TENANT_BASE_URI=

# === 05. REDIS — OPTIONAL ===
# Leave blank until you run an authorized Redis service.
REDIS_URL=

# === 06. TRANSACTIONAL EMAIL — ACTIVE RESEND ADAPTER ===
# Obtain the API key from Resend; verify the sender domain before setting MAIL_FROM.
RESEND_API_KEY=
MAIL_FROM=

# === 07. SMTP — [RESERVED/LEGACY], NOT USED BY v1.23 ===
# Do not paste Purelymail mailbox passwords unless an SMTP adapter is implemented.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# === 08. SMS — [RESERVED], INTEGRATION NOT IMPLEMENTED ===
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
# Optional provider-specific placeholders; not consumed by v1.23.
YOOLA_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# === 09. PAYMENTS — [RESERVED], REAL PAYOUTS DISABLED ===
# Generic provider fields from your earlier .env. These are not an implementation.
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_PUBLIC_KEY=
# Optional planned-provider placeholders. Obtain actual values from each provider.
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_NOTIFICATION_ID=
PAWAPAY_API_TOKEN=
EVERSEND_API_KEY=
EVERSEND_SECRET_KEY=

# === 10. INTERNAL WORKERS — ACTIVE ===
OUTBOX_POLL_MS=2000
NOTIFICATION_POLL_MS=5000

# === 11. FILE / DOCUMENT STORAGE — [RESERVED], NOT CONNECTED ===
STORAGE_DRIVER=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# === 12. ENCRYPTED DATABASE BACKUPS — ACTIVE IN BACKUP SCRIPTS ===
# Host/backup-only env. Do not put the full backup DB credential in the web container.
BACKUP_SOURCE_URI=
BACKUP_KEY_FILE=
BACKUP_OUTPUT_DIR=
BACKUP_MAX_AGE_HOURS=26
BACKUP_RESTORE_URI=
BACKUP_RECOVERY_DIR=

# === 13. IMMUTABLE S3 BACKUPS — ACTIVE IN OFFSITE SCRIPTS ===
OFFSITE_S3_BUCKET=
OFFSITE_S3_EXPECTED_OWNER=
OFFSITE_S3_PREFIX=classicfin/
AWS_REGION=
OFFSITE_RETENTION_DAYS=90
OFFSITE_MAX_AGE_HOURS=26
# Optional AWS SDK authentication; prefer a restricted role/profile where possible.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# === 14. OPERATIONS ALERTING — ACTIVE IN ALERT SCRIPTS ===
OPS_ALERT_URL=
OPS_ALERT_TOKEN_FILE=

# === 15. ADMIN BOOTSTRAP / EMERGENCY RECOVERY — ONE-TIME COMMAND INPUTS ===
# Set only when running that specific command; otherwise leave blank.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_PASSWORD_FILE=
ADMIN_RECOVERY_EMAIL=
ADMIN_RECOVERY_PASSWORD_FILE=
ADMIN_RECOVERY_APPROVED=
MFA_RECOVERY_EMAIL=
MFA_RECOVERY_PASSWORD_FILE=
MFA_RECOVERY_CONFIRM=
MFA_TENANT_RECOVERY_ADMIN_PASSWORD_FILE=
MFA_TENANT_RECOVERY_TARGET_PASSWORD_FILE=

# === 16. COMMERCIAL LEGACY SETTINGS — [RESERVED], NOT ACTIVE v1.23 ===
# The app's versioned plan catalogue is authoritative.
TRIAL_GRACE_DAYS=7
DEFAULT_TRIAL_MONTHS=2

# === 17. DEPLOYMENT SHELL SETTINGS — [DEPLOY ONLY], NOT APP SECRETS ===
# The three env-file paths must be different on Contabo production.
CLASSICFIN_ENV_FILE=
CLASSICFIN_WORKER_ENV_FILE=
CLASSICFIN_NOTIFICATION_ENV_FILE=
CLASSICFIN_IMAGE=
CLASSICFIN_HOST_PORT=3500
CLASSICFIN_RELEASE_IMAGE=
CLASSICFIN_COMPOSE_FILE=
CLASSICFIN_STATE_DIR=
CLASSICFIN_INITIAL_DEPLOY=

# === 18. TEST-ONLY FLAGS — LEAVE BLANK IN NORMAL USE ===
MOCK_DB=
MOCK_REDIS=
