<section class="view show"><div class="grid"><form class="card" method="post" action="/tenant/branches"><div class="cardHead"><b>Create branch</b><span>Branch, cash drawer, currencies, open/close day.</span></div><div class="cardBody" style="display:grid;gap:12px"><label class="field">Branch name<input class="control" name="name" required /></label><label class="field">Currency<select class="control" name="currency"><option>UGX</option><option>USD</option><option>SSP</option></select></label><button class="btn btnPrimary">Add branch</button></div></form><section class="card"><div class="cardHead"><b>Day sessions</b><span>Expected vs actual cash.</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Branch</th><th>Currency</th><th>Status</th><th>Opening</th><th>Expected</th><th>Actual</th></tr></thead><tbody><% data.branches.forEach(b => { %><tr data-search-row><td><b><%= b.name %></b></td><td><%= b.currency %></td><td><span class="tag"><%= b.status %></span></td><td><%= money(b.currency,b.openingCash) %></td><td><%= money(b.currency,b.expectedCash) %></td><td><%= money(b.currency,b.actualCash) %></td></tr><% }) %></tbody></table></div></section></div></section>
