<section class="view show">
  <p class="tiny">Published terms stay fixed for existing subscriptions. Prices are shown for reference; no payment is collected here.</p>
  <% if(!data.published.length){ %><section class="card" style="margin-bottom:14px"><div class="cardHead"><b>Set up plans</b><span>Required before tenant creation</span></div><div class="cardBody"><p>Make the standard plans available before creating your first tenant.</p><form method="post" action="/platform/plans/publish-initial"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btnPrimary" type="submit">Set up plans and continue</button></form></div></section><% } %>
  <section class="card"><div class="cardHead"><b>Published plans</b><span><%= data.published.length %> versions</span></div><div class="cardBody tableWrap">
    <table><thead><tr><th>Plan</th><th>Version</th><th>Price/month</th><th>Branch limit</th><th>Seat limit</th><th>Published</th></tr></thead><tbody>
    <% data.published.forEach(p=>{ %><tr data-search-row><td><%= p.name %> (<%= p.code %>)</td><td>v<%= p.version %></td><td><%= p.currency %> <%= (p.priceMonthlyMinor/100).toFixed(2) %></td><td><%= p.limits.branches %></td><td><%= p.limits.users %></td><td><%= new Date(p.publishedAt).toISOString().slice(0,10) %></td></tr><% }) %>
    <% if(!data.published.length){ %><tr><td colspan="6">Set up plans above to make them available for tenant creation.</td></tr><% } %>
    </tbody></table></div></section>
  <% if(!data.published.length){ %><div class="grid3" style="margin-top:14px"><% data.plans.forEach(p=>{ %><article class="card" data-search-row><div class="cardHead"><b><%= p.name %></b><span>Standard plan</span></div><div class="cardBody"><div class="stat"><div class="k">Monthly price</div><div class="v"><%= p.currency %> <%= p.priceMonthly %></div></div><p class="tiny"><%= p.description %></p><p class="tiny"><%= p.limits.users %> users · <%= p.limits.branches %> branches · <%= p.limits.transactionsPerMonth %> records / month</p></div></article><% }) %></div><% } %>
</section>
