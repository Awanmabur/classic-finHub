<% if (typeof flash!=='undefined'&&flash&&flash.message) { const feedbackType=flash.type==='bad'?'bad':flash.type==='good'?'good':'info'; %>
  <div class="sessionFeedback feedback-<%= feedbackType %>" data-session-flash data-feedback-message role="<%= feedbackType === 'bad' ? 'alert' : 'status' %>" tabindex="-1">
    <span class="feedbackIcon" aria-hidden="true"><%= feedbackType==='bad'?'!':feedbackType==='good'?'✓':'i' %></span><div class="feedbackContent"><strong><%= feedbackType==='bad'?'Please check':feedbackType==='good'?'Done':'Information' %></strong><p><%= flash.message %></p></div><button class="feedbackDismiss" type="button" data-feedback-dismiss aria-label="Dismiss message">×</button>
  </div>
<% } %>
