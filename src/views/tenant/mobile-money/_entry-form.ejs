<% const entryOperation = typeof operation === 'string' && operation === 'cash_out' ? 'cash_out' : 'cash_in';
   const entryLabel = entryOperation === 'cash_in' ? 'Cash-in' : 'Cash-out';
   const entryPermissions = user.permissions || [];
   const entryCan = permission => entryPermissions.includes('*') || entryPermissions.includes(permission);
   const entryNetworks = data.networksAvailable || ['MTN','MTN SSD','Airtel','Africell','M-Pesa'];
   const entryCurrency=data.entryCurrency||currentBranch.currency;
   const entryCurrencyOptions=data.entryCurrencies?.length?data.entryCurrencies:(currentBranch.currencies||['UGX','USD','SSP','KES']).map(code=>({code,label:code==='KES'?'KSH':code}));
   const entryAmountPattern = entryCurrency === 'UGX' ? '[0-9]{1,11}' : '[0-9]{1,11}([.][0-9]{1,2})?';
   const entryCurrencyLabel = typeof currencyLabel === 'function' ? currencyLabel(entryCurrency) : (entryCurrency === 'KES' ? 'KSH' : entryCurrency); %>
<form class="card mobileMoneyEntry" method="post" action="/tenant/mobile-money/<%= entryOperation === 'cash_in' ? 'cash-in' : 'cash-out' %>" autocomplete="off" data-mobile-money-form data-operation="<%= entryOperation %>" data-currency="<%= entryCurrency %>" data-currency-label="<%= entryCurrencyLabel %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="idempotencyKey" value="<%= data.idempotencyKey %>">
  <div class="cardHead"><div><b>Mobile Money - <%= entryLabel %></b><br><span>Customer, network, and amount details</span></div></div>
  <div class="cardBody mobileMoneyFormBody">
    <div class="seg childActions" aria-label="Mobile money operation">
      <% if(entryCan('mobile_money.cash_in')){ %><a class="chip <%= entryOperation === 'cash_in' ? 'active' : '' %>" href="/tenant/mobile-money/cash-in" data-mobile-operation="cash_in" <%- entryOperation === 'cash_in' ? 'aria-current="page"' : '' %>>Cash-in</a><% } %>
      <% if(entryCan('mobile_money.cash_out')){ %><a class="chip <%= entryOperation === 'cash_out' ? 'active' : '' %>" href="/tenant/mobile-money/cash-out" data-mobile-operation="cash_out" <%- entryOperation === 'cash_out' ? 'aria-current="page"' : '' %>>Cash-out</a><% } %>
    </div>
    <div class="formSection">
      <div class="formSectionTitle">Customer and network</div>
      <div class="row2">
        <label class="field">Operation<input class="control" value="<%= entryLabel %>" data-mobile-operation-label readonly></label>
        <label class="field">Network<select class="control" name="network" required><% entryNetworks.forEach(network=>{ %><option value="<%= network %>"><%= network %></option><% }) %></select></label>
      </div>
      <div class="row2">
        <label class="field">Customer phone<input class="control" type="tel" name="customerPhone" placeholder="+256..." inputmode="tel" maxlength="24" required autocomplete="tel"></label>
        <label class="field">Customer name<input class="control" name="customer" placeholder="Customer full name or optional" minlength="2" maxlength="120" autocomplete="name"></label>
      </div>
      <div class="row2">
        <label class="field">Wallet / agent float reference<input class="control" name="networkReference" placeholder="Network transaction ID / float ref" pattern="[A-Za-z0-9._:\/\-]{5,100}" minlength="5" maxlength="100" required></label>
        <label class="field">Customer ID / note<input class="control" name="customerNote" placeholder="Optional verification or note" maxlength="400"></label>
      </div>
    </div>
    <div class="formSection">
      <div class="formSectionTitle">Amount details</div>
      <div class="row2">
        <label class="field">Currency<select class="control" name="currency" data-mobile-currency required><% entryCurrencyOptions.forEach(option=>{ %><option value="<%= option.code %>" <%= option.code===entryCurrency?'selected':'' %>><%= option.label %></option><% }) %></select></label>
        <label class="field">Amount<input class="control" type="text" inputmode="decimal" name="amount" placeholder="0" pattern="<%= entryAmountPattern %>" required></label>
      </div>
      <div class="row2">
        <label class="field">Fee / commission<input class="control" type="text" inputmode="decimal" name="fee" placeholder="0" value="0" pattern="<%= entryAmountPattern %>" required></label>
        <label class="field">Payment method<select class="control" name="paymentMethod" required><option value="Cash">Cash</option><option value="Wallet Balance">Wallet Balance</option><option value="Bank">Bank</option></select></label>
      </div>
      <%- include('_funds-context') %>
    </div>
    <div class="summary">
      <div class="sumRow"><span data-mobile-total-label><%= entryOperation==='cash_out'?'Total customer receives':'Total customer pays' %></span><b data-mobile-total>—</b></div>
      <div class="sumRow"><span>Reference</span><b class="mono mobileRequestReference" data-mobile-reference><%= data.idempotencyKey %></b></div>
    </div>
    <div class="rowBtns"><button class="btn btnPrimary" type="submit">Process mobile money</button></div>
  </div>
</form>
