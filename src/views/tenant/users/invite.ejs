<section class="view show"><section class="card"><div class="cardHead"><b>Private staff invitation</b><span>Expires after 24 hours</span></div><div class="cardBody"><p><% if(data.inviteQueued){ %>The staff activation email has been queued; delivery has not yet been confirmed. Keep this private fallback link if the email does not arrive.<% }else{ %>Automatic email delivery is not configured. Share this link privately with the staff member.<% } %> The link is single-use and expires after 24 hours.</p><label class="field">Activation link<input class="control" value="<%= data.inviteUrl %>" readonly data-select-on-focus></label><a class="btn btnPrimary" href="/tenant/users">Return to staff</a></div></section></section>
