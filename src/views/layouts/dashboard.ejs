<!doctype html>
<html lang="en">
<head>
  <link rel="icon" type="image/png" href="/images/classicfinhub-logo.png">
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= pageTitle %> — ClassicFin Hub</title>
  <meta name="robots" content="noindex,nofollow" />
  <meta name="description" content="Protected ClassicFin Hub operations workspace." />
  <link rel="stylesheet" href="/vendor/inter/inter.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= assetVersion %>" />
  <link rel="stylesheet" href="/css/dashboard.css?v=<%= assetVersion %>" />
</head>
<body>
  <% const visiblePaths = new Set(menu.flatMap(group => group.items.map(item => item.href)));
     const can = permission => user.permissions.includes('*') || user.permissions.includes(permission);
     const quickActions = context === 'tenant' ? [
       {href:'/tenant/money-transfer',label:'New transfer request',permission:'money_transfer.create'},
       {href:'/tenant/mobile-money',label:'New mobile money record',permission:['mobile_money.cash_in','mobile_money.cash_out']},
       {href:'/tenant/forex',label:'New forex quote',permission:'forex.quotes.create'},
       {href:'/tenant/banking',label:'New banking request',permission:'banking.requests.create'},
       {href:'/tenant/approvals',label:'New approval request',permission:'approvals.submit'}
     ].filter(action => visiblePaths.has(action.href) && (Array.isArray(action.permission) ? action.permission.some(can) : can(action.permission))) : [];
     const pageContent = include(view, { data, money, tenant, user, context, quickActions, visiblePaths });
     const hasPageSearch = pageContent.includes('data-search-row'); %>
  <a class="skip-link" href="#workspaceContent">Skip to workspace</a>
  <div class="grain" aria-hidden="true"></div>
  <div class="wrap"><div class="shell">
    <%- include('../partials/dashboard-sidebar', { context, menu, currentPath, tenant, user }) %>
    <main class="panel main" id="workspaceContent" tabindex="-1">
      <div class="topbar">
        <div class="title"><h2 id="pageTitle"><%= pageTitle %></h2><p id="pageSub"><%= pageSub %></p></div>
        <div class="topActions">
          <button class="btn btnIcon mobileOnly" id="menuBtn" type="button" aria-label="Open menu" aria-controls="sidePanel" aria-expanded="false"><i class="fa-solid fa-bars-staggered" aria-hidden="true"></i></button>
          <% if (hasPageSearch) { %><div class="ctrl pageSearch"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input id="search" type="search" aria-label="Search records on this page" placeholder="Search this page…"></div><% } %>
          <% if (context === 'platform' && ['/platform/dashboard','/platform/tenants'].includes(currentPath)) { %><a class="btn btnPrimary" href="/platform/tenants/create"><i class="fa-solid fa-plus" aria-hidden="true"></i> Create tenant</a><% } %>
          <% if (context === 'tenant' && quickActions.length) { %><button class="btn btnPrimary" type="button" id="newTransactionBtn" aria-haspopup="dialog" aria-controls="operationChooser" aria-expanded="false"><i class="fa-solid fa-plus" aria-hidden="true"></i> New transaction</button><% } %>
        </div>
      </div>
      <%- include('../partials/flash', { flash }) %>
      <%- pageContent %>
    </main>
  </div></div>
  <div class="menuOverlay" id="menuOverlay"></div>
  <% if (context === 'tenant' && quickActions.length) { %>
  <div class="overlay" id="operationChooser" role="dialog" aria-modal="true" aria-labelledby="operationChooserTitle" aria-hidden="true">
    <div class="sheet">
      <div class="sheetHead"><div><b id="operationChooserTitle">New transaction</b><p class="tiny">Choose an authorized service to open its secured recording form.</p></div>
        <button class="btn btnIcon" type="button" data-dialog-close aria-label="Close transaction chooser"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div>
      <div class="sheetBody">
        <div class="opLauncher">
          <% quickActions.forEach(action => { %>
          <div class="opGroup"><h3><%= action.label %></h3><p>Continue to the authenticated, tenant-scoped workflow.</p>
            <a class="btn btnPrimary" href="<%= action.href %>?new=<%= action.href === '/tenant/forex' ? 'quote' : '1' %>"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i> Open form</a></div>
          <% }) %>
        </div>
        <p class="tiny">These are internal records and requests. No money is sent, paid out, exchanged or settled by opening a form.</p>
      </div>
    </div>
  </div>
  <% } %>
  <script src="/js/dashboard.js?v=<%= assetVersion %>"></script>
</body>
</html>
