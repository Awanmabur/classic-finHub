<section class="view show"><section class="card"><div class="cardHead"><b>Notifications</b><span>SMS, email, in-app, WhatsApp later.</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Event</th><th>Channel</th><th>Recipient</th><th>Status</th><th>Message</th></tr></thead><tbody><% data.notifications.forEach(n => { %><tr data-search-row><td><%= n.event %></td><td><%= n.channel %></td><td><%= n.recipient %></td><td><span class="tag"><%= n.status %></span></td><td><%= n.message %></td></tr><% }) %></tbody></table></div></section></section>
