<%
  const fixedDestination=destination!==null;
  const accounts=data.fundingAccounts;
  const disabled=fixedDestination?!accounts.length:accounts.length<2;
%>
<form class="cardBody workspaceStack" method="post" action="/tenant/treasury/funding" <%= fixedDestination?'':'data-wallet-funding-form' %>>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="idempotencyKey" value="<%= data.fundingIdempotencyKey %>">
  <% if (fixedDestination) { %>
    <input type="hidden" name="destinationAccountId" value="<%= destination._id %>">
    <input type="hidden" name="returnToAccount" value="true">
  <% } %>
  <div class="row2">
    <label class="field">From account<select class="control" name="sourceAccountId" required>
      <option value="">Choose source</option>
      <% for (const account of accounts) { %>
        <option value="<%= account._id %>" data-branch-id="<%= account.branchId %>" data-currency="<%= account.currency %>" data-operator-id="<%= account.operatorId||'' %>"><% if (data.allBranches&&data.branchNames[String(account.branchId)]) { %><%= data.branchNames[String(account.branchId)] %> · <% } %><%= account.name %> · <%= data.format(account.bookBalanceMinor,account.currency) %></option>
      <% } %>
    </select></label>
    <% if (!fixedDestination) { %>
      <label class="field">To account<select class="control" name="destinationAccountId" required>
        <option value="">Choose destination</option>
        <% for (const account of accounts) { %>
          <option value="<%= account._id %>" data-branch-id="<%= account.branchId %>" data-currency="<%= account.currency %>" data-operator-id="<%= account.operatorId||'' %>" <%= data.fundingDestination===String(account._id)?'selected':'' %>><% if (data.allBranches&&data.branchNames[String(account.branchId)]) { %><%= data.branchNames[String(account.branchId)] %> · <% } %><%= account.name %> · <%= account.currency==='KES'?'KSH':account.currency %></option>
        <% } %>
      </select></label>
    <% } %>
    <label class="field">Amount<% if (fixedDestination) { %> (<%= destination.currency==='KES'?'KSH':destination.currency %>)<% } %><input class="control" name="amount" inputmode="decimal" required placeholder="0" pattern="[0-9]+([.][0-9]{1,2})?"></label>
    <label class="field">Transfer reference<input class="control" name="evidenceReference" minlength="6" maxlength="120" required placeholder="Receipt or statement reference"></label>
  </div>
  <label class="field">Transfer note<textarea class="control" name="note" minlength="12" maxlength="400" required rows="2"></textarea></label>
  <p class="tiny">A second person approves the transfer before the balances update. A cash account needs a verified open day.</p>
  <% if (disabled) { %><p class="tiny">Set up at least two compatible accounts with confirmed opening balances.</p><% } %>
  <% if (!fixedDestination) { %><p class="tiny" data-funding-choices-status role="status" aria-live="polite"></p><% } %>
  <div class="rowBtns"><button type="submit" class="btn btnPrimary" data-funding-submit <%= disabled?'disabled':'' %>>Send transfer for approval</button></div>
</form>
