<% const report=data.report;const query=`from=${encodeURIComponent(report.filters.from)}&to=${encodeURIComponent(report.filters.to)}`;const cash=report.cash; %>
<section class="view show">
 <section class="card"><div class="cardHead"><div><b><%= report.page.title %></b><br><span><%= report.page.subtitle %></span></div><div class="rowBtns noPrint"><% if(data.canCreateExpense&&report.key==='expenses'){ %><a class="btn btnPrimary" href="/tenant/expenses/new" data-expense-open>Add expense</a><% } %><% if(data.canExport&&report.sourceAvailable){ %><a class="btn" href="/tenant/reports/<%= report.key %>/export.csv?<%= query %>">Export CSV</a><% } %><button class="btn" type="button" data-print-report>Print report</button></div></div>
 <div class="cardBody noPrint"><form method="get" action="/tenant/reports/<%= report.key %>" class="row3"><label class="field">From (UTC)<input class="control" type="date" name="from" value="<%= report.filters.from %>"></label><label class="field">To (UTC)<input class="control" type="date" name="to" value="<%= report.filters.to %>"></label><div class="rowBtns"><button class="btn btnPrimary" type="submit">Apply filters</button><a class="btn" href="/tenant/reports/<%= report.key %>">Today</a></div></form><p class="tiny">Dates select records and cash shifts opened in this period (UTC), up to 90 days. All results follow your tenant, branch and account access.</p></div></section>
 <% if(!report.sourceAvailable){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Report source unavailable</b></div><div class="cardBody"><p>This source must be active in your subscription and assigned to your account. Operation Reports remains available through its permitted sources.</p><a class="btn" href="/tenant/reports">General reports page</a></div></section><% }else{ %>
 <% if(report.key==='daily'){ %><div class="grid" style="margin-top:14px"><section class="card"><div class="cardHead"><b>Daily control</b></div><div class="cardBody summary"><div class="sumRow"><span>Date</span><b><%= report.filters.from %> – <%= report.filters.to %></b></div><div class="sumRow"><span>Branch</span><b><%= report.scope.branchId?'Assigned branch':'All permitted branches' %></b></div><div class="sumRow"><span>Status</span><b><%= cash?`${cash.items.filter(shift=>shift.status==='approved').length} reconciled / ${cash.items.length} shifts`:'Cash source unavailable' %></b></div><div class="sumRow"><span>Operator</span><b><%= user.name||user.role %></b></div></div></section>
 <section class="card"><div class="cardHead"><b>Income summary</b><span>Recorded fees and approved expense evidence</span></div><div class="cardBody summary"><% if(!report.income.length){ %><p class="tiny">No financial activity in permitted sources for this period.</p><% } %><% report.income.forEach(row=>{ %><div class="sumRow"><span><%= row.currency %> recorded mobile fees</span><b><%= report.format(row.recordedFeesMinor,row.currency) %></b></div><div class="sumRow"><span><%= row.currency %> approved expenses</span><b><%= report.format(row.approvedExpensesMinor,row.currency) %></b></div><% }) %><p class="tiny">Recorded fees remain unverified income. Requests and quotations are reported separately from realized income.</p></div></section></div><% } %>
 <% if(cash){ %><div class="grid" style="margin-top:14px"><% if(report.key!=='closing'){ %><section class="card"><div class="cardHead"><b>Opening cash</b><span>Independently verified opening counts</span></div><div class="cardBody summary"><% if(!cash.totals.length){ %><p class="tiny">No cash shifts opened in this period.</p><% } %><% cash.totals.forEach(row=>{ %><div class="sumRow"><span><%= row.currency %> verified opening</span><b><%= report.format(row.verifiedOpeningMinor,row.currency) %></b></div><div class="sumRow"><span>Opening counts verified</span><b><%= row.verifiedCount %> / <%= row.count %></b></div><% }) %></div></section><% } %>
 <% if(report.key!=='opening'){ %><section class="card"><div class="cardHead"><b>Expected / actual closing</b><span>Counts stay separate from estimates</span></div><div class="cardBody summary"><% if(!cash.totals.length){ %><p class="tiny">No cash shifts opened in this period.</p><% } %><% cash.totals.forEach(row=>{ %><div class="sumRow"><span><%= row.currency %> expected cash, verified shifts</span><b><%= report.format(row.expectedMinor,row.currency) %></b></div><div class="sumRow"><span><%= row.currency %> counted closing (<%= row.countedCount %> shifts)</span><b><%= row.countedCount?report.format(row.actualMinor,row.currency):'Not counted' %></b></div><% }) %></div></section><% } %>
 <% if(report.key==='closing'){ %><section class="card"><div class="cardHead"><b>Discrepancy check</b><span>Only shifts with submitted physical counts</span></div><div class="cardBody summary"><% if(!cash.totals.length){ %><p class="tiny">No closing counts recorded.</p><% } %><% cash.totals.forEach(row=>{ %><div class="sumRow"><span><%= row.currency %> expected for counted shifts</span><b><%= row.countedCount?report.format(row.countedExpectedMinor,row.currency):'Not counted' %></b></div><div class="sumRow"><span><%= row.currency %> discrepancy</span><b><%= row.countedCount?report.format(row.varianceMinor,row.currency):'Not counted' %></b></div><% }) %></div></section><% } %></div>
 <% if(['opening','closing'].includes(report.key)){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Cash shift records</b><span>One count per operator and branch</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Opened (UTC)</th><th>Status</th><th>Opening</th><th>Opening verified</th><th>Expected closing</th><th>Counted closing</th><th>Difference</th></tr></thead><tbody><% if(!cash.items.length){ %><tr><td colspan="7">No cash shifts opened in the selected period.</td></tr><% } %><% cash.items.forEach(shift=>{ %><tr><td><%= new Date(shift.createdAt).toISOString() %></td><td><%= shift.status.replaceAll('_',' ') %></td><td><%= report.format(shift.openingMinor,shift.currency) %></td><td><%= shift.openingVerifiedAt&&shift.status!=='opening_rejected'?'Yes':'No' %></td><td><%= shift.expectedClosingMinor==null?'Not submitted':report.format(shift.expectedClosingMinor,shift.currency) %></td><td><%= shift.declaredClosingMinor==null?'Not counted':report.format(shift.declaredClosingMinor,shift.currency) %></td><td><%= shift.varianceMinor==null?'Not counted':report.format(shift.varianceMinor,shift.currency) %></td></tr><% }) %></tbody></table></div></section><% } %><% } %>
 <% if(report.key==='expenses'&&report.expenses){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Expenses</b><span>Pending and voided records remain visible</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Type</th><th>Amount</th><th>Method</th><th>Vendor</th><th>Reference</th><th>Description</th><th>Status</th><th class="noPrint">Action</th></tr></thead><tbody><% if(!report.expenses.length){ %><tr><td colspan="8">No expenses recorded.</td></tr><% } %><% report.expenses.forEach(expense=>{ %><tr data-search-row><td><%= expense.expenseType %></td><td><%= report.format(expense.amountMinor,expense.currency) %></td><td><%= expense.paymentMethod %></td><td><%= expense.vendor||'—' %></td><td><%= expense.reference||expense.recordReference %></td><td><%= expense.description||'—' %></td><td><%= expense.status.replaceAll('_',' ') %></td><td class="noPrint"><a class="btn" href="/tenant/expenses/<%= expense._id %>">View</a></td></tr><% }) %></tbody></table></div></section><% }else if(report.key==='expenses'){ %><p class="tiny">Your reporting access includes aggregate expenses. Detailed vendor and description fields require Expenses view permission.</p><% } %>
 <% if(!['opening','closing'].includes(report.key)){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b><%= ['daily','transactions'].includes(report.key)?'Transaction summary':report.page.title %></b><span>By currency, activity and internal status</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Type</th><th>Status</th><th>Count</th><th>Total</th><th>Fees</th><th>Net cash impact</th></tr></thead><tbody><% if(!report.rows.length){ %><tr><td colspan="6">No activity in these sources for the selected period.</td></tr><% } %><% report.rows.forEach(row=>{ %><tr data-search-row><td><b><%= row.module %></b><br><span class="tiny"><%= row.activity %></span></td><td><%= row.status.replaceAll('_',' ') %></td><td><%= row.count %></td><td><%= row.volume %><% if(row.targetCurrency&&row.targetAmountMinor!=null){ %><br><span class="tiny">Quoted target: <%= report.format(row.targetAmountMinor,row.targetCurrency) %></span><% } %></td><td><%= row.fees %></td><td><%= row.module==='Expenses'?(row.status==='approved'&&row.activity==='Cash'?report.format('-'+row.amountMinor,row.currency):'No posted cash effect'):(row.module==='Mobile Money'?'See currency cash impact':'No posted cash effect') %></td></tr><% }) %></tbody></table></div></section>
 <% if(Object.keys(report.impact).length){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Cash impact</b><span>Mobile money cash records, excluding internal voids</span></div><div class="cardBody summary"><% Object.entries(report.impact).forEach(([currency,amount])=>{ %><div class="sumRow"><span><%= currency %> net drawer movement</span><b><%= report.format(amount,currency) %></b></div><% }) %><p class="tiny">Cash-in minus cash-out for Cash payments. Recorded fees, Wallet Balance and Bank payments are excluded. This records operational evidence and does not prove external settlement.</p></div></section><% } %><% } %>
 <% } %><p class="tiny" style="margin-top:12px"><%= report.note %></p>
 <% if(data.canCreateExpense&&report.key==='expenses'){ %><%- include('../expenses/_modal') %><% } %>
</section>
