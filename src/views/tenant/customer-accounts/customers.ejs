<section class="view show">
 <div class="rowBtns"><a class="btn" href="/tenant/customers">Customers directory</a><% if(data.canExportCustomer){ %><a class="btn" href="/tenant/customers/export.csv?q=<%= encodeURIComponent(data.records.q) %>&amp;status=<%= data.records.status %>">Export CSV</a><% } %><a class="btn" href="/tenant/customers/logbook">Customer logbook</a><a class="btn" href="/tenant/customers?status=<%= data.records.status==='archived'?'active':'archived' %>"><%= data.records.status==='archived'?'Active customers':'Archived customers' %></a></div>
 <div class="grid" style="margin-top:14px"><section class="card"><div class="cardHead"><div><b>Customers directory</b><br><span>Customer profiles for banking, mobile money, and transfer operations</span></div><% if(data.canCreateCustomer){ %><a class="btn btnPrimary" href="/tenant/customers/new" data-directory-open>New customer</a><% } %></div><div class="cardBody">
  <div class="grid3"><div class="stat"><div class="k">Total customers</div><div class="v"><%= data.records.total %></div><div class="s"><span class="dot"></span><span><%= data.records.status==='archived'?'Archived profiles':'Directory size' %></span></div></div><div class="stat"><div class="k">Linked accounts</div><div class="v"><%= data.records.accounts==null?'—':data.records.accounts %></div><div class="s"><span class="dot"></span><span>Accounts attached</span></div></div><div class="stat"><div class="k">Customer activity</div><div class="v"><i class="fa-solid fa-book" aria-hidden="true"></i></div><div class="s"><span class="dot warn"></span><a href="/tenant/customers/logbook">Open customer logbook</a></div></div></div>
  <form method="get" action="/tenant/customers" class="rowBtns" style="margin-top:14px"><input type="hidden" name="status" value="<%= data.records.status %>"><label class="field">Search customers<input class="control" type="search" name="q" value="<%= data.records.q %>" maxlength="100" placeholder="Name, phone or customer reference"></label><button class="btn" type="submit">Search</button></form>
  <div class="tableWrap"><table><thead><tr><th>Customer</th><th>Phone</th><th>Customer Ref</th><th>Next of Kin</th><th>Accounts</th><th>Created</th></tr></thead><tbody><% if(!data.records.items.length){ %><tr><td colspan="6">No customers match your permitted branch and search.</td></tr><% }data.records.items.forEach(c=>{ %><tr data-search-row><td><a href="/tenant/customers/<%= c._id %>"><b><%= c.name %></b></a><br><span class="tiny"><%= c.type %> · <%= c.status %></span></td><td><%= c.phone %></td><td class="mono"><%= c.reference %></td><td><%= c.nextOfKinName||'—' %><br><span class="tiny"><%= c.nextOfKinPhone %></span></td><td><%= c.accountCount==null?'—':c.accountCount %></td><td><%= new Date(c.createdAt).toLocaleDateString('en-GB') %></td></tr><% }) %></tbody></table></div>
  <% if(data.records.nextCursor){ %><a class="btn" href="/tenant/customers?q=<%= encodeURIComponent(data.records.q) %>&amp;status=<%= data.records.status %>&amp;cursor=<%= encodeURIComponent(data.records.nextCursor) %>">Next customers</a><% } %>
 </div></section><section class="card"><div class="cardHead"><div><b>Customer logbook</b><br><span>Recent transactions grouped from customer phones and linked accounts</span></div></div><div class="cardBody"><p class="tiny">View actual records from your assigned modules and permitted branch. A matching recorded phone is an activity reference; it does not verify customer ownership or settlement.</p><a class="btn" href="/tenant/customers/logbook">Open customer logbook</a></div></section></div>
 <% if(data.canCreateCustomer){ %><%- include('modal',{data,user}) %><% } %>
</section>
