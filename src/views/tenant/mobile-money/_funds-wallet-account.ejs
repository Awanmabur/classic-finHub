 <label class="field" data-wallet-account-field><%= entryOperation==='cash_in'?'Provider float wallet · deposit destination':'Provider float wallet · withdrawal source' %><select class="control" name="walletAccountId" required data-wallet-account><option value="">Select wallet</option><% walletOptions.forEach(wallet=>{ %><option value="<%= wallet.id %>" data-network="<%= wallet.network %>" data-currency="<%= wallet.currency %>" data-expected-minor="<%= wallet.expectedMinor??'' %>" data-state="<%= wallet.state %>" data-reconciliation="<%= wallet.reconciliation %>" data-default="<%= wallet.isDefault?'true':'false' %>" data-assigned="<%= wallet.assignedToOperator?'true':'false' %>" data-fee-treatment="<%= wallet.feeTreatment||'record_only' %>" data-cash-drawer="<%= wallet.cashDrawerAccountId||'' %>" <%= !readyWallet(wallet)?'disabled':'' %>><%= wallet.name %> · <%= wallet.currency==='KES'?'KSH':wallet.currency %> · <%= wallet.network %><%= !ownWallet(wallet)?' (assigned to another cashier)':wallet.state!=='active'||wallet.reconciliation!=='matched'||wallet.expectedMinor===null?' (opening or reconciliation required)':'' %></option><% }) %></select><% if(!availableWallets.length){ %><span class="tiny" role="status">No ready provider wallet is available to your cashier login. <% if(walletOptions.some(w=>!ownWallet(w))){ %>Some wallets belong to another cashier; sign in as their assigned operator or ask the owner to assign your actual wallet.<% }else{ %>Ask the owner to create or approve a real provider wallet in Treasury.<% } %> <a href="/tenant/treasury">Review funds setup</a>.</span><% } %></label>
 

