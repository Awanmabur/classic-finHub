<% const r=data.record; %><section class="view show"><div class="rowBtns"><a class="btn" href="/tenant/accounts">Accounts directory</a><a class="btn" href="/tenant/accounts/movements?accountId=<%= r._id %>">Account movements</a><% if(data.canManageAccount&&r.status!=='closed'){ %><button type="button" class="btn btnPrimary" data-directory-open>Edit account</button><% } %></div><div class="grid" style="margin-top:14px"><section class="card"><div class="cardHead"><div><b><%= r.accountNumber %></b><br><span><%= r.type %> · <%= r.status %></span></div></div><div class="cardBody"><div class="stat"><div class="k">Internal ledger balance</div><div class="v"><%= data.formatMinor(r.balance?.minor,r.currency) %></div><div class="s"><span class="dot"></span><span><%= r.balance?.postingCount||0 %> ledger posting(s)</span></div></div><div class="summary"><% [['Customer',r.customer?.name],['Phone',r.customer?.phone],['Customer Ref',r.customer?.reference],['Account number',r.accountNumber],['Currency',r.currency],['Status',r.status]].forEach(([label,value])=>{ %><div class="sumRow"><span><%= label %></span><b><%= value||'—' %></b></div><% }) %></div></div></section><section class="card"><div class="cardHead"><b>Account intelligence</b></div><div class="cardBody"><div class="summary"><% [['Account officer',r.officer],['Purpose / source of funds',r.purpose],['KYC risk level',r.risk],['Overdraft limit','Unavailable']].forEach(([label,value])=>{ %><div class="sumRow"><span><%= label %></span><b><%= value||'—' %></b></div><% }) %></div><p class="tiny">Balances reflect posted internal journals in <%= r.currency %>. Directory changes do not move funds or grant a payment facility.</p></div></section></div><% if(data.canManageAccount&&r.status!=='closed'){ %><%- include('modal',{data,user}) %><% } %></section>
