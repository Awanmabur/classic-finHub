<section class="view show"><section class="card"><div class="cardHead"><div><b>Finish cash shift</b><br><span>Compare the physical cash in your drawer with the recorded amount.</span></div><a class="btn" href="/tenant/cash/shifts">All cash shifts</a></div><div class="cardBody">
<% if(data.shift){ %>
  <div class="summary"><div class="sumRow"><span>Expected cash · <%= data.shift.currency==='KES'?'KSH':data.shift.currency %></span><b><%= data.expected %></b></div></div>
  <p class="tiny">This amount comes from posted transactions. Count the physical notes and coins before confirming.</p>
  <form method="post" action="/tenant/day/close">
   <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="shiftId" value="<%= data.shift._id %>"><input type="hidden" name="currency" value="<%= data.shift.currency %>"><input type="hidden" name="closingFromBook" value="on">
   <label class="field"><input type="checkbox" name="physicalCountConfirmed" value="on" required> I counted my cash and it matches this amount.</label>
   <div class="rowBtns"><button class="btn btnPrimary" type="submit"><%= typeof user!=='undefined'&&user.role==='Tenant Owner'?'Finish and close':'Submit closing count' %></button></div>
  </form>
  <details class="logicNote"><summary>Cash does not match?</summary>
   <form method="post" action="/tenant/day/close">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="shiftId" value="<%= data.shift._id %>"><input type="hidden" name="currency" value="<%= data.shift.currency %>">
    <label class="field">Actually counted closing cash<input class="control" name="countedCash" required inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" placeholder="Actual physical count"></label>
    <label class="field">Evidence or explanation<textarea class="control" name="note" minlength="12" maxlength="400" rows="2" required></textarea></label>
    <div class="rowBtns"><button class="btn" type="submit">Report difference</button></div>
   </form>
  </details>
<% } else { %><p>No open cash shift. Start one only when you are physically taking responsibility for a cash drawer.</p><a class="btn btnPrimary" href="/tenant/cash/shifts" data-transaction-kind="cash_shift_open">Start cash shift</a><% } %>
</div></section></section>
