<% const assignedModules=Array.isArray(data.tenant.enabledModules)?data.tenant.enabledModules:[];
   const grants=Array.isArray(data.tenant.moduleGrants)?data.tenant.moduleGrants:[];
   const currentSub=data.tenant.subscription;
   const currentNow=new Date();
   const isValidDate=value=>value&&Number.isFinite(new Date(value).getTime());
   const tenantCanOperate=['active','trial'].includes(data.tenant.status);
   const planTermActive=Object.hasOwn(data,'effectivePlan')?Boolean(data.effectivePlan):Boolean(tenantCanOperate&&currentSub&&['trial','granted'].includes(currentSub.status)&&isValidDate(currentSub.periodStart)&&isValidDate(currentSub.periodEnd)&&new Date(currentSub.periodStart)<=currentNow&&new Date(currentSub.periodEnd)>currentNow);
   const snapModules=Array.isArray(currentSub?.modules)?currentSub.modules:[];
   const activePlanModules=planTermActive?assignedModules.filter(key=>snapModules.includes(key)&&(!data.modules?.length||data.modules.some(m=>m.key===key&&m.runtimeStatus!=='disabled'))):[];
   const activeAddonGrants=Object.hasOwn(data,'activeAddonGrants')?data.activeAddonGrants:tenantCanOperate?grants.filter(g=>g.status==='granted'&&isValidDate(g.periodStart)&&isValidDate(g.periodEnd)&&new Date(g.periodStart)<=currentNow&&new Date(g.periodEnd)>currentNow):[];
   const effectiveKeys=new Set([...activePlanModules,...activeAddonGrants.map(g=>g.moduleKey)]);
   const moduleLabel=key=>data.modules?.find(m=>m.key===key)?.name||key.replaceAll('_',' ');
   const setupDescription=data.tenant.setupStatus==='invited'?'Owner activation pending':data.tenant.setupStatus==='complete'?'Owner setup completed':'Setup status unavailable'; %>
<section class="view show platformTenantDetailPage"><div class="grid3">
 <% [
  {title:'Tenant',value:data.tenant.name,textual:true,note:data.tenant.status,noteDot:true,noteTone:tenantCanOperate?'good':'warn'},
  {title:'Owner',value:data.tenant.owner,textual:true,note:data.tenant.email||'No owner email'},
  {title:'Modules enabled',value:effectiveKeys.size,note:'Currently entitled, not all assigned'}
 ].forEach(card=>{ %><%- include('../../partials/stat-card',card) %><% }) %>
</div><% if(data.tenant.setupStatus==='invited'){ %>
<section class="card" style="margin-top:14px"><div class="cardHead"><b>Owner activation</b><span>Invitation pending</span></div><div class="cardBody"><p class="tiny">If the original activation page was interrupted or its link was lost, create a replacement for the existing workspace. Earlier unused links will expire.</p><form method="post" action="/platform/tenants/<%= data.tenant.id||data.tenant._id %>/owner-invitation"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= data.tenant.__v||0 %>"><label class="field">Reason (12–400 characters)<textarea class="control" name="reason" minlength="12" maxlength="400" rows="2" required placeholder="Explain why the owner needs a replacement activation link"></textarea></label><button class="btn" type="submit">Create replacement owner activation link</button></form></div></section>
<% } %>
<section class="card" style="margin-top:14px" aria-label="Current tenant setup and access">
  <div class="cardHead"><div><b>Current workspace state</b><br><span>Saved tenant subscription and activation status, not unpublished plan drafts</span></div><span class="tag"><%= setupDescription %></span></div>
  <div class="cardBody">
    <div class="summary">
      <div class="sumRow"><span>Owner setup</span><b><%= setupDescription %></b></div>
      <div class="sumRow"><span>Workspace access</span><b><%= data.tenant.status %></b></div>
      <div class="sumRow"><span>Current subscribed plan</span><b><%= currentSub?currentSub.planName+' · '+currentSub.planCode+' v'+currentSub.planVersion:'No published plan entitlement recorded' %></b></div>
      <div class="sumRow"><span>Plan access right now</span><b><%= planTermActive?'In term':currentSub?'Inactive / expired / revoked':'Not configured' %></b></div>
      <div class="sumRow"><span>Current plan modules available</span><b><%= activePlanModules.length %> of <%= snapModules.length %> in saved terms</b></div>
      <div class="sumRow"><span>Active independent module grants</span><b><%= activeAddonGrants.length %></b></div>
      <div class="sumRow"><span>Reserved staff seats</span><b><%= data.tenant.seatsReserved %><%= currentSub?' / '+currentSub.limits.users:'' %></b></div>
      <div class="sumRow"><span>Branches created</span><b><%= data.tenant.branchCount %><%= currentSub?' / '+currentSub.limits.branches:'' %></b></div>
    </div>
    <p class="tiny">No setup task is marked complete based on a plan's current marketing description. These values come from the saved tenant record; branch and account readiness must be checked in the tenant workspace.</p>
  </div>
</section>
<% const listedNow=['active','trial'].includes(data.tenant.status)&&data.tenant.setupStatus==='complete'&&data.tenant.directoryListing?.visibility!=='hidden'; %>
<section class="card" style="margin-top:14px">
  <div class="cardHead"><div><b>Business directory</b><br>
   <span><%= listedNow?'Automatically live':'Not public' %> · No listing approval required</span></div></div>
  <div class="cardBody"><p class="tiny">An activated business appears in the directory without administrator approval. Its owner can hide or show it from the business website workspace. The directory never displays private sign-in email, internal staff, customer records or financial accounts.</p>
   <% if(listedNow){ %><a class="btn" href="/t/<%= data.tenant.slug %>" target="_blank" rel="noopener noreferrer">Open public business profile</a><% } %>
  </div>
</section>
<section class="card" style="margin-top:14px" aria-label="Active module entitlements">
 <div class="cardHead"><div><b>Modules — plan vs independent access</b><br><span>Current entitlements, with recorded but inactive assignments shown separately</span></div></div>
 <div class="cardBody">
   <h3>Included in saved plan terms</h3>
   <% if(!snapModules.length){ %><p class="tiny">This plan does not include operational modules.</p><% } %>
   <div class="seg"><% snapModules.forEach(key=>{ %><span class="chip <%= activePlanModules.includes(key)?'active':'' %>"><%= moduleLabel(key) %> · <%= activePlanModules.includes(key)?'available':'not currently available' %></span><% }) %></div>
   <h3>Independent module grants</h3>
   <% if(!grants.length){ %><p class="tiny">No independent grants have been recorded.</p><% } %>
   <div class="seg"><% grants.forEach(g=>{ %><span class="chip <%= activeAddonGrants.some(a=>a.moduleKey===g.moduleKey)?'active':'' %>"><%= moduleLabel(g.moduleKey) %> · <%= activeAddonGrants.some(a=>a.moduleKey===g.moduleKey)?'active':g.status==='revoked'?'revoked':'expired / not in term' %></span><% }) %></div>
 </div>
</section>
<details class="card" style="margin-top:14px"><summary class="cardHead"><b>Change workspace access status</b><span>Super Admin · audited</span></summary><div class="cardBody"><p class="tiny">A suspension blocks tenant operations. Status changes require a reason. Plan, pricing and subscription changes are deliberately separate from this control.</p>
<form method="post" action="/platform/tenants/<%= data.tenant.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><p class="tiny">Current state: <strong><%= data.tenant.status %></strong>. Only choose a different state when you intend to change workspace access.</p><label class="field">Change to<select name="status" class="control" required><option value="" selected disabled>Current: <%= data.tenant.status %> — choose another state</option><% const options={trial:['active','suspended'],active:['past_due','suspended'],past_due:['active','suspended'],suspended:['active']}[data.tenant.status]||[];options.forEach(st=>{ %><option value="<%= st %>"><%= st %></option><% }) %></select></label><label class="field">Reason (12–400 characters)<textarea name="reason" class="control" required minlength="12" maxlength="400" rows="3"></textarea></label><button type="submit" class="btn btnPrimary">Update status</button></form></div></details>
<details class="card" style="margin-top:14px"><summary class="cardHead"><b>Edit tenant profile</b><span>Display details only · audited</span></summary><div class="cardBody"><form method="post" action="/platform/tenants/<%= data.tenant.id %>/profile"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row2"><label class="field">Business name<input class="control" name="name" required minlength="2" maxlength="150" value="<%= data.tenant.name %>"></label><label class="field">Contact phone<input class="control" name="phone" maxlength="40" value="<%= data.tenant.phone||'' %>"></label></div><label class="field">Reason (12–400 characters)<textarea class="control" name="reason" required minlength="12" maxlength="400" rows="2"></textarea></label><button type="submit" class="btn">Save profile</button></form><p class="tiny">Owner email, tenant slug, financial records, plan entitlements, subscription charges and audit history are not editable through this form.</p></div></details>
<details class="card" style="margin-top:14px"><summary class="cardHead"><b>Subscription access &amp; limits</b><span>Plan terms and usage</span></summary><div class="cardBody">
  <% const sub=data.tenant.subscription; %>
  <div class="summary"><div class="sumRow"><span>Published plan</span><b><%= sub?`${sub.planCode} v${sub.planVersion}`:'Not migrated / no entitlement' %></b></div>
  <div class="sumRow"><span>Entitlement</span><b><%= sub?.status||'Unassigned' %></b></div>
  <div class="sumRow"><span>Expires</span><b><%= sub?formatUtcDate(sub.periodEnd).split('T')[0]:'No term' %></b></div>
  <div class="sumRow"><span>Reserved seats</span><b><%= data.tenant.seatsReserved %> / <%= sub?.limits?.users??'—' %></b></div>
  <div class="sumRow"><span>Active branches</span><b><%= data.tenant.branchCount %> / <%= sub?.limits?.branches??'—' %></b></div></div>
  <p class="tiny">Manual grants change module access and quotas and are fully audited. They are support-authorized entitlements, not proof of an invoice, collection, or settlement. Suspended tenants must be reactivated through the separate status workflow.</p>
  <form method="post" action="/platform/tenants/<%= data.tenant.id %>/subscription/grant">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="row2"><label class="field">Published plan<select class="control" name="planCode" required><option value="" selected disabled><%= currentSub?`Current: ${currentSub.planName||currentSub.planCode} — select a plan to change or renew`:"Choose a published plan" %></option><% const uniquePlans=new Set();data.published.forEach(v=>{if(!uniquePlans.has(v.code)){uniquePlans.add(v.code);%><option value="<%= v.code %>"><%= v.name %><%= currentSub?.planCode===v.code?" — current plan (renew)":" — new plan" %></option><% }}); %></select></label>
    <label class="field">Duration in days (1–366)<input class="control" type="number" name="days" min="1" max="366" required value="30"></label></div>
    <label class="field">Change justification (20–600 characters)<textarea class="control" name="reason" required minlength="20" maxlength="600" rows="3"></textarea></label>
    <button type="submit" class="btn btnPrimary">Grant / renew subscription</button>
  </form>
  <% if(sub && ['trial','granted'].includes(sub.status)){ %>
  <form method="post" action="/platform/tenants/<%= data.tenant.id %>/subscription/revoke" style="margin-top:18px">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field">Revocation reason (20–600 characters)<textarea class="control" name="reason" minlength="20" maxlength="600" required rows="2"></textarea></label>
    <button type="submit" class="btn">Revoke subscription access</button>
  </form><% } %>
</div></details>

<details class="card" style="margin-top:14px"><summary class="cardHead"><b>Independent module subscriptions</b><span>Super Admin · audited manual entitlement · no payment collected</span></summary><div class="cardBody">
  <div class="summary">
    <div class="sumRow"><span>Effective modules now</span><b><%= effectiveKeys.size %></b></div>
    <div class="sumRow"><span>Available through current plan</span><b><%= activePlanModules.length %></b></div>
    <div class="sumRow"><span>Available through independent grants</span><b><%= activeAddonGrants.length %></b></div>
  </div>
  <% if(effectiveKeys.size){ %><div class="seg" aria-label="Modules currently enabled">
    <% [...effectiveKeys].sort().forEach(key=>{ %><span class="chip active"><%= moduleLabel(key) %> · enabled</span><% }); %>
  </div><% } %>
  <% if(grants.length){ %><h3>Independent grant history</h3><div class="summary">
    <% grants.forEach(g=>{ %><div class="sumRow"><span><%= g.moduleKey %> (<%= g.status %>)</span><b><%= formatUtcDate(g.periodEnd).split('T')[0] %></b></div><% }) %>
  </div><% } %>
  <h3>Grant or renew access</h3>
  <form method="post" action="/platform/tenants/<%= data.tenant.id %>/modules/grant">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row3">
      <label class="field">Independent module / add-on<select class="control" name="moduleKey" required data-module-record-allocation>
        <option value="" selected disabled>Select a new module or renew an existing grant</option>
        <% const standaloneModules=data.independentModules||[];
           const independentlyActiveKeys=new Set(activeAddonGrants.map(g=>g.moduleKey)); %>
        <% if(standaloneModules.some(m=>independentlyActiveKeys.has(m.key))){ %>
        <optgroup label="Already active — select only to renew">
          <% standaloneModules.filter(m=>independentlyActiveKeys.has(m.key)).forEach(m=>{ %>
          <option value="<%= m.key %>" data-requires-records="<%= m.requiresRecords===true %>"><%= m.name %> · ACTIVE · renew</option><% }); %>
        </optgroup><% } %>
        <optgroup label="Available standalone modules">
          <% standaloneModules.filter(m=>m.category!=='Addon'&&!effectiveKeys.has(m.key)).forEach(m=>{ %><option value="<%= m.key %>" data-requires-records="<%= m.requiresRecords===true %>"><%= m.name %> · USD <%= m.priceMonthly %>/mo</option><% }); %>
        </optgroup>
        <optgroup label="Available optional add-ons">
          <% standaloneModules.filter(m=>m.category==='Addon'&&!effectiveKeys.has(m.key)).forEach(m=>{ %><option value="<%= m.key %>" data-requires-records="<%= m.requiresRecords===true %>"><%= m.name %> · USD <%= m.priceMonthly %>/mo</option><% }); %>
        </optgroup>
      </select><span class="tiny">Standalone access remains separate from the saved plan and does not collect payment automatically.</span></label>
      <label class="field">Days<input class="control" type="number" name="days" min="1" max="366" value="30" required></label>
      <label class="field">Monthly record allocation (positive for transaction modules, customers, accounts and expenses; 0 for report and control modules)<input class="control" type="number" name="recordsPerMonth" min="0" max="1000000" value="0" required></label>
    </div><div class="row2"><label class="field">Workspace seat limit<input class="control" type="number" name="users" min="1" value="5" required></label><label class="field">Branch limit<input class="control" type="number" name="branches" min="1" value="1" required></label></div>
    <label class="field">Approval justification (20–600 characters)<textarea class="control" name="reason" required minlength="20" maxlength="600" rows="2"></textarea></label>
    <button type="submit" class="btn btnPrimary">Grant / renew module access</button>
  </form>
  <% grants.filter(g=>g.status==='granted').forEach(g=>{ %><form method="post" action="/platform/tenants/<%= data.tenant.id %>/modules/revoke" style="margin-top:12px">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="moduleKey" value="<%= g.moduleKey %>">
    <label class="field">Revoke <%= g.moduleKey %> · reason<textarea class="control" name="reason" required minlength="20" maxlength="600" rows="2"></textarea></label>
    <button type="submit" class="btn">Revoke standalone grant</button>
  </form><% }) %>
  <p class="tiny">Each module may be independently granted or revoked. This action updates access and audit history, not bank transfers, invoices or actual billing payments.</p>
</div></details>
</section>
