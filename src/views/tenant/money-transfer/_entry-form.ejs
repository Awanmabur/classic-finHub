<% const transferCountries=data.countryOptions||[]; %>
<div class="formSection"><div class="formSectionTitle">Sender details</div><div class="row2">
<label class="field">Sender name<input class="control" name="senderName" required minlength="2" maxlength="120" autocomplete="off" placeholder="Enter sender's full name"></label>
<label class="field">Sender phone<input class="control" name="senderPhone" type="tel" required maxlength="40" autocomplete="off" placeholder="+256700123456"><span class="tiny">Include the international country code.</span></label>
<label class="field">Sender ID / document no.<input class="control" name="senderDocument" maxlength="80" placeholder="National ID, passport, or optional"></label>
<label class="field">Sender country<select class="control" name="senderCountry" required><option value="">Select country</option><% transferCountries.forEach(country=>{ %><option value="<%= country.code %>"><%= country.name %></option><% }) %></select></label>
</div></div>
<div class="formSection"><div class="formSectionTitle">Receiver details</div><div class="row2">
<label class="field">Receiver name<input class="control" name="receiverName" required minlength="2" maxlength="120" autocomplete="off" placeholder="Enter receiver's full name"></label>
<label class="field">Receiver phone<input class="control" name="receiverPhone" type="tel" required maxlength="40" autocomplete="off" placeholder="+256701234567"><span class="tiny">Include the international country code.</span></label>
<label class="field">Receiver ID / document no.<input class="control" name="receiverDocument" maxlength="80" placeholder="Optional verification ID"></label>
<label class="field">Receiver country<select class="control" name="receiverCountry" required><option value="">Select country</option><% transferCountries.forEach(country=>{ %><option value="<%= country.code %>"><%= country.name %></option><% }) %></select></label>
</div></div>
<div class="formSection"><div class="formSectionTitle">Transfer details</div><div class="row2">
<label class="field">Transfer method<select class="control" name="transferMethod"><% ['Cash','Bank','Mobile Money','Online'].forEach(method=>{ %><option><%= method %></option><% }) %></select></label>
<label class="field">Purpose / narration<input class="control" name="purpose" maxlength="400" placeholder="Family support, trade, school fees..."></label>
<label class="field">Currency<select class="control" name="currency" required><% (data.currencyChoices||(typeof currencyOptions==='undefined'?[]:currencyOptions).filter(option=>!currentBranch.currencies||currentBranch.currencies.includes(option.code))).forEach(option=>{ %><option value="<%= option.code %>" <%= option.code===(data.selectedCurrency||currentBranch.currency)?'selected':'' %>><%= option.label %></option><% }) %></select></label>
<label class="field">Amount<input class="control" name="amount" inputmode="decimal" required pattern="[0-9]+([.][0-9]{1,2})?" placeholder="0"></label>
<label class="field">Exchange rate<input class="control" name="exchangeRate" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,8})?" placeholder="Optional indicative rate"><span class="tiny">Reference only; the request does not perform a currency conversion.</span></label>
<label class="field">Transfer fee<input class="control" name="fee" inputmode="decimal" required pattern="[0-9]+([.][0-9]{1,2})?" value="0"></label>
</div></div>
<div class="summary"><div class="sumRow"><span>Generated PIN</span><b>Issued after reviewed collection</b></div><div class="sumRow"><span>Total sender pays</span><b data-transfer-total>—</b></div><div class="sumRow"><span>Reference</span><b class="mono"><%= data.idempotencyKey %></b></div></div>
<label class="field">Request validity<select class="control" name="validDays" required><% for(let days=1;days<=30;days++){ %><option value="<%= days %>" <%= days===7?'selected':'' %>><%= days %> day<%= days===1?'':'s' %></option><% } %></select></label>
<div class="rowBtns"><button class="btn btnPrimary" type="submit">Save transfer &amp; continue</button></div>
