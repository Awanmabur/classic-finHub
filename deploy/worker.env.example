# Dedicated production outbox worker only; NOT the web application environment.
NODE_ENV=production
APP_URL=https://replace-with-real-domain.example
# Same platform database, but a DIFFERENT MongoDB user limited to this DB.
MONGO_WORKER_URI=
MAIL_PROVIDER=resend
RESEND_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MAIL_FROM=
INVITE_MAIL_ENCRYPTION_KEY_HEX=
OUTBOX_POLL_MS=2000
