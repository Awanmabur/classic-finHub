<!doctype html><html lang="en"><head>
  <link rel="icon" type="image/png" href="/images/classicfinhub-logo.png"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Activate staff account | ClassicFin Hub</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="/css/feedback.css?v=<%= typeof assetVersion==='undefined'?'1':assetVersion %>">
</head><body class="legal-body auth-body"><main class="auth-main"><section class="auth-card" style="max-width:520px;margin:3rem auto;padding:2rem"><h1>Activate staff access</h1><p>A private staff invitation may be used only once. Create a strong password to activate your assigned role.</p>
<%- include('../partials/flash', {flash:typeof flash==='undefined'?null:flash}) %>
<form method="post" action="/accept-staff-invite" data-activation-form hidden><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="token" value="" data-activation-token><input type="hidden" name="slug" value="<%= slug %>"><label><span>New password</span><input type="password" minlength="14" maxlength="72" name="password" required autocomplete="new-password"></label><label><span>Confirm password</span><input type="password" name="confirmPassword" minlength="14" maxlength="72" required autocomplete="new-password"></label><p class="auth-helper">Use 14 or more characters, with uppercase, lowercase, a number and a symbol. Maximum 72 UTF-8 bytes (some characters use more than one byte).</p><button class="btn btn-dark" type="submit">Activate account</button></form><p data-activation-missing>Missing or invalid invitation. Ask the tenant owner to issue a new one.</p><a href="/signin">Back to sign in</a><script src="/js/activation.js" defer></script></section></main><script src="/js/feedback.js?v=<%= typeof assetVersion==='undefined'?'1':assetVersion %>" defer></script>
</body></html>
