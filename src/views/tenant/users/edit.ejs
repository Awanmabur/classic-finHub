<section class="view show"><div class="grid">
  <section class="card"><div class="cardHead"><b>Edit staff access</b><span>Verified tenant member · <%= data.account.status %></span></div><div class="cardBody">
    <p class="tiny">Account: <b><%= data.account.email %></b>. Email identity is immutable here; changes to role, branch and modules invalidate existing sessions.</p>
    <form method="post" action="/tenant/users/<%= data.account._id %>/update"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field">Display name<input class="control" name="name" minlength="2" maxlength="120" required value="<%= data.account.name %>"></label>
      <label class="field">Role<select class="control" name="role" required><% data.roles.forEach(role=>{ %><option value="<%= role %>" <%= role===data.account.role?'selected':'' %>><%= role %></option><% }) %></select></label>
      <label class="field">Assigned branch<select class="control" name="branchId" required><option value="">Choose an active branch</option><% data.branches.forEach(b=>{ %><option value="<%= b._id %>" <%= String(data.account.branchId)===String(b._id)?'selected':'' %>><%= b.name %></option><% }) %></select></label>
      <fieldset class="field"><legend>Allowed live modules (role permissions still apply)</legend><% data.assignable.forEach(m=>{ %><label style="display:inline-flex;gap:8px;margin-right:12px;align-items:center"><input type="checkbox" name="allowedModules" value="<%= m %>" <%= (data.account.allowedModules||[]).includes(m)?'checked':'' %>><%= m.replace(/_/g,' ') %></label><% }) %><% if(!data.assignable.length){ %><p class="tiny">No live modules subscribed.</p><% } %></fieldset>
      <div class="rowBtns"><button class="btn btnPrimary" type="submit">Save access changes</button><a class="btn" href="/tenant/users">Cancel</a></div>
    </form>
  </div></section>
  <section class="card"><div class="cardHead"><b>Security controls</b><span><%= user.role==='Tenant Owner'?'Tenant-wide admin boundary':'Branch-only admin boundary' %></span></div><div class="cardBody"><p><%= user.role==='Tenant Owner'?'The Tenant Owner can manage tenant staff.':'Only staff in your branch with the Operator or Viewer role can be managed here.' %> A changed role may require authenticator verification on the next login.</p><p class="tiny">The module list restricts access; it does not grant any permission absent from the selected role. Disabled accounts remain disabled until explicitly restored.</p></div></section>
</div></section>