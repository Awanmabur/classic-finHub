<section class="view show"><div class="grid"><form class="card" method="post" action="/platform/tenants"><div class="cardHead"><b>Create tenant</b><span>Provision database, seed defaults, and invite owner.</span></div><div class="cardBody" style="display:grid;gap:12px"><div class="row2"><label class="field">Tenant name<input class="control" name="name" required placeholder="Acme Forex" /></label><label class="field">Slug<input class="control" name="slug" placeholder="acme-forex" /></label></div><div class="row2"><label class="field">Owner<input class="control" name="owner" required /></label><label class="field">Owner email<input class="control" type="email" name="email" required /></label></div><div class="row2"><label class="field">Phone<input class="control" name="phone" /></label><label class="field">Plan<select class="control" name="plan"><% data.plans.forEach(p => { %><option value="<%= p.code %>"><%= p.name %></option><% }) %></select></label></div><label class="field">Enabled modules<select class="control" name="enabledModules" multiple size="6"><% data.modules.forEach(m => { %><option value="<%= m.key %>"><%= m.name %></option><% }) %></select></label><button class="btn btnPrimary" type="submit">Create tenant and owner invite</button></div></form><section class="card"><div class="cardHead"><b>Provisioning checklist</b><span>From blueprint stage 6</span></div><div class="cardBody txList"><div class="tx"><span>Generate tenant DB name</span><b>required</b></div><div class="tx"><span>Seed settings, modules, roles</span><b>required</b></div><div class="tx"><span>Seed default branch and templates</span><b>required</b></div><div class="tx"><span>Create tenant owner invite</span><b>required</b></div></div></section></div></section>
