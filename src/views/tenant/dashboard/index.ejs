<%
  const zone = typeof businessTimeZone === 'string' ? businessTimeZone : 'UTC';
  const snapshot = data.workspaceSnapshot || {};
  const finance = data.financeOverview || {};
  const cashDay = snapshot.cashDay;
  const displayCurrency = code => code === 'KES' ? 'KSH' : code;
  const displayAmount = row => row?.formatted?.replace(/^KES /, 'KSH ') || '—';
  const matchesCurrency = row => !data.dashboardCurrency || row.currency === data.dashboardCurrency;
  const filterMoney = rows => (rows || []).filter(matchesCurrency);
  const currencies = typeof currencyOptions === 'undefined'
    ? [{code:'UGX',label:'UGX'},{code:'USD',label:'USD'},{code:'SSP',label:'SSP'},{code:'KES',label:'KSH'}]
    : currencyOptions;
  const currencyRows = currencies.filter(option => !data.dashboardCurrency || option.code === data.dashboardCurrency);
  const modules = [
    ['hasTransfer','money_transfer','Money transfer'],
    ['hasMobileMoney','mobile_money','Mobile money'],
    ['hasBanking','banking','Banking'],
    ['hasForex','forex','Forex']
  ].filter(([access,key]) => data[access] &&
    (!Array.isArray(data.visibleDashboardModules) || data.visibleDashboardModules.includes(key)));
  const moduleLabel = key => modules.find(([,moduleKey]) => moduleKey === key)?.[2] || key.replaceAll('_',' ');
  const bookedAssets = filterMoney(finance.bookAssets);
  const postedNet = filterMoney(finance.postedNet);
  const amountCards = [
    ['Operating assets', bookedAssets],
    ['Posted net income', finance.mixedRegion ? [] : postedNet]
  ].filter(([,rows]) => finance.available && rows.length);
  const count = modules.length ? snapshot.todayTransactionCount : null;
  const canSeeCash = visiblePaths.has('/tenant/treasury');
  const ownerMoneyPage = user.role === 'Tenant Owner' && canSeeCash;
  const hasCashDay = visiblePaths.has('/tenant/cash/shifts') && data.dashboardCashAvailable !== false;
  const dayStatus = {open:'Open',pending_open:'Opening count saved',submitted:'Closing count saved',
    disputed:'Count needs correction'}[cashDay?.status] || 'Closed';
  const dayAction = {open:'Close day',disputed:'Correct closing count',
    pending_open:ownerMoneyPage?'Finish opening':'View opening count',
    submitted:ownerMoneyPage?'Finish closing':'View closing count'}[cashDay?.status] || 'Open day';
  const cashDayHref = (ownerMoneyPage ? '/tenant/treasury' : '/tenant/cash/shifts') +
    (cashDay?.currency ? '?currency=' + encodeURIComponent(cashDay.currency) : '') + (ownerMoneyPage ? '#cash-day' : '');
  const recentActivity = (snapshot.recentActivity || []).slice(0, 6);
  const actualFunds = accounts => filterMoney(accounts).filter(account => account.expectedMinor != null || account.expected);
  const drawerAccounts = actualFunds((data.mobileFunds?.paymentAccounts || []).filter(account => account.kind === 'cash'));
  const walletAccounts = actualFunds(data.mobileFunds?.wallets);
  const fundGroups = [['cash','Physical cash',drawerAccounts],['float','Electronic float',walletAccounts]]
    .filter(([, , accounts]) => modules.some(([,key]) => key === 'mobile_money') && accounts.length);
  const moduleIncome = (finance.moduleEarnings || []).filter(entry => filterMoney(entry.net).length);
  const assetsByModule = (finance.byModule || []).filter(entry => filterMoney(entry.totals).length);
  const cashTotals = canSeeCash ? filterMoney(snapshot.cash) : [];
  const financialDetails = fundGroups.length || moduleIncome.length || assetsByModule.length || cashTotals.length;
%>
<section class="view show" id="view-overview">
  <% if(Number.isInteger(count) || amountCards.length || hasCashDay){ %>
    <section class="dashboardTopStats overviewStatsGrid" data-dashboard-top-stats aria-label="Key figures">
      <% if(Number.isInteger(count)){ %>
        <div class="stat">
          <div class="k">Posted transactions today</div>
          <div class="v"><%= count.toLocaleString('en-GB') %></div>
        </div>
      <% } %>
      <% amountCards.forEach(([label,rows])=>{ %>
        <div class="stat">
          <div class="k"><%= label %></div>
          <ul class="dashboardStatAmounts">
            <% rows.forEach(row=>{ %><li><%= displayAmount(row) %></li><% }); %>
          </ul>
        </div>
      <% }); %>
      <% if(hasCashDay){ %>
        <div class="stat stat--text dashboardCashDay">
          <div class="k">Cash day</div>
          <% if(cashDay){ %>
            <div class="v"><%= dayStatus %></div>
            <div class="dashboardCashLocation"><%= cashDay.branchName %> · <%= displayCurrency(cashDay.currency) %></div>
          <% } %>
          <a class="btn" href="<%= cashDayHref %>"><%= cashDay ? dayAction : 'View cash day' %></a>
        </div>
      <% } %>
    </section>
  <% } %>

  <% if(modules.length){ %>
    <section class="card dashboardCurrencyCard" aria-labelledby="todayCurrencyStats">
      <div class="cardHead"><b id="todayCurrencyStats">Today by currency</b><span><%= snapshot.mixedRegion ? 'Multiple time zones' : zone %></span></div>
      <div class="cardBody">
        <% if(snapshot.mixedRegion){ %>
          <p class="tiny">Select a branch to view its business day.</p>
        <% } else { %>
          <div class="tableWrap dashboardCurrencyTable">
            <table data-dashboard-currency-stats>
              <thead><tr><th scope="col">Currency</th><% modules.forEach(([, ,label])=>{ %><th scope="col"><%= label %></th><% }); %></tr></thead>
              <tbody>
                <% currencyRows.forEach(currency=>{ %>
                  <tr><th scope="row"><%= currency.label %></th>
                    <% modules.forEach(([,key,label])=>{
                      const row = (snapshot.todayByCurrency?.[key] || []).find(value => value.currency === currency.code);
                      const unavailable = snapshot.todayByCurrencyUnavailable?.[key];
                    %>
                      <td<% if(!row&&!unavailable){ %> class="dashboardCurrencyEmpty" aria-label="No posted activity"<% } %>><span class="dashboardCurrencyMetric" aria-hidden="true"><%= label %></span><strong><%= unavailable ? 'Unavailable' : displayAmount(row) %></strong><% if(!unavailable && Number.isInteger(row?.count)){ %><small><%= row.count %> <%= row.count === 1 ? 'transaction' : 'transactions' %></small><% } %></td>
                    <% }); %>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </section>
  <% } %>

  <% if(recentActivity.length || modules.length || (!amountCards.length && !hasCashDay)){ %>
    <section class="card" aria-labelledby="dashboardActivity">
      <div class="cardHead"><b id="dashboardActivity">Recent activity</b></div>
      <div class="cardBody">
        <% if(!recentActivity.length){ %><p class="tiny">No recent transactions.</p><% } else { %>
          <div class="txList" id="recentList">
            <% recentActivity.forEach(row=>{ %>
              <a class="tx" data-search-row href="<%= row.href %>">
                <div class="txLeft">
                  <span class="txDot <%= /voided|rejected|disputed|failed/.test(row.status || '') ? 'bad' : /pending|requested|quoted|awaiting/.test(row.status || '') ? 'warn' : 'good' %>"></span>
                  <div class="txMeta"><b><%= row.label %></b><span><%= row.subtitle %><% if(row.createdAt){ %> · <%= typeof formatLocalDate==='function'?formatLocalDate(row.createdAt):new Date(row.createdAt).toISOString().slice(0,16).replace('T',' ')+' UTC' %><% } %></span></div>
                </div>
                <div class="txAmt"><%= row.amountLabel %><small><%= row.status || '' %></small></div>
              </a>
            <% }); %>
          </div>
        <% } %>
      </div>
    </section>
  <% } %>

  <% if(financialDetails){ %>
    <details class="card dashboardFinancialDetails">
      <summary class="cardHead"><b>Financial details</b><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
      <div class="cardBody workspaceStack">
        <% if(fundGroups.length){ %><div class="overviewStatsGrid">
          <% fundGroups.forEach(([type,label,accounts])=>{
            const totals = filterMoney(data.mobileBookTotals?.[type]);
            [...new Set(accounts.map(account => account.currency))].forEach(currency=>{
              const current = accounts.filter(account => account.currency === currency);
              const total = totals.find(row => row.currency === currency);
          %>
            <div class="stat" data-dashboard-fund-stat="<%= type %>" data-fund-currency="<%= currency %>">
              <div class="k"><%= label %> · <%= displayCurrency(currency) %></div>
              <div class="v"><%= total ? displayAmount(total) : current.length === 1 ? current[0].expected : '' %></div>
              <% current.forEach(account=>{ %><div class="s"><%= account.name %> · <%= account.expected %></div><% }); %>
            </div>
          <% }); }); %>
        </div><% } %>
        <% if(moduleIncome.length){ %>
          <div class="summary">
            <b>Posted net income by module</b>
            <% moduleIncome.forEach(entry=>filterMoney(entry.net).forEach(row=>{ %>
              <div class="sumRow"><span><%= moduleLabel(entry.moduleKey) %></span><b><%= displayAmount(row) %></b></div>
            <% })); %>
          </div>
        <% } %>
        <% if(assetsByModule.length){ %>
          <div class="summary">
            <b>Operating assets by module</b>
            <% assetsByModule.forEach(entry=>filterMoney(entry.totals).forEach(row=>{ %>
              <div class="sumRow"><span><%= entry.moduleKey === 'shared' ? 'Shared treasury' : moduleLabel(entry.moduleKey) %></span><b><%= displayAmount(row) %></b></div>
            <% })); %>
          </div>
        <% } %>
        <% if(cashTotals.length){ %>
          <div class="summary" id="cashSummary">
            <b>Expected cash in open drawers</b>
            <% cashTotals.forEach(row=>{ %>
              <div class="sumRow"><span><%= displayCurrency(row.currency) %></span><b><%= row.expectedFormatted.replace(/^KES /,'KSH ') %></b></div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </details>
  <% } %>
</section>
