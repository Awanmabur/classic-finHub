<aside class="panel side" id="sidePanel">
  <div class="brand">
    <div class="logo"></div>
    <div><h1><%= context === 'platform' ? 'ClassicFin Platform' : (tenant?.name || 'Tenant Workspace') %></h1><p><%= context === 'platform' ? 'Classic Technologies' : (tenant?.status + ' • ' + tenant?.plan) %></p></div>
  </div>
  <nav class="nav">
    <% menu.forEach(group => { %>
      <div class="navGroup">
        <button type="button" class="item"><i class="fa-solid fa-folder-tree"></i> <span><%= group.label %></span></button>
        <% group.items.forEach(item => { %>
          <a href="<%= item.href %>" class="subitem <%= currentPath === item.href ? 'active' : '' %>"><i class="fa-solid <%= item.icon %>"></i><span><%= item.label %></span></a>
        <% }) %>
      </div>
    <% }) %>
  </nav>
  <div class="sideFoot">
    <div class="mini"><div><b><%= user?.name || 'Demo Admin' %></b><span><%= user?.role || (context === 'platform' ? 'Super Admin' : 'Tenant Owner') %></span></div><span class="tag"><%= context %></span></div>
    <div class="mini"><div><b>Data isolation</b><span><%= context === 'platform' ? 'Platform database' : tenant?.dbName %></span></div><i class="fa-solid fa-database"></i></div>
    <a class="btn" href="/"><i class="fa-solid fa-globe"></i> Public site</a>
  </div>
</aside>
