<% const receiptBrand=typeof identity!=='undefined'&&identity?identity:{};
 const receiptLayout=['classic','compact','detailed'].includes(receiptBrand.layout)?receiptBrand.layout:'classic';
 const receiptPrimary=/^#[a-fA-F0-9]{6}$/.test(receiptBrand.primary||'')?receiptBrand.primary:'#082c52';
 const receiptSecondary=/^#[a-fA-F0-9]{6}$/.test(receiptBrand.secondary||'')?receiptBrand.secondary:'#0d4f91';
 const receiptZone=typeof businessTimeZone==='string'?businessTimeZone:'UTC';
 const receiptTime=typeof formatLocalDate==='function'?formatLocalDate:(v=>new Date(v).toISOString()); %>
<!doctype html><html lang="en"><head>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Transfer Request Acknowledgement · <%= order.reference %></title>
<link rel="stylesheet" href="/css/acknowledgement.css"><link rel="stylesheet" href="/css/feedback.css?v=<%= typeof assetVersion==='undefined'?'1':assetVersion %>"></head><body><main class="receipt receipt--<%= receiptLayout %>" style="--receipt-primary:<%= receiptPrimary %>;--receipt-secondary:<%= receiptSecondary %>"><%- include('../../partials/flash', {flash:typeof flash==='undefined'?null:flash}) %>
<header class="receiptBrandHeader"><% if(receiptBrand.showLogo!==false){ %><img class="platformMark receiptLogo" src="<%= receiptBrand.logoUrl||'/images/classicfinhub-mark.png' %>" width="68" height="68" alt="<%= receiptBrand.logoUrl?'Business':'ClassicFin Hub platform' %> logo"><% } %><h1><%= typeof identity!=='undefined'&&identity?.name?identity.name:tenant.name %> — Transfer Request Acknowledgement</h1><p><%= receiptBrand.header||'Internal transaction acknowledgement' %></p></header><% if(typeof identity!=='undefined'&&identity){ %><p><%= identity.prefix %> · <%= identity.template %><% if(identity.supportPhone){ %> · Support: <%= identity.supportPhone %><% } %></p><% } %>
<% if(order.status==='paid_out_manual'){ %><p class="warning">MANUAL BOOK ACKNOWLEDGEMENT. Collection and payout were independently reviewed and posted. Consult the linked movement evidence for the actual counted cash or statement confirmation.</p><% }else if(order.status==='collected_manual'){ %><p class="warning">MANUAL COLLECTION RECORDED. Collection was independently reviewed and posted to the funds book. Payout remains outstanding. The payout PIN is shown once from the collection movement.</p><% }else{ %><p class="warning">NOT A PAYMENT RECEIPT. This records an internal request only. No funds have been collected, transferred, paid out, credited, or settled. No claim PIN is issued.</p><% } %>
<table><tbody><tr><th>Request reference</th><td><%= order.reference %></td></tr><tr><th>Status</th><td><%= order.status.replaceAll('_',' ') %></td></tr><tr><th>Amount requested</th><td><%= formatMoneyMinor(order.amountMinor,order.currency) %></td></tr><tr><th>Proposed fee</th><td><%= formatMoneyMinor(order.feeMinor,order.currency) %></td></tr><tr><th>From branch</th><td><%= order.originBranchName||'Original operating branch' %></td></tr><tr><th>To branch</th><td><%= order.destinationBranchName||order.originBranchName||'Original operating branch' %></td></tr><tr><th>Sender</th><td><%= order.sender.name %> (<%= order.sender.country %>)</td></tr><tr><th>Beneficiary</th><td><%= order.beneficiary.name %> (<%= order.beneficiary.country %>)</td></tr><tr><th>Submitted (<%= receiptZone %>)</th><td><%= receiptTime(order.createdAt) %></td></tr><tr><th>Request expires (<%= receiptZone %>)</th><td><%= receiptTime(order.expiresAt) %></td></tr></tbody></table>
<p>Generated for an authorized staff user. The receiver must complete PIN and identity checks before a payout can be requested.</p><p><a href="/tenant/money-transfer/<%= order._id %>">Open transfer record and manual movements</a></p><% if(typeof identity!=='undefined'&&identity?.footerNote){ %><p><%= identity.footerNote %></p><% } %><button type="button" id="printRequest">Print internal request</button></main><script defer src="/js/print-request.js?v=<%= assetVersion %>"></script>
<script src="/js/feedback.js?v=<%= typeof assetVersion==='undefined'?'1':assetVersion %>" defer></script></body></html>
