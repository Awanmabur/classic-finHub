<% const r=data.record; %><section class="view show"><div class="rowBtns"><a class="btn" href="/tenant/customers">Customers directory</a><a class="btn" href="/tenant/customers/logbook?customerId=<%= r._id %>">Customer logbook</a><% if(data.canManageCustomer&&r.status==='active'){ %><button class="btn btnPrimary" type="button" data-directory-open>Edit customer</button><% } %></div>
 <div class="grid" style="margin-top:14px"><section class="card"><div class="cardHead"><div><b><%= r.name %></b><br><span><%= r.reference %> · <%= r.status %></span></div></div><div class="cardBody"><div class="summary"><% [['Full name',r.name],['Phone',r.phone],['Email',r.email],['ID / Passport No.',r.identityNumber],['Customer type',r.type],['Customer reference',r.reference],['Country',r.country],['City / area',r.city],['Address / notes',r.note]].forEach(([label,value])=>{ %><div class="sumRow"><span><%= label %></span><b><%= value||'—' %></b></div><% }) %></div></div></section>
 <section class="card"><div class="cardHead"><b>Next of kin / emergency contact</b></div><div class="cardBody"><div class="summary"><% [['Next of kin name',r.nextOfKinName],['Next of kin phone',r.nextOfKinPhone],['Relationship',r.relationship]].forEach(([label,value])=>{ %><div class="sumRow"><span><%= label %></span><b><%= value||'—' %></b></div><% }) %></div><% if(data.canManageCustomer&&r.status==='active'){ %><form action="/tenant/customers/<%= r._id %>/archive" method="post" style="margin-top:14px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= r.revision %>"><p class="tiny">Archiving retains this profile and its activity. Accounts must be closed first.</p><button class="btn" type="submit">Archive customer</button></form><% } %></div></section></div>
 <% if(data.canManageCustomer&&r.status==='active'){ %><%- include('modal',{data,user}) %><% } %>
</section>
