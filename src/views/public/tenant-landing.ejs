<% const landing=data.landing, tenant=data.tenant;
const businessName=landing.name||tenant.name;
const publicPrimary=/^#[0-9a-fA-F]{6}$/.test(landing.primary||'')?landing.primary:'var(--dark)';
const publicSecondary=/^#[0-9a-fA-F]{6}$/.test(landing.secondary||'')?landing.secondary:'var(--dark-2)';
const supportTel=String(landing.supportPhone||'').replace(/[^+0-9]/g,''); %>
<div class="publicBusinessProfile" style="--pbPrimary:<%= publicPrimary %>;--pbSecondary:<%= publicSecondary %>">
  <nav class="businessDirCrumbs" aria-label="Breadcrumb"><a href="/">Home</a><i class="fa-solid fa-chevron-right" aria-hidden="true"></i><a href="/businesses">Businesses</a><i class="fa-solid fa-chevron-right" aria-hidden="true"></i><span aria-current="page"><%= businessName %></span></nav>
  <header class="publicBusinessHero">
    <div class="publicBusinessCover" aria-hidden="true"></div>
    <div class="publicBusinessHeading">
      <div class="publicBusinessIdentity">
        <div class="publicBusinessAvatar" aria-hidden="true"><%= businessName.trim().slice(0,1).toUpperCase() %></div>
        <div><span class="publicBusinessEyebrow"><i class="fa-solid fa-circle-check" aria-hidden="true"></i> <%= landing.publishedAt ? "Published business profile" : "ClassicFin Hub business" %></span>
          <h1><%= businessName %></h1>
          <% if(landing.country){ %><p class="publicBusinessLocation"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> <%= landing.country %></p><% } %>
        </div>
      </div>
      <div class="publicBusinessHeroActions">
        <% if(supportTel){ %><a href="tel:<%= supportTel %>" class="btn btn-dark"><i class="fa-solid fa-phone" aria-hidden="true"></i> Contact business</a><% } %>
        <a href="/businesses" class="btn btn-light">All businesses</a>
      </div>
    </div>
    <div class="publicBusinessIntro">
      <% if(landing.headline){ %><h2><%= landing.headline %></h2><% }else{ %><h2>Business overview</h2><p>This business has not published additional profile information yet.</p><% } %>
      <% if(landing.subtitle){ %><p><%= landing.subtitle %></p><% } %>
    </div>
  </header>
  <% if(landing.services?.length){ %>
    <section class="publicBusinessSection" id="services">
      <div class="publicBusinessSectionHead"><span>What we offer</span><h2>Business services</h2></div>
      <div class="publicBusinessServices">
        <% landing.services.forEach((service,i)=>{ %><article><span class="publicBusinessServiceIcon"><i class="fa-solid fa-briefcase" aria-hidden="true"></i></span><h3><%= service %></h3></article><% }) %>
      </div>
    </section>
  <% } %>
  <% if(landing.sections?.length){ %>
    <section class="publicBusinessSection" id="about">
      <div class="publicBusinessSectionHead"><span>Business information</span><h2>More about <%= businessName %></h2></div>
      <div class="publicBusinessDetails">
        <% landing.sections.forEach(section=>{ %>
          <article><h3><%= section.name %></h3><p><%= section.description %></p></article>
        <% }) %>
      </div>
    </section>
  <% } %>

</div>
