<section class="view show">
  <section class="card">
    <div class="cardHead"><b>Close day</b><a class="btn" href="/tenant/cash/shifts">Cash day</a></div>
    <div class="cardBody">
      <% if(data.shift){ %>
        <%- include('_close-count', {shift:data.shift, expected:data.expected, returnToDay:false}) %>
      <% } else { %>
        <p>No open drawer for this currency.</p>
        <a class="btn btnPrimary" href="/tenant/cash/shifts">Go to Cash day</a>
      <% } %>
    </div>
  </section>
</section>
