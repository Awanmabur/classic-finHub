<%
  const cashLabel = (value, currency) => typeof formatMoneyMinor === 'function'
    ? formatMoneyMinor(value, currency) : money(currency, amountFromMinor(value, currency));
  const labels = {
    pending_open: 'Opening count awaiting review', open: 'Open', submitted: 'Closing count awaiting review',
    disputed: 'Closing count needs correction', approved: 'Closed', opening_rejected: 'Opening count rejected'
  };
  const currentBranch = typeof operationBranch === 'undefined' ? null : operationBranch;
  const branchProblem = typeof operationBranchError === 'string' && operationBranchError
    ? operationBranchError : 'An active operating branch must be assigned to your account.';
  const active = data.currentShift;
  const regionalTime = typeof formatLocalDate === 'function' ? formatLocalDate : value => new Date(value).toISOString();
  const selected = data.selectedCurrency;
  const currencyText = data.currencyOptions.find(option => option.code === selected)?.label || selected;
  const nextHistory = new URLSearchParams({cursor:data.shifts.nextCursor || ''});
  if(selected) nextHistory.set('currency', selected);
%>
<section class="view show">
  <% if(data.canOpen){ %>
    <section class="card">
      <div class="cardHead">
        <div><b>Your cash drawer</b><% if(currentBranch){ %><br><span><%= currentBranch.name %> · <%= currencyText %></span><% } %></div>
        <% if(currentBranch){ %><span class="tag"><%= labels[active?.status] || 'Closed' %></span><% } %>
      </div>
      <div class="cardBody">
        <% if(!currentBranch){ %>
          <%- include('../../partials/operation-branch', {currentBranch, branchProblem, user}) %>
        <% } else if(!active && data.openingBook){ %>
          <p>This records the cash already in your drawer.</p>
          <p><%= data.openingBook.name %> · <strong><%= cashLabel(data.openingBook.bookBalanceMinor, selected) %></strong></p>
          <form method="post" action="/tenant/day/open" data-cash-open-form>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="currency" value="<%= selected %>">
            <input type="hidden" name="openingFromBook" value="on">
            <label class="field"><input type="checkbox" name="physicalCountConfirmed" value="on" required> I counted my physical cash and it matches the displayed balance.</label>
            <div class="rowBtns"><button class="btn btnPrimary" type="submit">Send opening count</button></div>
          </form>
        <% } else if(active?.status === 'open' || active?.status === 'disputed'){ %>
          <% if(active.status === 'disputed' && active.reviewNote){ %><p>Reviewer’s note: <%= active.reviewNote %></p><% } %>
          <%- include('../workflow/_close-count', {shift:active, expected:data.expected, returnToDay:true}) %>
        <% } else if(active){ %>
          <p><%= active.status === 'pending_open' ? 'Opening cash counted' : 'Closing cash counted' %> <strong><%= cashLabel(active.status === 'pending_open' ? active.openingMinor : active.declaredClosingMinor, active.currency) %></strong></p>
        <% } else { %>
          <p>A reconciled cash drawer is required for <%= currencyText %>.</p>
          <a class="btn" href="/tenant/treasury">Prepare cash drawer</a>
        <% } %>
      </div>
    </section>
  <% } %>

  <% if(data.canReview){ %>
    <section class="card" <%- data.canOpen ? 'style="margin-top:14px"' : '' %>>
      <div class="cardHead"><b>Counts to review</b></div>
      <div class="cardBody">
        <% if(!data.reviewQueue.length){ %><p>No cash counts are waiting for your review.</p><% } %>
        <% data.reviewQueue.forEach(shift => {
          const isOpening = shift.status === 'pending_open';
        %>
          <details style="margin-block:8px">
            <summary><%= isOpening ? 'Opening' : 'Closing' %> · <%= data.operatorNames[String(shift.operatorId)] || 'Operator' %> · <%= data.branchNames[String(shift.branchId)] || 'Branch' %> · <%= typeof currencyLabel === 'function' ? currencyLabel(shift.currency) : shift.currency %></summary>
            <p>Counted cash <strong><%= cashLabel(isOpening ? shift.openingMinor : shift.declaredClosingMinor, shift.currency) %></strong></p>
            <% if(!isOpening){ %><p>Expected cash <strong><%= cashLabel(shift.expectedClosingMinor, shift.currency) %></strong> · Difference <strong><%= cashLabel(shift.varianceMinor, shift.currency) %></strong></p><% } %>
            <%- include('../workflow/_review-count', {shift, isOpening, canApprove:shift.canApprove, returnToDay:true}) %>
            <p><a href="/tenant/cash/shifts/<%= shift._id %>">Count details</a></p>
          </details>
        <% }) %>
      </div>
    </section>
  <% } %>

  <details class="card" style="margin-top:14px" <%- data.showHistory ? 'open' : '' %>>
    <summary class="cardHead"><b>Cash shift history</b><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
    <div class="cardBody tableWrap">
      <table>
        <thead><tr><th>Opened (local)</th><th>Branch</th><th>Operator</th><th>Status</th><th>Opening cash</th><th>Details</th></tr></thead>
        <tbody>
          <% if(!data.shifts.items.length){ %><tr><td colspan="6">No cash shifts to show.</td></tr><% } %>
          <% data.shifts.items.forEach(shift => { %>
            <tr data-search-row>
              <td><%= regionalTime(shift.createdAt,shift.branchId) %></td>
              <td><%= data.branchNames[String(shift.branchId)] || 'Branch' %></td>
              <td><%= data.operatorNames[String(shift.operatorId)] || 'Operator' %></td>
              <td><%= labels[shift.status] || shift.status %></td>
              <td><%= cashLabel(shift.openingMinor, shift.currency) %></td>
              <td><a class="btn" href="/tenant/cash/shifts/<%= shift._id %>">View shift</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if(data.shifts.nextCursor){ %><p><a class="btn" href="/tenant/cash/shifts?<%= nextHistory.toString() %>">Older shifts</a></p><% } %>
    </div>
  </details>
</section>
