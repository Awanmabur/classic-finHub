<% const funds=data.funds||{wallets:[],paymentAccounts:[],customerAccounts:[],setupHref:'/tenant/treasury'};
   const walletOptions=funds.wallets||[],paymentOptions=funds.paymentAccounts||[],customerOptions=funds.customerAccounts||[]; %>
<div class="formSection" data-mobile-funds>
 <div class="formSectionTitle">Wallet and payment balances</div>
 <div class="row2">
  <label class="field">Wallet account<select class="control" name="walletAccountId" required data-wallet-account><option value="">Select wallet</option><% walletOptions.forEach(wallet=>{ %><option value="<%= wallet.id %>" data-network="<%= wallet.network %>" data-currency="<%= wallet.currency %>" data-expected-minor="<%= wallet.expectedMinor??'' %>" data-observed="<%= wallet.observed||'Unknown' %>" data-observed-at="<%= wallet.observedAt?new Date(wallet.observedAt).toISOString():'' %>" data-state="<%= wallet.state %>" data-reconciliation="<%= wallet.reconciliation %>" <%= wallet.state!=='active'||wallet.expectedMinor===null?'disabled':'' %>><%= wallet.name %> · <%= wallet.expected||'Opening evidence required' %><%= wallet.state!=='active'?' · '+wallet.state:'' %></option><% }) %></select></label>
  <label class="field" data-payment-account-field>Payment account<select class="control" name="paymentAccountId" required data-payment-account><option value="">Select payment account</option><% paymentOptions.forEach(account=>{ %><option value="<%= account.id %>" data-kind="<%= account.kind %>" data-currency="<%= account.currency %>" data-expected-minor="<%= account.expectedMinor??'' %>" data-state="<%= account.state %>" <%= account.state!=='active'||account.expectedMinor===null?'disabled':'' %>><%= account.name %> · <%= account.expected||'Opening evidence required' %><%= account.state!=='active'?' · '+account.state:'' %></option><% }) %></select></label>
  <label class="field" data-customer-wallet-field hidden>Customer wallet account<select class="control" name="customerAccountId" required data-customer-wallet disabled><option value="">Select customer account</option><% customerOptions.forEach(account=>{ %><option value="<%= account.id %>"><%= account.name %> · ****<%= account.last4 %> · <%= account.balance %></option><% }) %></select></label>
 </div>
 <div class="row2"><label class="field">Book wallet balance before<input class="control" readonly value="Unknown" data-wallet-before></label><label class="field">Expected wallet balance after<input class="control" readonly value="Unknown" data-wallet-after></label></div>
 <div class="row2"><label class="field">Actual wallet balance after<input class="control" name="observedWalletBalance" inputmode="decimal" required pattern="[0-9]+([.][0-9]{1,2})?" placeholder="Balance shown by the network wallet"></label><label class="field">Evidence reference<input class="control" name="observationEvidenceReference" maxlength="120" placeholder="Network receipt, statement, or app reference"></label></div>
 <div class="row2"><label class="field">Fee treatment<select class="control" name="feeTreatment"><option value="record_only">Record fee only</option><option value="payment_collected">Fee collected from customer</option><option value="wallet_commission">Commission credited to network wallet</option></select></label><label class="field">Latest actual wallet balance<input class="control" readonly value="Unknown" data-wallet-observed></label></div>
 <div class="logicNote" data-wallet-comparison role="status" aria-live="polite">Select a confirmed wallet to compare the expected book with the actual network balance.</div>
 <div class="rowBtns"><button class="btn" type="button" data-funds-refresh>Refresh balances</button><a class="btn" href="<%= funds.setupHref||'/tenant/treasury' %>">Wallets, cash &amp; balances</a></div>
 <div class="logicNote">Use the balance shown by the network wallet after the transaction. A difference is recorded for independent review and holds the wallet; it never silently overwrites the book.</div>
</div>
