<%
  const zone = typeof businessTimeZone === 'string' ? businessTimeZone : 'UTC';
  const snapshot = data.workspaceSnapshot || {};
  const finance = data.financeOverview || {};
  const displayAmount = row => row?.formatted?.replace(/^KES /, 'KSH ') || '—';
  const filterMoney = rows => (rows || []).filter(row => !data.dashboardCurrency || row.currency === data.dashboardCurrency);
  const currencies = typeof currencyOptions === 'undefined'
    ? [{code:'UGX',label:'UGX'},{code:'USD',label:'USD'},{code:'SSP',label:'SSP'},{code:'KES',label:'KSH'}]
    : currencyOptions;
  const currencyRows = currencies.filter(option => !data.dashboardCurrency || option.code === data.dashboardCurrency);
  const modules = [
    ['hasTransfer', 'money_transfer', 'Money transfer'],
    ['hasMobileMoney', 'mobile_money', 'Mobile money'],
    ['hasBanking', 'banking', 'Banking'],
    ['hasForex', 'forex', 'Forex']
  ].filter(([access, key]) => data[access] &&
    (!Array.isArray(data.visibleDashboardModules) || data.visibleDashboardModules.includes(key)));
  const metrics = modules.map(([, key, label]) => ({
    label, rows: snapshot.todayByCurrency?.[key] || [],
    unavailable: snapshot.mixedRegion || snapshot.todayByCurrencyUnavailable?.[key]
  }));
  if(finance.available && (finance.bookAssets?.length || finance.postedNet?.length)){
    metrics.push(
      {label:'Operating assets', rows:finance.bookAssets || []},
      {label:'Posted net income', rows:finance.postedNet || [], unavailable:finance.mixedRegion}
    );
  }
  const count = modules.length ? snapshot.todayTransactionCount : null;
  const totals = [
    ['Physical cash', data.mobileBookTotals?.cash, 'cash'],
    ['Electronic float', data.mobileBookTotals?.float, 'float']
  ].map(([label, rows, kind]) => ({label, rows: filterMoney(rows), kind})).filter(metric => metric.rows.length);
  const recentActivity = (snapshot.recentActivity || []).slice(0, 6);
%>
<section class="view show" id="view-overview">
  <% if(Number.isInteger(count) || totals.length){ %>
    <section class="card" aria-labelledby="dashboardStats">
      <div class="cardHead"><b id="dashboardStats">Stats</b></div>
      <div class="cardBody">
        <div class="dashboardStatsGrid">
          <% if(Number.isInteger(count)){ %>
            <div class="stat"><div class="k">Posted transactions today</div><div class="v"><%= count.toLocaleString('en-GB') %></div></div>
          <% } %>
          <% totals.forEach(({label, rows, kind}) => { %>
            <div class="stat"<% if(kind){ %> data-dashboard-fund-stat="<%= kind %>"<% } %>>
              <div class="k"><%= label %></div>
              <% rows.forEach(row => { %><div class="v"><%= displayAmount(row) %></div><% }); %>
            </div>
          <% }); %>
        </div>
      </div>
    </section>
  <% } %>

  <% if(metrics.length){ %>
    <section class="card" aria-labelledby="todayCurrencyStats">
      <div class="cardHead"><b id="todayCurrencyStats">Today by currency</b><span><%= snapshot.mixedRegion ? 'Multiple time zones' : zone %></span></div>
      <% if(snapshot.mixedRegion){ %>
        <div class="cardBody"><p class="tiny">Select a branch to view its business day.</p></div>
      <% } %>
      <div class="cardBody tableWrap dashboardCurrencyTable" role="region" aria-labelledby="todayCurrencyStats" tabindex="0">
        <table data-dashboard-currency-stats>
          <thead><tr><th scope="col">Currency</th><% metrics.forEach(({label}) => { %><th scope="col"><%= label %></th><% }); %></tr></thead>
          <tbody>
            <% currencyRows.forEach(currency => { %>
              <tr><th scope="row"><%= currency.label %></th>
                <% metrics.forEach(({rows, unavailable}) => {
                  const row = rows.find(value => value.currency === currency.code);
                %>
                  <td><%= unavailable ? 'Unavailable' : displayAmount(row) %><% if(!unavailable && Number.isInteger(row?.count)){ %><small><%= row.count %> <%= row.count === 1 ? 'transaction' : 'transactions' %></small><% } %></td>
                <% }); %>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </section>
  <% } %>

  <section class="card" aria-labelledby="dashboardActivity">
    <div class="cardHead">
      <b id="dashboardActivity">Recent activity</b>
      <div data-offline-access hidden><button class="btn" type="button" aria-haspopup="dialog">Offline access</button></div>
    </div>
    <div class="cardBody">
      <% if(!recentActivity.length){ %><p class="tiny">No recent transactions.</p><% } else { %>
        <div class="txList" id="recentList">
          <% recentActivity.forEach(row=>{ %>
            <a class="tx" data-search-row href="<%= row.href %>">
              <div class="txLeft">
                <span class="txDot <%= /voided|rejected|disputed|failed/.test(row.status || '') ? 'bad' : /pending|requested|quoted|awaiting/.test(row.status || '') ? 'warn' : 'good' %>"></span>
                <div class="txMeta"><b><%= row.label %></b><span><%= row.subtitle %><% if(row.createdAt){ %> · <%= typeof formatLocalDate==='function'?formatLocalDate(row.createdAt):new Date(row.createdAt).toISOString().slice(0,16).replace('T',' ')+' UTC' %><% } %></span></div>
              </div>
              <div class="txAmt"><%= row.amountLabel %><small><%= row.status || '' %></small></div>
            </a>
          <% }); %>
        </div>
      <% } %>
    </div>
  </section>
</section>
