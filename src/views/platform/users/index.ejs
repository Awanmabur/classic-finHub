<section class="view show"><section class="card"><div class="cardHead"><b>Platform users</b><span>Super admin, platform admin, subadmin, support, billing, auditor.</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th></tr></thead><tbody><% data.platformUsers.forEach(u => { %><tr data-search-row><td><%= u.name %></td><td><%= u.email %></td><td><%= u.role %></td><td><span class="tag"><%= u.status %></span></td></tr><% }) %></tbody></table></div></section></section>
