<section class="view show"><div class="grid"><form class="card" method="post" action="/tenant/forex/buy"><div class="cardHead"><b>Forex buy/sell</b><span>Rates, rate approval, currency stock, cash drawer impact.</span></div><div class="cardBody" style="display:grid;gap:12px"><div class="row2"><label class="field">Customer<input class="control" name="customer" required /></label><label class="field">Pair<select class="control" name="pair"><% data.forexRates.forEach(r => { %><option><%= r.pair %></option><% }) %></select></label></div><div class="row3"><label class="field">Amount<input class="control" type="number" name="amount" required /></label><label class="field">Fee<input class="control" type="number" name="fee" value="10" /></label><label class="field">Currency<select class="control" name="currency"><option>USD</option><option>KSH</option><option>SSP</option></select></label></div><div class="rowBtns"><button class="btn btnPrimary" formaction="/tenant/forex/buy">Buy forex</button><button class="btn" formaction="/tenant/forex/sell">Sell forex</button></div></div></form><section class="card"><div class="cardHead"><b>Active rate board</b><span>Current teller rates</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Pair</th><th>Buy</th><th>Sell</th><th>Status</th></tr></thead><tbody><% data.forexRates.forEach(r => { %><tr data-search-row><td><b><%= r.pair %></b></td><td><%= r.buy %></td><td><%= r.sell %></td><td><span class="tag"><%= r.status %></span></td></tr><% }) %></tbody></table></div></section></div></section>
