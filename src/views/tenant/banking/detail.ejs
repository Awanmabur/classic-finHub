<% const viewZone=typeof businessTimeZone==='string'?businessTimeZone:'UTC';
const localWhen=typeof formatLocalDate==='function'?formatLocalDate:
 (value=>new Date(value).toISOString().slice(0,16).replace('T',' ')); %>
<section class="view show">
<%- include('../partials/record-balances',{recordStatus:data.request.status}) %><section class="card"><div class="cardHead"><b>Banking request <%= data.request.reference %></b><span><%= data.request.status.replaceAll('_',' ') %></span></div><div class="cardBody"><% if(data.request.status==='posted_manual'){ %><p class="tiny">This final banking movement was posted to the funds book and customer account ledger with the original cashier's evidence. Check its supporting count or statement evidence below.</p><% }else{ %><p class="tiny">This unposted banking instruction has not changed any balance. Select the correct funds account and finalize the actual movement.</p><% } %>
<div class="summary"><div class="sumRow"><span>Operation</span><b><%= data.request.kind.replaceAll('_',' ') %></b></div><div class="sumRow"><span>Requested amount</span><b><%= data.formatMoneyMinor(data.request.amountMinor,data.request.currency) %></b></div><div class="sumRow"><span>Source</span><b><%= data.request.source.customerName %> · <%= data.request.source.institutionName %> · ****<%= data.request.source.last4 %></b></div><% if(data.request.destination){ %><div class="sumRow"><span>Destination</span><b><%= data.request.destination.customerName %> · <%= data.request.destination.institutionName %> · ****<%= data.request.destination.last4 %></b></div><% } %><div class="sumRow"><span>Reason</span><b><%= data.request.note %></b></div><div class="sumRow"><span>Expires Local · <%= viewZone %></span><b><%= localWhen(data.request.expiresAt,undefined) %></b></div><div class="sumRow"><span>Submitted Local · <%= viewZone %></span><b><%= localWhen(data.request.createdAt,undefined) %></b></div><div class="sumRow"><span>Posting evidence</span><b><%= data.request.reviewNote||'No posted funds evidence yet' %></b></div></div>
<div class="summary"><% [['Payment channel',data.request.capture?.paymentChannel||'Cash'],['Customer phone / contact',data.request.capture?.customerPhone],['External reference',data.request.capture?.externalReference]].forEach(([label,value])=>{ %><div class="sumRow"><span><%= label %></span><b><%= value||'—' %></b></div><% }) %></div>
<div class="rowBtns" style="margin-top:12px"><% if(data.canFx){ %><a class="btn" href="/tenant/banking/exchange">Open internal customer account FX transfer</a><% } %><% if(data.pendingMovementId){ %><a class="btn btnPrimary" href="/tenant/funded/<%= data.pendingMovementId %>">Finish interrupted posting</a><% } %><% if(data.canRecordManual){ %><a class="btn btnPrimary" href="/tenant/funded/prepare/banking/<%= data.request._id %>">Finalize banking movement</a><% } %><% if(data.request.manualExecutionId){ %><a class="btn btnPrimary" href="/tenant/funded/<%= data.request.manualExecutionId %>">View posted movement</a><% } %><a class="btn" href="/tenant/funded">Final movements &amp; receipts</a><a class="btn" href="/tenant/banking/history">Return to history</a></div></div></section>

<% if(data.canCancel){ %><form method="post" action="/tenant/banking/<%= data.request._id %>/cancel" class="card" style="margin-top:14px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="cardHead"><b>Cancel undecided request</b></div><div class="cardBody"><label class="field">Reason (12–400 characters)<textarea name="note" class="control" required minlength="12" maxlength="400" rows="2"></textarea></label><button class="btn" type="submit">Cancel pending request</button></div></form><% } %>
</section>
