<% const row=data.execution; %><section class="view show"><section class="card"><div class="cardHead"><div><b><%= row.sourceReference %></b><br><span><%= row.action.replaceAll('_',' ') %></span></div><span class="tag"><%= row.status.replaceAll('_',' ') %></span></div><div class="cardBody"><div class="summary"><div class="sumRow"><span>Manual source</span><b><%= row.evidenceReference %></b></div><div class="sumRow"><span>Explanation</span><b><%= row.note %></b></div><div class="sumRow"><span>Independent review</span><b><%= row.reviewNote||'Awaiting review' %></b></div><div class="sumRow"><span>Posted ledger journals</span><b><%= row.journalIds.length %></b></div></div><p class="tiny">Posted manual books record the independently checked movement. Provider verification and later balance observations retain their own evidence and time.</p><div class="rowBtns"><a class="btn" href="/tenant/funded">Manual movements</a><a class="btn" href="/tenant/treasury">Balances &amp; reconciliation</a></div></div></section>
<% if(data.sms){ const notice=data.sms; %><section class="card" style="margin-top:14px" data-transfer-sms-state="<%= notice.state %>"><div class="cardHead"><div><b>Receiver SMS</b><br><span><%= notice.recipientMasked %></span></div><span class="tag"><%= notice.state==='accepted'?'Provider accepted':notice.state.replaceAll('_',' ') %></span></div><div class="cardBody"><p class="tiny"><% if(notice.state==='accepted'){ %>The SMS provider accepted this message. Delivery to the receiver has not been independently confirmed.<% }else if(notice.state==='not_configured'){ %>Receiver SMS is not configured. A platform operator must configure the outbound provider and dedicated encryption key. Use the one-time PIN handoff while it is unavailable.<% }else if(notice.state==='uncertain'){ %>The provider submission outcome is uncertain. Inspect the provider account before sending another message; automatic retry is stopped to prevent duplicate PIN messages.<% }else if(notice.state==='suppressed'){ %><% if(notice.failureCode==='SMS_TRANSFER_PAID'){ %>The transfer was paid out and its queued PIN handoff was cleared. A provider submission already in flight cannot be recalled.<% }else{ %>Sending stopped because the transfer, branch or entitlement is no longer available.<% } %><% }else if(notice.state==='dead'){ %>The provider rejected delivery or retries were exhausted. Correct the provider configuration before requesting an owner retry.<% }else{ %>The receiver message is waiting for provider submission. A PIN message is not proof that cash has been paid out.<% } %></p><% if(notice.failureCode){ %><p class="tiny">Status code: <%= notice.failureCode %></p><% } %><% if(notice.acceptedMessageId){ %><p class="tiny">Provider reference: <%= notice.acceptedMessageId %></p><% } %><% if(data.smsRetryLimited){ %><p class="tiny">The three owner retries are used. Inspect the provider and use the controlled private PIN handoff.</p><% }else if(data.smsRetryCooling){ %><p class="tiny">Wait one minute between owner retries, then refresh this page.</p><% } %><% if(data.canRetrySms){ %><form data-funded-form method="post" action="/tenant/funded/<%= row._id %>/retry-sms"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field">Retry reason<textarea class="control" name="note" minlength="20" maxlength="400" required placeholder="Explain the provider configuration or rejected submission that was corrected"></textarea></label><button class="btn" type="submit">Retry receiver SMS</button></form><% } %></div></section><% } %>
<% if(data.canRevealPin){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Transfer payout PIN</b><span>Shown once</span></div><div class="cardBody"><form data-funded-form method="post" action="/tenant/funded/<%= row._id %>/reveal-pin"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btnPrimary" type="submit">Show payout PIN once</button></form></div></section><% } %>
<% if(data.canReview){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Independent financial review</b></div><div class="cardBody"><form data-funded-form method="post" action="/tenant/funded/<%= row._id %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field">Review evidence<textarea class="control" name="note" minlength="12" maxlength="400" required rows="3"></textarea></label><div class="rowBtns"><button class="btn btnPrimary" name="decision" value="approve" type="submit">Approve and post manual movement</button><button class="btn" name="decision" value="reject" type="submit">Reject</button></div></form></div></section><% } %></section>
