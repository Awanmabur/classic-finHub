<section class="view show"><section class="card"><div class="cardHead"><b>Subscriptions and trials</b><span>Read-only listing · manual grants via the tenant profile</span></div><div class="cardBody tableWrap">
<table><thead><tr><th>Tenant</th><th>Published plan</th><th>Term</th><th>Access state</th><th>Actions</th></tr></thead><tbody>
<% data.tenants.forEach(t=>{ const s=t.subscription, valid=s && ['trial','granted'].includes(s.status) && ['trial','active'].includes(t.status) && new Date(s.periodEnd)>new Date(); %>
<tr data-search-row><td><%= t.name %></td><td><%= s ? `${s.planCode} v${s.planVersion}` : 'Migration required' %></td><td><%= s && s.periodEnd ? new Date(s.periodEnd).toISOString().slice(0,10):'Not assigned' %></td><td><span class="tag"><%= valid ? s.status : 'restricted' %></span></td><td><a href="/platform/tenants/<%= t._id %>">Manage tenant</a></td></tr>
<% }) %><% if(!data.tenants.length){ %><tr><td colspan="5">No tenants provisioned.</td></tr><% } %></tbody></table></div></section></section>
