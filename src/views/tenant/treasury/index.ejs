<section class="view show">
 <section class="card treasurySetupGuide" aria-label="Start cash and float setup">
  <% const configuredCash=(data.snapshot.accounts||[]).filter(a=>a.kind==='cash').length;
     const configuredWallet=(data.snapshot.accounts||[]).filter(a=>a.kind==='wallet').length;
     const pendingOpening=(data.snapshot.accounts||[]).filter(a=>a.bookKnown!==true).length; %>
  <div class="cardHead"><div><b>Start here: cash and wallet opening</b><br><span>Real accounts, real opening evidence, independent approval</span></div><% if(data.hasMobileMoney){ %><a class="btn" href="/tenant/mobile-money/readiness">Mobile Money readiness</a><% } %></div>
  <div class="cardBody">
    <div class="summary">
      <div class="sumRow"><span>Cash drawers in this view</span><b><%= configuredCash %></b></div>
      <div class="sumRow"><span>Provider float wallets in this view</span><b><%= configuredWallet %></b></div>
      <div class="sumRow"><span>Accounts awaiting approved opening</span><b><%= pendingOpening %></b></div>
    </div>
    <ol class="setupSteps">
      <li><strong>Create an account</strong><p>Choose Cash for a physical drawer or Wallet for a real mobile network float account. Assign the correct branch, network, currency and operator. No money is created by this step.</p><% if(data.canCreateAccount){ %><a class="btn btnPrimary" href="#account-setup">Create an account</a><% }else{ %><span class="tiny">An authorized Treasury Manager must create the account in a selected branch.</span><% } %></li>
      <li><strong>Record opening balance evidence</strong><p>Open the newly created account from the balance table below. Submit its actual cash count or provider statement for review.</p><a class="btn" href="#treasury-accounts">Find your account</a></li>
      <li><strong>Approve independently</strong><p>A different authorized reviewer approves the evidence. Pending balances are not usable funds.</p><% if(data.canReview){ %><a class="btn" href="/tenant/treasury/review">Review opening evidence</a><% }else{ %><span class="tiny">An independently authorized reviewer completes this step.</span><% } %></li>
      <li><strong>Open day and record operations</strong><p>For cash payments, open a physical cash shift separately. Cash shifts never replace a provider float wallet or prove network settlement.</p><a class="btn" href="/tenant/cash/shifts">Cash shifts</a></li>
    </ol>
  </div>
 </section>
 <section class="card" id="treasury-accounts"><div class="cardHead"><div><b>Wallets, cash &amp; balances</b><br><span>Expected book and actual evidence</span></div><div class="rowBtns"><% if(data.canCreateAccount){ %><a class="btn" href="#account-setup">Add account</a><% } %><% if(data.canObserve){ %><a class="btn btnPrimary" href="#add-funds">Add funds</a><% } %><% if(data.canReview){ %><a class="btn" href="/tenant/treasury/review">Independent review</a><% } %></div></div><div class="cardBody">
  <p class="tiny"><%= data.snapshot.note %></p>
  <div class="tableWrap"><table><thead><tr><th>Account</th><th>Expected book</th><th>Last actual observation</th><th>Observed at (UTC)</th><th>Difference</th><th>Control</th></tr></thead><tbody>
   <% if(!data.snapshot.accounts.length){ %><tr><td colspan="6">No accounts are configured in this view. Add the wallet, drawer, bank or stock account and confirm its opening balance before using it.</td></tr><% } %>
   <% data.snapshot.accounts.forEach(account=>{ %><tr data-search-row><td><a href="/tenant/treasury/accounts/<%= account._id %>"><b><%= account.name %></b></a><br><span class="tiny"><% if(data.allBranches&&data.branchNames[String(account.branchId)]){ %><%= data.branchNames[String(account.branchId)] %> · <% } %><%= account.code %> · <%= account.kind.replaceAll('_',' ') %><%= account.network?' · '+account.network:'' %></span></td><td><%= account.expectedFormatted %><% if(account.kind==='cash'&&BigInt(String(account.reservedCashMinor||'0'))>0n){ %><div class="tiny">In transit (not spendable): <%= account.reservedCashFormatted %></div><div class="tiny"><strong>Available: <%= data.format(account.availableMinor,account.currency) %></strong></div><% } %></td><td><%= account.observedFormatted %><% if(account.pendingObservation){ %><br><span class="tiny">Pending actual: <%= account.pendingObservation.actualFormatted %> at <%= new Date(account.pendingObservation.observedAt).toISOString() %></span><% } %></td><td><%= account.lastObservationAt?new Date(account.lastObservationAt).toISOString().slice(0,16).replace('T',' '):'Not observed' %></td><td><%= account.varianceFormatted %></td><td><span class="tag"><%= account.status %> · <%= account.reconciliationState==='matched'?'matched at last reviewed observation':account.reconciliationState %></span></td></tr><% }) %>
  </tbody></table></div>
 </div></section>
 <%- include('_funding') %>
 <% if(data.canCreateAccount){ %><section class="card" style="margin-top:14px" id="account-setup"><div class="cardHead"><b>Add wallet / funds account</b><span><%= data.setupBranch.name %></span></div><form class="cardBody" method="post" action="/tenant/treasury/accounts" data-treasury-account-setup><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row2">
  <label class="field">Account code<input class="control" type="text" value="Generated automatically" readonly tabindex="-1" aria-label="Account code generated automatically"><span class="tiny">Generated from account type, provider, currency and a unique ID.</span></label><label class="field">Account name<input class="control" name="name" required minlength="3" maxlength="120" placeholder="Actual wallet or drawer name"></label>
  <label class="field">Account kind<select class="control" name="kind" required data-treasury-account-kind><% data.kinds.forEach(kind=>{ %><option value="<%= kind %>"><%= kind.replaceAll('_',' ') %></option><% }) %></select></label><label class="field" data-treasury-account-currency-field>Currency<select class="control" name="currency" required data-treasury-account-currency><% (data.setupBranch.currencies||['UGX','USD','SSP','KES']).forEach(currency=>{ %><option value="<%= currency %>"><%= currency==='KES'?'KSH':currency %></option><% }) %></select></label>
  <label class="field" data-treasury-account-network-field>Wallet network (wallet accounts only)<select class="control" name="network" data-treasury-account-network><option value="">Choose a network</option><% data.networks.forEach(network=>{ %><option data-market-currency="<%= data.networkMarketCurrencies?.[network]||'' %>"><%= network %></option><% }) %></select><small>Currency will follow the provider market where it is fixed. Multi-market wallets require an explicit approved currency.</small></label><label class="field">Assigned operator (required for cash)<select class="control" name="operatorId"><option value="">Shared branch account</option><% data.operators.forEach(operator=>{ %><option value="<%= operator._id %>"><%= operator.name %> · <%= operator.role %></option><% }) %></select></label>
  <label class="field">Wallet / bank identifier<input class="control" name="accountReference" maxlength="80" placeholder="Identifier for the real account; never a PIN or API key"></label><label class="field">Default for this operation<select class="control" name="isDefault"><option value="true">Yes</option><option value="false">No, select this account explicitly</option></select></label>
 </div><p class="tiny">This account will belong to <b><%= data.setupBranch.name %></b>. Creating an account does not create any funds.</p><button class="btn btnPrimary" type="submit">Create account</button></form></section><% }else if(data.canManage){ %><section class="card" style="margin-top:14px" id="account-setup"><div class="cardHead"><b>Add wallet / funds account</b></div><div class="cardBody"><p class="tiny">Choose a branch in the viewing control to add an account.</p></div></section><% } %>
 <% if(data.canReview){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Actual balance review queue</b><span>Different person required</span></div><div class="cardBody">
  <% if(!data.queue.length){ %><p class="tiny">No evidence awaits your independent review.</p><% } %>
  <% data.queue.forEach(observation=>{ %><div class="tx"><div class="txMeta"><b><a href="/tenant/treasury/accounts/<%= observation.accountId %>"><%= observation.account.name %> · <%= observation.kind %></a></b><span><%= observation.evidenceType.replaceAll('_',' ') %> · <%= observation.evidenceReference %> · <%= new Date(observation.observedAt).toISOString() %></span></div><b><%= data.format(observation.actualMinor,observation.account.currency) %></b></div><% }) %>
 </div></section><% } %>
 <%- include('_funding-history') %>
</section>
