<% const row=data.execution; %><section class="view show"><section class="card"><div class="cardHead"><div><b><%= row.sourceReference %></b><br><span><%= row.action.replaceAll('_',' ') %></span></div><span class="tag"><%= row.status.replaceAll('_',' ') %></span></div><div class="cardBody"><div class="summary"><div class="sumRow"><span>Manual source</span><b><%= row.evidenceReference %></b></div><div class="sumRow"><span>Explanation</span><b><%= row.note %></b></div><div class="sumRow"><span>Independent review</span><b><%= row.reviewNote||'Awaiting review' %></b></div><div class="sumRow"><span>Posted ledger journals</span><b><%= row.journalIds.length %></b></div></div><p class="tiny">Posted manual books record the independently checked movement. Provider verification and later balance observations retain their own evidence and time.</p><div class="rowBtns"><a class="btn" href="/tenant/funded">Manual movements</a><a class="btn" href="/tenant/treasury">Balances &amp; reconciliation</a></div></div></section>
<% if(data.canRevealPin){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Transfer payout PIN</b><span>Shown once</span></div><div class="cardBody"><form data-funded-form method="post" action="/tenant/funded/<%= row._id %>/reveal-pin"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btnPrimary" type="submit">Show payout PIN once</button></form></div></section><% } %>
<% if(data.canReview){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Independent financial review</b></div><div class="cardBody"><form data-funded-form method="post" action="/tenant/funded/<%= row._id %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field">Review evidence<textarea class="control" name="note" minlength="12" maxlength="400" required rows="3"></textarea></label><div class="rowBtns"><button class="btn btnPrimary" name="decision" value="approve" type="submit">Approve and post manual movement</button><button class="btn" name="decision" value="reject" type="submit">Reject</button></div></form></div></section><% } %></section>
