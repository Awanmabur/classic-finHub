<% for (const funding of fundings) {
  const contribution=funding.sourceKind==='owner_contribution';
  const status={pending_review:'Awaiting approval',posted:'Posted',rejected:'Rejected'}[funding.status];
  const destinationUrl=typeof ownerMoneyPage!=='undefined'&&ownerMoneyPage?
   data.ownerMoney.accountTarget(funding.destination._id):'/tenant/treasury/accounts/'+funding.destination._id;
%>
  <article class="treasuryPending">
    <h3><%= contribution?'Owner contribution':funding.source?.name||'Account transfer' %> → <% if (onAccount) { %><%= funding.destination.name %><% } else { %><a class="treasuryAccountLink" href="<%= destinationUrl %>"><%= funding.destination.name %></a><% } %></h3>
    <div class="treasurySource"><b><%= data.format(funding.amountMinor,funding.currency) %></b> · <%= status %></div>
    <div class="treasurySource"><%= funding.evidenceReference %> · <%= new Date(funding.createdAt).toISOString() %></div>
    <% if (funding.note) { %><p><%= funding.note %></p><% } %>
    <% if (funding.reviewNote) { %><p class="tiny">Review: <%= funding.reviewNote %></p><% } %>
    <% if (allowReview(funding)) { %>
      <form class="workspaceStack" method="post" action="/tenant/treasury/funding/<%= funding._id %>/review" data-wallet-funding-review>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (onAccount) { %><input type="hidden" name="returnToAccount" value="<%= data.account._id %>"><% } %>
        <label class="field">Review note<textarea class="control" name="note" minlength="12" maxlength="400" required rows="2"></textarea></label>
        <div class="rowBtns"><button class="btn btnPrimary" name="decision" value="approve">Approve</button><button class="btn" name="decision" value="reject">Reject</button></div>
      </form>
    <% } %>
  </article>
<% } %>
