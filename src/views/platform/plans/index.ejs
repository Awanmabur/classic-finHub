<section class="view show"><div class="grid3"><% data.plans.forEach(p => { %><article class="card" data-search-row><div class="cardHead"><b><%= p.name %></b><span><%= p.trialMonths %> month trial</span></div><div class="cardBody"><div class="stat"><div class="k">Monthly</div><div class="v"><%= p.currency %> <%= p.priceMonthly %></div><div class="s"><span class="dot"></span><%= p.modules.length %> modules</div></div><p class="tiny"><%= p.description %></p><a class="btn" href="/platform/plans/editor?plan=<%= p.code %>">Edit plan</a></div></article><% }) %></div></section>
