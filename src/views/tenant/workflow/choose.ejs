<section class="view show"><section class="card"><div class="cardHead"><div><b>New transaction</b><br><span>Choose a module, then enter the operation details.</span></div></div><div class="cardBody transactionChoices">
<% transactionOptions.forEach(option=>{ const href=({cash_in:'/tenant/mobile-money/cash-in',cash_out:'/tenant/mobile-money/cash-out',transfer:'/tenant/money-transfer/send',banking_deposit:'/tenant/banking/deposit',banking_withdrawal:'/tenant/banking/withdraw',banking_transfer:'/tenant/banking/transfer',forex_buy:'/tenant/forex/buy',forex_sell:'/tenant/forex/sell',customer:'/tenant/customers/new',account:'/tenant/accounts/new',expense:'/tenant/expenses/new',approval:'/tenant/approvals',cash_shift_open:'/tenant/mobile-money/shifts',cash_shift_close:'/tenant/day/close'})[option.kind]; %><a class="transactionChoice" href="<%= href %>" data-transaction-kind="<%= option.kind %>"><i class="fa-solid <%= option.icon %>" aria-hidden="true"></i><span><b><%= option.label %></b><small><%= option.description %></small></span></a><% }) %>
<% if(!transactionOptions.length){ %><p class="tiny">Your account has no assigned transaction modules. Contact your tenant administrator to configure access.</p><% } %>
</div></section></section>
