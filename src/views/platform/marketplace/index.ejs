<section class="view show"><div class="grid3"><% data.modules.forEach(m => { %><article class="card" data-search-row><div class="cardHead"><b><i class="fa-solid <%= m.icon %>"></i> <%= m.name %></b><span><%= m.category %></span></div><div class="cardBody"><p class="tiny"><%= m.description %></p><div class="summary"><div class="sumRow"><span>Monthly addon price</span><b>$<%= m.priceMonthly %></b></div><div class="sumRow"><span>Status</span><b><%= m.status %></b></div><div class="sumRow"><span>Core</span><b><%= m.isCore ? 'Yes' : 'No' %></b></div></div><a class="btn" href="/platform/modules">Manage registry</a></div></article><% }) %></div></section>
