<% const previous=data.submitted||{};
   const label=code=>code==='KES'?'KSH':code;
   const rateSetup='/tenant/forex/rates#forexRateProposalForm'; %>
<section class="view show workspaceStack">
 <section class="card">
  <div class="cardHead">
   <div><b>Cross-currency customer account transfer</b><span>Real internal account balances · approved Buy/Sell rate</span></div>
   <a class="btn" href="/tenant/banking">Banking</a>
  </div>
  <div class="cardBody">
   <p class="tiny">Use this only when both accounts are held by the same customer in this branch. FinHub atomically debits the source liability and credits the destination liability in their own currencies. This is an internal financial-book transfer, not an external bank wire or evidence of an outside payment.</p>
   <form method="get" action="/tenant/banking/exchange" class="row2" style="margin-bottom:12px">
    <label class="field">Find customer by name or account number
     <input class="control" name="q" value="<%= data.search||'' %>" maxlength="60" placeholder="Customer or account number">
    </label>
    <button class="btn" type="submit">Search accounts</button>
   </form>
   <% if(data.truncated){ %><p class="tiny">Showing the first 100 results. Search for the customer before posting an exchange.</p><% } %>
   <% if(data.rateError){ %><p role="alert" class="workspaceNote" data-banking-fx-server-error><%= data.rateError %></p><% } %>
   <% if(!data.accounts.length){ %><p>Open two active customer accounts in different currencies before transferring.</p><a class="btn" href="/tenant/accounts">Manage customer accounts</a><% }else{ %>
   <form method="post" action="/tenant/banking/exchange/preview" autocomplete="off" data-feedback-skip data-banking-fx
     data-expired-pairs="<%= (data.expiredPairs||[]).map(pair=>pair.fromCurrency+':'+pair.toCurrency).join(' ') %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="idempotencyKey" value="<%= data.idempotencyKey %>">
    <input type="hidden" name="q" value="<%= data.search||'' %>">
    <div class="formSection">
     <div class="formSectionTitle">Customer accounts</div>
     <div class="row2">
      <label class="field">Debit source account
       <select class="control" name="sourceAccountId" required><option value="">Select posted customer balance</option>
        <% data.accounts.forEach(a=>{ %>
         <option value="<%= a._id %>" data-customer="<%= a.customerId %>" data-currency="<%= a.currency %>" <%= String(a._id)===previous.sourceAccountId?'selected':'' %>><%= a.customerName %> · ****<%= a.accountNumber.slice(-4) %> · <%= label(a.currency) %> · Book: <%= a.balanceLabel||'Balance unavailable' %></option>
        <% }) %>
       </select>
      </label>
      <label class="field">Credit destination account
       <select class="control" name="destinationAccountId" required><option value="">Select same customer's other currency account</option>
        <% data.accounts.forEach(a=>{ %>
         <option value="<%= a._id %>" data-customer="<%= a.customerId %>" data-currency="<%= a.currency %>" <%= String(a._id)===previous.destinationAccountId?'selected':'' %>><%= a.customerName %> · ****<%= a.accountNumber.slice(-4) %> · <%= label(a.currency) %> · Book: <%= a.balanceLabel||'Balance unavailable' %></option>
        <% }) %>
       </select>
      </label>
     </div>
     <div class="row2">
      <label class="field">Amount to exchange (source account currency)
       <input class="control" name="amount" value="<%= previous.amount||'' %>" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" maxlength="32" required placeholder="Enter exact source amount">
      </label>
      <label class="field">Approved exchange rate
       <select class="control" name="rateChoice" required aria-describedby="bankingFxRateStatus"><option value="">Choose currency pair and direction</option>
        <% data.rates.forEach(r=>{ %>
         <option value="<%= r._id %>:<%= r.revision %>:<%= r.rateDecimal %>" data-from="<%= r.fromCurrency %>" data-to="<%= r.toCurrency %>" data-expires-at="<%= r.expiresAt?new Date(r.expiresAt).toISOString():'' %>"><% const quote=data.rateDisplay(r.rateDecimal,r.fromCurrency); %><%= label(r.fromCurrency) %> → <%= label(r.toCurrency) %> · <%= r.side==='buy'?'Buy':'Sell' %> · <%= quote.text %> = <%= quote.rate %> <%= label(r.toCurrency) %></option>
        <% }) %>
       </select>
      </label>
     </div>
     <div class="rowBtns" data-banking-fx-rate-notice>
      <span id="bankingFxRateStatus" role="status" data-banking-fx-rate-status><%= data.rates.length?'Select the two accounts to see their exchange rates.':'This branch has no active Buy/Sell rates. Select the two accounts to check their currency pair.' %></span>
      <% if(data.canSetRate){ %><a class="btn" data-banking-fx-rate-action href="<%= rateSetup %>">Set exchange rate</a><% } %>
     </div>
     <label class="field">Customer-approved voucher / instruction reference
      <input class="control" name="evidenceReference" value="<%= previous.evidenceReference||'' %>" minlength="6" maxlength="120" required placeholder="Signed instruction, receipt or verifiable customer authorization">
     </label>
     <label class="field"><input type="checkbox" name="confirmCustomerAuthority" value="yes" required> The customer approved the actual two-currency transfer and the source and destination account details have been checked.</label>
     <button class="btn btnPrimary" type="submit" data-banking-fx-submit <%= data.rates.length?'':'disabled' %>>Review exact exchange amounts</button>
    </div>
   </form><% } %>
  </div>
 </section>
 <section class="card">
  <div class="cardHead"><b>Completed internal currency exchanges</b><span><%= data.records.length %> recent</span></div>
  <div class="cardBody">
   <% if(!data.records.length){ %><p class="tiny">No internal account currency exchanges have been posted in this branch.</p><% }else{ %>
    <div class="tableWrap"><table aria-label="Posted internal banking forex exchanges">
     <thead><tr><th>Posted</th><th>Source account debit</th><th>Destination account credit</th><th>Rate</th><th>Customer instruction</th><th>Type</th></tr></thead>
     <tbody><% data.records.forEach(r=>{ %>
      <tr><td><%= formatLocalDate(r.postedAt,r.branchId) %></td>
       <td><%= data.formatMoneyMinor(r.sourceAmountMinor,r.sourceCurrency) %></td>
       <td><%= data.formatMoneyMinor(r.destinationAmountMinor,r.destinationCurrency) %></td>
       <td><% const rd=data.rateDisplay(r.rateDecimal,r.sourceCurrency); %><%= r.rateSide.toUpperCase() %> · <%= rd.text %> = <%= rd.rate %> <%= r.destinationCurrency %></td>
       <td><%= r.evidenceReference %></td><td>Posted internally · no external bank payment</td>
      </tr>
     <% }) %></tbody>
    </table></div>
   <% } %>
  </div>
 </section>
</section>
<script defer src="/js/banking-fx.js?v=<%= typeof assetVersion==='undefined'?'1':assetVersion %>"></script>
