<%
  const reportTypes = [
    ['/summary', 'Summary'], ['', 'All operations'], ['/daily', 'Daily business'], ['/opening', 'Opening cash'], ['/closing', 'Closing cash'],
    ['/transactions', 'Transactions'], ['/expenses', 'Expenses'], ['/transfer', 'Transfers'], ['/mobile', 'Mobile money'],
    ['/banking', 'Banking'], ['/forex', 'Forex'], ['/loans', 'Loans'], ['/airtime', 'Airtime']
  ].map(([path, label]) => ['/tenant/reports' + path, label]);
%>
<details class="card noPrint" style="margin-bottom:14px">
  <summary class="cardHead"><b>Report types</b><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
  <div class="cardBody rowBtns">
    <% reportTypes.filter(([href]) => visiblePaths.has(href)).forEach(([href, label]) => { %>
      <a class="btn" href="<%= href %>" <% if(currentPath === href){ %>aria-current="page"<% } %>><%= label %></a>
    <% }) %>
  </div>
</details>
