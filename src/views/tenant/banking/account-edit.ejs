<section class="view show"><form method="post" action="/tenant/banking/accounts/<%= data.reference._id %>/update" class="card" autocomplete="off"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="cardHead"><b>Edit masked account reference</b></div><div class="cardBody" style="display:grid;gap:12px"><p class="tiny">Edits affect future requests only. Historical banking request snapshots remain unchanged.</p>
<label class="field">Customer<input name="customerName" class="control" required minlength="2" maxlength="120" value="<%= data.reference.customerName %>"></label>
<label class="field">Institution<select name="institutionChoice" class="control" required><option value="__new__">Add a new institution</option><% (data.institutions||[data.reference.institutionName]).forEach(name=>{ %><option value="<%= name %>" <%= name===data.reference.institutionName?'selected':'' %>><%= name %></option><% }) %></select></label>
<label class="field">New institution name (only if adding new)<input name="institutionName" class="control" minlength="2" maxlength="120" placeholder="Enter new institution name"></label>
<label class="field">Last four characters<input name="last4" class="control" required pattern="[A-Za-z0-9]{4}" minlength="4" maxlength="4" value="<%= data.reference.last4 %>"></label>
<input type="hidden" name="currency" value="<%= data.reference.currency %>"><p class="tiny">Currency: <%= data.reference.currency %> (immutable)</p><div class="rowBtns"><button type="submit" class="btn btnPrimary">Save reference</button><a class="btn" href="/tenant/banking/accounts">Cancel</a></div></div></form></section>
