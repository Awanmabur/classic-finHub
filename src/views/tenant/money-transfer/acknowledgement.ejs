<!doctype html><html lang="en"><head>
  <link rel="icon" type="image/png" href="/images/classicfinhub-logo.png"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Transfer Request Acknowledgement · <%= order.reference %></title>
<style>body{font:15px/1.5 system-ui,Arial,sans-serif;color:#18243a;max-width:760px;margin:40px auto;padding:20px}h1{font-size:24px}table{border-collapse:collapse;width:100%}th,td{padding:12px;text-align:left;border-bottom:1px solid #ddd}th{width:38%}.warning{padding:18px;border:2px solid #b86e22;background:#fff6ed;font-weight:700}button{padding:12px;margin-top:16px}@media print{button{display:none}body{margin:0}}</style></head><body>
<h1><%= typeof identity!=='undefined'&&identity?.name?identity.name:tenant.name %> — Transfer Request Acknowledgement</h1><% if(typeof identity!=='undefined'&&identity){ %><p><%= identity.prefix %> · <%= identity.template %><% if(identity.supportPhone){ %> · Support: <%= identity.supportPhone %><% } %></p><% } %>
<p class="warning">NOT A PAYMENT RECEIPT. This records an internal request only. No funds have been collected, transferred, paid out, credited, or settled. No claim PIN is issued.</p>
<table><tbody><tr><th>Request reference</th><td><%= order.reference %></td></tr><tr><th>Status</th><td><%= order.status.replaceAll('_',' ') %></td></tr><tr><th>Amount requested</th><td><%= formatMoneyMinor(order.amountMinor,order.currency) %></td></tr><tr><th>Proposed fee</th><td><%= formatMoneyMinor(order.feeMinor,order.currency) %></td></tr><tr><th>Sender</th><td><%= order.sender.name %> (<%= order.sender.country %>)</td></tr><tr><th>Beneficiary</th><td><%= order.beneficiary.name %> (<%= order.beneficiary.country %>)</td></tr><tr><th>Submitted (UTC)</th><td><%= new Date(order.createdAt).toISOString() %></td></tr><tr><th>Request expires (UTC)</th><td><%= new Date(order.expiresAt).toISOString() %></td></tr></tbody></table>
<p>Generated for an authorized staff user. This document cannot be used to demand or claim a payout.</p><% if(typeof identity!=='undefined'&&identity?.footerNote){ %><p><%= identity.footerNote %></p><% } %><button type="button" id="printRequest">Print internal request</button><script defer src="/js/print-request.js?v=<%= assetVersion %>"></script>
</body></html>
