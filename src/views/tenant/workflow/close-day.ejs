<section class="view show"><section class="card"><div class="cardHead"><div><b>Close day</b><br><span>Auto closing balances from reports</span></div><a class="btn" href="/tenant/cash/shifts">Cash control review</a></div><div class="cardBody">
<% if(data.shift){ %><form method="post" action="/tenant/day/close"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="shiftId" value="<%= data.shift._id %>"><input type="hidden" name="currency" value="<%= data.shift.currency %>"><div class="formSection"><div class="formSectionTitle">Auto closing balances from reports</div><div class="row2"><label class="field">Expected closing <%= typeof currencyLabel==='function'?currencyLabel(data.shift.currency):data.shift.currency %><input class="control" value="<%= data.expected %>" readonly></label><label class="field">Counted closing <%= typeof currencyLabel==='function'?currencyLabel(data.shift.currency):data.shift.currency %><input class="control" name="countedCash" required type="text" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" placeholder="0"></label><label class="field">Closing note<input class="control" name="note" maxlength="400" placeholder="Explain any difference from the expected cash"></label></div></div><p class="tiny">Only your assigned branch drawer is included. Posted cash fees are included; noncash entries are excluded. Unresolved records must be reviewed before closing.</p><div class="rowBtns"><button class="btn btnPrimary" type="submit">Close day using report balances</button></div></form>
<% } else { %><p>No verified open cash shift is available for your account in your operating branch.</p><a class="btn btnPrimary" href="/tenant/cash/shifts" data-transaction-kind="cash_shift_open">Open day</a><% } %>
</div></section></section>
