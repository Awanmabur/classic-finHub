<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="icon" type="image/png" href="/images/classicfinhub-logo.png">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Request tenant setup | ClassicFin Hub</title>
  <meta name="description" content="ClassicFin Hub account access and tenant setup page." />
  <link rel="stylesheet" href="/vendor/inter/inter.css?v=<%= assetVersion %>" />
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= assetVersion %>" />
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>" />
  <meta name="robots" content="noindex,nofollow">
</head>
<body class="legal-body auth-body" id="top">
  <div class="cursor-glow" aria-hidden="true"></div>
  <aside class="side-rail" aria-label="Desktop navigation">
    <a class="rail-logo logo-mark" href="/#home" aria-label="ClassicFin Hub home">
      <img src="/images/classicfinhub-logo.png" alt="ClassicFin Hub logo" />
    </a>
    <nav>
      <a href="/#home"><i class="fa-solid fa-house"></i><span>Home</span></a>
      <a href="/services"><i class="fa-solid fa-table-cells-large"></i><span>Modules</span></a>
      <a href="/#book"><i class="fa-solid fa-calendar-check"></i><span>Book</span></a>
      <a href="/about"><i class="fa-solid fa-building-columns"></i><span>Company</span></a>
      <a href="/pricing"><i class="fa-solid fa-tags"></i><span>Pricing</span></a>
      <a href="/price-compare"><i class="fa-solid fa-scale-balanced"></i><span>Compare</span></a>
      <a href="/support"><i class="fa-solid fa-message"></i><span>Support</span></a>
      <div class="rail-auth">
        <a href="/signin" aria-label="Sign in"><i class="fa-solid fa-right-to-bracket"></i><span>Sign in</span></a>
        <a href="/signup" aria-label="Request setup"><i class="fa-solid fa-user-plus"></i><span>Request setup</span></a>
      </div>
    </nav>
    <button class="rail-theme" id="themeToggle" aria-label="Toggle theme"><i class="fa-solid fa-moon"></i></button>
  </aside>

  <header class="mobile-header">
    <a class="mobile-brand" href="/#home"><span class="mobile-logo"><img src="/images/classicfinhub-logo.png" alt="ClassicFin Hub logo" /></span><strong>ClassicFin Hub</strong></a>
    <div class="mobile-auth-actions"><a href="/signin">Sign in</a><a href="/signup">Request setup</a></div><button class="mobile-menu-btn" id="menuBtn" aria-label="Open menu"><i class="fa-solid fa-bars-staggered"></i></button>
  </header>

  <nav class="mobile-panel" id="mobilePanel" aria-label="Mobile navigation">
    <a href="/#home">Home</a>
    <a href="/services">Modules</a>
    <a href="/#book">Book demo</a>
    <a href="/about">Company</a>
    <a href="/pricing">Pricing</a>
    <a href="/price-compare">Price compare</a>
    <a href="/support">Support</a>
    <a href="/signin">Dashboard sign in</a>
    <a href="/signin">Sign in</a>
    <a href="/signup">Request setup</a>
    <button id="themeToggleMobile"><i class="fa-solid fa-moon"></i> Change theme</button>
  </nav>
  <main class="page auth-main smooth-page">
  <div class="auth-shell float-in">
    <section class="auth-panel">
      <div>
        <a class="rail-logo logo-mark" href="/"><img src="/images/classicfinhub-logo.png" alt="ClassicFin Hub logo" /></a>
        <h1>Request your ClassicFin Hub tenant workspace.</h1>
        <p>Start the appointment-first onboarding flow so Classic Technologies can present the platform, confirm modules, create your tenant, and invite the owner.</p>
      </div>
      <div class="auth-points">
        <div><i class="fa-solid fa-circle-check"></i> Demo appointment first</div><div><i class="fa-solid fa-circle-check"></i> Trial and module planning</div><div><i class="fa-solid fa-circle-check"></i> Tenant owner invite</div>
      </div>
    </section>

    <section class="auth-card">
      <a class="auth-back" href="/#home"><i class="fa-solid fa-arrow-left"></i> Back to website</a>
      <div>
        <p class="kicker">Tenant onboarding</p>
        <h2>Request setup</h2>
        <p class="auth-helper">Tell us about the business, modules, branches, and trial needs. The team will follow up before tenant creation.</p>
        <form autocomplete="off" method="post" action="/signup"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="auth-row"><label><span>Owner name</span><input name="Owner name" type="text" placeholder="Full name" required /></label><label><span>Business name</span><input name="Business name" type="text" placeholder="Business or tenant name" required /></label></div>
          <div class="auth-row"><label><span>Email</span><input name="Email" type="email" placeholder="owner@example.com" required /></label><label><span>Phone</span><input name="Phone" type="tel" placeholder="+211..." required /></label></div>
          <fieldset style="border:0;margin:0;padding:0;min-width:0"><legend>Modules needed (select any)</legend><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:8px;margin-top:8px"><% selectableModules.forEach(m=>{ %><label style="display:flex;align-items:center;gap:8px"><input name="modules" type="checkbox" value="<%= m.key %>" style="width:auto;flex:none;padding:0"><span><%= m.name %></span></label><% }) %></div><small>Leave unselected if unsure.</small></fieldset>
          <label><span>Setup note</span><textarea name="Message" rows="4" placeholder="Branches, users, currencies, trial preference, and expected transaction volume"></textarea></label>
          <button class="btn btn-dark" type="submit">Send setup request</button>
        </form>
        <p class="auth-switch">Already have access? <a href="/signin">Sign in</a></p>
      </div>
    </section>
  </div>
    <footer class="footer reveal">
      <div class="footer-inner">
        <div class="footer-brand">
          <strong>ClassicFin Hub</strong>
          <span>Classic Technologies</span>
          <p>Multi-tenant finance SaaS for money transfer, mobile money, banking, forex, tenant onboarding, pricing, reports, billing, and secure operations.</p>
          <div class="footer-socials">
            <a href="mailto:info@classicfinhub.com" aria-label="Email ClassicFin Hub"><i class="fa-solid fa-envelope"></i></a>
            <a href="https://api.whatsapp.com/send?phone=211921789914" aria-label="WhatsApp ClassicFin Hub"><i class="fa-brands fa-whatsapp"></i></a>
            <a href="tel:211921789914" aria-label="Call ClassicFin Hub"><i class="fa-solid fa-phone"></i></a>
          </div>
        </div>
        <div class="footer-column">
          <h3>Product</h3>
          <a href="/services">Modules</a>
          <a href="/pricing">Pricing</a>
          <a href="/price-compare">Price compare</a>
          <a href="/signin">Dashboard sign in</a>
        </div>
        <div class="footer-column">
          <h3>Solutions</h3>
          <a href="/services#money-transfer">Money transfer</a>
          <a href="/services#mobile-money">Mobile money</a>
          <a href="/services#banking">Banking operation</a>
          <a href="/services#forex">Forex operation</a>
        </div>
        <div class="footer-column">
          <h3>Company</h3>
          <a href="/about">About</a>
          <a href="/support">Support</a>
          <a href="/faq">FAQs</a>
          <a href="/#book">Book demo</a>
        </div>
        <div class="footer-column">
          <h3>Legal & access</h3>
          <a href="/terms">Terms</a>
          <a href="/privacy">Privacy</a>
          <a href="/cookies">Cookies</a>
          <a href="/refund-policy">Refund policy</a>
          <a href="/signin">Sign in</a>
          <a href="/signup">Request setup</a>
        </div>
      </div>
      <div class="footer-note"><p>© <span id="year"></span> ClassicFin Hub by Classic Technologies. All rights reserved.</p><a href="#top">Back to top</a></div>
    </footer>
  </main>
  <script src="/js/script.js?v=<%= assetVersion %>"></script>
</body>
</html>
