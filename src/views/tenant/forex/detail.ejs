<% const viewZone=typeof businessTimeZone==='string'?businessTimeZone:'UTC';
const localWhen=typeof formatLocalDate==='function'?formatLocalDate:
 (value=>new Date(value).toISOString().slice(0,16).replace('T',' ')); %>
<section class="view show"><section class="card"><div class="cardHead"><b>Forex quotation <%= data.quote.reference %></b><span><%= data.quote.status.replaceAll('_',' ') %></span></div><div class="cardBody">
 <% if(data.quote?.originModule==='mobile_money'){ %>
 <section class="card"><div class="cardBody">
  <b>Source: Mobile Money · <%= data.quote.originNetwork %> · <%= data.quote.originOperation==='cash_out'?'Withdrawal':'Deposit' %></b>
  <p class="tiny">This exchange shares the original Mobile Money cash/float posting. External provider settlement is not independently established by manual entry.</p>
  <% if(data.quote.originRecordId&&(user.permissions||[]).some(p=>['*','mobile_money.view'].includes(p))){ %><a class="btn" href="/tenant/mobile-money/<%= data.quote.originRecordId %>">Open original Mobile Money transaction</a><% } %>
 </div></section><% } %>
 <% if(data.quote.status==='posted_manual'){ %><p class="tiny">This completed exchange was posted to the foreign-currency stock and settlement books at the locked rate. Its evidence and posting history remain auditable.</p><% }else{ %><p class="tiny">This quotation has not changed currency stock or settlement balances. Confirm the actual funds movement to finalize the exchange in the book without routine review.</p><% } %>
 <div class="summary"><div class="sumRow"><span>Started from</span><b><%= (data.quote.originModule||'forex').replaceAll('_',' ') %></b></div>
<% if(data.quote.originRecordId&&['banking','money_transfer'].includes(data.quote.originModule)){ %><div class="sumRow"><span>Actual funded source record</span><b><a href="/tenant/<%= data.quote.originModule==='banking'?'banking':'money-transfer' %>/<%= data.quote.originRecordId %>">View originating instruction</a></b></div><% } %><div class="sumRow"><span>Customer label</span><b><%= data.quote.customerLabel %></b></div><div class="sumRow"><span>Source amount</span><b><%= data.amountLabel(data.quote.sourceMinor,data.quote.fromCurrency) %></b></div><div class="sumRow"><span>Quoted target amount</span><b><%= data.amountLabel(data.quote.targetMinor,data.quote.toCurrency) %></b></div><div class="sumRow"><span>Locked rate</span><b><%= data.quote.rateDecimal %> <%= data.quote.toCurrency %> per 1 <%= data.quote.fromCurrency %></b></div><div class="sumRow"><span>Expires Local · <%= viewZone %></span><b><%= localWhen(data.quote.expiresAt,undefined) %></b></div><div class="sumRow"><span>Purpose</span><b><%= data.quote.note %></b></div><div class="sumRow"><span>Independent review</span><b><%= data.quote.reviewNote||'Not yet reviewed' %></b></div></div>
 <div class="summary"><% [['Customer phone',data.quote.capture?.customerPhone],['ID / Passport No.',data.quote.capture?.identityDocument],['Commission / fee (proposed)',(data.quote.capture?.commission||'0')+' '+data.quote.toCurrency],['Settlement method',data.quote.capture?.settlementMethod||'Cash'],['Rate source',data.quote.capture?.rateSource],['External reference',data.quote.capture?.externalReference]].forEach(([label,value])=>{ %><div class="sumRow"><span><%= label %></span><b><%= value||'—' %></b></div><% }) %></div>
 <div class="rowBtns" style="margin-top:12px"><% if(data.pendingMovementId){ %><a class="btn btnPrimary" href="/tenant/funded/<%= data.pendingMovementId %>">Complete pending exchange</a><% } %><% if(data.canRecordManual){ %><a class="btn btnPrimary" href="/tenant/funded/prepare/forex/<%= data.quote._id %>">Finalize actual exchange</a><% } %><% if(data.quote.manualExecutionId){ %><a class="btn btnPrimary" href="/tenant/funded/<%= data.quote.manualExecutionId %>">View posted exchange</a><% } %><a class="btn" href="/tenant/funded">Manual movements &amp; review</a><a href="/tenant/forex/history" class="btn">Quote history</a></div></div></section>
 <% if(data.canReview){ %><form method="post" action="/tenant/forex/<%= data.quote._id %>/review" class="card" style="margin-top:14px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="cardHead"><b>Independent quote decision</b></div><div class="cardBody"><label class="field">Review explanation<textarea name="note" minlength="12" maxlength="400" required class="control" rows="3"></textarea></label><div class="rowBtns"><button class="btn btnPrimary" name="decision" value="approve">Approve pending execution</button><button class="btn" name="decision" value="reject">Reject</button></div></div></form><% } %>
 <% if(data.canCancel){ %><form method="post" action="/tenant/forex/<%= data.quote._id %>/cancel" class="card" style="margin-top:14px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="cardHead"><b>Cancel undecided quote</b></div><div class="cardBody"><label class="field">Reason<textarea name="note" minlength="12" maxlength="400" required class="control" rows="2"></textarea></label><button class="btn" type="submit">Cancel quote</button></div></form><% } %>
</section>
