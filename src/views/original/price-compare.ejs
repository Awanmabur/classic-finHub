<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="icon" type="image/png" href="/images/classicfinhub-logo.png">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ClassicFin Hub price compare | Compare plans and addons</title>
  <meta name="description" content="Compare ClassicFin Hub plans, monthly prices, included modules, users, branches, transaction limits, reports, billing features and addons." />
  <link rel="stylesheet" href="/vendor/inter/inter.css?v=<%= assetVersion %>" />
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= assetVersion %>" />
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="ClassicFin Hub" />
  <meta property="og:title" content="ClassicFin Hub price compare | Compare plans and addons" />
  <meta property="og:description" content="Compare ClassicFin Hub plans, monthly prices, included modules, users, branches, transaction limits, reports, billing features and addons." />
  <meta property="og:image" content="<%= appUrl %>/images/classicfinhub-logo.png" />
  <meta property="og:image:alt" content="ClassicFin Hub logo" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="ClassicFin Hub price compare | Compare plans and addons" />
  <meta name="twitter:description" content="Compare ClassicFin Hub plans, monthly prices, included modules, users, branches, transaction limits, reports, billing features and addons." />
  <meta name="twitter:image" content="<%= appUrl %>/images/classicfinhub-logo.png" />
  <link rel="canonical" href="<%= appUrl %>/price-compare">
  <meta property="og:url" content="<%= appUrl %>/price-compare">
  <script type="application/ld+json" nonce="<%= cspNonce %>"><%- JSON.stringify({
    '@context':'https://schema.org','@type':'BreadcrumbList','itemListElement':[
      {'@type':'ListItem','position':1,'name':'Home','item':appUrl+'/'},
      {'@type':'ListItem','position':2,'name':'Price Compare','item':appUrl+'/price-compare'}
    ]
  }).replace(/</g,'\\u003c') %></script>
</head>
<body class="legal-body" id="top">
  <div class="cursor-glow" aria-hidden="true"></div>
  <aside class="side-rail" aria-label="Desktop navigation">
    <a class="rail-logo logo-mark" href="/#home" aria-label="ClassicFin Hub home">
      <img src="/images/classicfinhub-logo.png?v=<%= assetVersion %>" alt="ClassicFin Hub logo" />
    </a>
    <nav>
      <a href="/#home"><i class="fa-solid fa-house"></i><span>Home</span></a>
      <a href="/services"><i class="fa-solid fa-table-cells-large"></i><span>Modules</span></a>
      <a href="/#book"><i class="fa-solid fa-calendar-check"></i><span>Book</span></a>
      <a href="/about"><i class="fa-solid fa-building-columns"></i><span>Company</span></a>
      <a href="/pricing"><i class="fa-solid fa-tags"></i><span>Pricing</span></a>
      <a href="/price-compare" class="active"><i class="fa-solid fa-scale-balanced"></i><span>Compare</span></a>
      <a href="/support"><i class="fa-solid fa-message"></i><span>Support</span></a>
      <div class="rail-auth">
        <a href="/signin" aria-label="Sign in"><i class="fa-solid fa-right-to-bracket"></i><span>Sign in</span></a>
        <a href="/signup" aria-label="Request setup"><i class="fa-solid fa-user-plus"></i><span>Request setup</span></a>
      </div>
    </nav>
    <button class="rail-theme" id="themeToggle" aria-label="Toggle theme"><i class="fa-solid fa-moon"></i></button>
  </aside>

  <header class="mobile-header">
    <a class="mobile-brand" href="/#home"><span class="mobile-logo"><img src="/images/classicfinhub-logo.png?v=<%= assetVersion %>" alt="ClassicFin Hub logo" /></span><strong>ClassicFin Hub</strong></a>
    <div class="mobile-auth-actions"><a href="/signin">Sign in</a><a href="/signup">Request setup</a></div><button class="mobile-menu-btn" id="menuBtn" aria-label="Open menu"><i class="fa-solid fa-bars-staggered"></i></button>
  </header>

  <nav class="mobile-panel" id="mobilePanel" aria-label="Mobile navigation">
    <a href="/#home">Home</a>
    <a href="/services">Modules</a>
    <a href="/#book">Book demo</a>
    <a href="/about">Company</a>
    <a href="/pricing">Pricing</a>
    <a href="/price-compare">Price compare</a>
    <a href="/support">Support</a>
    <a href="/signin">Sign in</a>
    <a href="/signup">Request setup</a>
    <button id="themeToggleMobile"><i class="fa-solid fa-moon"></i> Change theme</button>
  </nav>

  <main class="page legal-shell smooth-page">
    <header class="legal-hero pricing-hero reveal">
      <p class="kicker">Price compare</p>
      <h1>Compare ClassicFin Hub prices, modules, and limits.</h1>
      <p>Use this page to choose the right plan before requesting setup. Pricing is shown clearly in USD, with practical limits and addons for growing finance operations.</p>
      <div class="hero-actions">
        <a class="btn btn-dark" href="/signup">Request setup</a>
        <a class="btn btn-light" href="/pricing">Back to pricing</a>
        <a class="btn btn-light" href="/#book">Book demo</a>
      </div>
    </header>

    <% if(!plans.length){ %><section class="compare-cards reveal"><article><h2><%= typeof catalogueUnavailable!=='undefined'&&catalogueUnavailable?'Published pricing is temporarily unavailable':'No plans currently published' %></h2><p>Contact the team for current subscription options.</p><a class="btn btn-light" href="/signup">Request plan details</a></article></section><% } else { %>
    <section class="compare-shell reveal">
      <div class="compare-table-wrap" role="region" aria-label="Plan prices and included capacity" tabindex="0">
        <table class="compare-table">
          <thead><tr><th scope="col">Feature</th><% plans.forEach(plan=>{ %><th scope="col" data-plan-code="<%= plan.code %>"><%= plan.name %><br><span><%= plan.currency %> $<%= Number(plan.priceMonthly).toFixed(2) %> / month</span></th><% }) %></tr></thead>
          <tbody>
            <tr><th scope="row">Entry mode</th><% plans.forEach(plan=>{ %><td><%= plan.entryMode==='sms_assisted'?'SMS-assisted + manual':'Manual entry' %></td><% }) %></tr>
            <tr><th scope="row">Yearly price</th><% plans.forEach(plan=>{ %><td><%= plan.currency %> $<%= Number(plan.priceYearly).toFixed(2) %></td><% }) %></tr>
            <tr><th scope="row">Included modules</th><% plans.forEach(plan=>{ %><td><%= (plan.moduleLabels||plan.modules.map(key=>key.replaceAll('_',' '))).join(', ')||'Workspace only' %></td><% }) %></tr>
            <tr><th scope="row">Branches included</th><% plans.forEach(plan=>{ %><td><%= plan.limits.branches.toLocaleString('en-US') %></td><% }) %></tr>
            <tr><th scope="row">Users included</th><% plans.forEach(plan=>{ %><td><%= plan.limits.users.toLocaleString('en-US') %></td><% }) %></tr>
            <tr><th scope="row">Monthly record limit</th><% plans.forEach(plan=>{ %><td><%= plan.limits.transactionsPerMonth.toLocaleString('en-US') %></td><% }) %></tr>
            <tr><th scope="row">Monthly SMS imports</th><% plans.forEach(plan=>{ %><td><%= plan.entryMode==='sms_assisted'?plan.limits.smsPerMonth.toLocaleString('en-US'):'Not included' %></td><% }) %></tr>
            <tr><th scope="row">Manual entry</th><% plans.forEach(plan=>{ %><td>Included</td><% }) %></tr>
            <tr><th scope="row">Trial</th><% plans.forEach(plan=>{ %><td><%= plan.trialMonths?plan.trialMonths+' month'+(plan.trialMonths===1?'':'s'):'No trial' %></td><% }) %></tr>
            <tr><th scope="row">Storage allowance</th><% plans.forEach(plan=>{ %><td><%= plan.limits.storageMb.toLocaleString('en-US') %> MB</td><% }) %></tr>
          </tbody>
        </table>
      </div>
    </section>
    <% } %>
    <section class="compare-cards reveal">
      <article><span>Manual entry</span><h2>Staff-controlled recording</h2><p>Enter records using the services included in your plan. Staff and branch permissions continue to control access.</p><a class="btn btn-light" href="/pricing">Review plans</a></article>
      <article><span>Premium automation</span><h2>SMS-assisted + manual</h2><p>Receive messages through a registered SMS relay, then capture supported confirmations with traceable source evidence. Manual recording stays available.</p><a class="btn btn-dark" href="/signup">Discuss SMS setup</a></article>
      <article><span>Published terms</span><h2>Clear capacity and pricing</h2><p>Compare current module access, seats, branch capacity and import allowances. SMS-assisted prices are higher than the matching manual plan.</p><a class="btn btn-light" href="/#book">Book a demo</a></article>
    </section>

    <section class="final-cta reveal">
      <div>
        <p class="kicker">Final step</p>
        <h2>Pick a plan, then configure the tenant.</h2>
        <p>Choose published module access, staff and branch capacity, and manual or SMS-assisted entry before requesting setup.</p>
      </div>
      <a class="btn btn-dark" href="/#book">Book setup demo</a>
    </section>

    <footer class="footer reveal">
      <div class="footer-inner">
        <div class="footer-brand">
          <strong>ClassicFin Hub</strong>
          <span>Classic Technologies</span>
          <p>Multi-tenant finance SaaS for money transfer, mobile money, banking, forex, tenant onboarding, pricing, reports, billing, and secure operations.</p>
          <div class="footer-socials">
            <a href="mailto:info@classicfinhub.com" aria-label="Email ClassicFin Hub"><i class="fa-solid fa-envelope"></i></a>
            <a href="https://api.whatsapp.com/send?phone=211921789914" aria-label="WhatsApp ClassicFin Hub"><i class="fa-brands fa-whatsapp"></i></a>
            <a href="tel:211921789914" aria-label="Call ClassicFin Hub"><i class="fa-solid fa-phone"></i></a>
          </div>
        </div>
        <div class="footer-column">
          <h3>Product</h3>
          <a href="/services">Modules</a>
          <a href="/pricing">Pricing</a>
          <a href="/price-compare">Price compare</a>
          <a href="/signin">Dashboard sign in</a>
        </div>
        <div class="footer-column">
          <h3>Solutions</h3>
          <a href="/services#money-transfer">Money transfer</a>
          <a href="/services#mobile-money">Mobile money</a>
          <a href="/services#banking">Banking operation</a>
          <a href="/services#forex">Forex operation</a>
        </div>
        <div class="footer-column">
          <h3>Company</h3>
          <a href="/about">About</a>
          <a href="/support">Support</a>
          <a href="/faq">FAQs</a>
          <a href="/#book">Book demo</a>
        </div>
        <div class="footer-column">
          <h3>Legal & access</h3>
          <a href="/product-guide">Product guide</a><a href="/terms">Terms</a>
          <a href="/privacy">Privacy</a>
          <a href="/cookies">Cookies</a>
          <a href="/refund-policy">Refund policy</a>
          <a href="/signin">Sign in</a>
          <a href="/signup">Request setup</a>
        </div>
      </div>
      <div class="footer-note"><p>© <span id="year"></span> ClassicFin Hub by Classic Technologies. All rights reserved.</p><a href="#top">Back to top</a></div>
    </footer>
  </main>

  <script src="/js/script.js?v=<%= assetVersion %>"></script>
</body>
</html>
