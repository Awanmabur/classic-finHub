<section class="view show"><section class="card"><div class="cardHead"><b>Banking request history</b><span>Records are not bank statements</span></div><div class="cardBody"><form method="get" action="/tenant/banking/history" class="rowBtns"><label class="field">Status<select name="status" class="control"><option value="">All</option><% ['requested','approved_pending_bank','rejected','cancelled','expired'].forEach(s=>{ %><option value="<%= s %>" <%= data.status===s?'selected':'' %>><%= s.replaceAll('_',' ') %></option><% }) %></select></label><button class="btn" type="submit">Filter</button></form></div>
<div class="cardBody tableWrap"><table><thead><tr><th>Reference</th><th>Operation</th><th>Amount</th><th>Status</th><th>Date (UTC)</th></tr></thead><tbody><% data.records.items.forEach(t=>{ %><tr data-search-row><td><a href="/tenant/banking/<%= t._id %>"><%= t.reference %></a></td><td><%= t.kind.replaceAll('_',' ') %></td><td><%= data.formatMoneyMinor(t.amountMinor,t.currency) %></td><td><%= t.status.replaceAll('_',' ') %></td><td><%= new Date(t.createdAt).toISOString().slice(0,16).replace('T',' ') %></td></tr><% }) %></tbody></table><% if(!data.records.items.length){ %><p class="tiny">No matching requests.</p><% } %></div>
<% if(data.records.nextCursor){ %><div class="cardBody"><a class="btn" href="/tenant/banking/history?status=<%= encodeURIComponent(data.status) %>&cursor=<%= encodeURIComponent(data.records.nextCursor) %>">Older requests</a></div><% } %>
</section><div class="rowBtns" style="margin-top:12px"><a class="btn" href="/tenant/banking">Banking dashboard</a></div></section>
