<% if(data.canObserve){ %>
<details class="card workspaceSecondary" id="add-funds" <%= data.fundingDestination?'open':'' %>><summary>Transfer existing funds</summary><form class="cardBody" method="post" action="/tenant/treasury/funding" data-wallet-funding-form>
 <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= data.fundingIdempotencyKey %>">
 <div class="formSection"><div class="formSectionTitle">Internal transfer</div><div class="row2">
  <label class="field">From account<select class="control" name="sourceAccountId" required><option value="">Select funding source</option><% data.fundingAccounts.forEach(account=>{ %><option value="<%= account._id %>" data-branch-id="<%= account.branchId %>" data-currency="<%= account.currency %>" data-operator-id="<%= account.operatorId||'' %>"><% if(data.allBranches&&data.branchNames[String(account.branchId)]){ %><%= data.branchNames[String(account.branchId)] %> · <% } %><%= account.name %> · <%= data.format(account.bookBalanceMinor,account.currency) %></option><% }) %></select></label>
  <label class="field">To wallet / account<select class="control" name="destinationAccountId" required><option value="">Select destination</option><% data.fundingAccounts.forEach(account=>{ %><option value="<%= account._id %>" data-branch-id="<%= account.branchId %>" data-currency="<%= account.currency %>" data-operator-id="<%= account.operatorId||'' %>" <%= data.fundingDestination===String(account._id)?'selected':'' %>><% if(data.allBranches&&data.branchNames[String(account.branchId)]){ %><%= data.branchNames[String(account.branchId)] %> · <% } %><%= account.name %> · <%= account.currency==='KES'?'KSH':account.currency %></option><% }) %></select></label>
  <label class="field">Amount<input class="control" name="amount" inputmode="decimal" required placeholder="0" pattern="[0-9]+([.][0-9]{1,2})?"></label>
 </div></div>
 <p class="tiny"><%= user.role==='Tenant Owner'?'Funding follows the branch of the selected accounts.':'Funding uses your assigned operating branch.' %> Both accounts must already contain reconciled, verified balances in the same branch and currency. The transfer posts instantly as a balanced movement and cannot create new money.</p>
 <% if(data.fundingAccounts.length<2){ %><p class="tiny">Set up two existing funded accounts with validated opening positions first. A cash source also needs an open drawer.</p><% } %>
 <p class="tiny" data-funding-choices-status role="status" aria-live="polite"></p>
 <div class="rowBtns"><button type="submit" class="btn btnPrimary" data-funding-submit <%= data.fundingAccounts.length<2?'disabled':'' %>>Transfer funds now</button></div>
</form></details>
<% } %>
