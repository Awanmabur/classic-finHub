<% const availableRates=data.rates.filter(r=>r.status==='active'&&String(r.branchId)===currentBranchId&&new Date(r.expiresAt).getTime()>Date.now()+5*60000);
   const firstRate=availableRates[0], operation=data.workspaceOperation==='sell'?'sell':'buy', labels=['USD','SSP','KES','UGX',...(availableRates.some(rate=>rate.fromCurrency==='EUR'||rate.toCurrency==='EUR')?['EUR']:[])]; %>
<div class="formSection"><div class="formSectionTitle">Customer and operation</div>
 <div class="row2"><label class="field">Operation<input class="control" value="<%= operation==='buy'?'Buy forex from customer':'Sell forex to customer' %>" readonly></label><label class="field">Customer name<input name="customerLabel" class="control" minlength="2" maxlength="120" placeholder="Customer full name" required></label></div>
 <div class="row2"><label class="field">Customer phone<input class="control" name="customerPhone" type="tel" required maxlength="16" placeholder="+256..."></label><label class="field">ID / Passport No.<input class="control" name="identityDocument" maxlength="80" placeholder="Optional verification document"></label></div>
</div>
<div class="formSection"><div class="formSectionTitle">Currency exchange details</div>
 <div class="row2"><label class="field">Foreign currency<select class="control" data-forex-currency="from" aria-label="Foreign currency"><% labels.forEach(code=>{ %><option value="<%= code %>" <%= firstRate?.fromCurrency===code?'selected':'' %>><%= code==='KES'?'KSH':code %></option><% }) %></select></label><label class="field">Settlement currency<select class="control" data-forex-currency="to" aria-label="Settlement currency"><% ['UGX','USD','SSP','KES',...(labels.includes('EUR')?['EUR']:[])].forEach(code=>{ %><option value="<%= code %>" <%= firstRate?.toCurrency===code?'selected':'' %>><%= code==='KES'?'KSH':code %></option><% }) %></select></label></div>
 <div class="row2"><label class="field">Foreign amount<input name="amount" class="control" inputmode="decimal" required placeholder="0"></label><label class="field">Exchange rate<select name="rateId" class="control approvedRatePicker" required aria-describedby="approvedRateHelp"><% if(!availableRates.length){ %><option value="">No approved rate</option><% }else{ %><option value="">Select active rate</option><% availableRates.forEach((r,index)=>{ %><option value="<%= r._id %>" data-from="<%= r.fromCurrency %>" data-to="<%= r.toCurrency %>" data-rate="<%= r.rateDecimal %>" <%= index===0?'selected':'' %>><%= r.rateDecimal %></option><% }) %><% } %></select></label></div>
 <div class="row2"><label class="field">Commission / fee<input class="control" name="commission" inputmode="decimal" value="0" placeholder="0" pattern="[0-9]+([.][0-9]{1,2})?"></label><label class="field">Settlement method<select class="control" name="settlementMethod"><% ['Cash','Bank settlement','Mobile money','Wallet balance'].forEach(method=>{ %><option><%= method %></option><% }) %></select></label></div>
</div>
<div class="formSection"><div class="formSectionTitle">Reference and notes</div>
 <div class="row2"><label class="field">Rate source<input class="control" name="rateSource" maxlength="120" value="Internal rate board" placeholder="Internal rate board / market quote"></label><label class="field">External reference<input class="control" name="externalReference" maxlength="120" placeholder="Slip, receipt, or optional ref"></label></div>
 <label class="field">Note / narration<input name="note" class="control" minlength="12" maxlength="400" required placeholder="Optional teller note"></label>
</div>
<div class="summary"><div class="sumRow"><span><%= operation==='sell'?'Customer pays':'Customer receives' %></span><b data-forex-total>—</b></div><div class="sumRow"><span>Drawer effect</span><b>Pending reviewed execution</b></div><div class="sumRow"><span>Reference</span><b class="mono"><%= data.idempotencyKey %></b></div></div>
<details class="logicNote"><summary>Approved rate and validity</summary><p id="approvedRateHelp">The selected exchange rate comes from your independently approved branch rate board.</p><label class="field">Quote validity<select name="validMinutes" class="control" required><% for(let mins=5;mins<=60;mins++){ %><option value="<%= mins %>" <%= mins===15?'selected':'' %>><%= mins %> minutes</option><% } %></select></label></details>
<button type="submit" class="btn btnPrimary" <%= availableRates.length?'':'disabled' %>>Post forex operation</button>
<% if(!availableRates.length){ %><p class="logicNote">Obtain approval for a rate valid beyond the quotation window first.</p><% } %>
