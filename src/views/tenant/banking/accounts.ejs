<% const currentBranch = typeof operationBranch !== 'undefined' ? operationBranch : (data.branches || []).find(b => String(b._id) === String(user.transactionBranchId || user.branchId || data.selectedBranchId || '') && b.status !== 'archived');
   const currentBranchId = currentBranch ? String(currentBranch._id) : null;
   const branchProblem = typeof operationBranchError === 'string' && operationBranchError ? operationBranchError : 'An active operating branch must be assigned to your account before creating records.'; %>
<section class="view show">
 <%- include('../../partials/operation-branch', {currentBranch, branchProblem, user}) %><section class="card"><div class="cardHead"><b>Masked account reference directory</b><span>Not bank-issued accounts or balances</span></div><div class="cardBody"><p class="tiny">Only the last four account characters are stored. Full bank account identifiers, passwords and balance figures must not be entered here. These records are not independently bank-verified.</p>

 </div></section>
 <% if(data.canManage && currentBranchId){ %><form class="card" method="post" action="/tenant/banking/accounts" autocomplete="off" style="margin-top:14px"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
 <div class="cardHead"><b>Add masked account reference</b></div><div class="cardBody"><div class="row2"><label class="field">Customer name<input name="customerName" class="control" required minlength="2" maxlength="120"></label><label class="field">Bank / institution<select name="institutionChoice" class="control" required><option value="__new__">Add a new institution</option><% (data.institutions||[]).forEach(name=>{ %><option value="<%= name %>"><%= name %></option><% }) %></select></label></div>
 <label class="field">New institution name (only if adding new)<input name="institutionName" class="control" minlength="2" maxlength="120" placeholder="Enter once, then select it next time"></label>
 <div class="row2"><label class="field">Last 4 characters only<input name="last4" class="control" minlength="4" maxlength="4" required pattern="[A-Za-z0-9]{4}" placeholder="1234"></label><label class="field">Currency<select class="control" name="currency" required><% (data.currencyChoices||(typeof currencyOptions==='undefined'?[]:currencyOptions).filter(option=>!currentBranch.currencies||currentBranch.currencies.includes(option.code))).forEach(option=>{ %><option value="<%= option.code %>" <%= option.code===(data.selectedCurrency||currentBranch.currency)?'selected':'' %>><%= option.label %></option><% }) %></select></label></div><button class="btn btnPrimary" type="submit">Save masked reference</button></div></form><% } %>
 <section class="card" style="margin-top:14px"><div class="cardHead"><b>Active references</b><span><%= data.references.length %> listed</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Customer</th><th>Institution</th><th>Reference</th><th>Currency</th><th>Actions</th></tr></thead><tbody><% data.references.forEach(a=>{ %><tr data-search-row><td><%= a.customerName %></td><td><%= a.institutionName %></td><td>****<%= a.last4 %></td><td><%= a.currency %></td><td><% if(data.canManage){ %><a class="btn" href="/tenant/banking/accounts/<%= a._id %>/edit">Edit</a><form method="post" action="/tenant/banking/accounts/<%= a._id %>/archive" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Archive</button></form><% } else { %>Read only<% } %></td></tr><% }) %></tbody></table><% if(!data.references.length){ %><p class="tiny">No active account references for this branch.</p><% } %></div></section>
 <div class="rowBtns" style="margin-top:12px"><a class="btn" href="/tenant/banking">Banking requests</a></div>
</section>
