<section class="hero"><div class="hero-copy reveal"><p class="kicker">Tenant landing page</p><h1><%= data.tenant.name %></h1><p class="lead">A branded tenant landing page for the tenant. Customer self-service and receipts are planned features, not yet enabled.</p><div class="hero-actions"><a href="/signin" class="btn btn-dark">Tenant login</a><a href="/signup" class="btn btn-light">Request information</a></div></div><div class="hero-dashboard reveal"><div class="money-card"><div><span>Enabled modules</span><h2><%= data.tenant.enabledModules.length %></h2></div><i class="fa-solid fa-layer-group"></i></div><div class="dash-list"><% data.tenant.enabledModules.forEach(m => { %><div><i class="fa-solid fa-check"></i><span><%= m %></span><b>Included</b></div><% }) %></div></div></section>
