<section class="view show">
  <div class="rowBtns" style="margin-bottom:14px"><a class="btn btnPrimary" href="/platform/plans/new"><i class="fa-solid fa-plus" aria-hidden="true"></i> Create plan</a></div>
  <p class="tiny">Create a manual-entry plan or a higher-priced SMS-assisted plan. Published versions preserve the terms already assigned to tenants.</p>
  <% if(!data.published.length){ %><section class="card" style="margin-bottom:14px"><div class="cardHead"><b>Standard plans</b><span>Optional starting catalogue</span></div><div class="cardBody"><p>Create your own plan above, or publish the standard plans as a starting point.</p><form method="post" action="/platform/plans/publish-initial"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Set up plans and continue</button></form></div></section><% } %>
  <section class="card"><div class="cardHead"><b>Published plans</b><span>Latest configuration per plan</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Plan</th><th>Entry mode</th><th>Monthly</th><th>Yearly</th><th>Staff / branches</th><th>Availability</th><th></th></tr></thead><tbody>
    <% (data.latest||[]).forEach(plan=>{ %><tr data-search-row><td><b><%= plan.name %></b><br><span class="tiny"><%= plan.code %> · v<%= plan.version %></span></td><td><%= plan.entryMode==='sms_assisted'?'SMS-assisted + manual':'Manual entry' %></td><td><%= plan.currency %> <%= (plan.priceMonthlyMinor/100).toFixed(2) %></td><td><%= plan.currency %> <%= (plan.priceYearlyMinor/100).toFixed(2) %></td><td><%= plan.limits.users %> / <%= plan.limits.branches %></td><td><%= plan.availableForNewTenants===false?'Existing subscribers only':'Available' %></td><td><a class="btn" href="/platform/plans/<%= encodeURIComponent(plan.code) %>/edit">Edit next version</a></td></tr><% }) %>
    <% if(!(data.latest||[]).length){ %><tr><td colspan="7">No published plans yet. Create a plan and publish its saved draft.</td></tr><% } %>
  </tbody></table></div></section>
  <% const changedDrafts=(data.drafts||[]).filter(draft=>draft.revision!==draft.publishedDraftRevision);if(changedDrafts.length){ %><section class="card" style="margin-top:18px"><div class="cardHead"><b>Unpublished drafts</b><span>Drafts do not grant tenant access</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Plan</th><th>Revision</th><th>Based on</th><th>Updated</th><th></th></tr></thead><tbody><% changedDrafts.forEach(draft=>{ %><tr data-search-row><td><%= draft.terms.name %><br><span class="tiny"><%= draft.code %></span></td><td><%= draft.revision %></td><td><%= draft.baseVersion?'Published v'+draft.baseVersion:'New plan' %></td><td><%= new Date(draft.updatedAt).toISOString().slice(0,10) %></td><td><a class="btn" href="/platform/plans/<%= encodeURIComponent(draft.code) %>/edit">Continue editing</a></td></tr><% }) %></tbody></table></div></section><% } %>
  <% if(data.published.length){ %><details class="card" style="margin-top:18px"><summary class="cardHead">Published version history</summary><div class="cardBody tableWrap"><table><thead><tr><th>Plan</th><th>Version</th><th>Monthly</th><th>Yearly</th><th>Published</th></tr></thead><tbody><% data.published.forEach(plan=>{ %><tr><td><%= plan.name %></td><td>v<%= plan.version %></td><td><%= plan.currency %> <%= (plan.priceMonthlyMinor/100).toFixed(2) %></td><td><%= plan.currency %> <%= (plan.priceYearlyMinor/100).toFixed(2) %></td><td><%= new Date(plan.publishedAt).toISOString().slice(0,10) %></td></tr><% }) %></tbody></table></div></details><% } %>
</section>
