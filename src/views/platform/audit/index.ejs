<section class="view show"><section class="card"><div class="cardHead"><b>Platform audit trail</b><span>Latest 100 administrative events</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Date (UTC)</th><th>Actor</th><th>Action</th><th>Module</th><th>Record ID</th></tr></thead><tbody><% if(!data.auditLogs.length){ %><tr><td colspan="5">No recorded platform administration events.</td></tr><% } %><% data.auditLogs.forEach(a=>{ %><tr data-search-row><td><%= a.createdAt?new Date(a.createdAt).toISOString():'—' %></td><td><%= a.actorName||a.actorId||'System' %></td><td><%= a.action %></td><td><%= a.moduleKey||'—' %></td><td><%= a.recordId||'—' %></td></tr><% }) %></tbody></table></div><p class="tiny">Audit records use the platform database. Protect retention, database administration, backups and external log forwarding separately.</p></section></section>