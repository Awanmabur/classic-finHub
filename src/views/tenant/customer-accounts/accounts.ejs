<section class="view show"><div class="rowBtns"><a class="btn" href="/tenant/accounts">Accounts directory</a><a class="btn" href="/tenant/accounts/balances">Account balances</a><a class="btn" href="/tenant/accounts/movements">Account movements</a></div>
 <section class="card" style="margin-top:14px"><div class="cardHead"><div><b><%= data.mode==='balances'?'Account balances':'Accounts directory' %></b><br><span><%= data.mode==='balances'?'Internal ledger balances by currency':'Account numbers, owners, balances, and overdraft readiness' %></span></div><div class="rowBtns"><% if(data.canManageAccount){ %><a class="btn" href="/tenant/accounts/new" data-directory-open>New account</a><% }if(data.canBank){ %><a class="btn btnPrimary" href="/tenant/banking">New account operation</a><% } %></div></div>
 <div class="cardBody"><div class="grid3"><div class="stat"><div class="k">Accounts</div><div class="v"><%= data.records.total %></div><div class="s"><span class="dot"></span><span>Directory size</span></div></div><div class="stat"><div class="k">Account balances</div><div class="v">UGX / USD / SSP / KSH</div><div class="s"><span class="dot"></span><span>Verified ledger postings</span></div></div><div class="stat"><div class="k">Overdraft</div><div class="v">Unavailable</div><div class="s"><span class="dot warn"></span><span>No credit facility enabled</span></div></div></div>
 <p class="tiny">These are internal book balances from ledger journals. Unverified requests do not change a balance. Each account uses its branch currency; KSH is stored using the canonical KES currency.</p>
 <form method="get" action="<%= data.mode==='balances'?'/tenant/accounts/balances':'/tenant/accounts' %>" class="rowBtns"><label class="field">Search accounts<input class="control" type="search" name="q" value="<%= data.records.q %>" maxlength="100" placeholder="Account number"></label><button class="btn">Search</button></form>
 <div class="tableWrap"><table><thead><tr><th>Account</th><th>Customer</th><th>Phone</th><th>Customer Ref</th><th>UGX</th><th>USD</th><th>SSP</th><th>KSH</th><th>Overdraft</th></tr></thead><tbody><% if(!data.records.items.length){ %><tr><td colspan="9">No accounts match your permitted branch and search.</td></tr><% }data.records.items.forEach(a=>{ %><tr data-search-row><td><a href="/tenant/accounts/<%= a._id %>"><b><%= a.accountNumber %></b></a><br><span class="tiny"><%= a.type %> · <%= a.status %></span></td><td><%= a.customer?.name||'Customer unavailable' %></td><td><%= a.customer?.phone||'—' %></td><td class="mono"><%= a.customer?.reference||'—' %></td><td><%= a.currency==='UGX'?data.formatMinor(a.balance?.minor,'UGX'):'—' %></td><td><%= a.currency==='USD'?data.formatMinor(a.balance?.minor,'USD'):'—' %></td><td><%= a.currency==='SSP'?data.formatMinor(a.balance?.minor,'SSP'):'—' %></td><td><%= a.currency==='KES'?data.formatMinor(a.balance?.minor,'KES'):'—' %></td><td>Unavailable</td></tr><% }) %></tbody></table></div>
 <% if(data.records.nextCursor){ %><a class="btn" href="<%= data.mode==='balances'?'/tenant/accounts/balances':'/tenant/accounts' %>?q=<%= encodeURIComponent(data.records.q) %>&amp;cursor=<%= encodeURIComponent(data.records.nextCursor) %>">Next accounts</a><% } %></div></section>
 <section class="card" style="margin-top:14px"><div class="cardHead"><div><b>Account movements</b><br><span>Deposits, withdrawals, and transfers</span></div></div><div class="cardBody"><p class="tiny">View posted journals linked to these customer accounts.</p><a class="btn" href="/tenant/accounts/movements">Open account movements</a></div></section>
 <% if(data.canManageAccount){ %><%- include('modal',{data,user}) %><% } %>
</section>
