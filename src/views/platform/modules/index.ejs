<section class="view show"><div class="grid3"><% data.modules.slice(0,4).forEach(m=>{ %><div class="stat"><div class="k"><%= m.category %></div><div class="v"><%= m.name %></div><div class="s"><span class="dot"></span><%= m.runtimeStatus %></div></div><% }) %></div>
<section class="card" style="margin-top:14px"><div class="cardHead"><b>Module registry</b><span>Read-only catalogue — activation requires a plan/version change</span></div><div class="cardBody tableWrap"><table class="denseDirectory"><thead><tr><th>Module</th><th>Category</th><th>Indicative price</th><th>Permissions</th><th>Runtime</th></tr></thead><tbody><% data.modules.forEach(m=>{ %><tr data-search-row><td><div class="dataCellLine" title="<%= m.name %> — <%= m.description %>"><b><%= m.name %></b><span class="tiny"><%= m.description %></span></div></td><td><%= m.category %></td><td>USD <%= m.priceMonthly %>/mo</td><td><%= m.permissions.join(', ') %></td><td><span class="tag"><%= m.runtimeStatus %></span></td></tr><% }) %></tbody></table></div></section></section>
