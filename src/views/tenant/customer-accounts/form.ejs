<% const editing=!!data.formRecord, r=data.formRecord||{}, kind=data.formKind, customer=kind==='customer', action=customer?(editing?'/tenant/customers/'+r._id+'/update':'/tenant/customers'):(editing?'/tenant/accounts/'+r._id+'/update':'/tenant/accounts'), val=k=>r[k]||''; %>
<form class="svc" id="directoryForm" method="post" action="<%= action %>" autocomplete="off">
 <input type="hidden" name="_csrf" value="<%= csrfToken %>">
 <% if(editing){ %><input type="hidden" name="revision" value="<%= r.revision %>"><% }else{ %><input type="hidden" name="idempotencyKey" value="<%= data.idempotencyKey %>"><% } %>
 <% if(customer){ %>
 <div class="formSection"><div class="formSectionTitle">Customer identity</div>
  <div class="row2"><label class="field">Full name<input class="control" name="name" value="<%= val('name') %>" placeholder="Customer full name" minlength="2" maxlength="120" required></label><label class="field">Phone<input class="control" name="phone" value="<%= val('phone') %>" placeholder="+256..." type="tel" maxlength="40" required></label></div>
  <div class="row2"><label class="field">Email<input class="control" name="email" value="<%= val('email') %>" placeholder="Optional email" type="email" maxlength="254"></label><label class="field">ID / Passport No.<input class="control" name="identityNumber" value="<%= val('identityNumber') %>" placeholder="National ID or passport" maxlength="60"></label></div>
  <div class="row2"><label class="field">Customer type<select class="control" name="type"><% ['Individual','Business','Agent'].forEach(type=>{ %><option <%= r.type===type?'selected':'' %>><%= type %></option><% }) %></select></label><label class="field">Customer reference<input class="control" name="reference" value="<%= val('reference') %>" placeholder="Auto-generated if empty" maxlength="32" <%= editing?'readonly':'' %>></label></div>
 </div>
 <div class="formSection"><div class="formSectionTitle">Next of kin / emergency contact</div><div class="row3">
  <label class="field">Next of kin name<input class="control" name="nextOfKinName" value="<%= val('nextOfKinName') %>" placeholder="Full name" maxlength="120"></label><label class="field">Next of kin phone<input class="control" name="nextOfKinPhone" value="<%= val('nextOfKinPhone') %>" placeholder="+256..." type="tel" maxlength="40"></label><label class="field">Relationship<input class="control" name="relationship" value="<%= val('relationship') %>" placeholder="Parent, spouse, sibling..." maxlength="60"></label>
 </div></div>
 <div class="formSection"><div class="formSectionTitle">Address and notes</div><div class="row2"><label class="field">Country<input class="control" name="country" value="<%= val('country') %>" placeholder="Country" maxlength="80"></label><label class="field">City / area<input class="control" name="city" value="<%= val('city') %>" placeholder="City or area" maxlength="100"></label></div><label class="field">Address / notes<input class="control" name="note" placeholder="Optional address or note" maxlength="500" value="<%= val('note') %>"></label></div>
 <% }else{ %>
 <div class="formSection">
  <% if(editing){ %>
   <p><b><%= r.customer?.name||'Customer unavailable' %></b> · <%= r.currency==='KES'?'KSH':r.currency %></p>
  <% }else{ %>
   <label class="field">Find a customer
    <input class="control" type="search" data-customer-lookup placeholder="Name, phone, or customer reference" maxlength="100">
   </label>
   <label class="field">Customer
    <select class="control" name="customerId" data-customer-choices required>
     <option value="">Select customer</option>
     <% (data.customerChoices||[]).forEach(c=>{ %><option value="<%= c._id %>"><%= c.name %> · <%= c.phone %> · <%= c.reference %></option><% }) %>
    </select>
   </label>
   <p class="tiny" data-customer-search-status aria-live="polite"></p>
  <% } %>
  <div class="row2">
   <label class="field">Account number
    <input class="control" name="accountNumber" value="<%= val('accountNumber') %>" placeholder="Auto-generated if empty" maxlength="32"<% if(editing){ %> required<%= data.canCorrectNumber?'':' readonly' %><% } %>>
    <% if(editing&&!data.canCorrectNumber){ %><span class="tiny">Already used on financial records.</span><% } %>
   </label>
   <label class="field">Account type
    <select class="control" name="type">
     <% ['Current Account','Savings Account','Agent Account','Business Account'].forEach(type=>{ %><option <%= r.type===type?'selected':'' %>><%= type %></option><% }) %>
    </select>
   </label>
   <% if(!editing){ %>
    <label class="field">Currency
     <select class="control" name="currency" required>
      <% (data.currencyChoices||[]).forEach(option=>{ %><option value="<%= option.code %>" <%= option.code===data.selectedCurrency?'selected':'' %>><%= option.label %></option><% }) %>
     </select>
    </label>
   <% }else{ %>
    <label class="field">Status
     <select class="control" name="status">
      <% ['active','pending','suspended','closed'].forEach(status=>{ %><option value="<%= status %>" <%= r.status===status?'selected':'' %>><%= status[0].toUpperCase()+status.slice(1) %></option><% }) %>
     </select>
    </label>
   <% } %>
  </div>
  <% if(!editing){ %><p class="tiny">The balance starts at zero. Record a deposit after creating the account.</p><% } %>
 </div>
 <details class="logicNote">
  <summary>Additional account details</summary>
  <div class="row2">
   <label class="field">Account officer<input class="control" name="officer" value="<%= editing?val('officer'):user.name %>" maxlength="120"></label>
   <label class="field">Purpose / source of funds<input class="control" name="purpose" value="<%= val('purpose') %>" maxlength="240"></label>
   <label class="field">KYC risk level<select class="control" name="risk"><% ['Low','Medium','High'].forEach(risk=>{ %><option <%= r.risk===risk?'selected':'' %>><%= risk %></option><% }) %></select></label>
  </div>
 </details>
 <% } %>
 <div data-directory-submit><button type="submit" class="btn btnPrimary"><%= editing?(customer?'Save customer':'Save account'):(customer?'Create customer':'Create account') %></button></div>
</form>
