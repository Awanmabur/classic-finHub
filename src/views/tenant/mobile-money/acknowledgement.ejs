<% const receiptZone=typeof businessTimeZone==='string'?businessTimeZone:'UTC';
 const receiptTime=typeof formatLocalDate==='function'?formatLocalDate:(v=>new Date(v).toISOString()); %>
<!doctype html><html lang="en"><head>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Operational acknowledgement — ClassicFin Hub</title>
<link rel="stylesheet" href="/css/acknowledgement.css"><link rel="stylesheet" href="/css/feedback.css?v=<%= typeof assetVersion==='undefined'?'1':assetVersion %>"></head><body>
<main class="receipt"><%- include('../../partials/flash', {flash:typeof flash==='undefined'?null:flash}) %><header><img class="platformMark" src="/images/classicfinhub-mark.png" width="52" height="52" alt="ClassicFin Hub platform logo" decoding="async"><h1><%= typeof identity!=='undefined'&&identity?.name?identity.name:'ClassicFin Hub' %></h1><p>Internal operational acknowledgement</p><% if(typeof identity!=='undefined'&&identity){ %><p><%= identity.prefix %> · <%= identity.template %><% if(identity.supportPhone){ %> · <%= identity.supportPhone %><% } %></p><% } %></header>
<div class="warning"><strong>NOT PROOF OF PAYMENT OR SETTLEMENT</strong><p>This acknowledgement confirms only that an operation was recorded internally. The network/provider has not been verified by this acknowledgement, and it is not a tax invoice.</p></div>
<dl><dt>Record reference</dt><dd><%= reference %></dd>
<dt>Recorded (<%= receiptZone %>)</dt><dd><%= receiptTime(record.createdAt) %></dd>
<dt>Operation</dt><dd><%= record.operation.replace('_',' ') %></dd>
<dt>Network</dt><dd><%= record.network %></dd>
<dt>Network reference (unverified)</dt><dd><%= record.networkReference %></dd>
<dt>Customer</dt><dd><%= record.customer %></dd>
<dt>Recorded amount</dt><dd><%= amount %></dd>
<dt>Recorded fee</dt><dd><%= fee %></dd>
<dt>Internal record</dt><dd><%= record.status==='voided_internal'?'Voided internally':record.fundingState==='book_recorded'?'Recorded in cash and float books':record.status==='recorded'?'Recorded':record.status==='pending_verification'?'Historical entry · book posting not established':record.status.replaceAll('_',' ') %></dd>
<dt>Network settlement</dt><dd>Not independently verified in FinHub</dd>
<% if(['accepted','disputed'].includes(record.reviewState)){ %><dt>Historical review outcome</dt><dd><%= record.reviewState %></dd><% } %>
<dt>Correction status</dt><dd><%= record.correctionState || 'none' %></dd></dl>
<p class="foot">If the entry is inaccurate, contact the branch for a controlled correction. No wallet or provider balance is confirmed here.</p>
<% if(typeof identity!=='undefined'&&identity?.footerNote){ %><p class="foot"><%= identity.footerNote %></p><% } %>
<nav><a href="/tenant/mobile-money/<%= record._id %>">Return to record</a> <button id="printAcknowledgement" type="button">Print</button></nav>
</main><script src="/js/acknowledgement.js" defer></script><script src="/js/feedback.js?v=<%= typeof assetVersion==='undefined'?'1':assetVersion %>" defer></script></body></html>
