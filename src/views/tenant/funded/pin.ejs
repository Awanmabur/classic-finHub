<section class="view show"><section class="card"><div class="cardHead"><div><b>Transfer payout PIN</b><br><span><%= data.source.reference %></span></div><span class="tag">Posted manual collection</span></div><div class="cardBody"><div class="summary"><div class="sumRow"><span>Generated PIN</span><b class="mono"><%= data.pin %></b></div><div class="sumRow"><span>Receiver</span><b><%= data.source.beneficiary.name %></b></div><div class="sumRow"><span>Amount</span><b><%= typeof formatMoneyMinor==='function'?formatMoneyMinor(data.source.amountMinor,data.source.currency):data.source.amountMinor+' '+data.source.currency %></b></div></div><p class="tiny">This PIN is displayed once. Share it privately. Cash is released only after receiver verification and independent payout approval.</p><a class="btn" href="/tenant/funded/<%= data.execution._id %>">Back to movement</a></div></section></section>
