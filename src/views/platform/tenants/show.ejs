<section class="view show"><div class="grid3"><div class="stat"><div class="k">Tenant</div><div class="v"><%= data.tenant.name %></div><div class="s"><span class="dot"></span><%= data.tenant.status %></div></div><div class="stat"><div class="k">Owner</div><div class="v" style="font-size:14px"><%= data.tenant.owner %></div><div class="s"><%= data.tenant.email %></div></div><div class="stat"><div class="k">Modules</div><div class="v"><%= data.tenant.enabledModules.length+(data.tenant.moduleGrants||[]).filter(g=>g.status==='granted'&&new Date(g.periodEnd)>new Date()).length %></div><div class="s"><span class="dot warn"></span>Assigned to this workspace</div></div></div><section class="card" style="margin-top:14px"><div class="cardHead"><b>Enabled modules</b><span>Plan and independent entitlements are administered separately below.</span></div><div class="cardBody"><div class="seg"><% data.modules.forEach(m => { %><span class="chip <%= (data.tenant.enabledModules.includes(m.key)||(data.tenant.moduleGrants||[]).some(g=>g.moduleKey===m.key&&g.status==='granted'&&new Date(g.periodEnd)>new Date())) ? 'active' : '' %>"><i class="fa-solid <%= m.icon %>"></i> <%= m.name %></span><% }) %></div></div></section></section>

<section class="card" style="margin-top:14px"><div class="cardHead"><b>Change workspace access status</b><span>Super Admin · audited</span></div><div class="cardBody"><p class="tiny">A suspension blocks tenant operations. Status changes require a reason. Plan, pricing and subscription changes are deliberately separate from this control.</p>
<form method="post" action="/platform/tenants/<%= data.tenant.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field">New status<select name="status" class="control" required><option value="">Choose status</option><% const options={trial:['active','suspended'],active:['past_due','suspended'],past_due:['active','suspended'],suspended:['active']}[data.tenant.status]||[];options.forEach(st=>{ %><option value="<%= st %>"><%= st %></option><% }) %></select></label><label class="field">Reason (12–400 characters)<textarea name="reason" class="control" required minlength="12" maxlength="400" rows="3"></textarea></label><button type="submit" class="btn btnPrimary">Update status</button></form></div></section>
<section class="card" style="margin-top:14px"><div class="cardHead"><b>Edit tenant profile</b><span>Display details only · audited</span></div><div class="cardBody"><form method="post" action="/platform/tenants/<%= data.tenant.id %>/profile"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row2"><label class="field">Business name<input class="control" name="name" required minlength="2" maxlength="150" value="<%= data.tenant.name %>"></label><label class="field">Contact phone<input class="control" name="phone" maxlength="40" value="<%= data.tenant.phone||'' %>"></label></div><label class="field">Reason (12–400 characters)<textarea class="control" name="reason" required minlength="12" maxlength="400" rows="2"></textarea></label><button type="submit" class="btn">Save profile</button></form><p class="tiny">Owner email, tenant slug, financial records, plan entitlements, subscription charges and audit history are not editable through this form.</p></div></section>
<section class="card" style="margin-top:14px"><div class="cardHead"><b>Subscription access &amp; limits</b><span>Plan terms and usage</span></div><div class="cardBody">
  <% const sub=data.tenant.subscription; %>
  <div class="summary"><div class="sumRow"><span>Published plan</span><b><%= sub?`${sub.planCode} v${sub.planVersion}`:'Not migrated / no entitlement' %></b></div>
  <div class="sumRow"><span>Entitlement</span><b><%= sub?.status||'Unassigned' %></b></div>
  <div class="sumRow"><span>Expires</span><b><%= sub?.periodEnd?new Date(sub.periodEnd).toISOString().slice(0,10):'No term' %></b></div>
  <div class="sumRow"><span>Reserved seats</span><b><%= data.tenant.seatsReserved %> / <%= sub?.limits?.users??'—' %></b></div>
  <div class="sumRow"><span>Active branches</span><b><%= data.tenant.branchCount %> / <%= sub?.limits?.branches??'—' %></b></div></div>
  <p class="tiny">Manual grants change module access and quotas and are fully audited. They are support-authorized entitlements, not proof of an invoice, collection, or settlement. Suspended tenants must be reactivated through the separate status workflow.</p>
  <form method="post" action="/platform/tenants/<%= data.tenant.id %>/subscription/grant">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="row2"><label class="field">Published plan<select class="control" name="planCode" required><option value="">Choose published plan</option><% const uniquePlans=new Set();data.published.forEach(v=>{if(!uniquePlans.has(v.code)){uniquePlans.add(v.code);%><option value="<%= v.code %>"><%= v.name %> (latest published)</option><% }}); %></select></label>
    <label class="field">Duration in days (1–366)<input class="control" type="number" name="days" min="1" max="366" required value="30"></label></div>
    <label class="field">Change justification (20–600 characters)<textarea class="control" name="reason" required minlength="20" maxlength="600" rows="3"></textarea></label>
    <button type="submit" class="btn btnPrimary">Grant / renew subscription</button>
  </form>
  <% if(sub && ['trial','granted'].includes(sub.status)){ %>
  <form method="post" action="/platform/tenants/<%= data.tenant.id %>/subscription/revoke" style="margin-top:18px">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field">Revocation reason (20–600 characters)<textarea class="control" name="reason" minlength="20" maxlength="600" required rows="2"></textarea></label>
    <button type="submit" class="btn">Revoke subscription access</button>
  </form><% } %>
</div></section>

<section class="card" style="margin-top:14px"><div class="cardHead"><b>Independent module subscriptions</b><span>Super Admin · audited manual entitlement · no payment collected</span></div><div class="cardBody">
  <% const grants=data.tenant.moduleGrants||[]; %><div class="summary"><% grants.forEach(g=>{ %><div class="sumRow"><span><%= g.moduleKey %> (<%= g.status %>)</span><b><%= new Date(g.periodEnd).toISOString().slice(0,10) %></b></div><% }) %></div>
  <form method="post" action="/platform/tenants/<%= data.tenant.id %>/modules/grant">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row3">
      <label class="field">Independent module<select class="control" name="moduleKey" required data-module-record-allocation><% (data.independentModules||[]).forEach(m=>{ %><option value="<%= m.key %>" data-requires-records="<%= m.requiresRecords===true %>"><%= m.name %> · USD <%= m.priceMonthly %>/mo</option><% }) %></select></label>
      <label class="field">Days<input class="control" type="number" name="days" min="1" max="366" value="30" required></label>
      <label class="field">Monthly record allocation (positive for transaction modules, customers, accounts and expenses; 0 for report and control modules)<input class="control" type="number" name="recordsPerMonth" min="0" max="1000000" value="0" required></label>
    </div><div class="row2"><label class="field">Workspace seat limit<input class="control" type="number" name="users" min="1" value="5" required></label><label class="field">Branch limit<input class="control" type="number" name="branches" min="1" value="1" required></label></div>
    <label class="field">Approval justification (20–600 characters)<textarea class="control" name="reason" required minlength="20" maxlength="600" rows="2"></textarea></label>
    <button type="submit" class="btn btnPrimary">Grant / renew module access</button>
  </form>
  <% grants.filter(g=>g.status==='granted').forEach(g=>{ %><form method="post" action="/platform/tenants/<%= data.tenant.id %>/modules/revoke" style="margin-top:12px">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="moduleKey" value="<%= g.moduleKey %>">
    <label class="field">Revoke <%= g.moduleKey %> · reason<textarea class="control" name="reason" required minlength="20" maxlength="600" rows="2"></textarea></label>
    <button type="submit" class="btn">Revoke standalone grant</button>
  </form><% }) %>
  <p class="tiny">Each module may be independently granted or revoked. This action updates access and audit history, not bank transfers, invoices or actual billing payments.</p>
</div></section>
