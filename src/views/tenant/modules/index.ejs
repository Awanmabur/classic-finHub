<section class="view show tenantModulePage">
 <section class="card modulePageIntro">
  <div class="cardHead"><div><b>Modules for your business</b><br><span>Active access, requests, and independent subscriptions</span></div><% if(user.role==='Tenant Owner'){ %><a class="btn" href="/tenant/workspace/roles">Assign staff access</a><% } %></div>
  <div class="cardBody"><p class="tiny">Request a module directly below. The platform reviews and activates subscriptions; submitting a request does not charge you or give staff new financial rights.</p></div>
 </section>
 <div class="tenantModuleCards">
 <% data.modules.forEach(m=>{
   const active=data.entitledKeys?.includes(m.key);
   const grant=data.grants.find(g=>g.moduleKey===m.key);
   const pending=Boolean(data.pendingKeys?.includes(m.key));
   const access=data.moduleAccessStates?.[m.key]||{state:'unsubscribed',message:'Unavailable',href:null};
   const requestable=user.role==='Tenant Owner'&&!active&&!pending&&['enabled','recording_only'].includes(m.runtimeStatus);
 %>
  <article class="card tenantModuleCard" data-search-row>
   <div class="cardHead"><div class="moduleCardTitle"><i class="fa-solid <%= m.icon %>" aria-hidden="true"></i><b><%= m.name %></b></div><span class="tag"><%= active?'Active':pending?'Requested':m.runtimeStatus==='disabled'?'Unavailable':'Not subscribed' %></span></div>
   <div class="cardBody moduleCardBody">
    <p class="moduleCardDescription"><%= m.description %></p>
    <% if(active){ %>
      <p class="tiny"><%= grant?'Independent subscription through '+new Date(grant.periodEnd).toISOString().slice(0,10):'Included in your current subscription' %></p>
      <p class="tiny"><strong>Your access:</strong> <%= access.message %></p>
      <% if(access.href){ %><a class="btn" href="<%= access.href %>">Open module</a><% } %>
    <% }else if(pending){ %>
      <p class="tiny modulePendingText">Request submitted · awaiting platform review</p>
    <% }else if(requestable){ %>
      <p class="tiny"><%= m.requiresQuote?'Price agreed after platform review':'Indicative price: USD '+m.priceMonthly+'/month' %></p>
      <form method="post" action="/tenant/modules/request" class="moduleRequestForm">
       <input type="hidden" name="_csrf" value="<%= csrfToken %>">
       <input type="hidden" name="moduleKey" value="<%= m.key %>">
       <label class="field">How will you use this module?
        <textarea class="control" name="reason" required minlength="20" maxlength="600" rows="2" placeholder="Describe the business need briefly"></textarea>
       </label>
       <button class="btn btnPrimary" type="submit"><%= m.requiresQuote?'Request a quotation':'Request module' %></button>
      </form>
    <% }else if(!active){ %>
      <p class="tiny"><%= m.runtimeStatus==='disabled'?'This module is not currently available for activation.':'Your tenant owner manages module subscriptions.' %></p>
    <% } %>
   </div>
  </article>
 <% }); %>
 </div>
</section>