<% const currentBranch = typeof operationBranch !== 'undefined' ? operationBranch : (data.branches || []).find(branch=>String(branch._id) === String(user.transactionBranchId || user.branchId || data.selectedBranchId || '') && branch.status !== 'archived');
   const branchProblem = typeof operationBranchError === 'string' && operationBranchError ? operationBranchError : 'An active operating branch must be assigned to your account before creating records.';
   const entryPath = '/tenant/mobile-money/' + (data.operation === 'cash_out' ? 'cash-out' : 'cash-in'); %>
<section class="view show mobileMoneyPage">
  <%- include('../../partials/operation-branch',{currentBranch,branchProblem,user}) %>
  <div class="richActions"><a class="btn" href="/tenant/mobile-money/network-activity">Network activity</a><a class="btn" href="/tenant/mobile-money/cash-impact">Cash impact</a><% if((user.permissions||[]).includes('*')||(user.permissions||[]).includes('treasury.view')){ %><a class="btn" href="/tenant/mobile-money/tariffs">Agent rate sheets</a><% } %><% if((user.permissions||[]).some(permission=>['*','mobile_money.report','reports.view'].includes(permission))){ %><a class="btn" href="/tenant/mobile-money/report">Mobile money report</a><% } %><% if(['Tenant Owner','Mobile Money Operator','Branch Manager','Reconciliation Officer','Auditor'].includes(user.role)){ %><a class="btn" href="/tenant/mobile-money/shifts">Manage physical cash shifts</a><% } %></div>
  <% if(data.fxState && user.role==='Tenant Owner' &&
    ((user.permissions||[]).includes('*')||(user.permissions||[]).includes('treasury.manage')) &&
    data.fxState.wallets.length && data.fxState.drawers.length){ %>
  <details class="card logicNote" style="margin-top:12px">
   <summary class="cardHead">Exchange rates · owner settings</summary>
   <form method="post" action="/tenant/mobile-money/fx/rates" class="cardBody" autocomplete="off">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="row2">
     <label class="field">Provider wallet currency
      <select class="control" name="fromCurrency" required>
       <% [...new Set(data.fxState.wallets.map(w=>w.currency))].forEach(code=>{ %><option value="<%= code %>"><%= code==='KES'?'KSH':code %></option><% }) %>
      </select></label>
     <label class="field">Cash currency
      <select class="control" name="toCurrency" required>
       <% [...new Set(data.fxState.drawers.map(d=>d.currency))].forEach(code=>{ %><option value="<%= code %>"><%= code==='KES'?'KSH':code %></option><% }) %>
      </select></label>
    </div>
    <div class="row2">
     <label class="field">Rate type
      <select class="control" name="side" required><option value="buy">Buy · customer withdraws in cash</option><option value="sell">Sell · customer deposits cash</option></select></label>
     <label class="field">Reference amount
      <select class="control" name="rateBaseUnits" required>
       <option value="1">1 unit</option><option value="100">100 units</option><option value="1000" selected>1,000 units</option>
      </select></label>
    </div>
    <label class="field">Target currency amount for the selected reference
     <input class="control" name="quotedRate" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,8})?" required placeholder="Enter your actual operating rate"></label>
    <input type="hidden" name="validHours" value="24">
    <p class="tiny">For example, enter 1,000 UGX and its equivalent SSP amount. The system saves a precise per-unit rate. Updating a rate does not change completed transactions.</p>
    <button class="btn btnPrimary" type="submit">Save operating exchange rate</button>
   </form>
  </details>
  <% } %>
  <div class="grid mobileMoneyEntryGrid">
    <% if(data.canRecord && currentBranch){ %>
      <%- include('_entry-form',{currentBranch,operation:data.operation}) %>
    <% } else { %><section class="card"><div class="cardHead"><b><%= data.operation === 'cash_out' ? 'Withdrawal' : 'Deposit' %> · access check</b></div><div class="cardBody">
     <% if(!data.canRecord){ const allowedDeposit=(user.permissions||[]).includes('*')||(user.permissions||[]).includes('mobile_money.cash_in');
        const allowedWithdrawal=(user.permissions||[]).includes('*')||(user.permissions||[]).includes('mobile_money.cash_out');
        const requestedAction=data.operation==='cash_out'?'Withdrawal':'Deposit'; %>
       <p role="status">This signed-in session has role <strong><%= user.role %></strong>. It can view Mobile Money but is not authorized to record <%= requestedAction.toLowerCase() %> transactions. This screen has not changed your role or removed any permissions.</p>
       <p class="tiny">Deposit recording: <strong><%= allowedDeposit?'Allowed':'Not allowed' %></strong> · Withdrawal recording: <strong><%= allowedWithdrawal?'Allowed':'Not allowed' %></strong>. Account access is checked live from your tenant user role.</p>
       <% if(!allowedDeposit&&!allowedWithdrawal){ %>
         <p class="tiny">Viewing reports is different from recording transactions. If you previously recorded deposits or withdrawals using this same login, check the role shown above against your former role before changing permissions.</p>
       <% }else if(!allowedDeposit){ %><a class="btn" href="/tenant/mobile-money/cash-out">Open permitted Withdrawal</a>
       <% }else if(!allowedWithdrawal){ %><a class="btn" href="/tenant/mobile-money/cash-in">Open permitted Deposit</a><% } %>
     <% }else{ %><p role="status"><%= branchProblem %></p>
       <a class="btn" href="/tenant/branches">Review operating branch assignment</a>
     <% } %>
    </div></section><% } %>
    <section class="card"><div class="cardHead"><div><b><%= data.operation === 'cash_out' ? 'Withdrawal' : 'Deposit' %> activity</b><br><span>Recorded operations</span></div><a class="btn" href="/tenant/mobile-money/history">All history</a></div><div class="cardBody richPageGrid"><%- include('_filters',{filterAction:entryPath,fixedOperation:data.operation}) %><%- include('_activity',{activityRecords:data.records,activityPath:entryPath}) %></div></section>
  </div>
  <p class="tiny">Cash-In and Cash-Out exchange real physical cash with provider float. The assigned operator must have an independently approved cash shift. Commission estimates come from provider rate sheets and are never treated as a confirmed payout. <a href="/tenant/mobile-money">Review recorded transactions</a>.</p>
</section>
