<section class="view show"><section class="card"><div class="cardHead"><b>Staff users</b><span>Invite staff, assign roles, branch, permissions.</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Branch</th><th>Status</th></tr></thead><tbody><% data.users.forEach(u => { %><tr data-search-row><td><b><%= u.name %></b></td><td><%= u.email %></td><td><%= u.role %></td><td><%= u.branch %></td><td><span class="tag"><%= u.status %></span></td></tr><% }) %></tbody></table></div></section></section>
