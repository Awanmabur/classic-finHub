<section class="view show"><div class="grid"><form class="card" method="post" action="/tenant/money-transfer/send"><div class="cardHead"><b>Send money</b><span>Generate PIN/claim code, notify receiver, create receipt.</span></div><div class="cardBody" style="display:grid;gap:12px"><div class="row2"><label class="field">Sender<input class="control" name="customer" required placeholder="Sender name" /></label><label class="field">Receiver phone<input class="control" name="phone" placeholder="+256…" /></label></div><div class="row3"><label class="field">Amount<input class="control" type="number" name="amount" required /></label><label class="field">Fee<input class="control" type="number" name="fee" value="5000" /></label><label class="field">Currency<select class="control" name="currency"><option>UGX</option><option>USD</option><option>SSP</option></select></label></div><button class="btn btnPrimary">Create transfer</button></div></form><section class="card"><div class="cardHead"><b>Pending payout queue</b><span>Payout by PIN and ID verification.</span></div><div class="cardBody txList"><% data.transactions.filter(t=>t.module==='Money Transfer').forEach(t => { %><div class="tx" data-search-row><div class="txLeft"><span class="txDot warn"></span><div class="txMeta"><b><%= t.reference %></b><span><%= t.customer %> — <%= t.status %></span></div></div><div class="txAmt"><%= money(t.currency,t.amount) %></div></div><% }) %></div></section></div></section>
