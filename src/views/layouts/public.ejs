<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title || 'ClassicFin Hub' %></title>
  <meta name="description" content="ClassicFin Hub is a multi-tenant finance SaaS platform for money transfer, mobile money, banking, forex, reporting, analytics, billing, tenant onboarding, roles, and secure operations." />
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="cursor-glow" aria-hidden="true"></div>
  <aside class="side-rail" aria-label="Desktop navigation">
    <a class="rail-logo logo-mark" href="/" aria-label="ClassicFin Hub home"><img src="/images/classicfinhub-logo.png" alt="ClassicFin Hub logo" /></a>
    <nav>
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>"><i class="fa-solid fa-house"></i><span>Home</span></a>
      <a href="/services" class="<%= currentPath === '/services' ? 'active' : '' %>"><i class="fa-solid fa-table-cells-large"></i><span>Modules</span></a>
      <a href="/marketplace" class="<%= currentPath === '/marketplace' ? 'active' : '' %>"><i class="fa-solid fa-store"></i><span>Marketplace</span></a>
      <a href="/book-appointment" class="<%= currentPath === '/book-appointment' ? 'active' : '' %>"><i class="fa-solid fa-calendar-check"></i><span>Book</span></a>
      <a href="/pricing" class="<%= currentPath === '/pricing' ? 'active' : '' %>"><i class="fa-solid fa-tags"></i><span>Pricing</span></a>
      <a href="/price-compare" class="<%= currentPath === '/price-compare' ? 'active' : '' %>"><i class="fa-solid fa-scale-balanced"></i><span>Compare</span></a>
      <a href="/support" class="<%= currentPath === '/support' ? 'active' : '' %>"><i class="fa-solid fa-message"></i><span>Support</span></a>
      <div class="rail-auth">
        <a href="/signin" aria-label="Sign in"><i class="fa-solid fa-right-to-bracket"></i><span>Sign in</span></a>
        <a href="/signup" aria-label="Request setup"><i class="fa-solid fa-user-plus"></i><span>Request setup</span></a>
      </div>
    </nav>
    <button class="rail-theme" id="themeToggle" aria-label="Toggle theme"><i class="fa-solid fa-moon"></i></button>
  </aside>
  <header class="mobile-header">
    <a class="mobile-brand" href="/"><span class="mobile-logo"><img src="/images/classicfinhub-logo.png" alt="ClassicFin Hub logo" /></span><strong>ClassicFin Hub</strong></a>
    <div class="mobile-auth-actions"><a href="/signin">Sign in</a><a href="/signup">Request setup</a></div><button class="mobile-menu-btn" id="menuBtn" aria-label="Open menu"><i class="fa-solid fa-bars-staggered"></i></button>
  </header>
  <nav class="mobile-panel" id="mobilePanel" aria-label="Mobile navigation">
    <a href="/">Home</a><a href="/services">Modules</a><a href="/marketplace">Marketplace</a><a href="/book-appointment">Book demo</a><a href="/pricing">Pricing</a><a href="/price-compare">Price compare</a><a href="/support">Support</a><a href="/platform/dashboard">Platform dashboard</a><a href="/tenant/dashboard">Tenant dashboard</a><a href="/signin">Sign in</a><a href="/signup">Request setup</a><button id="themeToggleMobile"><i class="fa-solid fa-moon"></i> Change theme</button>
  </nav>
  <main class="page smooth-page">
    <%- include('../partials/flash', { flash }) %>
    <%- include(view, { data, modules, plans, tenants, appointments, currentPath }) %>
  </main>
  <footer class="footer" id="contact">
    <div><img src="/images/classicfinhub-logo.png" alt="ClassicFin Hub logo" /><strong>ClassicFin Hub</strong><p>Multi-tenant finance SaaS for Classic Technologies.</p></div>
    <div><a href="/terms">Terms</a><a href="/privacy">Privacy</a><a href="/cookies">Cookies</a><a href="/refund-policy">Refund policy</a></div>
    <p>© <span id="year"></span> Classic Technologies. All rights reserved.</p>
  </footer>
  <script src="/js/script.js"></script>
</body>
</html>
