<section class="view show"><section class="card"><div class="cardHead"><b>Plan editor</b><span>Attach modules, addons, prices, limits, and trial terms.</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Plan</th><th>Trial</th><th>Limits</th><th>Modules</th></tr></thead><tbody><% data.plans.forEach(p => { %><tr data-search-row><td><b><%= p.name %></b><br><span class="tiny"><%= p.description %></span></td><td><%= p.trialMonths %> months</td><td><%= p.limits.users %> users • <%= p.limits.branches %> branches • <%= p.limits.transactionsPerMonth %> tx</td><td><div class="seg"><% p.modules.forEach(m => { %><span class="chip active"><%= m %></span><% }) %></div></td></tr><% }) %></tbody></table></div></section></section>
