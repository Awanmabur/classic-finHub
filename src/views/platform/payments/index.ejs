<section class="view show"><section class="card"><div class="cardHead"><b>Payments</b><span>Provider status and reconciliation.</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Invoice</th><th>Tenant</th><th>Amount</th><th>Method</th><th>Status</th><th>Paid at</th></tr></thead><tbody><% data.payments.forEach(p => { %><tr data-search-row><td><%= p.invoice %></td><td><%= p.tenantName %></td><td><%= p.currency %> <%= p.amount %></td><td><%= p.method %></td><td><span class="tag"><%= p.status %></span></td><td><%= p.paidAt || '—' %></td></tr><% }) %></tbody></table></div></section></section>
