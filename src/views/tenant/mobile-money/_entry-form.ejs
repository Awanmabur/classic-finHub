<% const entryOperation = typeof operation === 'string' && operation === 'cash_out' ? 'cash_out' : 'cash_in';
   const entryLabel = entryOperation === 'cash_in' ? 'Deposit' : 'Withdraw';
   const entryPermissions = user.permissions || [];
   const entryCan = permission => entryPermissions.includes('*') || entryPermissions.includes(permission);
   const configuredNetworks=[...new Set((data.funds?.wallets||[]).filter(w=>(w.assignedToOperator||w.shared)&&w.state==='active'&&w.reconciliation==='matched'&&w.expectedMinor!==null).map(w=>w.network))];
   const entryNetworks = configuredNetworks.length?configuredNetworks:(data.networksAvailable || ['MTN','MTN SSD','Airtel','Africell','M-Pesa','mGURUSH','Digi Cash']);
   const entryNetworkCurrencies={MTN:'UGX','MTN SSD':'SSP',Airtel:'UGX'};
   const entryCurrencyOptions=data.entryCurrencies?.length?data.entryCurrencies:(currentBranch.currencies||['UGX','USD','SSP','KES']).map(code=>({code,label:code==='KES'?'KSH':code}));
   const entryEligibleWallets=(data.funds?.wallets||[]).filter(w=>w.state==='active'&&w.reconciliation==='matched'&&w.expectedMinor!==null);
   const entryVerifiedMarket=network=>{const markets=[...new Set(entryEligibleWallets.filter(w=>w.network===network).map(w=>w.currency))];return entryNetworkCurrencies[network]||(markets.length===1?markets[0]:'');};
   const entryNeedsWallet=network=>['mGURUSH','Digi Cash'].includes(network)&&!entryEligibleWallets.some(w=>w.network===network);
   const selectedEntryNetwork=(entryNetworks.includes('MTN')&&entryCurrencyOptions.some(c=>c.code==='UGX')?'MTN':null)||entryNetworks.find(n=>entryNetworkCurrencies[n]&&entryCurrencyOptions.some(c=>c.code===entryNetworkCurrencies[n]))||entryNetworks.find(n=>!entryNetworkCurrencies[n])||entryNetworks[0];
   const entryCurrency=entryVerifiedMarket(selectedEntryNetwork)||data.entryCurrency||currentBranch.currency;
   const entryAmountPattern = entryCurrency === 'UGX' ? '[0-9]{1,11}' : '[0-9]{1,11}([.][0-9]{1,2})?';
   const entryCurrencyLabel = typeof currencyLabel === 'function' ? currencyLabel(entryCurrency) : (entryCurrency === 'KES' ? 'KSH' : entryCurrency); %>
<form class="card mobileMoneyEntry" method="post" action="/tenant/mobile-money/<%= entryOperation === 'cash_in' ? 'cash-in' : 'cash-out' %>" autocomplete="off" data-mobile-money-form data-operation="<%= entryOperation %>" data-currency="<%= entryCurrency %>" data-currency-label="<%= entryCurrencyLabel %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="idempotencyKey" value="<%= data.idempotencyKey %>">
  <div class="cardHead"><div><b>Mobile Money - <%= entryLabel %></b><br><span>Customer, network, and amount details</span></div></div>
  <div class="cardBody mobileMoneyFormBody">
    <div class="seg childActions" aria-label="Mobile money operation">
      <% if(entryCan('mobile_money.cash_in')){ %><a class="chip <%= entryOperation === 'cash_in' ? 'active' : '' %>" href="/tenant/mobile-money/cash-in" data-mobile-operation="cash_in" <%- entryOperation === 'cash_in' ? 'aria-current="page"' : '' %>>Customer deposit</a><% } %>
      <% if(entryCan('mobile_money.cash_out')){ %><a class="chip <%= entryOperation === 'cash_out' ? 'active' : '' %>" href="/tenant/mobile-money/cash-out" data-mobile-operation="cash_out" <%- entryOperation === 'cash_out' ? 'aria-current="page"' : '' %>>Customer withdrawal</a><% } %>
    </div>
    <div class="formSection">
      <div class="formSectionTitle">Customer and network</div>
      <input type="hidden" value="<%= entryLabel %>" data-mobile-operation-label><input type="hidden" name="fee" value="0">
      <div class="row2">
        <% if(entryNetworks.length===1){ %>
        <div class="field"><span>Provider network (automatically selected)</span>
          <input class="control" type="text" readonly tabindex="-1" aria-label="Automatically selected network" value="<%= selectedEntryNetwork==='MTN'?'MTN MoMo Uganda':selectedEntryNetwork==='MTN SSD'?'MTN MoMo South Sudan':selectedEntryNetwork %> · <%= entryCurrency %>">
          <input type="hidden" name="network" value="<%= selectedEntryNetwork %>" data-market-currency="<%= entryVerifiedMarket(selectedEntryNetwork) %>">
        </div>
        <% }else{ %><label class="field">Network<select class="control" name="network" required><% entryNetworks.forEach(network=>{ %><option value="<%= network %>" data-market-currency="<%= entryVerifiedMarket(network) %>"<%- network===selectedEntryNetwork?' selected':'' %><%- (entryNetworkCurrencies[network]&&!entryCurrencyOptions.some(c=>c.code===entryNetworkCurrencies[network]))||entryNeedsWallet(network)?' disabled':'' %>><%= network==='MTN SSD'?'MTN MoMo South Sudan':network==='MTN'?'MTN MoMo Uganda':network %></option><% }) %></select></label><% } %>
        <label class="field">Customer phone<input class="control" type="tel" name="customerPhone" placeholder="<%= entryCurrency==='UGX'?'+256...':entryCurrency==='SSP'?'+211...':entryCurrency==='KES'?'+254...':'International number...' %>" inputmode="tel" maxlength="24" required autocomplete="tel"></label>
      </div>
      <label class="field">Network transaction reference<input class="control" name="networkReference" placeholder="Reference from the provider transaction" pattern="[A-Za-z0-9._:\/\-]{5,100}" minlength="5" maxlength="100" required><span class="tiny">Captured automatically for received SMS transactions; enter the provider reference for a manual transaction.</span></label>
    </div>
    <div class="formSection">
      <div class="formSectionTitle">Amount and accounts</div>
      <div class="row2">
        <label class="field" data-mobile-currency-field <%= entryVerifiedMarket(selectedEntryNetwork)?'hidden':'' %>>Currency (derived from network)<select class="control" name="currency" data-mobile-currency required><% entryCurrencyOptions.forEach(option=>{ %><option value="<%= option.code %>" <%= option.code===entryCurrency?'selected':'' %>><%= option.label %></option><% }) %></select></label>
        <label class="field">Amount (<span data-mobile-currency-label><%= entryCurrency %></span>)<input class="control" type="text" inputmode="decimal" name="amount" placeholder="0" pattern="<%= entryAmountPattern %>" required></label>
      </div>
      <% if(data.crossCurrencyEnabled){
       // Only approved real cashier-owned drawers are candidates. An operator
       // cannot create or borrow cash balances through this control.
       const linkedDrawers=(data.funds?.paymentAccounts||[]).filter(a=>a.kind==='cash'&&a.assignedToOperator&&a.state==='active'&&a.reconciliation==='matched'&&a.expectedMinor!==null);
       const linkedCurrencies=[...new Set(linkedDrawers.map(a=>a.currency))];
      %>
      <div class="formSection" data-linked-currency-area>
       <div class="formSectionTitle">Customer cash currency · shared Treasury drawer</div>
       <div class="row2">
        <label class="field">Actual cash handed over
         <select class="control" name="cashCurrency" data-linked-cash-currency required>
          <% linkedCurrencies.forEach(code=>{ %><option value="<%= code %>" <%= code===entryCurrency?'selected':'' %>><%= code==='KES'?'KSH':code %> · existing cashier drawer</option><% }) %>
         </select>
        </label>
        <label class="field" data-linked-rate-field hidden>Approved Forex rate
         <select class="control" name="fxRateId" data-linked-rate disabled>
          <option value="">Choose the approved rate</option>
          <% (data.approvedFxRates||[]).forEach(rate=>{ %>
           <option value="<%= rate._id %>" data-from="<%= rate.fromCurrency %>" data-to="<%= rate.toCurrency %>" data-side="<%= rate.side %>"><%= rate.fromCurrency %> → <%= rate.toCurrency %> · <%= rate.side==='buy'?'buy':'sell' %> · <%= rate.rateDecimal %></option>
          <% }) %>
         </select>
        </label>
       </div>
       <section class="summary" data-linked-preview hidden aria-live="polite">
        <div class="sumRow"><span data-linked-preview-title>Customer cash movement</span><b data-linked-preview-amount>—</b></div>
        <div class="sumRow"><span>Provider float movement</span><b data-linked-preview-wallet>—</b></div>
        <p class="tiny" data-linked-preview-note></p>
       </section>
       <label class="field" data-linked-confirm-field hidden>
        <span><input type="checkbox" name="cashHandoverConfirmed" value="on" data-linked-confirm disabled> I have physically counted and handed over/received the displayed cash amount.</span>
       </label>
       <p class="tiny">Cash is recorded only against your existing verified shift. Conversion uses your independently approved Mobile Money rates; no separate Forex trading subscription is required. This does not confirm provider settlement. <a href="/tenant/mobile-money/currency-rates">View or approve cash conversion rates</a>.</p>
      </div>
      <% } %>
      <input type="hidden" name="paymentMethod" value="Cash">
      <p class="tiny" data-momo-account-notice hidden aria-live="polite"></p>
      <%- include('_funds-context') %>
      <% const entryBalances=[...(data.funds?.paymentAccounts||[]).filter(a=>a.kind==='cash'&&a.state==='active'&&a.reconciliation==='matched'&&a.expectedMinor!=null),
       ...(data.funds?.wallets||[]).filter(a=>a.state==='active'&&a.reconciliation==='matched'&&a.expectedMinor!=null)]; %>
      <div class="networkBalanceGrid mobileEntryBalances" data-mobile-balance-stats aria-label="Cash and float book balances">
       <% entryBalances.forEach(a=>{ %>
        <div class="networkBalanceStat" data-balance-account="<%= a.id %>" data-balance-network="<%= a.network||'' %>" data-balance-currency="<%= a.currency %>" data-balance-kind="<%= a.kind %>">
         <span><%= a.kind==='cash'?'Physical cash':'Electronic float · '+(a.network==='MTN SSD'?'MTN South Sudan':a.network) %></span>
         <strong><%= a.expected||'Opening approval pending' %></strong>
         <small><%= a.name %> · <%= a.reconciliation||'Not reconciled' %> · book balance</small>
        </div>
       <% }) %>
       <% if(!entryBalances.length){ %><p class="tiny">No cash or float account is available. Configure the agent accounts in Treasury.</p><% } %>
      </div>
    </div>
    <%- include('../partials/operation-pricing',{pricingOperation:'mobile_money.'+entryOperation,pricingField:'fee'}) %>
    <section class="mobileQuoteSummary" data-mobile-provider-quote aria-live="polite" hidden>
      <div class="summary">
       <div class="sumRow" data-quote-commission-row hidden><span>Expected agent commission</span><b data-mobile-agent-commission></b></div>
       <div class="sumRow" data-quote-customer-row hidden><span>Network customer charge</span><b data-mobile-provider-charge></b></div>
      </div>
      <p class="tiny" data-mobile-quote-note></p>
    </section>

    <div class="summary">
      <div class="sumRow"><span data-mobile-total-label><%= entryOperation==='cash_out'?'Physical cash paid to customer':'Physical cash received from customer' %></span><b data-mobile-total>—</b></div>
      <div class="sumRow"><span>Reference</span><b class="mono mobileRequestReference" data-mobile-reference><%= data.idempotencyKey %></b></div>
    </div>
    <details class="logicNote"><summary>Additional details</summary><div class="row2"><label class="field">Customer name<input class="control" name="customer" placeholder="Optional customer name" minlength="2" maxlength="120" autocomplete="name"></label><label class="field">Customer ID / note<input class="control" name="customerNote" placeholder="Optional verification or note" maxlength="400"></label></div></details>
    <p class="tiny">Only record a transaction after the official network confirms it and the real customer cash exchange has occurred. Internal posting is immediate; independent review is separate.</p>
    <div class="rowBtns"><button class="btn btnPrimary" type="submit" data-mobile-submit-label><%= entryOperation==='cash_in'?'Record deposit':'Record withdrawal' %></button></div>
  </div>
</form>
