<section class="view show"><section class="card"><div class="cardHead"><b>Forex quotation <%= data.quote.reference %></b><span><%= data.quote.status.replaceAll('_',' ') %></span></div><div class="cardBody">
 <% if(data.quote.status==='posted_manual'){ %><p class="tiny">This manual exchange was independently reviewed and posted to the foreign currency stock and settlement books at the locked rate.</p><% }else{ %><p class="tiny">This quotation has not changed currency stock or settlement balances. Record the actual manual exchange and obtain independent review before the book changes.</p><% } %>
 <div class="summary"><div class="sumRow"><span>Customer label</span><b><%= data.quote.customerLabel %></b></div><div class="sumRow"><span>Source amount</span><b><%= data.amountLabel(data.quote.sourceMinor,data.quote.fromCurrency) %></b></div><div class="sumRow"><span>Quoted target amount</span><b><%= data.amountLabel(data.quote.targetMinor,data.quote.toCurrency) %></b></div><div class="sumRow"><span>Locked rate</span><b><%= data.quote.rateDecimal %> <%= data.quote.toCurrency %> per 1 <%= data.quote.fromCurrency %></b></div><div class="sumRow"><span>Expires UTC</span><b><%= new Date(data.quote.expiresAt).toISOString().slice(0,16).replace('T',' ') %></b></div><div class="sumRow"><span>Purpose</span><b><%= data.quote.note %></b></div><div class="sumRow"><span>Independent review</span><b><%= data.quote.reviewNote||'Not yet reviewed' %></b></div></div>
 <div class="summary"><% [['Customer phone',data.quote.capture?.customerPhone],['ID / Passport No.',data.quote.capture?.identityDocument],['Commission / fee (proposed)',(data.quote.capture?.commission||'0')+' '+data.quote.toCurrency],['Settlement method',data.quote.capture?.settlementMethod||'Cash'],['Rate source',data.quote.capture?.rateSource],['External reference',data.quote.capture?.externalReference]].forEach(([label,value])=>{ %><div class="sumRow"><span><%= label %></span><b><%= value||'—' %></b></div><% }) %></div>
 <div class="rowBtns" style="margin-top:12px"><% if(data.pendingMovementId){ %><a class="btn btnPrimary" href="/tenant/funded/<%= data.pendingMovementId %>">View movement awaiting review</a><% } %><% if(data.canRecordManual){ %><a class="btn btnPrimary" href="/tenant/funded/prepare/forex/<%= data.quote._id %>">Record manual exchange</a><% } %><% if(data.quote.manualExecutionId){ %><a class="btn btnPrimary" href="/tenant/funded/<%= data.quote.manualExecutionId %>">View posted exchange</a><% } %><a class="btn" href="/tenant/funded">Manual movements &amp; review</a><a href="/tenant/forex/history" class="btn">Quote history</a></div></div></section>
 <% if(data.canReview){ %><form method="post" action="/tenant/forex/<%= data.quote._id %>/review" class="card" style="margin-top:14px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="cardHead"><b>Independent quote decision</b></div><div class="cardBody"><label class="field">Review explanation<textarea name="note" minlength="12" maxlength="400" required class="control" rows="3"></textarea></label><div class="rowBtns"><button class="btn btnPrimary" name="decision" value="approve">Approve pending execution</button><button class="btn" name="decision" value="reject">Reject</button></div></div></form><% } %>
 <% if(data.canCancel){ %><form method="post" action="/tenant/forex/<%= data.quote._id %>/cancel" class="card" style="margin-top:14px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="cardHead"><b>Cancel undecided quote</b></div><div class="cardBody"><label class="field">Reason<textarea name="note" minlength="12" maxlength="400" required class="control" rows="2"></textarea></label><button class="btn" type="submit">Cancel quote</button></div></form><% } %>
</section>
