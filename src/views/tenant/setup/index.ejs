<section class="view show"><div class="grid"><section class="card"><div class="cardHead"><b>Tenant owner setup wizard</b><span>Owner invite acceptance to operations start.</span></div><div class="cardBody txList"><% ['Verify email/phone','Create password','Complete tenant profile','Confirm default branch','Confirm currencies','Create/edit roles','Invite staff','Invite/register customers','Start operations'].forEach((step,i) => { %><div class="tx"><div class="txLeft"><span class="txDot <%= i < 8 ? 'good' : 'warn' %>"></span><div class="txMeta"><b><%= i+1 %>. <%= step %></b><span><%= i < 8 ? 'Completed in demo tenant' : 'Ready' %></span></div></div><span class="tag"><%= i < 8 ? 'done' : 'next' %></span></div><% }) %></div></section><section class="card"><div class="cardHead"><b>Tenant profile</b><span>Branding and defaults</span></div><div class="cardBody summary"><div class="sumRow"><span>Name</span><b><%= tenant.name %></b></div><div class="sumRow"><span>Database</span><b><%= tenant.dbName %></b></div><div class="sumRow"><span>Plan</span><b><%= tenant.plan %></b></div><div class="sumRow"><span>Status</span><b><%= tenant.status %></b></div></div></section></div></section>
