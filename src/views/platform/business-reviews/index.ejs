<section class="view show">
 <section class="card">
  <div class="cardHead"><div><b>Customer feedback safety</b><br><span>Customer reviews appear immediately without approvals. Administrators intervene only when abusive or fraudulent content needs to be hidden; every action is audited.</span></div></div>
  <div class="cardBody">
   <% if(!data.reviews.length){ %><p>No customer reviews have been submitted.</p><% } %>
   <div class="workspaceStack">
   <% data.reviews.forEach(review=>{ %>
     <article class="card" style="margin-bottom:14px">
       <div class="cardHead"><div><b><%= review.tenantSlug %> · <%= review.rating %> / 5 stars</b><br><span><%= review.authorName %> · <%= review.status %> · <%= new Date(review.createdAt).toLocaleDateString('en-GB') %></span></div></div>
       <div class="cardBody"><p style="white-space:pre-line;overflow-wrap:anywhere"><%= review.comment %></p>
         <% if(review.ownerReply){ %><p class="tiny">Business response: <%= review.ownerReply %></p><% } %>
         <% const choices=review.status==='approved'?['hide']:review.status==='rejected'?['restore']:[]; %>
         <% if(review.status==='pending'){ %><p class="tiny">Legacy queued review from the previous workflow; new reviews publish immediately.</p><% } %>
         <% if(choices.length){ %>
           <form method="post" action="/platform/business-reviews/<%= review._id %>/moderate">
             <input type="hidden" name="_csrf" value="<%= csrfToken %>">
             <input type="hidden" name="revision" value="<%= review.revision %>">
             <label class="field">Reason for this abuse-related action (12–400 characters)<textarea class="control" name="reason" required minlength="12" maxlength="400" rows="2"></textarea></label>
             <div class="workspaceActions"><% choices.forEach(action=>{ %><button type="submit" class="btn <%= action==='restore'?'btnPrimary':'' %>" name="action" value="<%= action %>"><%= action[0].toUpperCase()+action.slice(1) %> review</button><% }) %></div>
           </form>
         <% } %>
       </div>
     </article>
   <% }) %>
   </div>
  </div>
 </section>
</section>
