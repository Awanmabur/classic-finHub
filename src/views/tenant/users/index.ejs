<section class="view show"><div class="grid">
  <form class="card" method="post" action="/tenant/users/invite"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="cardHead"><b>Invite staff</b><span><%= user.role==='Tenant Owner'?'Tenant-wide':'Your branch only' %> · staff access</span></div><div class="cardBody" style="display:grid;gap:12px">
    <div class="row2"><label class="field">Full name<input name="name" class="control" required minlength="2" maxlength="120"></label><label class="field">Email<input type="email" name="email" class="control" required maxlength="254"></label></div>
    <label class="field">Role<select name="role" class="control"><% data.roles.forEach(role=>{ %><option value="<%= role %>"><%= role %></option><% }) %></select></label>
    <label class="field">Assigned branch<select name="branchId" class="control" required><option value="">Select branch</option><% data.branches.forEach(b=>{ %><option value="<%= b._id %>"><%= b.name %> (<%= b.code %>)</option><% }) %></select></label>
    <fieldset class="field moduleChoices"><legend>Module access</legend><p class="tiny">Choose the subscribed modules this person can use with their role.</p><div class="moduleChoiceGrid"><% if(!data.assignable.length){ %><p class="tiny">No live financial modules are currently subscribed.</p><% } %><% data.assignable.forEach(m=>{ %><label class="moduleChoice"><input type="checkbox" name="allowedModules" value="<%= m %>"><span><%= m.replace(/_/g,' ') %></span></label><% }) %></div></fieldset>
    <% if(!data.branches.length){ %><p class="tiny" role="status">Add an active branch before inviting staff.<% if(user.role==='Tenant Owner'){ %> <a href="/tenant/branches">Manage branches</a><% } %></p><% } %>
    <button class="btn btnPrimary" <%= data.branches.length?'':'disabled' %>>Invite staff</button>
    <p class="tiny">Access follows the assigned branch, role and modules. <% if(data.inviteMailReady){ %>A secure email will be queued automatically, with a backup link available on the next page.<% }else{ %>Email delivery is not configured; a private manual invitation link will appear.<% } %></p>
  </div></form>
  <section class="card"><div class="cardHead"><b>Seat usage</b><span>Staff capacity</span></div><div class="cardBody summary"><div class="sumRow"><span>Reserved seats</span><b><%= tenant.seatsReserved||1 %></b></div><div class="sumRow"><span>Plan limit</span><b><%= data.plan?.limits.users||'—' %></b></div><div class="sumRow"><span>Pending invitations</span><b><%= data.invitations.length %></b></div><p class="tiny">Disabling staff releases their seat. Role and branch changes revoke active sessions.</p></div></section>
</div>
<section class="card" style="margin-top:14px"><div class="cardHead"><b>Team directory and permissions</b><span><%= user.role==='Tenant Owner'?'Tenant-wide controls':'Assigned-branch controls' %></span></div><div class="cardBody tableWrap"><table><thead><tr><th>Account</th><th>Role & status</th><th>Branch</th><th>Modules</th><th>Actions</th></tr></thead><tbody>
<% data.users.forEach(u=>{ %><tr data-search-row><td><div class="dataCellLine" title="<%= u.name %> · <%= u.email %>"><b><%= u.name %></b><span class="tiny"><%= u.email %></span></div></td><td><div class="dataCellLine"><span><%= u.role %></span><span class="tag"><%= u.status %></span></div></td>
<td><%= data.branches.find(b=>String(b._id)===String(u.branchId))?.name||'Tenant-wide / unassigned' %></td><td><span class="cellEllipsis" title="<%= u.role==='Tenant Owner'?'All subscribed':(u.allowedModules||[]).join(', ')||'Not explicitly assigned' %>"><%= u.role==='Tenant Owner'?'All subscribed':(u.allowedModules||[]).join(', ')||'Not explicitly assigned' %></span></td><td><div class="actionLine">
<% if(u.role!=='Tenant Owner'){ %>
<a class="btn" href="/tenant/users/<%= u._id %>/edit">Edit access</a>
<% if(u.status==='active'){ %><form method="post" action="/tenant/users/<%= u._id %>/disable"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btnDanger" type="submit">Disable</button></form><% } else { %><form method="post" action="/tenant/users/<%= u._id %>/enable"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Restore</button></form><% } %>
<% } else { %><span class="tiny">Protected owner account</span><% } %></div></td></tr><% }) %>
</tbody></table></div></section>
<section class="card" style="margin-top:14px"><div class="cardHead"><b>Outstanding invitations</b><span>Single-use activation links</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Email</th><th>Role</th><th>Branch</th><th>Expires</th><th>Action</th></tr></thead><tbody>
<% if(!data.invitations.length){ %><tr><td colspan="5">No outstanding invitations.</td></tr><% } %>
<% data.invitations.forEach(i=>{ %><tr><td><%= i.email %></td><td><%= i.role %></td><td><%= data.branches.find(b=>String(b._id)===String(i.branchId))?.name||'—' %></td><td><%= new Date(i.expiresAt).toISOString() %></td><td><form method="post" action="/tenant/users/invitations/<%= i._id %>/revoke"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btnDanger">Revoke invitation</button></form></td></tr><% }) %>
</tbody></table></div></section>
</section>