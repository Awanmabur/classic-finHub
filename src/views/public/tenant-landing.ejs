<% const landing=data.landing; %>
<section class="hero"><div class="hero-copy reveal"><p class="kicker"><%= landing?.name||data.tenant.name %></p><h1><%= landing?.headline||data.tenant.name %></h1><p class="lead"><%= landing?.subtitle||'Contact our team for information about our services.' %></p><div class="hero-actions"><a href="/signin" class="btn btn-dark">Tenant login</a><% if(landing?.supportPhone){ %><span class="btn btn-light">Support: <%= landing.supportPhone %></span><% } %></div></div><div class="hero-dashboard reveal"><div class="money-card"><div><span>Our services</span><h2><%= (landing?.services||[]).length %></h2></div><i class="fa-solid fa-layer-group" aria-hidden="true"></i></div><div class="dash-list"><% (landing?.services||[]).forEach(service=>{ %><div><i class="fa-solid fa-check" aria-hidden="true"></i><span><%= service %></span></div><% }) %></div></div></section>
<% if(landing?.sections?.length){ %><section class="section"><div class="feature-grid"><% landing.sections.forEach(section=>{ %><article class="feature-card"><h2><%= section.name %></h2><p><%= section.description %></p></article><% }) %></div></section><% } %>
