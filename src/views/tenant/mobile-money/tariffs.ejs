<link rel="stylesheet" href="/css/workspace.css?v=<%= assetVersion %>">
<section class="view show workspaceStack networkTariffPage">
 <section class="card">
  <div class="cardHead"><div><b>Network agent commission sheets</b><br><span>Cash deposit and withdrawal rates for each agent network and branch</span></div><a class="btn" href="/tenant/treasury">Cash &amp; float accounts</a></div>
  <div class="cardBody workspaceStack">
   <p class="tiny">These are agent commission schedules, NOT customer withdrawal charges. Quotes never increase cash, float, income or profit. Only the network's actual, independently reconciled payout may enter the books.</p>
   <div class="workspaceActions"><a class="btn" href="/tenant/mobile-money/network-activity">Network activity</a><a class="btn" href="/tenant/mobile-money/report">Operations report</a><a class="btn" href="/tenant/workspace/pricing">Customer fees &amp; costs</a></div>
  </div>
 </section>
 <section class="card">
  <div class="cardHead"><div><b>Published customer network charges</b><br><span>Separate from agent commission and financial profit</span></div></div>
  <div class="cardBody workspaceStack">
   <p class="tiny">These provider tables are informational references. Customer network fees can include separate taxes, may be revised, and are charged by the provider — never automatically credited as agent income. The Airtel schedule below contains historical effective-date text.</p>
   <% data.customerTariffReferences.forEach(source=>{ %>
   <details class="networkTariffRecord">
    <summary><span><b><%= source.label %></b><small><%= source.currency %> · Deposit: <%= data.formatMinor(source.depositFeeMinor,source.currency) %> network fee</small></span><span class="tag"><%= source.status==='published_reference'?'Published reference':'Historical — verify' %></span></summary>
    <div class="networkTariffRecordBody">
     <p class="tiny"><%= source.note %></p>
     <div class="networkTariffMetadata"><span>Network <b><%= source.label %></b></span><span>Checked <b><%= source.checkedOn %></b></span><span>Source <a href="<%= source.source %>" target="_blank" rel="noopener noreferrer">View official provider table</a></span></div>
     <div class="tableWrap"><table><thead><tr><th>Amount from</th><th>Amount to</th><% source.operations.forEach(op=>{ %><th><%= op.label %></th><% }) %></tr></thead><tbody>
      <% source.bands.forEach(tier=>{ %><tr><td><%= data.formatMinor(tier.minMinor,source.currency) %></td><td><%= data.formatMinor(tier.maxMinor,source.currency) %></td>
       <% source.operations.forEach(op=>{const charge=tier.charges[op.key];%><td><%= charge==null?'Not available':data.formatMinor(charge,source.currency) %></td><% }) %>
      </tr><% }) %>
     </tbody></table></div>
    </div>
   </details>
   <% }) %>
   <div class="workspaceNote"><b>MTN MoMo South Sudan, Africell and other markets:</b> A complete current public fee and agent-commission sheet has not been verified. Configure the provider market and independently review its genuine contract before any local quote is trusted. Missing rates remain unavailable; they are never invented.</div>
  </div>
 </section>
 <section class="card">
  <div class="cardHead"><b>Configured network schedules</b><span><%= data.schedules.length %> saved</span></div>
  <div class="cardBody workspaceStack">
   <% if(!data.schedules.length){ %><p class="tiny">No agent commission schedule has been entered. MTN South Sudan and other providers will show no automatic commission rather than an invented rate.</p><% } %>
   <% data.schedules.forEach(schedule=>{ const branch=data.branches.find(b=>String(b._id)===String(schedule.branchId)); %>
   <details class="networkTariffRecord">
    <summary><span><b><%= schedule.network==='MTN SSD'?'MTN MoMo South Sudan':schedule.network==='MTN'?'MTN MoMo Uganda':schedule.network %></b><small><%= branch?.name||'Assigned branch' %> · <%= schedule.currency %> · <%= schedule.operation==='cash_in'?'Customer deposit':'Customer withdrawal' %> · Version <%= schedule.version %></small></span><span class="tag"><%= schedule.status==='approved'?'Approved for quoting':schedule.status==='retired'?'Retired':'Awaiting independent review' %></span></summary>
    <div class="networkTariffRecordBody">
     <div class="networkTariffMetadata"><span>Effective from <b><%= new Date(schedule.effectiveFrom).toISOString().slice(0,10) %></b></span><span>Source <b><%= schedule.evidenceReference %></b></span><span>Independent reviewer <b><%= schedule.approvedBy?'Recorded':'Pending' %></b></span></div>
     <div class="tableWrap"><table><thead><tr><th>Minimum (<%= schedule.currency %>)</th><th>Maximum</th><th>Commission type</th><th>Rate (minor units or bps)</th></tr></thead><tbody>
      <% schedule.tiers.forEach(tier=>{ %><tr><td><%= data.formatMinor(tier.minMinor,schedule.currency) %></td><td><%= data.formatMinor(tier.maxMinor,schedule.currency) %></td><td><%= tier.rate.kind==='flat'?'Fixed':'Percentage' %></td><td><%= tier.rate.value %><%= tier.rate.kind==='basis_points'?' bps':'' %></td></tr><% }) %>
     </tbody></table></div>

     <form class="networkTariffQuoteForm" method="get" action="/tenant/mobile-money/tariffs/<%= schedule._id %>/quote">
      <label class="field">Transaction amount (<%= schedule.currency %>)<input class="control" name="amount" type="text" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" placeholder="Amount to quote" required></label>
      <button class="btn" type="submit">Estimate commission</button>
      <span class="tiny">Reference estimate only — no money is posted.</span>
     </form>
     <% if(data.canPropose&&schedule.status==='draft'){ %>
     <details class="networkTariffEdit"><summary>Edit draft rates</summary>
      <form class="networkTariffForm" method="post" action="/tenant/mobile-money/tariffs/<%= schedule._id %>/edit">
       <input type="hidden" name="_csrf" value="<%= csrfToken %>">
       <input type="hidden" name="revision" value="<%= schedule.revision %>">
       <label class="field">Provider agreement or schedule reference<input class="control" name="evidenceReference" minlength="12" maxlength="350" required value="<%= schedule.evidenceReference %>"></label>
       <label class="field">Rate bands<textarea class="control networkTariffBands" name="bands" rows="7" maxlength="30000" required spellcheck="false"><%= data.serializeLines(schedule.tiers) %></textarea></label>
       <div class="networkTariffActions"><button class="btn" type="submit">Save draft revisions</button><span class="tiny">Approved schedules are immutable. Updates require an independent review.</span></div>
      </form>
     </details>
     <% } %>
     <% if(data.canReview&&schedule.status==='draft'){ %>
      <div class="networkTariffAction"><p class="tiny">Review the original provider agreement before approving. You cannot approve your own submission.</p>
       <form action="/tenant/mobile-money/tariffs/<%= schedule._id %>/approve" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btnPrimary">Approve rate sheet</button></form>
      </div>
     <% } %>
     <% if(data.canReview&&schedule.status==='approved'){ %>
      <form action="/tenant/mobile-money/tariffs/<%= schedule._id %>/retire" method="post" class="networkTariffAction"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn">Retire rate sheet</button></form>
     <% } %>
     <p class="tiny">A schedule is an estimate. The provider balance or daily commission statement is required before recognizing actual commission revenue.</p>
    </div>
   </details>
   <% }) %>
  </div>
 </section>
 <% if(data.canPropose){ %>
 <section class="card">
  <div class="cardHead"><div><b>Submit agent commission sheet</b><br><span>Tenant Owner · independent approval required</span></div></div>
  <form class="cardBody networkTariffForm" method="post" action="/tenant/mobile-money/tariffs" autocomplete="off">
   <input type="hidden" name="_csrf" value="<%= csrfToken %>">
   <div class="networkTariffFields">
    <label class="field">Network<select name="network" class="control" required><option value="">Choose network</option><% data.providerChoices.forEach(p=>{ %><option value="<%= p.key %>"><%= p.displayName %> — <%= p.currency %></option><% }) %></select></label>
    <label class="field">Currency<select name="currency" class="control" required><option value="">Choose currency</option><option value="UGX">UGX — Uganda shilling</option><option value="SSP">SSP — South Sudanese pound</option></select></label>
    <label class="field">Branch<select name="branchId" class="control" required><option value="">Choose branch</option><% data.branches.forEach(b=>{ %><option value="<%= b._id %>"><%= b.name %></option><% }) %></select></label>
    <label class="field">Agent operation<select name="operation" class="control" required><option value="cash_in">Customer deposit (Cash-in)</option><option value="cash_out">Customer withdrawal (Cash-out)</option></select></label>
    <label class="field">Effective from (UTC)<input type="date" name="effectiveFrom" class="control" required></label>
    <label class="field">Expires (optional)<input type="date" name="expiresAt" class="control"></label>
   </div>
   <label class="field">Provider rate sheet, contract or statement reference<input name="evidenceReference" class="control" minlength="12" maxlength="350" required placeholder="Source document reference, issuer and revision date"><span class="tiny">A source reference records the document's identity; it does not automatically verify a provider-issued tariff.</span></label>
   <label class="field">Commission bands<textarea name="bands" class="control networkTariffBands" rows="8" maxlength="30000" required spellcheck="false" placeholder="500, 2500, basis_points, 400&#10;2501, 5000, flat, 110"></textarea><span class="tiny">One row per band: minimum amount, maximum amount, flat or basis_points, rate. Use exact minor units. For UGX, 100 means UGX 100. For SSP, check the system currency precision before entering bands. 100 basis points = 1%. No overlapping ranges.</span></label>
   <div class="networkTariffActions"><button class="btn btnPrimary" type="submit">Submit for review</button><span class="tiny">This does not change customer fees or post any money.</span></div>
  </form>
 </section>
 <% } %>

 <section class="card">
  <div class="cardHead"><div><b>Provider commission payouts</b><br><span>Statement-backed receipts, independent review and separate income posting</span></div><span class="tag"><%= data.postingEnabled?'Posting gate enabled':'Posting locked' %></span></div>
  <div class="cardBody workspaceStack">
   <% if(!data.postingEnabled){ %><p class="workspaceNote">Payout posting is disabled until historic wallet commission entries are reconciled and a staging release gate passes. Submissions are stored as evidence only, not treated as cash, float or profit.</p><% } %>
   <% if(data.canSubmitPayout){ %>
   <details class="networkTariffRecord"><summary><b>Record a provider commission credit</b><span class="tag">Requires statement evidence</span></summary>
    <form class="networkTariffRecordBody networkTariffForm" method="post" action="/tenant/mobile-money/tariffs/payouts">
     <input type="hidden" name="_csrf" value="<%= csrfToken %>">
     <div class="networkTariffFields">
      <label class="field">Receiving network wallet<select name="walletAccountId" class="control" required><option value="">Choose reconciled wallet</option><% data.commissions.wallets.forEach(wallet=>{ %><option value="<%= wallet._id %>"><%= wallet.name %> · <%= wallet.network %> · <%= wallet.currency %></option><% }) %></select></label>
      <label class="field">Provider network<select name="network" class="control" required><option value="">Choose network</option><% data.providerChoices.forEach(p=>{ %><option value="<%= p.key %>"><%= p.displayName %></option><% }) %></select></label>
      <label class="field">Currency<select name="currency" class="control" required><option value="UGX">UGX</option><option value="SSP">SSP</option><option value="KES">KES</option><option value="USD">USD</option></select></label>
      <label class="field">Net commission actually credited<input name="amount" class="control" type="text" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" placeholder="0.00" required></label>
      <label class="field">Gross commission before deductions<input name="grossAmount" class="control" type="text" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" placeholder="0.00" required></label>
      <label class="field">Tax withheld by provider<input name="taxWithheld" class="control" type="text" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" value="0" required></label>
      <label class="field">Provider commission deduction / cost<input name="providerCost" class="control" type="text" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" value="0" required></label>
      <label class="field">Provider commission credit reference<input name="providerReference" class="control" minlength="6" maxlength="120" placeholder="Unique credit or statement reference" required></label>
      <label class="field">Actual provider credit time (UTC)<input name="creditedAt" class="control" type="datetime-local" required></label>
     </div>
     <label class="field">Statement evidence and proof reference<input name="statementEvidence" class="control" minlength="12" maxlength="350" placeholder="Statement date, provider, account and trace ID" required></label>
     <div class="networkTariffActions"><button class="btn btnPrimary" type="submit">Submit credit for reconciliation</button><span class="tiny">No balance changes until independent review and a posting-enabled environment.</span></div>
    </form>
   </details>
   <% } %>
   <% if(!data.commissions.records.length){ %><p class="tiny">No commission credits recorded for your permitted wallets.</p><% } %>
   <% data.commissions.records.forEach(payout=>{ %>
    <div class="networkTariffPayout">
     <div class="networkTariffPayoutDetails"><b><%= payout.network==='MTN SSD'?'MTN South Sudan':payout.network %> — <%= data.formatMinor(payout.amountMinor,payout.currency) %></b><span><%= payout.providerReference %> · <%= new Date(payout.creditedAt).toISOString().slice(0,16).replace('T',' ') %> UTC</span><span class="tiny"><%= payout.statementEvidence %></span></div>
     <span class="tag"><%= payout.status==='posted'?'Posted income':payout.status==='rejected'?'Rejected':'Pending review' %></span>
     <% if(data.canReviewPayout&&payout.status==='pending_review'){ %>
     <form class="networkTariffReview" method="post" action="/tenant/mobile-money/tariffs/payouts/<%= payout._id %>/review">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field">Review note (minimum 12 characters)<input class="control" name="note" minlength="12" maxlength="400" placeholder="Compare original provider credit statement and ledger" required></label>
      <div class="networkTariffActions"><button class="btn" name="decision" value="reject">Reject evidence</button>
       <% if(data.postingEnabled){ %><button class="btn btnPrimary" name="decision" value="approve">Approve and post</button><% }else{ %><span class="tiny">Posting requires a verified historical-commission migration and financial release approval.</span><% } %>
      </div>
     </form>
     <% } %>
    </div>
   <% }) %>
  </div>
 </section>

</section>
