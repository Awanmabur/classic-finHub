<% const planByCode = Object.fromEntries(plans.map(plan => [plan.code, plan]));
const starterPlan = planByCode.starter_trial;
const agentPlan = planByCode.agent;
const financePlan = planByCode.finance;
const enterprisePlan = planByCode.enterprise; %>
<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="icon" type="image/png" href="/images/classicfinhub-logo.png">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ClassicFin Hub pricing | Plans, trials, modules and addons</title>
  <meta name="description" content="Compare ClassicFin Hub pricing plans: Starter Trial, Agent Plan, Finance Plan, Enterprise Plan, module subscriptions, trials, addons, invoices, billing and limits." />
  <link rel="stylesheet" href="/vendor/inter/inter.css?v=<%= assetVersion %>" />
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= assetVersion %>" />
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="ClassicFin Hub" />
  <meta property="og:title" content="ClassicFin Hub pricing | Plans, trials, modules and addons" />
  <meta property="og:description" content="Compare ClassicFin Hub pricing plans: Starter Trial, Agent Plan, Finance Plan, Enterprise Plan, module subscriptions, trials, addons, invoices, billing and limits." />
  <meta property="og:image" content="<%= appUrl %>/images/classicfinhub-logo.png" />
  <meta property="og:image:alt" content="ClassicFin Hub logo" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="ClassicFin Hub pricing | Plans, trials, modules and addons" />
  <meta name="twitter:description" content="Compare ClassicFin Hub pricing plans: Starter Trial, Agent Plan, Finance Plan, Enterprise Plan, module subscriptions, trials, addons, invoices, billing and limits." />
  <meta name="twitter:image" content="<%= appUrl %>/images/classicfinhub-logo.png" />
  <link rel="canonical" href="<%= appUrl %>/pricing">
  <meta property="og:url" content="<%= appUrl %>/pricing">
