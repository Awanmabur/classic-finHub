<% const currentBranch = typeof operationBranch !== 'undefined' ? operationBranch : (data.branches || []).find(b => String(b._id) === String(user.transactionBranchId || user.branchId || data.selectedBranchId || '') && b.status !== 'archived');
   const currentBranchId = currentBranch ? String(currentBranch._id) : null;
   const branchProblem = typeof operationBranchError === 'string' && operationBranchError ? operationBranchError : 'An active operating branch must be assigned to your account before creating records.'; %>
<section class="view show">
 <%- include('../../partials/operation-branch', {currentBranch, branchProblem, user}) %>
 <section class="card"><div class="cardHead"><b><%= data.workspaceTitle||'Transfer requests — internal operations' %></b><span>Reviewed manual collection and payout</span><a class="btn" href="/tenant/money-transfer/records">Money transfer record</a></div>
  <div class="cardBody">
   <p class="tiny">Save sender and receiver details, record the actual collection against opened funds accounts, and obtain independent review to generate the payout PIN.</p>
   <div class="rowBtns"><a class="btn" href="/tenant/funded">Manual movements &amp; review</a><a class="btn" href="/tenant/treasury">Balances &amp; reconciliation</a><a class="btn" href="/tenant/money-transfer/contacts">Manage sender and beneficiary contacts</a><a class="btn" href="/tenant/money-transfer/payout">Payout by PIN</a><a class="btn" href="/tenant/money-transfer/pending-payouts">Pending payout queue</a><a class="btn" href="/tenant/money-transfer/fees">Transfer fee summary</a><a class="btn" href="/tenant/money-transfer/report">Transfer report summary</a></div>

  </div>
 </section>
 <div class="grid" style="margin-top:14px">
  <% if(data.canCreate && currentBranchId){ %><form method="post" action="/tenant/money-transfer/requests" class="card" autocomplete="off" data-transfer-form data-currency="<%= currentBranch.currency %>">
   <input type="hidden" name="_csrf" value="<%= csrfToken %>">
   <input type="hidden" name="idempotencyKey" value="<%= data.idempotencyKey %>">

   <div class="cardHead"><b><%= data.workspaceTitle||'New transfer request' %></b><span>Independent collection review required</span></div>
   <div class="cardBody" style="display:grid;gap:12px">
    <%- include('_entry-form',{currentBranch}) %>
   </div>
  </form><% } else if(data.canCreate){ %><section class="card"><div class="cardHead"><b>New request</b></div><div class="cardBody"><p class="tiny">Your account needs an active operating branch before creating a request.</p></div></section><% } %>
  <section class="card"><div class="cardHead"><b>Recent transfer requests</b><span><%= data.records.items.length %> visible</span></div>
   <div class="cardBody txList">
    <% if(!data.records.items.length){ %><p class="tiny">No transfer requests found in your authorized scope.</p><% } %>
    <% data.records.items.forEach(t=>{ %><div class="tx" data-search-row><div class="txMeta"><b><a href="/tenant/money-transfer/<%= t._id %>"><%= t.reference %></a></b><span><%= t.sender.name %> → <%= t.beneficiary.name %> · <%= t.status.replaceAll('_',' ') %></span></div><b><%= data.formatMoneyMinor(t.amountMinor,t.currency) %></b></div><% }) %>
   </div><div class="cardBody"><a class="btn" href="/tenant/money-transfer/history">All request history</a></div>
  </section>
 </div>
 <% if(data.canReview){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Independent review queue</b><span>Two-person decision</span></div><div class="cardBody">
  <% if(!data.queue.length){ %><p class="tiny">No requests await your independent review.</p><% } %>
  <% data.queue.forEach(t=>{ %><form method="post" action="/tenant/money-transfer/<%= t._id %>/review" class="card" style="margin-bottom:12px;padding:12px">
   <input type="hidden" name="_csrf" value="<%= csrfToken %>">
   <div class="cardHead"><b><a href="/tenant/money-transfer/<%= t._id %>"><%= t.reference %></a></b><span><%= data.formatMoneyMinor(t.amountMinor,t.currency) %></span></div>
   <p class="tiny">Sender: <%= t.sender.name %> · Beneficiary: <%= t.beneficiary.name %> · Expires: <%= new Date(t.expiresAt).toISOString().slice(0,10) %></p>
   <label class="field">Decision rationale (12–400 characters)<textarea class="control" name="note" minlength="12" maxlength="400" required rows="2" placeholder="Record evidence reviewed and decision rationale; do not include sensitive identification documents"></textarea></label>
   <div class="rowBtns"><button class="btn btnPrimary" type="submit" name="decision" value="approve">Approve pending provider</button><button class="btn" type="submit" name="decision" value="reject">Reject</button></div>
  </form><% }) %>
 </div></section><% } %>
</section>
