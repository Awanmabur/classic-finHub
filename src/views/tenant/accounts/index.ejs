<section class="view show"><section class="card"><div class="cardHead"><b>Accounts</b><span>Open accounts, deposits, withdrawals, account transfers, statements.</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Number</th><th>Customer</th><th>Type</th><th>Currency</th><th>Balance</th><th>Status</th></tr></thead><tbody><% data.accounts.forEach(a => { %><tr data-search-row><td><b><%= a.number %></b></td><td><%= a.customer %></td><td><%= a.type %></td><td><%= a.currency %></td><td><%= money(a.currency,a.balance) %></td><td><span class="tag"><%= a.status %></span></td></tr><% }) %></tbody></table></div></section></section>
