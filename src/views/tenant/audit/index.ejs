<section class="view show"><section class="card"><div class="cardHead"><b>Tenant audit logs</b><span>Actor, action, module, IP, before/after ready.</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Actor</th><th>Action</th><th>Module</th><th>IP</th><th>Date</th></tr></thead><tbody><% data.auditLogs.forEach(a => { %><tr data-search-row><td><%= a.actor %></td><td><%= a.action %></td><td><%= a.module %></td><td><%= a.ip %></td><td><%= a.createdAt %></td></tr><% }) %></tbody></table></div></section></section>
