# PRIVATE host service configuration. NEVER commit a completed copy.
# FULL replica-set URI: leave database path EMPTY to include platform + ALL tenant DBs.
# Use a dedicated authenticated backup user with sufficient backup/cluster privileges.
BACKUP_SOURCE_URI=
# Absolute 0600 file with 32 random bytes (or 64 hexadecimal characters); hold offsite escrow.
BACKUP_KEY_FILE=/etc/classicfin/backup-key
# Absolute 0700 directory; replicate encrypted archives to offsite immutable storage.
BACKUP_OUTPUT_DIR=/var/backups/classicfin
# Alert if latest authenticated backup is older than this many hours.
BACKUP_MAX_AGE_HOURS=26
# BACKUP_RESTORE_URI only on isolated scratch rs-restore instance, never prod.
# BACKUP_RESTORE_URI=mongodb://127.0.0.1:27019/admin?replicaSet=rs-restore&directConnection=true

# Required for immutable offsite replication. Supported target: AWS S3 with
# versioning + Object Lock enabled; use a separate AWS IAM role / profile.
OFFSITE_S3_BUCKET=
OFFSITE_S3_EXPECTED_OWNER=
OFFSITE_S3_PREFIX=classicfin/
AWS_REGION=
OFFSITE_RETENTION_DAYS=90
OFFSITE_MAX_AGE_HOURS=26
# AWS_PROFILE=classicfin-backup (if configured outside the application)
# Isolated recovery-only directory (0700), not a production MongoDB directory.
# BACKUP_RECOVERY_DIR=/var/backups/classicfin-recovery
