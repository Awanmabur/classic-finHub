<section class="view show"><section class="card"><div class="cardHead"><b>Invoices</b><span>Generated after trial or module addon approval.</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Number</th><th>Tenant</th><th>Plan</th><th>Amount</th><th>Status</th><th>Due</th></tr></thead><tbody><% data.invoices.forEach(i => { %><tr data-search-row><td><b><%= i.number %></b></td><td><%= i.tenantName %></td><td><%= i.plan %></td><td><%= i.currency %> <%= i.amount %></td><td><span class="tag"><%= i.status %></span></td><td><%= i.dueDate %></td></tr><% }) %></tbody></table></div></section></section>
