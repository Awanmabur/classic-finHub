<% const moduleFinance=typeof data.financeOverview==='object'&&data.financeOverview?data.financeOverview:{};
   const modulePosting=(moduleFinance.moduleEarnings||[]).find(item=>item.moduleKey===moduleKey)||{};
   const moduleAssets=(moduleFinance.byModule||[]).find(item=>item.moduleKey===moduleKey)?.totals||[];
   const sharedTreasuryAssets=(moduleFinance.byModule||[]).find(item=>item.moduleKey==='shared')?.totals||[];
   const showSharedForex=moduleKey==='forex'&&!moduleAssets.length&&sharedTreasuryAssets.length>0;
   const financialCards=[
    {title:showSharedForex?'Shared Treasury · reference':'Operating assets · book',items:showSharedForex?sharedTreasuryAssets:moduleAssets,
      empty:moduleKey==='forex'?'Set up Forex stock and settlement balances in Treasury':'No opened module-specific accounts',
      note:showSharedForex?'These shared balances are shown for context only, not allocated to Forex or added again to total assets.':'Only actual opened financial accounts appear here; shared balances are held once in Treasury.'},
    {title:'Posted income · '+(moduleFinance.periodLabel||'today'),items:modulePosting.income||[],empty:'No income posted',note:'Actual collected fees and recognized income only. Currency trading gains require matched inventory cost.'},
    {title:'Posted expenses · '+(moduleFinance.periodLabel||'today'),items:modulePosting.expenses||[],empty:'No expenses posted',note:'Actual booked expenses only, not anticipated costs.'},
    {title:'Posted net income · '+(moduleFinance.periodLabel||'today'),items:modulePosting.net||[],empty:'No posted net income',note:moduleKey==='forex'?'Operating income less booked expenses; Forex trading profit is not fabricated without verified inventory cost basis.':'Posted income less posted expenses.'}
   ]; %>
<% if(moduleFinance.available){ %>
<section class="financialModuleOverview" aria-label="Financial summary for this module" style="margin-top:12px">
 <div class="grid3 overviewStatsGrid moduleStatsGrid">
  <% financialCards.forEach(card=>{ %>
  <div class="stat" title="<%= card.note %>">
   <div class="k"><%= card.title %></div>
   <% if(!card.items.length){ %><div class="v"><%= card.empty %></div>
   <% }else{ %><div class="overviewCurrencyLines">
    <% card.items.forEach(row=>{ %><div class="overviewCurrencyLine">
      <span><%= row.currency==='KES'?'KSH':row.currency %></span>
      <b><%= row.formatted.replace(/^KES /,'KSH ') %></b>
    </div><% }); %>
   </div><% } %>
   <div class="s"><%= card.note %></div>
  </div><% }); %>
 </div>
</section>
<% } else if(typeof user==='object'&&user&&['Tenant Owner','Branch Manager','Reconciliation Officer','Auditor'].includes(user.role)){ %>
<section class="card financialModuleOverview" aria-label="Financial statistics availability">
 <div class="cardHead"><b>Financial summary · <%= moduleKey.replaceAll('_',' ') %></b></div>
 <div class="cardBody"><p class="tiny"><%= moduleFinance.reason||'Choose an active operating branch to display authorized posted financial totals.' %></p></div>
</section>
<% } %>
