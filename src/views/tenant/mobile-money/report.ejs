<% const reportZoneLabel=typeof businessTimeZone==='string'?businessTimeZone:'UTC'; %>
<% const report=data.reportData;
   const exportParams=new URLSearchParams();
   if(report){exportParams.set('period',report.window.key);if(report.window.key==='custom'){exportParams.set('from',report.window.from);exportParams.set('to',report.window.to);}
    if(data.filters?.network)exportParams.set('network',data.filters.network);
    if(data.filters?.currency)exportParams.set('currency',data.filters.currency);}
   const totals=(report?.currencies||[]),groups=report?.networks||[],expenses=report?.expenses||[];
   const count=key=>groups.reduce((sum,row)=>sum+(row[key]||0),0);
   const format=(minor,currency)=>data.formatMoneyMinor(minor,currency); %>
<section class="view show mobileMoneyPage workspaceStack" aria-label="Mobile Money consolidated reporting">
 <section class="card">
  <div class="cardHead"><div><b>Mobile Money business report</b><br><span>One view · provider, currency, verified income, cash movements and expenses</span></div>
   <% if(data.canExport){ %><a class="btn" href="/tenant/mobile-money/report/unified.csv?<%= exportParams.toString() %>">Export consolidated CSV</a><% } %>
  </div>
  <div class="cardBody workspaceStack">
   <p class="tiny">Cash/float principal is not income. Provider commission estimates are not received commission. Customer network charges are not automatically agent earnings. Values are scoped to your accessible branches and records.</p>
   <%- include('_filters',{filterAction:'/tenant/mobile-money/report'}) %>
   <div class="summary">
    <div class="sumRow"><span>Business period (<%= reportZoneLabel %>)</span><b><%= report.window.from %> to <%= report.window.to %></b></div>
    <div class="sumRow"><span>Manual / SMS records</span><b><%= count('manualCount') %> / <%= count('smsCount') %></b></div>
    <div class="sumRow"><span>Provider-unverified recorded entries</span><b><%= count('providerUnverifiedCount') %></b></div>
    <div class="sumRow"><span>Voided originals (excluded from active totals)</span><b><%= count('voidedCount') %></b></div>
   </div>
  </div>
 </section>
 <section class="card">
  <div class="cardHead"><b>Per-currency operating totals</b><span>Never add different currencies together</span></div>
  <div class="cardBody">
   <% if(!totals.length){ %><p class="tiny">No Mobile Money records or posted commission receipts in this period.</p><% } %>
   <% totals.forEach(row=>{ %>
    <div class="mobileMoneyCurrencyBlock">
     <h3><%= row.currency==='KES'?'KSH':row.currency %></h3>
     <div class="networkBalanceGrid">
      <div class="networkBalanceStat"><span>Deposits / Withdrawals</span><strong><%= row.depositCount %> / <%= row.withdrawalCount %></strong><small>Recorded entries, voids excluded</small></div>
      <div class="networkBalanceStat"><span>Transaction volume</span><strong><%= row.volumeMinorFormatted %></strong><small>Principal exchanged — not revenue</small></div>
      <div class="networkBalanceStat"><span>Net cash movement</span><strong><%= row.cashImpactMinorFormatted %></strong><small>Internal physical drawer movement</small></div>
      <div class="networkBalanceStat"><span>Provider commission received</span><strong><%= row.receivedCommissionMinorFormatted %></strong><small>Posted from independently reviewed payout evidence</small></div>
      <div class="networkBalanceStat"><span>Explicitly collected agent fees</span><strong><%= row.collectedFeeMinorFormatted %></strong><small>Only payment_collected policy, not provider charges</small></div>
      <div class="networkBalanceStat"><span>Estimated commission</span><strong><%= row.commissionMissingCount&&String(row.estimatedCommissionMinor)==='0'?'Not configured':row.estimatedCommissionMinorFormatted %></strong><small>From approved tenant sheets · <%= row.commissionMissingCount||0 %> transaction(s) without an approved sheet. Published provider reference amounts appear separately below and never count as income.</small></div>
     </div>
     <div class="summary">
      <div class="sumRow"><span>All transaction fees recorded (including non-income)</span><b><%= row.recordedFeeMinorFormatted %></b></div>
      <div class="sumRow"><span>Provider network customer-charge estimates from approved tenant sheets</span><b><%= row.customerNetworkChargeEstimateMinorFormatted %></b></div>
      <div class="sumRow"><span>Published agent commission reference (not received income)</span><b><%= row.publishedCommissionReferenceMinorFormatted %></b></div>
      <div class="sumRow"><span>Published network charge to customers (not agent revenue)</span><b><%= row.publishedCustomerChargeReferenceMinorFormatted %></b></div>
      <div class="sumRow"><span>Configured operating-cost estimates (not verified cash expenses)</span><b><%= row.configuredCostEstimateMinorFormatted %></b></div>
      <div class="sumRow"><span>Legacy wallet-commission treatment — review for double counting</span><b><%= row.legacyWalletFeeMinorFormatted %></b></div>
      <div class="sumRow"><span>Provider commission gross / withheld tax / provider costs</span><b><%= row.grossCommissionMinorFormatted %> / <%= row.withheldTaxMinorFormatted %> / <%= row.providerCostMinorFormatted %></b></div>
     </div>
    </div>
   <% }) %>
  </div>
 </section>
 <section class="card">
  <div class="cardHead"><b>Network and currency breakdown</b><span>MTN Uganda, Airtel, South Sudan and other configured providers remain distinct</span></div>
  <div class="cardBody tableWrap" tabindex="0" role="region" aria-label="Mobile Money network and currency reporting">
   <table><thead><tr><th>Network · Currency</th><th>Deposits</th><th>Withdrawals</th><th>Principal volume</th><th>Cash impact</th><th>Collected agent fees</th><th>Commission estimated</th><th>Approved provider charge estimate</th><th>Published commission reference</th><th>Published customer network charge</th><th>Configured cost estimate</th><th>Commission received</th></tr></thead>
    <tbody><% if(!groups.length){ %><tr><td colspan="12">No recorded activity in this period.</td></tr><% } %>
     <% groups.forEach(row=>{ %><tr data-search-row>
      <td><b><%= row.network %></b> · <%= row.currency==='KES'?'KSH':row.currency %></td>
      <td><%= row.depositCount %></td><td><%= row.withdrawalCount %></td>
      <td><%= row.volumeMinorFormatted %></td><td><%= row.cashImpactMinorFormatted %></td>
      <td><%= row.collectedFeeMinorFormatted %></td><td><%= row.commissionMissingCount&&String(row.estimatedCommissionMinor)==='0'?'Not configured':row.estimatedCommissionMinorFormatted %><% if(row.commissionMissingCount){ %><small><%= row.commissionMissingCount %> missing sheet</small><% } %></td>
      <td><%= row.customerNetworkChargeEstimateMinorFormatted %></td><td><%= row.publishedCommissionReferenceMinorFormatted %></td><td><%= row.publishedCustomerChargeReferenceMinorFormatted %></td><td><%= row.configuredCostEstimateMinorFormatted %></td>
      <td><%= row.receivedCommissionMinorFormatted %></td>
     </tr><% }) %></tbody>
   </table>
  </div>
 </section>
 <section class="card">
  <div class="cardHead"><b>Approved operating expenses by currency</b><span>Shared branch costs are not arbitrarily allocated to networks</span></div>
  <div class="cardBody">
   <% if(!report.expensesAccessible){ %><p class="tiny">Expense totals unavailable: the Expenses module or reporting permissions are not assigned. A true net-profit figure cannot be established here.</p><% }
   else if(!expenses.length){ %><p class="tiny">No approved expenses in this reporting period. This does not prove the business had no costs.</p><% }else{ %>
    <div class="summary"><% expenses.forEach(expense=>{ %><div class="sumRow"><span><%= expense.currency %> · <%= expense.count %> approved expense(s)</span><b><%= expense.formatted %></b></div><% }) %></div>
   <% } %>
   <p class="tiny">Approved expenses use the independent approval date. They may relate to other business modules. Do not subtract all shared branch costs from one network to claim provider-level profit. Unsettled commissions, tax and expenses not yet recorded are excluded.</p>
   <div class="rowBtns"><a class="btn" href="/tenant/expenses">Record and review expenses</a><a class="btn" href="/tenant/mobile-money/tariffs">Rates and commission payouts</a><a class="btn" href="/tenant/cash/shifts">Cash shifts</a></div>
  </div>
 </section>
 <section class="card"><div class="cardHead"><b>Reporting and reconciliation controls</b></div>
  <div class="cardBody"><p class="tiny"><%= report.note %></p><p class="tiny">This report is based on approved provider-payout receipts, recorded operations and eligible approved expenses. It is not a live network statement or audited annual financial statement. For detailed entries, use Mobile Money History or the independent review queue.</p>
   <div class="rowBtns"><a class="btn" href="/tenant/mobile-money/history">Transaction history</a><a class="btn" href="/tenant/mobile-money">Independent review</a><a class="btn" href="/tenant/treasury">Cash and float reconciliation</a></div>
  </div>
 </section>
</section>
