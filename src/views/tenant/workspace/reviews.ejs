<section class="view show workspaceStack">
  <section class="card">
    <div class="cardHead"><div><b>Customer ratings & reviews</b><br><span>Reply to approved reviews. Customer ratings and comments appear immediately. Owners may reply, and the platform can remove abuse.</span></div><a class="btn" href="/tenant/workspace/landing">Business website</a></div>
    <div class="cardBody">
      <p class="tiny">Submitted customer feedback appears immediately on your public business website. Hidden or withdrawn reviews are not public. Reviews do not verify a real transaction, and a business reply does not alter a customer's rating.</p>
      <% if(!data.reviews.length){ %><p>No reviews submitted for this business yet. Share your published profile link to invite genuine customer feedback.</p><% } %>
      <div class="workspaceStack">
      <% data.reviews.forEach(review=>{ %>
        <div class="card" style="margin-top:12px">
          <div class="cardHead"><div><b><%= review.authorName %> · <%= review.rating %> / 5 stars</b><br><span><%= review.status %> · <%= new Date(review.createdAt).toLocaleDateString('en-GB') %></span></div></div>
          <div class="cardBody"><p style="white-space:pre-line;overflow-wrap:anywhere"><%= review.comment %></p>
            <% if(review.status==='approved'){ %>
              <% if(data.canManage){ %>
              <form method="post" action="/tenant/workspace/reviews/<%= review._id %>/reply">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= review.revision %>">
                <label class="field">Public business reply (clear this field to remove your reply)
                  <textarea name="reply" class="control" maxlength="1200" rows="3" placeholder="Thank the customer and respond professionally"><%= review.ownerReply||'' %></textarea>
                </label>
                <button type="submit" class="btn btnPrimary">Save business reply</button>
              </form>
              <% }else if(review.ownerReply){ %><p class="tiny">Business reply: <%= review.ownerReply %></p><% } %>
            <% }else{ %><p class="tiny">This review cannot receive a public response until approved.</p><% } %>
          </div>
        </div>
      <% }) %>
      </div>
    </div>
  </section>
</section>
