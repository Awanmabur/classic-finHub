<section class="view show"><section class="card"><div class="cardHead"><b>Banking request <%= data.request.reference %></b><span><%= data.request.status.replaceAll('_',' ') %></span></div><div class="cardBody"><p class="tiny"><strong>INTERNAL REQUEST ONLY — NOT BANK CONFIRMATION, BALANCE, OR PROOF OF PAYMENT.</strong> Approval authorizes later verification; it does not execute any banking transaction.</p>
<div class="summary"><div class="sumRow"><span>Operation</span><b><%= data.request.kind.replaceAll('_',' ') %></b></div><div class="sumRow"><span>Requested amount</span><b><%= data.formatMoneyMinor(data.request.amountMinor,data.request.currency) %></b></div><div class="sumRow"><span>Source</span><b><%= data.request.source.customerName %> · <%= data.request.source.institutionName %> · ****<%= data.request.source.last4 %></b></div><% if(data.request.destination){ %><div class="sumRow"><span>Destination</span><b><%= data.request.destination.customerName %> · <%= data.request.destination.institutionName %> · ****<%= data.request.destination.last4 %></b></div><% } %><div class="sumRow"><span>Reason</span><b><%= data.request.note %></b></div><div class="sumRow"><span>Expires UTC</span><b><%= new Date(data.request.expiresAt).toISOString().slice(0,16).replace('T',' ') %></b></div><div class="sumRow"><span>Submitted UTC</span><b><%= new Date(data.request.createdAt).toISOString().slice(0,16).replace('T',' ') %></b></div><div class="sumRow"><span>Internal review</span><b><%= data.request.reviewNote||'Awaiting review' %></b></div></div>
<div class="summary"><% [['Payment channel',data.request.capture?.paymentChannel||'Cash'],['Customer phone / contact',data.request.capture?.customerPhone],['External reference',data.request.capture?.externalReference]].forEach(([label,value])=>{ %><div class="sumRow"><span><%= label %></span><b><%= value||'—' %></b></div><% }) %></div>
<div class="rowBtns" style="margin-top:12px"><a class="btn" href="/tenant/banking/history">Return to history</a></div></div></section>
<% if(data.canReview){ %><form method="post" action="/tenant/banking/<%= data.request._id %>/review" class="card" style="margin-top:14px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="cardHead"><b>Independent review</b></div><div class="cardBody"><label class="field">Rationale (12–400 characters)<textarea name="note" class="control" required minlength="12" maxlength="400" rows="3"></textarea></label><div class="rowBtns"><button type="submit" class="btn btnPrimary" name="decision" value="approve">Approve pending bank</button><button type="submit" class="btn" name="decision" value="reject">Reject request</button></div></div></form><% } %>
<% if(data.canCancel){ %><form method="post" action="/tenant/banking/<%= data.request._id %>/cancel" class="card" style="margin-top:14px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="cardHead"><b>Cancel undecided request</b></div><div class="cardBody"><label class="field">Reason (12–400 characters)<textarea name="note" class="control" required minlength="12" maxlength="400" rows="2"></textarea></label><button class="btn" type="submit">Cancel pending request</button></div></form><% } %>
</section>
