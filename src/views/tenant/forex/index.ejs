<% const currentBranch = typeof operationBranch !== 'undefined' ? operationBranch : (data.branches || []).find(b => String(b._id) === String(user.transactionBranchId || user.branchId || data.selectedBranchId || '') && b.status !== 'archived');
   const currentBranchId = currentBranch ? String(currentBranch._id) : null;
   const branchProblem = typeof operationBranchError === 'string' && operationBranchError ? operationBranchError : 'An active operating branch must be assigned to your account before creating records.';
   const actualForexCurrencies=[...new Set((data.currencyChoices||[]).map(option=>option.code))];
   const proposalCurrencies=[...actualForexCurrencies,...(actualForexCurrencies.includes('EUR')?[]:['EUR'])];
   const approvedForexRates=(data.formRates||data.rates||[]).filter(rate=>rate.status==='active'&&new Date(rate.expiresAt)>new Date()); %>
<section class="view show">
 <%- include('../../partials/operation-branch', {currentBranch, branchProblem, user}) %>
 <%- include('../partials/module-finance',{moduleKey:'forex'}) %>
 <section class="card"><div class="cardHead"><b><%= data.workspaceTitle||'Forex trading and rates' %></b><span>Approved rates · actual exchange posting</span></div>
  <div class="cardBody"><p class="tiny">Use the authorized Buy or Sell rate, record the actual exchange against opened currency accounts, and finalize it in the funds books.</p>
   <div class="rowBtns"><% if(data.canMobileFx){ %><a class="btn" href="/tenant/mobile-money/cash-out?fx=1">Mobile Money withdrawal in another currency</a><% } %><a class="btn" href="/tenant/funded">Manual movements &amp; review</a><a class="btn" href="/tenant/treasury">Balances &amp; reconciliation</a><a class="btn" href="/tenant/forex/buy">Buy forex from customer</a><a class="btn" href="/tenant/forex/sell">Sell forex to customer</a><a class="btn" href="/tenant/forex/rates">Active rate board</a><a class="btn" href="/tenant/forex/cash-impact">Forex cash impact</a><a class="btn" href="/tenant/forex/records">Forex operation records</a><a class="btn" href="/tenant/forex/report">Forex report summary</a></div>

  </div></section>
 <div class="grid" style="margin-top:14px">
 <% if(data.canPropose && currentBranchId && proposalCurrencies.length>=2 && !['buy','sell'].includes(data.workspaceOperation)){ %><form method="post" action="/tenant/forex/rates" id="forexRateProposalForm" class="card" autocomplete="off"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="cardHead"><b>Set Buy/Sell or indicative rate</b><span><%= user.role==='Tenant Owner'?'Owner rates activate immediately':'Staff rate changes need authorization' %></span></div><div class="cardBody" style="display:grid;gap:12px">
   <div class="row2"><label class="field">Source currency<select class="control" name="fromCurrency" data-forex-rate-source required><% proposalCurrencies.forEach((c,i)=>{ %><option value="<%= c %>" <%= i===0?'selected':'' %>><%= c==='EUR'?'EUR (quote only)':c==='KES'?'KSH':c %></option><% }) %></select></label><label class="field">Target currency<select class="control" name="toCurrency" required><% proposalCurrencies.forEach((c,i)=>{ %><option value="<%= c %>" <%= i===1?'selected':'' %>><%= c==='EUR'?'EUR (quote only)':c==='KES'?'KSH':c %></option><% }) %></select></label></div>
   <label class="field">Rate purpose<select class="control" name="side" required><option value="buy">Buy foreign currency from customer</option><option value="sell">Sell foreign currency to customer</option><option value="quote">Indicative quotation only</option></select></label>
   <p class="tiny">Buying and selling have separate approved prices for the same pair. Choose two different currencies. Only enabled branch currencies can be exchanged in cash. EUR is for indicative quotes until EUR cash/ledger support is added.</p>
   <div class="row2" data-forex-rate-editor>
    <label class="field">Quoted source amount
     <select name="rateBaseUnits" class="control" data-rate-basis required>
      <option value="1">1 source unit</option><option value="100">100 source units</option><option value="1000" selected>1,000 source units</option>
     </select>
    </label>
    <label class="field">Target currency amount for this source amount
     <input name="quotedRate" class="control" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,8})?" placeholder="Enter actual agreed rate" required>
    </label>
   </div>
   <p class="tiny">Example: If 1,000 UGX buys 4,000 SSP, enter source amount 1,000 and target amount 4,000. Only the normalized rate is stored; no past rates are silently changed.</p>
   <label class="field">Rate validity<select name="validHours" class="control" required><% for(let hours=1;hours<=72;hours++){ %><option value="<%= hours %>" <%= hours===24?'selected':'' %>><%= hours %> hour<%= hours===1?'':'s' %></option><% } %></select></label>
   <label class="field">Source and justification (12–400 characters)<textarea name="note" class="control" rows="2" minlength="12" maxlength="400" required></textarea></label>
   <button class="btn btnPrimary" type="submit"><%= user.role==='Tenant Owner'?'Activate exchange rate':'Submit rate for review' %></button>
  </div></form><% } %>
 <% if(approvedForexRates.length){ %>
 <section class="card"><div class="cardHead"><b>Approved rate board</b><div class="rowBtns"><span>Provider verification not automatic</span><a class="btn" href="<%= data.showRetiredRates?'/tenant/forex':'/tenant/forex?rates=retired' %>"><%= data.showRetiredRates?'Hide retired':'Retired rates' %></a></div></div><div class="cardBody tableWrap"><table><thead><tr><th>Pair</th><th>Purpose</th><th>Rate</th><th>State</th><th>Expires UTC</th><% if(data.canPropose){ %><th>Actions</th><% } %></tr></thead><tbody><% data.rates.filter(r=>r.status==='active' && new Date(r.expiresAt)>new Date()).forEach(r=>{ %><tr><td><%= r.fromCurrency %> → <%= r.toCurrency %></td><td><%= r.side==='buy'?'Buy':r.side==='sell'?'Sell':'Indicative' %></td><td><% const rd=data.rateDisplay(r.rateDecimal,r.fromCurrency); %><%= rd.text %> = <%= rd.rate %> <%= r.toCurrency %></td><td><%= r.status %></td><td><%= new Date(r.expiresAt).toISOString().slice(0,16).replace('T',' ') %></td><% if(data.canPropose){ %><td><% if(String(r.branchId)===String(currentBranchId)){ %>
  <a class="btn" href="#forexRateProposalForm" data-replace-forex-rate data-from="<%= r.fromCurrency %>" data-to="<%= r.toCurrency %>" data-side="<%= r.side %>" data-rate="<%= r.rateDecimal %>">Replace rate</a>
  <% if(data.canRateReview){ %><details class="forexRetireAction"><summary>Retire</summary><form method="post" action="/tenant/forex/rates/<%= r._id %>/retire"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field">Reason<textarea class="control" name="note" minlength="12" maxlength="400" rows="2" required placeholder="Reason to remove this rate from active use"></textarea></label><button class="btn" type="submit">Retire rate</button></form></details><% } %>
  <% } %></td><% } %></tr><% }) %></tbody></table></div></section>
 <% }else{ %><p class="tiny">No active Forex rate for this branch yet. The Tenant Owner can activate the Buy/Sell rates above; cash exchanges require an active valid rate.</p><% } %>
 </div>
 <% if(data.showRetiredRates){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Retired Forex rates</b><span>Inactive board values retained for audit</span></div><div class="cardBody tableWrap">
 <table><thead><tr><th>Pair</th><th>Side</th><th>Historical rate</th><th>Retired</th><th>Reason</th></tr></thead><tbody>
 <% if(!(data.retiredRates||[]).length){ %><tr><td colspan="5">No retired rates for the selected operating branch.</td></tr><% } %>
 <% (data.retiredRates||[]).forEach(r=>{ %><tr><td><%= r.fromCurrency %> → <%= r.toCurrency %></td><td><%= r.side %></td><td><%= r.rateDecimal %></td><td><%= r.retiredAt?new Date(r.retiredAt).toISOString().slice(0,16).replace('T',' '):'—' %> UTC</td><td><%= r.retireNote||'—' %></td></tr><% }) %>
 </tbody></table></div></section><% } %>
 <div class="grid" style="margin-top:14px">
 <% if(data.canQuote && currentBranchId && data.workspaceOperation!=='rates'){ %><form class="card" method="post" action="/tenant/forex/quotes" autocomplete="off" data-forex-form><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= data.idempotencyKey %>"><input type="hidden" name="operation" value="<%= ['buy','sell'].includes(data.workspaceOperation)?data.workspaceOperation:'quote' %>">
  <div class="cardHead"><b><%= data.workspaceOperation==='buy'?'Forex Operations - Buy':data.workspaceOperation==='sell'?'Forex Operations - Sell':'Create a customer quote' %></b><span>Locked rate snapshot · actual cash trade</span></div><div class="cardBody" style="display:grid;gap:12px">
   <%- include('_entry-form',{currentBranchId}) %>
  </div></form><% } %>
 <section class="card"><div class="cardHead"><b>Recent quotations</b><span>Branch and role scoped</span></div><div class="cardBody txList"><% if(!data.records.items.length){ %><p class="tiny">No quotes in your permitted scope.</p><% } %><% data.records.items.slice(0,12).forEach(q=>{ %><div class="tx"><div class="txMeta"><b><a href="/tenant/forex/<%= q._id %>"><%= q.reference %></a></b><span><%= q.fromCurrency %> → <%= q.toCurrency %> · <%= q.status.replaceAll('_',' ') %> · <%= q.originModule==='mobile_money'?'Source Mobile Money · '+(q.originNetwork||'')+' '+(q.originOperation==='cash_out'?'Withdrawal':'Deposit'):q.originModule==='banking'?'Source Banking':q.originModule==='money_transfer'?'Source Money Transfer':'Direct Forex' %></span></div><b><%= data.amountLabel(q.sourceMinor,q.fromCurrency) %></b></div><% }) %></div><div class="cardBody"><a class="btn" href="/tenant/forex/history">All quotes</a></div></section>
 </div>
 <% if(data.canRateReview&&(data.rateQueue||[]).length){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Rate approval queue</b><span>No self-approval</span></div><div class="cardBody"><% if(!data.rateQueue.length){ %><p class="tiny">No outstanding rates for review.</p><% } %><% data.rateQueue.forEach(r=>{ %><form method="post" action="/tenant/forex/rates/<%= r._id %>/review" class="card" style="padding:12px;margin-bottom:12px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><b><%= r.side==='buy'?'Buy':r.side==='sell'?'Sell':'Indicative' %> · <%= r.fromCurrency %> → <%= r.toCurrency %>: <% const rr=data.rateDisplay(r.rateDecimal,r.fromCurrency); %><%= rr.text %> = <%= rr.rate %> <%= r.toCurrency %></b><p class="tiny"><%= r.note %></p><label class="field">Independent justification<textarea name="note" class="control" minlength="12" maxlength="400" rows="2" required></textarea></label><div class="rowBtns"><button class="btn btnPrimary" name="decision" value="approve">Approve indicative rate</button><button class="btn" name="decision" value="reject">Reject</button></div></form><% }) %></div></section><% } %>
 <% if(data.canQuoteReview&&(data.quoteQueue||[]).length){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Quote approval queue</b><span>Not a trade-execution queue</span></div><div class="cardBody"><% if(!data.quoteQueue.length){ %><p class="tiny">No quotes awaiting independent review.</p><% } %><% data.quoteQueue.forEach(q=>{ %><form method="post" action="/tenant/forex/<%= q._id %>/review" class="card" style="padding:12px;margin-bottom:12px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><b><a href="/tenant/forex/<%= q._id %>"><%= q.reference %></a></b><p class="tiny"><%= data.amountLabel(q.sourceMinor,q.fromCurrency) %> → <%= data.amountLabel(q.targetMinor,q.toCurrency) %></p><label class="field">Review reason<textarea name="note" class="control" minlength="12" maxlength="400" rows="2" required></textarea></label><div class="rowBtns"><button class="btn btnPrimary" name="decision" value="approve">Approve pending execution</button><button class="btn" name="decision" value="reject">Reject</button></div></form><% }) %></div></section><% } %>
</section>

<script>
(()=>{const editor=document.querySelector('[data-forex-rate-editor]');if(!editor)return;
 const form=editor.closest('form'),from=form?.querySelector('[data-forex-rate-source]'),basis=form?.querySelector('[data-rate-basis]');
 if(!from||!basis)return;
 const update=()=>{basis.value=['UGX','KES','SSP'].includes(from.value)?'1000':'1';};
 from.addEventListener('change',update);update();
 for(const action of document.querySelectorAll('[data-replace-forex-rate]')){
  action.addEventListener('click',()=>{
   const target=form.querySelector('[name="toCurrency"]'),side=form.querySelector('[name="side"]'),
    amount=form.querySelector('[name="quotedRate"]'),note=form.querySelector('[name="note"]');
   if(!target||!side||!amount)return;
   from.value=action.dataset.from||'';
   target.value=action.dataset.to||'';
   side.value=action.dataset.side||'';
   // Show the existing exact price in the approved units (1 or 1,000).
   // This pre-fills a NEW immutable rate proposal; it never edits past rates.
   update();
   const sourceRate=String(action.dataset.rate||'');
   if(/^(?:0|[1-9]\\d*)(?:\\.\\d{1,8})?$/.test(sourceRate)){
    const [whole,fraction='']=sourceRate.split('.');
    const scaled=(BigInt(whole)*100000000n+BigInt(fraction.padEnd(8,'0')))*BigInt(basis.value);
    const decimals=(scaled%100000000n).toString().padStart(8,'0').replace(/0+$/,'');
    amount.value=(scaled/100000000n).toString()+(decimals?'.'+decimals:'');
   }else amount.value='';
   if(note)note.value='';
   form.scrollIntoView({behavior:'smooth',block:'start'});
   amount.focus({preventScroll:true});
  });
 }
})();
</script>
