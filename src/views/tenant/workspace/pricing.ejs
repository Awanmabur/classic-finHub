<link rel="stylesheet" href="/css/workspace.css?v=<%= assetVersion %>">
<% const branchName=id=>id?(data.branches.find(branch=>String(branch._id)===String(id))?.name||'Inactive branch'):'All branches';
   const operationName=key=>data.operations.find(operation=>operation.key===key)?.label||key;
   const minorLabel=(value,currency)=>{const scale=currency==='UGX'?0:2,number=BigInt(value||'0'),unit=10n**BigInt(scale);return (currency==='KES'?'KSH':currency)+' '+(number/unit).toLocaleString('en-US')+(scale?'.'+String(number%unit).padStart(scale,'0'):'');}; %>
<section class="view show workspaceStack" data-pricing-page>
 <section class="card"><div class="cardHead"><div><b>Automatic charges</b><br><span>Fees, commissions and cost estimates for subscribed operations</span></div><% if(data.operations.length){ %><a class="btn btnPrimary" href="/tenant/workspace/pricing/new" data-workspace-open="pricingCreateDialog">Add charges</a><% } %></div><div class="cardBody"><p class="tiny">Daily forms apply the matching saved charges automatically. Each price is a fixed amount plus a percentage of the transaction amount; Forex prices use the converted settlement amount.</p><p class="tiny">A branch-specific price overrides the tenant default. A network-specific price overrides the general price within that scope. A missing price means zero charge. Operating cost is an estimate and does not deduct cash or create an expense.</p><div class="workspaceActions"><a class="btn" href="/tenant/workspace/profile">Tenant profile</a><a class="btn" href="/tenant/treasury">Wallets &amp; balances</a></div></div></section>
 <section class="card"><div class="cardHead"><b>Configured prices</b><span><%= data.rules.length %> saved rules</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Operation</th><th>Scope</th><th>Customer fee / commission</th><th>Operating cost estimate</th><th>Status</th><th>Action</th></tr></thead><tbody>
 <% if(!data.rules.length){ %><tr><td colspan="6"><%= data.operations.length?'No charges configured yet. Add a price to apply it automatically to new operations.':'Your current subscription has no pricing-enabled operation modules.' %></td></tr><% } %>
 <% data.rules.forEach(rule=>{ %><tr data-pricing-rule="<%= rule._id %>"><td><b><%= operationName(rule.operation) %></b><br><span class="tiny"><%= rule.currency==='KES'?'KSH':rule.currency %></span></td><td><%= branchName(rule.branchId) %><br><span class="tiny"><%= rule.network||'All networks' %></span></td><td><%= minorLabel(rule.fixedFeeMinor,rule.currency) %> + <%= rule.feeBps/100 %>%</td><td><%= minorLabel(rule.fixedCostMinor,rule.currency) %> + <%= rule.costBps/100 %>%</td><td><span class="tag"><%= rule.enabled?'Enabled':'Disabled' %></span></td><td><a class="btn" href="/tenant/workspace/pricing/<%= rule._id %>/edit" data-workspace-edit>Edit</a></td></tr><% }) %>
 </tbody></table></div></section>
 <p class="workspaceNote">New settings apply to new operations. Already recorded operations keep their original charge and policy version. If prices change while a teller is entering a transaction, the form asks them to refresh and review the updated charge before saving.</p>
</section>
<% if(data.operations.length){ %><%- include('_dialog',{id:'pricingCreateDialog',titleId:'pricingCreateTitle',title:data.form.title,subtitle:data.form.subtitle,form:data.form,remote:false}) %><% } %>
<%- include('_dialog',{id:'workspaceRemoteEditor',titleId:'workspaceRemoteTitle',title:'Edit automatic charges',subtitle:'Update future operation charges.',form:null,remote:true}) %>
<script src="/js/workspace.js?v=<%= assetVersion %>" defer></script>
