<section class="view show"><div class="grid"><form class="card" method="post" action="/tenant/customers"><div class="cardHead"><b>Register customer</b><span>Manual create, invite, self-register, KYC.</span></div><div class="cardBody" style="display:grid;gap:12px"><label class="field">Name<input class="control" name="name" required /></label><label class="field">Phone<input class="control" name="phone" required /></label><label class="field">KYC status<select class="control" name="kyc"><option>pending</option><option>verified</option></select></label><button class="btn btnPrimary">Save customer</button></div></form><section class="card"><div class="cardHead"><b>Customers</b><span>KYC and account status.</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Name</th><th>Phone</th><th>KYC</th><th>Accounts</th><th>Balance</th></tr></thead><tbody><% data.customers.forEach(c => { %><tr data-search-row><td><b><%= c.name %></b></td><td><%= c.phone %></td><td><span class="tag"><%= c.kyc %></span></td><td><%= c.accounts %></td><td><%= money('UGX',c.balance) %></td></tr><% }) %></tbody></table></div></section></div></section>
