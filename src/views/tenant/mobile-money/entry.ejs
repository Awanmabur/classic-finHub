<link rel="stylesheet" href="/css/workspace.css?v=<%= assetVersion %>">
<% const currentBranch = typeof operationBranch !== 'undefined' ? operationBranch : (data.branches || []).find(branch=>String(branch._id) === String(user.transactionBranchId || user.branchId || data.selectedBranchId || '') && branch.status !== 'archived');
   const branchProblem = typeof operationBranchError === 'string' && operationBranchError ? operationBranchError : 'An active operating branch must be assigned to your account before creating records.';
   const entryPath = '/tenant/mobile-money/' + (data.operation === 'cash_out' ? 'cash-out' : 'cash-in'); %>
<section class="view show mobileMoneyPage">
  <%- include('../../partials/operation-branch',{currentBranch,branchProblem,user}) %>
  <div class="richActions"><a class="btn" href="/tenant/mobile-money/network-activity">Network activity</a><a class="btn" href="/tenant/mobile-money/cash-impact">Cash impact</a><% if((user.permissions||[]).includes('*')||(user.permissions||[]).includes('treasury.view')){ %><a class="btn" href="/tenant/mobile-money/tariffs">Agent rate sheets</a><% } %><% if((user.permissions||[]).some(permission=>['*','mobile_money.report','reports.view'].includes(permission))){ %><a class="btn" href="/tenant/mobile-money/report">Mobile money report</a><% } %><% if(['Tenant Owner','Mobile Money Operator','Branch Manager','Reconciliation Officer','Auditor'].includes(user.role)){ %><a class="btn" href="/tenant/mobile-money/shifts">Manage physical cash shifts</a><% } %></div>
  <div class="grid mobileMoneyEntryGrid">
    <% if(data.canRecord && currentBranch){ %><%- include('_entry-form',{currentBranch,operation:data.operation}) %><% } else { %><section class="card"><div class="cardHead"><b><%= data.operation === 'cash_out' ? 'Withdrawal' : 'Deposit' %></b></div><div class="cardBody"><p class="tiny"><%= data.canRecord ? branchProblem : 'Your role has read-only access to these records.' %></p></div></section><% } %>
    <section class="card"><div class="cardHead"><div><b><%= data.operation === 'cash_out' ? 'Withdrawal' : 'Deposit' %> activity</b><br><span>Saved records and verification status</span></div><a class="btn" href="/tenant/mobile-money/history">All history</a></div><div class="cardBody richPageGrid"><%- include('_filters',{filterAction:entryPath,fixedOperation:data.operation}) %><%- include('_activity',{activityRecords:data.records,activityPath:entryPath}) %></div></section>
  </div>
  <p class="tiny">Cash payments require an independently approved opening cash shift. Bank and Wallet Balance entries record the declared payment method without changing the physical cash drawer or executing a provider transfer. <a href="/tenant/mobile-money">Open internal review and correction requests</a>.</p>
</section>
