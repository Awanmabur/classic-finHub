<section class="view show"><section class="card"><div class="cardHead"><b>Expenses</b><span>Cash impact and profit/loss deductions.</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Type</th><th>Description</th><th>Amount</th><th>Date</th></tr></thead><tbody><% data.expenses.forEach(e => { %><tr data-search-row><td><%= e.type %></td><td><%= e.description %></td><td><%= money(e.currency,e.amount) %></td><td><%= e.date %></td></tr><% }) %></tbody></table></div></section></section>
