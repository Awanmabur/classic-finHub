<script src="/js/network-tariffs.js?v=<%= assetVersion %>" defer></script>
<section class="view show workspaceStack networkTariffPage">
 <section class="card">
  <div class="cardHead"><div><b>Mobile Money rates</b><br><span>Use existing network sheets · approve once · edit when rates change</span></div><a class="btn" href="/tenant/treasury">Cash &amp; float accounts</a></div>
  <div class="cardBody workspaceStack">
   <p class="tiny">The existing provider sheets are the starting rates. Prepare missing MTN bands without retyping, then have a different authorized reviewer approve the tenant copy. Approved rates automatically calculate transaction estimates. Customer network charges never become agent income.</p>
   <% if((data.networkMarkets||[]).length===1){ %>
    <p class="tiny"><b>Your network:</b> <%= (data.networkMarkets||[])[0].label %> · <%= (data.networkMarkets||[])[0].currency %></p>
   <% } %>
   <% const selectedRateBranch=data.selectedBranchId||String(data.branches[0]?._id||'');
      const existingMtnKinds=['agent_commission:cash_in','agent_commission:cash_out','customer_network_fee:cash_in','customer_network_fee:cash_out'];
      const activeMtn=new Set(data.schedules.filter(rule=>rule.network==='MTN'&&rule.currency==='UGX'&&
       String(rule.branchId)===selectedRateBranch&&['approved','draft'].includes(rule.status))
       .map(rule=>rule.scheduleKind+':'+rule.operation));
      const needMtnRates=(data.networkMarkets||[]).some(m=>m.network==='MTN')&&existingMtnKinds.some(key=>!activeMtn.has(key)); %>
   <% if(data.canPropose&&needMtnRates){ %>
    <form method="post" action="/tenant/mobile-money/tariffs/existing-reference" class="networkTariffActions">
     <input type="hidden" name="_csrf" value="<%= csrfToken %>">
     <input type="hidden" name="network" value="MTN">
     <% if(data.branches.length===1){ %><input type="hidden" name="branchId" value="<%= data.branches[0]._id %>">
     <% }else{ %><label class="field">Branch<select class="control" name="branchId" required>
      <% data.branches.forEach(branch=>{ %><option value="<%= branch._id %>" <%= String(branch._id)===selectedRateBranch?'selected':'' %>><%= branch.name %></option><% }) %>
     </select></label><% } %>
     <button class="btn btnPrimary" type="submit">Use existing MTN rate sheets</button>
     <span class="tiny">Prepares only missing rate bands for independent approval. No duplicates or manual entry.</span>
    </form>
   <% } %>
   <div class="workspaceActions"><a class="btn" href="/tenant/mobile-money/network-activity">Network activity</a><a class="btn" href="/tenant/mobile-money/report">Operations report</a><a class="btn" href="/tenant/workspace/pricing">Customer fees &amp; costs</a></div>
  </div>
 </section>
 <section class="card networkAgentOverview">
  <div class="cardHead"><div><b>Cash and float</b><br><span>Book balances for configured networks · not live provider balances</span></div><a class="btn" href="/tenant/treasury">Reconcile accounts</a></div>
  <div class="cardBody">
   <% const markets=new Set((data.networkMarkets||[]).map(m=>m.network+'|'+m.currency));
      const scopedFloat=(data.funds?.wallets||[]).filter(w=>markets.has(w.network+'|'+w.currency)&&w.state==='active');
      const linkedCash=new Set(scopedFloat.map(w=>w.cashDrawerAccountId).filter(Boolean));
      const compatibleCash=(data.funds?.paymentAccounts||[]).filter(a=>a.kind==='cash'&&(data.networkMarkets||[]).some(m=>m.currency===a.currency));
      const scopedCash=compatibleCash.filter(a=>linkedCash.has(a.id)||
       compatibleCash.filter(x=>x.currency===a.currency).length===1);
      const moneyAccounts=[...scopedCash,...scopedFloat]; %>
   <% if(moneyAccounts.length){ %>
   <div class="networkBalanceGrid"><% moneyAccounts.forEach(account=>{ %>
    <div class="networkBalanceStat">
     <span><%= account.kind==='cash'?'Physical cash · book balance':'Electronic float · '+(account.network==='MTN SSD'?'MTN South Sudan':account.network) %></span>
     <strong><%= account.expected||'Opening not approved' %></strong>
     <small><%= account.name %> · <%= account.currency %> · <%= account.reconciliation==='matched'?'Reconciled':(account.reconciliation||'Not reconciled') %></small>
    </div>
   <% }) %></div>
   <% }else{ %><p class="tiny">No scoped cash or float account is available here. Configure accounts and approve their opening balances in Treasury.</p><% } %>
  </div>
 </section>
 <% if((data.allProviders||[]).length>1){ %>
 <section class="card networkProviderDirectory">
  <div class="cardHead"><b>Configured networks</b><span class="tiny"><%= data.allProviders.length %> active markets</span></div>
  <div class="cardBody">
   <div class="networkProviderGrid">
    <% data.allProviders.forEach(p=>{const approved=data.schedules.filter(rule=>rule.network===p.key&&rule.status==='approved').length;
       const pending=data.schedules.filter(rule=>rule.network===p.key&&rule.status==='draft').length; %>
     <div class="networkProviderCard">
      <strong><%= p.displayName %> · <%= p.currency %></strong>
      <small><%= approved %> approved · <%= pending %> awaiting review</small>
      <a class="tiny" href="#configured-network-sheets">View applicable rates</a>
     </div>
    <% }) %>
   </div>
  </div>
 </section>
 <% } %>
 <% if(data.agentReferenceRates||data.customerTariffReferences.length){ %>
 <details class="card networkReferenceSection">
  <summary class="cardHead"><b>Existing provider rate tables</b><span class="tiny">Inspect the original amounts · tenant approval controls transaction rates</span></summary>
  <div class="cardBody workspaceStack">
   <% if(data.agentReferenceRates){const deposit=data.agentReferenceRates.deposit,withdrawal=data.agentReferenceRates.withdrawal; %>
    <details class="networkTariffRecord">
     <summary><span><b>MTN MoMo Uganda — agent commission</b><small>UGX · deposit and withdrawal rates</small></span><span class="tag">Published table</span></summary>
     <div class="networkTariffRecordBody">
      <p class="tiny">These are the existing MTN reference bands. They can be imported without retyping, independently reviewed, and then used for transaction commission estimates. Actual commission received is confirmed separately by provider statement.</p>
      <div class="tableWrap networkTariffScroll" role="region" tabindex="0" aria-label="Existing MTN Uganda agent commission table">
       <table><thead><tr><th>Amount from</th><th>Amount to</th><th>Deposit commission</th><th>Withdrawal commission</th></tr></thead><tbody>
        <% deposit.tiers.forEach((tier,i)=>{ const out=withdrawal.tiers[i]; %>
         <tr><td><%= data.formatMinor(tier.minMinor,'UGX') %></td><td><%= data.formatMinor(tier.maxMinor,'UGX') %></td>
          <td><%= tier.rate.kind==='basis_points'?Number(tier.rate.value)/100+'%':data.formatMinor(tier.rate.value,'UGX') %></td>
          <td><%= out.rate.kind==='basis_points'?Number(out.rate.value)/100+'%':data.formatMinor(out.rate.value,'UGX') %></td>
         </tr>
        <% }) %>
       </tbody></table>
      </div>
      <p class="tiny"><a href="<%= deposit.providerEvidence %>" target="_blank" rel="noopener noreferrer">Provider source</a> · Last checked <%= deposit.reviewedOn %>. The owner must confirm applicability to their actual agent agreement before approving the imported sheet.</p>
     </div>
    </details>
   <% } %>
   <% data.customerTariffReferences.forEach(source=>{ %>
    <details class="networkTariffRecord">
     <summary><span><b><%= source.label %> — customer network charges</b><small><%= source.currency %> · deposit: <%= data.formatMinor(source.depositFeeMinor,source.currency) %></small></span><span class="tag"><%= source.status==='published_reference'?'Published rates':'Historical — verify first' %></span></summary>
     <div class="networkTariffRecordBody">
      <p class="tiny">These charges belong to the provider, not the agent. Additional taxes can apply. Approved tenant copies are shown in transaction estimates, never as agent commission income.</p>
      <div class="networkTariffMetadata"><span>Checked <b><%= source.checkedOn %></b></span><span>Source <a href="<%= source.source %>" target="_blank" rel="noopener noreferrer">Provider rate table</a></span></div>
      <div class="tableWrap networkTariffScroll" role="region" tabindex="0"><table><thead><tr><th>From</th><th>To</th><% source.operations.forEach(op=>{ %><th><%= op.label %></th><% }) %></tr></thead><tbody>
       <% source.bands.forEach(tier=>{ %>
        <tr><td><%= data.formatMinor(tier.minMinor,source.currency) %></td><td><%= data.formatMinor(tier.maxMinor,source.currency) %></td>
         <% source.operations.forEach(op=>{ const charge=tier.charges[op.key]; %>
          <td><%= charge==null?'—':data.formatMinor(charge,source.currency) %></td>
         <% }) %></tr>
       <% }) %>
      </tbody></table></div>
     </div>
    </details>
   <% }) %>
  </div>
 </details>
 <% } %>
 <section class="card" id="configured-network-sheets">
  <div class="cardHead"><b>Saved network schedules</b><span><%= data.schedules.length %> saved</span></div>
  <div class="cardBody workspaceStack">
   <% if(!data.schedules.length){ %><p class="tiny">No network sheet approved yet. Use the existing published sheets above, then have another authorized user independently approve their activation.</p><% } %>
   <% data.schedules.forEach(schedule=>{ const branch=data.branches.find(b=>String(b._id)===String(schedule.branchId)); %>
   <details class="networkTariffRecord">
    <summary><span><b><%= schedule.network==='MTN SSD'?'MTN MoMo South Sudan':schedule.network==='MTN'?'MTN MoMo Uganda':schedule.network %></b><small><%= branch?.name||'Assigned branch' %> · <%= schedule.currency %> · <%= ({cash_in:'Customer deposit',cash_out:'Customer withdrawal',send:'Send money',bill_payment:'Bill payment',airtime_sale:'Sell airtime',merchant_payment:'Merchant payment'})[schedule.operation]||schedule.operation %> · <%= schedule.scheduleKind==='customer_network_fee'?'Customer fee':'Agent commission' %> · Version <%= schedule.version %></small></span><span class="tag"><%= schedule.status==='approved'?'Approved for quoting':schedule.status==='retired'?'Retired':'Awaiting independent review' %></span></summary>
    <div class="networkTariffRecordBody">
     <div class="networkTariffMetadata"><span>Effective from <b><%= new Date(schedule.effectiveFrom).toISOString().slice(0,10) %></b></span><span>Source <b><%= schedule.evidenceReference %></b></span><span>Independent reviewer <b><%= schedule.approvedBy?'Recorded':'Pending' %></b></span></div>
     <div class="tableWrap networkTariffScroll" role="region" tabindex="0" aria-label="Scrollable commission ranges"><table><thead><tr><th>Minimum (<%= schedule.currency %>)</th><th>Maximum</th><th>Commission type</th><th>Rate (minor units or bps)</th></tr></thead><tbody>
      <% schedule.tiers.forEach(tier=>{ %><tr><td><%= data.formatMinor(tier.minMinor,schedule.currency) %></td><td><%= data.formatMinor(tier.maxMinor,schedule.currency) %></td><td><%= tier.rate.kind==='flat'?'Fixed':'Percentage' %></td><td><%= tier.rate.value %><%= tier.rate.kind==='basis_points'?' bps':'' %></td></tr><% }) %>
     </tbody></table></div>

     <form class="networkTariffQuoteForm" method="get" action="/tenant/mobile-money/tariffs/<%= schedule._id %>/quote">
      <label class="field">Transaction amount (<%= schedule.currency %>)<input class="control" name="amount" type="text" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" placeholder="Amount to quote" required></label>
      <button class="btn" type="submit">Estimate commission</button>
      <span class="tiny">Estimated from the saved sheet · no funds posted</span>
     </form>
     <% if(data.canPropose&&schedule.status==='approved'){ %>
      <form class="networkTariffAction" method="post" action="/tenant/mobile-money/tariffs/<%= schedule._id %>/start-revision">
       <input type="hidden" name="_csrf" value="<%= csrfToken %>">
       <button class="btn" type="submit">Edit existing rates</button>
       <span class="tiny">Opens a new editable version with all current bands prefilled. Old approved rates remain active until the replacement is independently approved.</span>
      </form>
     <% } %>
     <% if(data.canPropose&&schedule.status==='draft'&&(data.actorRole==='Tenant Owner'||!data.actorRole||String(schedule.createdBy)===String(data.actorId))){ %>
     <details class="networkTariffEdit"><summary>Edit draft rates</summary>
      <form class="networkTariffForm" method="post" data-editor-currency="<%= schedule.currency %>" action="/tenant/mobile-money/tariffs/<%= schedule._id %>/edit">
       <input type="hidden" name="_csrf" value="<%= csrfToken %>">
       <input type="hidden" name="revision" value="<%= schedule.revision %>">
       <label class="field">Provider contract or rate sheet reference<input class="control" name="evidenceReference" minlength="12" maxlength="350" required value="<%= schedule.evidenceReference %>"></label>
       <label class="field">Rate bands<textarea class="control networkTariffBands" name="bands" rows="7" data-rate-editor maxlength="30000" required spellcheck="false"><%= data.serializeLines(schedule.tiers) %></textarea></label>
       <div class="networkTariffActions"><button class="btn" type="submit">Save draft revisions</button><span class="tiny">Approved schedules are immutable. Updates require an independent review.</span></div>
      </form>
     </details>
     <% } %>
     <% if(data.canReview&&schedule.status==='draft'&&String(schedule.createdBy)!==String(data.actorId||'')){ %>
      <div class="networkTariffAction"><p class="tiny">Review the original provider agreement before approving. You cannot approve your own submission.</p>
       <form action="/tenant/mobile-money/tariffs/<%= schedule._id %>/approve" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btnPrimary">Approve rate sheet</button></form>
      </div>
     <% } %>
     <% if(data.canReview&&schedule.status==='approved'&&String(schedule.createdBy)!==String(data.actorId||'')){ %>
      <form action="/tenant/mobile-money/tariffs/<%= schedule._id %>/retire" method="post" class="networkTariffAction"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn">Retire rate sheet</button></form>
     <% } %>
     <p class="tiny">A schedule is an estimate. The provider balance or daily commission statement is required before recognizing actual commission revenue.</p>
    </div>
   </details>
   <% }) %>
  </div>
 </section>
 <% if(data.canPropose&&(data.providerChoices||[]).some(p=>p.key!=='MTN')){ %>
 <details class="card networkNewSheet" id="network-sheet-form">
  <summary class="cardHead"><b>Add or edit agent rate ranges</b><span class="tiny">Open form · independent approval required</span></summary>
  <form class="cardBody networkTariffForm" method="post" action="/tenant/mobile-money/tariffs" autocomplete="off">
   <input type="hidden" name="_csrf" value="<%= csrfToken %>">
   <div class="networkTariffFields">
    <label class="field">Network<select name="network" class="control" data-provider-select required><option value="">Choose network</option><% data.providerChoices.forEach(p=>{ %><option value="<%= p.key %>" data-currency="<%= p.currency %>"><%= p.displayName %></option><% }) %></select></label>
    <label class="field">Currency (set by network or verified wallet)<input class="control" type="text" data-provider-currency-display readonly placeholder="Choose a network"><input type="hidden" name="currency" data-provider-currency></label>
    <label class="field" data-tariff-market-wallet-field hidden>Verified network wallet<select name="walletAccountId" class="control" data-tariff-market-wallet disabled><option value="">Choose reconciled network wallet</option><% data.commissions.wallets.forEach(w=>{ %><option value="<%= w._id %>" data-network="<%= w.network %>" data-currency="<%= w.currency %>" data-branch="<%= w.branchId %>"><%= w.name %> · <%= w.currency %></option><% }) %></select><small>For networks serving several markets, your approved wallet determines the currency.</small></label>
    <% if(data.actorRole==='Mobile Money Operator'&&data.branches.length===1){ %>
    <label class="field">Operating branch<input class="control" type="text" value="<%= data.branches[0].name %>" readonly tabindex="-1"><input type="hidden" name="branchId" value="<%= data.branches[0]._id %>"></label>
    <% }else{ %><label class="field">Branch<select name="branchId" class="control" required><option value="">Choose branch</option><% data.branches.forEach(b=>{ %><option value="<%= b._id %>"><%= b.name %></option><% }) %></select></label><% } %>
    <label class="field">Schedule type<select name="scheduleKind" class="control" required><option value="agent_commission">Agent commission paid by provider</option><option value="customer_network_fee">Network charge paid by customer</option></select></label>
    <label class="field">Agent operation<select name="operation" class="control" required><option value="cash_in">Deposit</option><option value="cash_out">Withdrawal</option><option value="send">Send money</option><option value="bill_payment">Pay a bill</option><option value="airtime_sale">Sell airtime or bundles</option><option value="merchant_payment">Merchant payment</option></select></label>
    <label class="field">Effective from (UTC)<input type="date" name="effectiveFrom" class="control" required></label>
    <label class="field">Expires (optional)<input type="date" name="expiresAt" class="control"></label>
   </div>
   <label class="field">Provider rate sheet, contract or statement reference<input name="evidenceReference" class="control" minlength="12" maxlength="350" required placeholder="Source document reference, issuer and revision date"><span class="tiny">A source reference records the document's identity; it does not automatically verify a provider-issued tariff.</span></label>
   <label class="field">Amount ranges and rates<textarea name="bands" class="control networkTariffBands" data-rate-editor rows="8" maxlength="30000" required spellcheck="false" placeholder="500, 2500, basis_points, 400&#10;2501, 5000, flat, 110"></textarea><span class="tiny">Enter transaction ranges and choose a fixed commission or percentage. The editor accepts normal currency amounts, checks for valid ranges, and requires independent approval before use. Without JavaScript, enter one line as: minimum minor units, maximum minor units, flat or basis_points, rate.</span></label>
   <div class="networkTariffActions"><button class="btn btnPrimary" type="submit">Submit for review</button><span class="tiny">This does not change customer fees or post any money.</span></div>
  </form>
 </details>
 <% } %>

 <section class="card">
  <div class="cardHead"><div><b>Received provider commissions</b><br><span>Statement-backed receipts, independent review and separate income posting</span></div><span class="tag"><%= data.postingEnabled?'Posting gate enabled':'Posting locked' %></span></div>
  <div class="cardBody workspaceStack">
   <% if(!data.postingEnabled){ %><p class="workspaceNote">Payout posting is disabled until historic wallet commission entries are reconciled and a staging release gate passes. Submissions are stored as evidence only, not treated as cash, float or profit.</p><% } %>
   <% if(data.canSubmitPayout){ %>
   <details class="networkTariffRecord"><summary><b>Record a provider commission credit</b><span class="tag">Requires statement evidence</span></summary>
    <form class="networkTariffRecordBody networkTariffForm" method="post" action="/tenant/mobile-money/tariffs/payouts">
     <input type="hidden" name="_csrf" value="<%= csrfToken %>">
     <div class="networkTariffFields">
      <label class="field">Receiving network wallet<select name="walletAccountId" class="control" data-payout-wallet required><option value="">Choose reconciled wallet</option><% data.commissions.wallets.forEach(wallet=>{ %><option value="<%= wallet._id %>" data-network="<%= wallet.network %>" data-currency="<%= wallet.currency %>"><%= wallet.name %> · <%= wallet.network==='MTN SSD'?'MTN South Sudan':wallet.network %> · <%= wallet.currency %></option><% }) %></select></label>
      <div class="field"><span>Network and currency</span><div class="networkReadOnly" data-payout-market>Choose a wallet to identify its network and currency</div><input type="hidden" name="network" data-payout-network><input type="hidden" name="currency" data-payout-currency></div>
      <label class="field">Net commission actually credited<input name="amount" class="control" type="text" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" placeholder="0.00" required></label>
      <label class="field">Gross commission before deductions<input name="grossAmount" class="control" type="text" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" placeholder="0.00" required></label>
      <label class="field">Tax withheld by provider<input name="taxWithheld" class="control" type="text" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" value="0" required></label>
      <label class="field">Provider commission deduction / cost<input name="providerCost" class="control" type="text" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" value="0" required></label>
      <label class="field">Provider commission credit reference<input name="providerReference" class="control" minlength="6" maxlength="120" placeholder="Unique credit or statement reference" required></label>
      <label class="field">Actual provider credit time (UTC)<input name="creditedAt" class="control" type="datetime-local" required></label>
     </div>
     <label class="field">Statement evidence and proof reference<input name="statementEvidence" class="control" minlength="12" maxlength="350" placeholder="Statement date, provider, account and trace ID" required></label>
     <div class="networkTariffActions"><button class="btn btnPrimary" type="submit">Submit credit for reconciliation</button><span class="tiny">No balance changes until independent review and a posting-enabled environment.</span></div>
    </form>
   </details>
   <% } %>
   <% if(!data.commissions.records.length){ %><p class="tiny">No commission credits recorded for your permitted wallets.</p><% } %>
   <% data.commissions.records.forEach(payout=>{ %>
    <div class="networkTariffPayout">
     <div class="networkTariffPayoutDetails"><b><%= payout.network==='MTN SSD'?'MTN South Sudan':payout.network %> — <%= data.formatMinor(payout.amountMinor,payout.currency) %></b><span><%= payout.providerReference %> · <%= new Date(payout.creditedAt).toISOString().slice(0,16).replace('T',' ') %> UTC</span><span class="tiny"><%= payout.statementEvidence %></span></div>
     <span class="tag"><%= payout.status==='posted'?'Posted income':payout.status==='rejected'?'Rejected':'Pending review' %></span>
     <% if(data.canReviewPayout&&payout.status==='pending_review'){ %>
     <form class="networkTariffReview" method="post" action="/tenant/mobile-money/tariffs/payouts/<%= payout._id %>/review">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field">Review note (minimum 12 characters)<input class="control" name="note" minlength="12" maxlength="400" placeholder="Compare original provider credit statement and ledger" required></label>
      <div class="networkTariffActions"><button class="btn" name="decision" value="reject">Reject evidence</button>
       <% if(data.postingEnabled){ %><button class="btn btnPrimary" name="decision" value="approve">Approve and post</button><% }else{ %><span class="tiny">Posting requires a verified historical-commission migration and financial release approval.</span><% } %>
      </div>
     </form>
     <% } %>
    </div>
   <% }) %>
  </div>
 </section>

</section>
