<section class="view show"><section class="card"><div class="cardHead"><b><%= data.regenerated?'Owner activation link replaced':'Tenant created — owner invite pending' %></b><span>One-time link</span></div><div class="cardBody"><p>Workspace: <b><%= data.tenant.name %></b> (<%= data.tenant.slug %>)</p><p><% if(data.inviteQueued){ %>An activation email has been queued to the owner. This is not a delivery confirmation. Keep this private fallback link if the email does not arrive.<% }else{ %>Email delivery is not configured. Send the private activation link through a trusted channel.<% } %> The link expires in 48 hours and will not be shown again.<% if(data.regenerated){ %> Earlier unused activation links are expired.<% } %></p><% if(!data.tenant.subscription){ %><p class="reportBlock" role="status">This plan has no trial. Grant a subscription from the tenant profile before operations can begin. No payment has been collected.</p><% } %><label class="field">Private activation link<input class="control" readonly value="<%= data.inviteUrl %>" data-select-on-focus></label><div class="rowBtns"><a class="btn" href="/platform/tenants/<%= data.tenant._id %>">Open tenant profile</a><a class="btn btnPrimary" href="/platform/tenants">Back to tenants</a></div></div></section></section>
