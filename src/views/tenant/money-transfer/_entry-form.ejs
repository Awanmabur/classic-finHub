<% const receivingBranches=(data.destinationBranches||data.branches||[]).filter(branch=>String(branch._id)!==String(currentBranch._id)&&branch.status==='active'); const phoneLocation=typeof phoneDefaults==='undefined'?{country:'SS',dialCode:'+211'}:phoneDefaults; %>
<input type="hidden" name="senderCountry" value="<%= phoneLocation.country %>"><input type="hidden" name="receiverCountry" value="<%= phoneLocation.country %>">
<input type="hidden" name="validDays" value="7"><input type="hidden" name="fee" value="0">
<div class="formSection"><div class="formSectionTitle">Sender details</div><div class="row2">
<label class="field">Sender name<input class="control" name="senderName" required minlength="2" maxlength="120" autocomplete="off" placeholder="Enter sender's full name"></label>
<label class="field">Sender phone<input class="control" name="senderPhone" type="tel" required maxlength="40" autocomplete="off" placeholder="<%= phoneLocation.dialCode %>…" data-phone-prefix="<%= phoneLocation.dialCode %>"></label>
</div></div>
<div class="formSection"><div class="formSectionTitle">Receiver details</div><div class="row2">
<label class="field">Receiver name<input class="control" name="receiverName" required minlength="2" maxlength="120" autocomplete="off" placeholder="Enter receiver's full name"></label>
<label class="field">Receiver phone<input class="control" name="receiverPhone" type="tel" required maxlength="40" autocomplete="off" placeholder="<%= phoneLocation.dialCode %>…" data-phone-prefix="<%= phoneLocation.dialCode %>"></label>
<label class="field">From branch<input class="control" value="<%= currentBranch.name %>" readonly aria-readonly="true"></label>
<label class="field">To branch<select class="control" name="destinationBranchId" required><option value="">Select receiving branch</option><% receivingBranches.forEach(branch=>{ %><option value="<%= branch._id %>" data-currencies="<%= (branch.currencies?.length?branch.currencies:(typeof currencyOptions==='undefined'?[branch.currency]:currencyOptions.map(option=>option.code))).join(',') %>"><%= branch.name %></option><% }) %></select><% if(!receivingBranches.length){ %><span class="tiny">Ask your administrator to configure another receiving branch.</span><% } %></label>
</div></div>
<div class="formSection"><div class="formSectionTitle">Transfer amount</div><div class="row2">
<label class="field">Currency<select class="control" name="currency" required><% (data.currencyChoices||(typeof currencyOptions==='undefined'?[]:currencyOptions).filter(option=>!currentBranch.currencies||currentBranch.currencies.includes(option.code))).forEach(option=>{ %><option value="<%= option.code %>" <%= option.code===(data.selectedCurrency||currentBranch.currency)?'selected':'' %>><%= option.label %></option><% }) %></select></label>
<label class="field">Amount<input class="control" name="amount" inputmode="decimal" required pattern="[0-9]+([.][0-9]{1,2})?" placeholder="0"></label>
</div></div>
<%- include('../partials/operation-pricing',{pricingOperation:'money_transfer.send',pricingField:'fee'}) %>
<div class="summary"><div class="sumRow"><span>Total sender pays</span><b data-transfer-total>—</b></div><div class="sumRow"><span>Generated PIN</span><b>Issued after reviewed collection</b></div></div>
<details class="logicNote"><summary>Additional details</summary><div class="row2"><label class="field">Sender ID / document no.<input class="control" name="senderDocument" maxlength="80" placeholder="Optional verification document"></label><label class="field">Receiver ID / document no.<input class="control" name="receiverDocument" maxlength="80" placeholder="Optional verification document"></label><label class="field">Transfer method<select class="control" name="transferMethod"><% ['Cash','Bank','Mobile Money','Online'].forEach(method=>{ %><option><%= method %></option><% }) %></select></label><label class="field">Purpose / narration<input class="control" name="purpose" maxlength="400" placeholder="Optional transfer details"></label></div><p class="tiny">Requests remain valid for 7 days. The operating branch, request reference and configured charges are applied automatically.</p><p class="tiny">Reference: <span class="mono"><%= data.idempotencyKey %></span></p></details>
<div class="rowBtns"><button class="btn btnPrimary" type="submit">Save transfer &amp; continue</button></div>
