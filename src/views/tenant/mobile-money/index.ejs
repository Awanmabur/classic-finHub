<section class="view show"><div class="grid"><form class="card" method="post" action="/tenant/mobile-money/cash-in"><div class="cardHead"><b>Mobile money cash-in / cash-out</b><span>Agent float, network reference, fees, and receipts.</span></div><div class="cardBody" style="display:grid;gap:12px"><div class="row2"><label class="field">Customer<input class="control" name="customer" required /></label><label class="field">Network<select class="control" name="network"><option>MTN</option><option>Airtel</option><option>M-Pesa</option></select></label></div><div class="row3"><label class="field">Amount<input class="control" type="number" name="amount" required /></label><label class="field">Fee<input class="control" type="number" name="fee" value="2500" /></label><label class="field">Currency<select class="control" name="currency"><option>UGX</option><option>KSH</option></select></label></div><div class="rowBtns"><button class="btn btnPrimary" formaction="/tenant/mobile-money/cash-in">Cash in</button><button class="btn" formaction="/tenant/mobile-money/cash-out">Cash out</button></div></div></form><section class="card"><div class="cardHead"><b>Network activity</b><span>Cash impact and reconciliation.</span></div><div class="cardBody txList"><% data.transactions.filter(t=>t.module==='Mobile Money').forEach(t => { %><div class="tx" data-search-row><div class="txMeta"><b><%= t.reference %></b><span><%= t.customer %> — <%= t.status %></span></div><b><%= money(t.currency,t.amount) %></b></div><% }) %></div></section></div></section>
