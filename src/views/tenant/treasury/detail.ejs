<% const account=data.account,known=account.openingBalanceMinor!==null,fmt=value=>value===null||value===undefined?'—':data.format(value,account.currency),byBatch=new Map(data.batches.map(batch=>[String(batch._id),batch])); %>
<section class="view show">
 <section class="card"><div class="cardHead"><div><b><%= account.name %></b><br><span><%= account.code %> · <%= account.kind.replaceAll('_',' ') %> · <%= account.network||account.currency %></span></div><div class="rowBtns"><a class="btn" href="/tenant/treasury">All balances</a><% if(data.canObserve&&['wallet','cash','bank'].includes(account.kind)){ %><a class="btn btnPrimary" href="/tenant/treasury?to=<%= account._id %>#add-funds">Add funds</a><% } %></div></div><div class="cardBody">
  <div class="grid3"><div class="stat"><div class="k">Expected book balance</div><div class="v"><%= known?fmt(account.bookBalanceMinor):'Not initialized' %></div><div class="s">Derived from posted ledger entries</div></div><div class="stat"><div class="k">Last reviewed actual balance</div><div class="v"><%= fmt(account.lastObservedMinor) %></div><div class="s"><%= account.lastObservationAt?new Date(account.lastObservationAt).toISOString():'No independently reviewed evidence' %></div></div><div class="stat"><div class="k">Difference at observation</div><div class="v"><%= fmt(account.lastVarianceMinor) %></div><div class="s"><%= account.status %> · <%= account.reconciliationState==='matched'?'matched at last reviewed observation':account.reconciliationState %></div></div></div>
  <% if(account.holdReason){ %><p role="status"><%= account.holdReason %></p><% } %><p class="tiny">The actual balance is dated evidence from a count, provider screen or statement. It is not a live provider API query. A mismatch holds further spending; the book remains unchanged until a missing entry, exact reversal or independently approved reconciliation adjustment resolves it.</p>
 </div></section>
 <% if(data.canManage&&account.status!=='archived'){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Account settings</b><span>Defaults for future transactions</span></div><form method="post" action="/tenant/treasury/accounts/<%= account._id %>/settings" class="cardBody" data-wallet-settings-form><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row2"><label class="field">Account name<input class="control" name="name" minlength="3" maxlength="120" required value="<%= account.name %>"></label><label class="field">Default for this operation<select class="control" name="isDefault"><option value="true" <%= account.selectionKey?'selected':'' %>>Yes</option><option value="false" <%= !account.selectionKey?'selected':'' %>>No, choose explicitly</option></select></label>
 <% if(account.kind==='wallet'){ %><label class="field">Fee / commission treatment<select class="control" name="feeTreatment"><% [['record_only','Record fee only'],['payment_collected','Fee collected from customer'],['wallet_commission','Commission credited to wallet']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= (account.feeTreatment||'record_only')===value?'selected':'' %>><%= label %></option><% }) %></select></label><% } %></div><p class="tiny">The default wallet and payment account are selected automatically for the matching operator, network and currency. Wallet fee treatment applies to future entries; prior transactions keep their original policy.</p><button type="submit" class="btn btnPrimary">Save account settings</button></form></section><% } %>
 <% if(data.canObserve&&account.status!=='archived'){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b><%= known?'Record actual balance check':'Submit actual opening balance' %></b></div><form method="post" action="/tenant/treasury/accounts/<%= account._id %>/observations" class="cardBody"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= data.idempotencyKey %>"><input type="hidden" name="kind" value="<%= known?'checkpoint':'opening' %>"><div class="row2">
 <label class="field">Actual balance shown / counted (<%= account.currency==='KES'?'KSH':account.currency %>)<input class="control" name="actualBalance" inputmode="decimal" required placeholder="Enter the real balance"></label><label class="field">Observed at (UTC)<input class="control" name="observedAt" type="datetime-local" required value="<%= new Date().toISOString().slice(0,16) %>"></label>
 <label class="field">Evidence type<select class="control" name="evidenceType" required><% ({wallet:['provider_app','provider_statement'],cash:['cash_count'],bank:['bank_statement','provider_app'],forex_stock:['stock_count'],transfer_clearing:['transfer_register','provider_statement']})[account.kind].forEach(type=>{ %><option value="<%= type %>"><%= type.replaceAll('_',' ') %></option><% }) %></select></label><label class="field">Evidence reference<input class="control" name="evidenceReference" minlength="6" maxlength="120" required placeholder="Statement, transaction, stock sheet or count reference"></label>
 <label class="field">Evidence explanation<textarea class="control" name="note" minlength="12" maxlength="400" required rows="2" placeholder="Describe the exact source and how the real balance was checked"></textarea></label></div><button class="btn btnPrimary" type="submit">Submit evidence for independent review</button></form></section><% } %>
 <section class="card" style="margin-top:14px"><div class="cardHead"><b>Actual balance evidence</b><span>Original observations are preserved</span></div><div class="cardBody">
 <% if(!data.observations.length){ %><p class="tiny">No actual balance evidence has been submitted.</p><% } %>
 <% data.observations.forEach(observation=>{ %><article class="card" style="margin-bottom:12px"><div class="cardHead"><b><%= observation.kind %> · <%= observation.status.replaceAll('_',' ') %></b><span><%= new Date(observation.observedAt).toISOString() %></span></div><div class="cardBody"><div class="summary"><div class="sumRow"><span>Actual balance</span><b><%= fmt(observation.actualMinor) %></b></div><div class="sumRow"><span>Expected at observation</span><b><%= fmt(observation.expectedMinorAtReview??observation.expectedMinorAtRequest) %></b></div><div class="sumRow"><span>Difference</span><b><%= fmt(observation.varianceMinorAtReview??observation.varianceMinorAtRequest) %></b></div><div class="sumRow"><span>Source</span><b><%= observation.evidenceType.replaceAll('_',' ') %> · <%= observation.evidenceReference %></b></div></div><p class="tiny"><%= observation.note %></p><% if(observation.reviewNote){ %><p class="tiny">Independent review: <%= observation.reviewNote %></p><% } %>
 <% if(data.canReview&&observation.status==='pending_review'&&String(observation.requestedBy)!==String(user.id)&&String(account.operatorId||'')!==String(user.id)){ %><form method="post" action="/tenant/treasury/observations/<%= observation._id %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field">Independent evidence review<textarea class="control" name="note" minlength="12" maxlength="400" required rows="2"></textarea></label><div class="rowBtns"><button class="btn btnPrimary" name="decision" value="approve">Approve evidence</button><button class="btn" name="decision" value="reject">Reject evidence</button></div></form><% } %>
 <% if(data.canObserve&&observation.status==='approved'&&observation.kind==='checkpoint'&&String(account.lastObservationId)===String(observation._id)&&observation.varianceMinorAtReview&&String(observation.varianceMinorAtReview)!=='0'&&!data.adjustments.some(adjustment=>String(adjustment.observationId)===String(observation._id))){ %><form method="post" action="/tenant/treasury/observations/<%= observation._id %>/adjustments"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= data.idempotencyKey %>"><label class="field">Explicit reconciliation adjustment justification<textarea class="control" name="reason" minlength="20" maxlength="400" required rows="2" placeholder="Explain the missing source, investigation and reason for the visible suspense adjustment"></textarea></label><button class="btn" type="submit">Request audited adjustment</button></form><% } %>
 </div></article><% }) %>
 </div></section>
 <% if(data.adjustments.length){ %><section class="card" style="margin-top:14px"><div class="cardHead"><b>Explicit reconciliation adjustments</b></div><div class="cardBody"><% data.adjustments.forEach(adjustment=>{ %><article class="card" style="margin-bottom:12px"><div class="cardHead"><b><%= adjustment.status %></b><span><%= fmt(adjustment.deltaMinor) %></span></div><div class="cardBody"><p><%= adjustment.reason %></p><% if(data.canReview&&adjustment.status==='pending_review'&&String(adjustment.requestedBy)!==String(user.id)&&String(account.operatorId||'')!==String(user.id)){ %><form method="post" action="/tenant/treasury/adjustments/<%= adjustment._id %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field">Independent adjustment review<textarea class="control" name="note" minlength="20" maxlength="400" required rows="2"></textarea></label><div class="rowBtns"><button class="btn btnPrimary" name="decision" value="approve">Approve visible adjustment</button><button class="btn" name="decision" value="reject">Reject adjustment</button></div></form><% } else { %><p class="tiny"><%= adjustment.reviewNote %></p><% } %></div></article><% }) %></div></section><% } %>
 <section class="card" style="margin-top:14px"><div class="cardHead"><b>Posted funds movement history</b><span>Append-only, balanced journal evidence</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Recorded UTC</th><th>Actual event UTC</th><th>Source</th><th>Movement</th><th>Book after</th><th>Journal</th></tr></thead><tbody><% if(!data.movements.length){ %><tr><td colspan="6">No funds movements posted.</td></tr><% } %><% data.movements.forEach(movement=>{const batch=byBatch.get(String(movement.batchId)); %><tr data-search-row><td><%= new Date(movement.createdAt).toISOString() %></td><td><%= new Date(movement.occurredAt).toISOString() %></td><td><%= batch?.description||movement.sourceRef %><br><span class="tiny"><%= movement.sourceType %> · <%= movement.sourceRef %><%= batch?.reversesBatchId?' · exact reversal':'' %></span></td><td><%= fmt(movement.deltaMinor) %></td><td><%= fmt(movement.balanceAfterMinor) %></td><td class="mono"><%= movement.journalId %></td></tr><% }) %></tbody></table></div></section>
</section>
