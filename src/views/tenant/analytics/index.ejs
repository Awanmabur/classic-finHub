<section class="view show"><div class="grid3"><% data.analyticsCards.forEach(card => { %><div class="stat" data-search-row><div class="k"><%= card.label %></div><div class="v"><%= card.value %></div><div class="s"><span class="dot <%= card.tone || '' %>"></span><%= card.note %></div></div><% }) %></div><section class="card" style="margin-top:14px"><div class="cardHead"><b>Comparison views</b><span>Today vs yesterday, module vs module, branch vs branch.</span></div><div class="cardBody"><div class="seg"><% ['Today vs yesterday','This week vs last week','Branch vs branch','Module vs module','Operator vs operator','Network vs network','Forex pair vs forex pair'].forEach(x => { %><span class="chip active"><%= x %></span><% }) %></div></div></section></section>
