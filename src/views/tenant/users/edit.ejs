<section class="view show"><div class="grid">
  <section class="card"><div class="cardHead"><b>Edit staff access</b><span>Verified tenant member · <%= data.account.status %></span></div><div class="cardBody">
    <p class="tiny">Account: <b><%= data.account.email %></b>. Email identity is immutable. Removing permissions takes effect on the next request; adding privileges requires the staff member to sign in again.</p>
    <form method="post" action="/tenant/users/<%= data.account._id %>/update" data-staff-access-form><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field">Display name<input class="control" name="name" minlength="2" maxlength="120" required value="<%= data.account.name %>"></label>
      <label class="field">Role<select class="control" name="role" required data-role-module-select><% data.roles.forEach(role=>{ %><option value="<%= role %>" data-default-modules="<%= (data.roleDefaults?.[role]?.modules||[]).join(',') %>" data-available-modules="<%= (data.allowedByRole?.[role]||[]).join(',') %>" <%= role===data.account.role?'selected':'' %>><%= role %></option><% }) %></select></label>
      <label class="field">Assigned branch<select class="control" name="branchId" required><option value="">Choose an active branch</option><% data.branches.forEach(b=>{ %><option value="<%= b._id %>" <%= String(data.account.branchId)===String(b._id)?'selected':'' %>><%= b.name %></option><% }) %></select></label>
      <input type="hidden" name="moduleSelectionSubmitted" value="yes"><fieldset class="field" data-role-module-choices><legend>Allowed live modules (role permissions still apply)</legend><% data.assignable.forEach(m=>{ %><label class="moduleChoice"><input type="checkbox" name="allowedModules" data-role-module-choice value="<%= m %>" <%= (data.account.allowedModules||[]).includes(m)?'checked':'' %>><span><%= m.replace(/_/g,' ') %></span></label><% }) %><% if(!data.assignable.length){ %><p class="tiny">No live modules subscribed.</p><% } %></fieldset>
      <p class="tiny">An assigned module is not automatically an operating permission. A reporting role can receive module data but cannot execute payments. Select an appropriate operating role for trading or transactions.</p>
      <div class="rowBtns"><button class="btn btnPrimary" type="submit">Save access changes</button><a class="btn" href="/tenant/users">Cancel</a></div>
    </form>
  </div></section>
  <section class="card"><div class="cardHead"><b>Security controls</b><span><%= user.role==='Tenant Owner'?'Tenant-wide admin boundary':'Branch-only admin boundary' %></span></div><div class="cardBody"><p><%= user.role==='Tenant Owner'?'The Tenant Owner can manage tenant staff.':'Only staff in your branch with the Operator or Viewer role can be managed here.' %><% if(typeof mfaEnabled!=='undefined'&&mfaEnabled){ %> A changed role may require authenticator verification on the next login.<% } %></p><p class="tiny">The module list restricts access; it does not grant any permission absent from the selected role. Disabled accounts remain disabled until explicitly restored.</p></div></section>
</div></section>
