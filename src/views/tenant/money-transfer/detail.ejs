<% const viewZone=typeof businessTimeZone==='string'?businessTimeZone:'UTC';
const localWhen=typeof formatLocalDate==='function'?formatLocalDate:
 (value=>new Date(value).toISOString().slice(0,16).replace('T',' ')); %>
<section class="view show financialReportsPage">
<%- include('../partials/record-balances',{recordStatus:data.order.status}) %><section class="card"><div class="cardHead"><b>Request <%= data.order.reference %></b><span><%= data.order.status.replaceAll('_',' ') %></span><a class="btn" href="/tenant/money-transfer/history">History</a></div><div class="cardBody">
<% if(data.order.status==='paid_out_manual'){ %><p class="tiny">Both the collection and payout are final ledger-backed entries. The original cash evidence and audit trail are retained.</p><% }else if(data.order.status==='collected_manual'){ %><p class="tiny">The collection is finalized and the payout PIN is available from its posted movement. Receiver identity and PIN must match before final cash payout.</p><% }else{ %><p class="tiny">This instruction is not a completed transfer collection. Select the actual received funds account and finalize it to issue the payout PIN.</p><% } %>
<div class="summary">
<div class="sumRow"><span>From branch</span><b><%= data.order.originBranchName||'Original operating branch' %></b></div><div class="sumRow"><span>To branch</span><b><%= data.order.destinationBranchName||data.order.originBranchName||'Original operating branch' %></b></div>
<div class="sumRow"><span>Requested amount</span><b><%= data.formatMoneyMinor(data.order.amountMinor,data.order.currency) %></b></div>
<div class="sumRow"><span><%= ['collected_manual','paid_out_manual'].includes(data.order.status)?'Posted transfer fee income':'Transfer fee quoted · not yet earned' %></span><b><%= data.formatMoneyMinor(data.order.feeMinor,data.order.currency) %></b></div>
<div class="sumRow"><span>Sender</span><b><%= data.order.sender.name %> · <%= data.order.sender.country %></b></div>
<div class="sumRow"><span>Sender phone</span><b><%= data.order.sender.phone %></b></div>
<div class="sumRow"><span>Beneficiary</span><b><%= data.order.beneficiary.name %> · <%= data.order.beneficiary.country %></b></div>
<div class="sumRow"><span>Beneficiary phone</span><b><%= data.order.beneficiary.phone %></b></div>
<div class="sumRow"><span>Submitted Local · <%= viewZone %></span><b><%= localWhen(data.order.createdAt,undefined) %></b></div>
<div class="sumRow"><span>Request expires Local · <%= viewZone %></span><b><%= localWhen(data.order.expiresAt,undefined) %></b></div>
<div class="sumRow"><span>Posting evidence</span><b><%= data.order.reviewNote||'No final funds posting yet' %></b></div>
</div><div class="rowBtns" style="margin-top:12px"><% if(data.canFx){ %><a class="btn btnPrimary" href="/tenant/funded/payout">Pay out in a different currency using approved rate and PIN</a><% } %><% if(data.pendingMovementId){ %><a class="btn btnPrimary" href="/tenant/funded/<%= data.pendingMovementId %>">Finish interrupted posting</a><% } %><% if(data.canRecordManual){ %><a class="btn btnPrimary" href="/tenant/funded/prepare/money_transfer/<%= data.order._id %>">Finalize transfer collection</a><% } %><% if(data.order.manualCollectionExecutionId&&(user.role==='Tenant Owner'||String(user.branchId)===String(data.order.branchId))){ %><a class="btn" href="/tenant/funded/<%= data.order.manualCollectionExecutionId %>">View collection / PIN</a><% } %><% if(data.order.manualPayoutExecutionId){ %><a class="btn" href="/tenant/funded/<%= data.order.manualPayoutExecutionId %>">View posted payout</a><% } %><% if(data.canPayout){ %><a class="btn btnPrimary" href="/tenant/funded/payout">Payout by PIN</a><% } %><a class="btn" href="/tenant/funded">Final movements &amp; receipts</a><a class="btn" href="/tenant/money-transfer/<%= data.order._id %>/acknowledgement">Print transfer acknowledgement</a></div></div></section>
<section class="card"><div class="cardBody">
 <details class="financialReportMore"><summary>Additional transfer details</summary>
 <div class="summary"><% [['Sender ID / document no.',data.order.capture?.senderDocument],['Receiver ID / document no.',data.order.capture?.receiverDocument],['Transfer method',data.order.capture?.method||'Cash'],['Purpose / narration',data.order.capture?.purpose],['Exchange rate (indicative)',data.order.capture?.exchangeRate]]
  .filter(([,value])=>value).forEach(([label,value])=>{ %><div class="sumRow"><span><%= label %></span><b><%= value %></b></div><% }) %></div>
 </details></div></section>

<% if(data.canCancel){ %><form class="card" style="margin-top:14px" method="post" action="/tenant/money-transfer/<%= data.order._id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="cardHead"><b>Cancel undecided request</b></div><div class="cardBody"><label class="field">Cancellation reason (12–400 characters)<textarea class="control" name="note" minlength="12" maxlength="400" required rows="2"></textarea></label><div class="rowBtns"><button class="btn" type="submit">Cancel request</button></div></div></form><% } %>
</section>
