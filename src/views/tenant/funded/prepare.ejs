<% const snapshot=data.snapshot,source=data.source; const choices=(kind,currency)=>data.accounts.filter(account=>account.kind===kind&&account.currency===currency&&account.status==='active'&&(kind!=='cash'||String(account.operatorId||'')===String(data.actor.id))); const accountLabel=account=>account.name+' · '+(typeof currencyLabel==='function'?currencyLabel(account.currency):account.currency)+' · '+(account.expectedFormatted||account.bookBalanceFormatted||(typeof formatMoneyMinor==='function'?formatMoneyMinor(account.bookBalanceMinor,account.currency):account.bookBalanceMinor)); const paymentKind=method=>method==='Cash'?'cash':['Mobile Money','Mobile money','Wallet Balance','Wallet balance'].includes(method)?'wallet':'bank'; %>
<section class="view show"><section class="card"><div class="cardHead"><div><b>Record manual movement</b><br><span><%= source.reference %> · <%= data.type.replaceAll('_',' ') %></span></div><a class="btn" href="/tenant/treasury">Balances &amp; reconciliation</a></div><div class="cardBody"><form data-funded-form method="post" action="/tenant/funded/<%= data.type %>/<%= source._id %>">
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= data.idempotencyKey %>">
<div class="formSection"><div class="formSectionTitle">Actual funds accounts</div><p class="tiny">Only accounts opened from independently reviewed counts or statements can post. A different reviewer confirms this manual movement before the book changes.</p><div class="row2">
<% let fields=[]; if(data.type==='forex')fields=[['foreignAccountId','Foreign currency stock','forex_stock',snapshot.fromCurrency],['settlementAccountId','Settlement account',paymentKind(snapshot.settlementMethod),snapshot.toCurrency]]; else if(data.type==='banking'&&snapshot.kind!=='transfer_request')fields=[['cashAccountId','Counted cash / settlement account',paymentKind(snapshot.paymentChannel),snapshot.currency]]; else if(data.type==='money_transfer')fields=[['collectionAccountId','Collected funds account',paymentKind(snapshot.method),snapshot.currency],['clearingAccountId','Transfer payable account','transfer_clearing',snapshot.currency]]; %>
<% fields.forEach(([name,label,kind,currency])=>{const accounts=choices(kind,currency); %><label class="field"><%= label %><select class="control" name="<%= name %>" required><option value="">Select an opened account</option><% accounts.forEach(account=>{ %><option value="<%= account._id %>"><%= accountLabel(account) %></option><% }) %></select><% if(!accounts.length){ %><span class="tiny">No opened <%= currency %> <%= kind.replaceAll('_',' ') %> account. Configure and reconcile it first.</span><% } %></label><% }) %>
</div></div>
<div class="formSection"><div class="formSectionTitle">Count or statement evidence</div><div class="row2"><label class="field">Counted cash / statement reference<input class="control" name="evidenceReference" minlength="5" maxlength="120" required placeholder="Cash slip, provider receipt or statement reference"></label><label class="field">Manual movement explanation<textarea class="control" name="note" minlength="12" maxlength="400" required rows="3" placeholder="What was counted or checked against the actual account?"></textarea></label></div></div>
<div class="summary"><div class="sumRow"><span>Reference</span><b><%= source.reference %></b></div><div class="sumRow"><span>Posting status</span><b>Pending independent review</b></div><% if(data.type==='forex'){ %><div class="sumRow"><span>Foreign amount</span><b><%= typeof formatMoneyMinor==='function'?formatMoneyMinor(snapshot.sourceMinor,snapshot.fromCurrency):snapshot.sourceMinor+' '+snapshot.fromCurrency %></b></div><div class="sumRow"><span>Settlement amount</span><b><%= typeof formatMoneyMinor==='function'?formatMoneyMinor(snapshot.targetMinor,snapshot.toCurrency):snapshot.targetMinor+' '+snapshot.toCurrency %></b></div><% } else { %><div class="sumRow"><span>Amount</span><b><%= typeof formatMoneyMinor==='function'?formatMoneyMinor(snapshot.amountMinor,snapshot.currency):snapshot.amountMinor+' '+snapshot.currency %></b></div><% } %></div>
<div class="rowBtns"><button class="btn btnPrimary" type="submit">Record for independent review</button><a class="btn" href="/tenant/funded">Cancel</a></div></form></div></section></section>
