<section class="view show">
 <section class="card"><div class="cardHead"><b>Appointment requests</b><span>Review, schedule and record the outcome</span></div><div class="cardBody">
  <form method="get" action="/platform/appointments" class="row3 appointmentFilters"><label class="field">Status<select class="control" name="status"><option value="">All statuses</option><% ['pending','confirmed','completed','cancelled'].forEach(status=>{ %><option value="<%= status %>" <%= data.filters.status===status?'selected':'' %>><%= status %></option><% }) %></select></label><label class="field">Business, contact or email<input class="control" name="q" value="<%= data.filters.q %>" maxlength="80" placeholder="Search by starting text"></label><div class="rowBtns"><button class="btn btnPrimary">Apply filters</button><a class="btn" href="/platform/appointments">Clear</a></div></form>
 </div></section>
 <section class="card platformAppointmentDirectory"><div class="cardHead"><b>Results</b><span><%= data.appointments.length %> shown · open any row to review</span></div>
 <div class="cardBody"><div class="tableWrap"><table class="denseDirectory appointmentTable">
 <thead><tr><th>Business</th><th>Contact</th><th>Preferred date</th><th>Modules</th><th>Status</th><th>Scheduled (UTC)</th><th>Action</th></tr></thead>
 <tbody>
 <% if(!data.appointments.length){ %><tr><td colspan="7">No appointment requests match these filters.</td></tr><% } %>
 <% data.appointments.forEach((a,index)=>{ %>
 <tr data-search-row>
 <td><b><%= a.businessName %></b></td>
 <td><span><%= a.contactName %></span><span class="tiny appointmentContact"><%= a.email||a.phone %></span></td>
 <td><%= a.preferredDate?new Date(a.preferredDate).toISOString().slice(0,10):'Flexible' %></td>
 <td><%= a.modules.map(key=>data.moduleLabels[key]||key).join(', ')||'Needs discovery' %></td>
 <td><span class="tag"><%= a.status %></span></td>
 <td><%= a.scheduledAt?new Date(a.scheduledAt).toISOString().slice(0,16).replace('T',' '):'Not scheduled' %></td>
 <td><button class="btn appointmentExpand" type="button" aria-expanded="false" aria-controls="appointment-detail-<%= index %>" data-appointment-toggle>Review</button></td>
 </tr>
 <tr class="appointmentDetailRow" id="appointment-detail-<%= index %>" hidden><td colspan="7">
 <div class="appointmentDetails"><div class="appointmentDetailSummary"><div><b>Business</b><span><%= a.businessName %></span></div><div><b>Contact</b><span><%= a.contactName %> · <%= a.email||a.phone %></span></div><div><b>Meeting link</b><span><%= a.meetingLink||'Not provided' %></span></div><div><b>Request notes</b><span><%= a.notes||'—' %></span></div><div><b>Latest decision</b><span><%= a.reviewNote||'Not reviewed' %></span></div></div>
 <% if(!['completed','cancelled'].includes(a.status)){ %>
 <form method="post" action="/platform/appointments/<%= a._id %>/decision" class="appointmentDecision appointmentRowDecision"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= a.revision %>"><div class="row2"><label class="field">Scheduled date and time (UTC)<input class="control" type="datetime-local" name="scheduledAt" value="<%= a.scheduledAt?new Date(a.scheduledAt).toISOString().slice(0,16):'' %>"></label><label class="field">Meeting link (optional)<input class="control" type="url" name="meetingLink" maxlength="500" placeholder="https://" value="<%= a.meetingLink||'' %>"></label></div><label class="field">Decision note<textarea class="control" name="note" minlength="12" maxlength="400" required rows="2"></textarea></label><div class="rowBtns"><button class="btn btnPrimary" name="action" value="confirm">Confirm / reschedule</button><% if(a.status==='confirmed'){ %><button class="btn" name="action" value="complete" <%= !a.scheduledAt||new Date(a.scheduledAt)>new Date()?'disabled':'' %>>Mark completed</button><% if(!a.scheduledAt||new Date(a.scheduledAt)>new Date()){ %><span class="tiny">Completion is available after the scheduled start.</span><% } %><% } %><button class="btn" name="action" value="cancel">Cancel request</button></div></form>
 <% } else if(a.status==='completed'){ %><a class="btn" href="/platform/tenants/create">Create tenant</a><% } %>
 </div>
 </td></tr>
 <% }) %>
 </tbody></table></div></div></section>
 <% if(data.nextCursor){ const params=new URLSearchParams({...data.filters,cursor:data.nextCursor}); %><div class="rowBtns" style="margin-top:14px"><a class="btn" href="/platform/appointments?<%= params.toString() %>">Older requests</a></div><% } %>
</section>
