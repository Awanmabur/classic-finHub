<!doctype html>
<html lang="en">
<head>
  <% const layoutTenantName=context==='tenant'?String(tenant?.name||'Tenant workspace'):'ClassicFin Hub'; %>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= pageTitle %> — <%= layoutTenantName %></title>
  <meta name="robots" content="noindex,nofollow" />
  <meta name="description" content="Protected <%= layoutTenantName %> operations workspace." />
  <link rel="stylesheet" href="/vendor/inter/inter.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= assetVersion %>" />
  <% if(context==='tenant'){ %><link rel="stylesheet" href="/css/approved-tenant.css?v=<%= assetVersion %>" /><% } else { %><link rel="stylesheet" href="/css/dashboard.css?v=<%= assetVersion %>" /><% } %>
  <link rel="stylesheet" href="/css/dashboard-layout.css?v=<%= assetVersion %>" />
  <% if(context==='tenant'){ %><link rel="stylesheet" href="/css/workspace.css?v=<%= assetVersion %>" /><link rel="stylesheet" href="/tenant/workspace/theme.css?v=<%= assetVersion %>" /><% } %>
<link rel="stylesheet" href="/css/feedback.css?v=<%= typeof assetVersion==='undefined'?'1':assetVersion %>">
  <link rel="stylesheet" href="/css/stat-system.css?v=<%= assetVersion %>" />
  <% if(context==='tenant'&&currentPath==='/tenant/setup'){ %><link rel="stylesheet" href="/css/tenant-quick-setup.css?v=<%= assetVersion %>" /><% } %>
<script src="/js/feedback.js?v=<%= typeof assetVersion==='undefined'?'1':assetVersion %>" defer></script>
</head>
<body<% if(context==='tenant'){ %> data-workspace="tenant" data-offline-context="<%= typeof offlineContext==='undefined'?'':JSON.stringify(offlineContext) %>" data-offline-scope="<%= typeof offlineIdentity!=='undefined'?offlineIdentity.scope:'' %>" data-offline-branch="<%= typeof offlineIdentity!=='undefined'?offlineIdentity.branchId:'' %>" data-offline-view="<%= typeof offlineIdentity!=='undefined'?offlineIdentity.viewBranchId:'' %>" data-offline-cacheable="<%= typeof offlineCacheable!=='undefined'&&offlineCacheable?'true':'false' %>" data-phone-prefix="<%= typeof phoneDefaults==='undefined'?'+211':phoneDefaults.dialCode %>"<% } %>>
  <% const visiblePaths = new Set(menu.flatMap(group => [...group.items.map(item => item.href),...(group.paths||[])]));
     const can = permission => user.permissions.includes('*') || user.permissions.includes(permission);
     const quickActions = context === 'tenant' ? [
       {href:'/tenant/money-transfer/send',accessPath:'/tenant/money-transfer',kind:'transfer',label:'New money transfer',permission:'money_transfer.create'},
       {href:'/tenant/mobile-money/cash-in',accessPath:'/tenant/mobile-money',kind:'mobile_money',label:'New mobile money',permission:['mobile_money.cash_in','mobile_money.cash_out']},
       {href:'/tenant/forex/buy',accessPath:'/tenant/forex',kind:'forex_buy',label:'New forex',permission:'forex.quotes.create'},
       {href:'/tenant/banking/deposit',accessPath:'/tenant/banking',kind:'banking_deposit',label:'New banking',permission:'banking.requests.create'},
       {href:'/tenant/approvals',kind:'approval',label:'New approval request',permission:'approvals.submit'},
       {href:'/tenant/cash/shifts',kind:'cash_shift_open',label:'Open day',permission:'treasury.view',roles:['Tenant Owner','Branch Manager','Mobile Money Operator','Money Transfer Operator','Banking Operator','Forex Operator']}
     ].filter(action => visiblePaths.has(action.accessPath||action.href) && (Array.isArray(action.permission) ? action.permission.some(can) : can(action.permission)) && (!action.roles || action.roles.includes(user.role)) && !(action.kind==='cash_shift_open' && data.workspaceSnapshot?.currentCashShift)) : [];
     const transactionOptions = context === 'tenant' ? [
       {kind:'cash_in',href:'/tenant/mobile-money',label:'Deposit',description:'Mobile Money',icon:'fa-arrow-down',permission:'mobile_money.cash_in'},
       {kind:'cash_out',href:'/tenant/mobile-money',label:'Withdrawal',description:'Mobile Money',icon:'fa-arrow-up',permission:'mobile_money.cash_out'},
       {kind:'payout',href:'/tenant/money-transfer',label:'Payout by PIN',description:'Payout verification',icon:'fa-key',permission:'money_transfer.payout'},
       {kind:'transfer',href:'/tenant/money-transfer',label:'Send money / Generate PIN',description:'Money Transfer',icon:'fa-money-bill-transfer',permission:'money_transfer.create'},
       {kind:'banking_deposit',href:'/tenant/banking',label:'Deposit',description:'Banking Operations',icon:'fa-building-columns',permission:'banking.requests.create'},
       {kind:'banking_withdrawal',href:'/tenant/banking',label:'Withdraw',description:'Banking Operations',icon:'fa-arrow-up',permission:'banking.requests.create'},
       {kind:'banking_transfer',href:'/tenant/banking',label:'Account transfer',description:'Banking Operations',icon:'fa-right-left',permission:'banking.requests.create'},
       {kind:'forex_buy',href:'/tenant/forex',label:'Buy forex from customer',description:'Forex Operations',icon:'fa-chart-line',permission:'forex.quotes.create'},
       {kind:'forex_sell',href:'/tenant/forex',label:'Sell forex to customer',description:'Forex Operations',icon:'fa-chart-line',permission:'forex.quotes.create'},
       {kind:'customer',href:'/tenant/customers',label:'New customer',description:'Customer identity and next of kin',icon:'fa-user-plus',permission:'customers.create'},
       {kind:'account',href:'/tenant/accounts',label:'New account',description:'Customer account and ledger mapping',icon:'fa-wallet',permission:'accounts.manage'},
       {kind:'expense',href:'/tenant/expenses',label:'Add expense',description:'Expense details and independent review',icon:'fa-receipt',permission:'expenses.create'},
       {kind:'approval',href:'/tenant/approvals',label:'Approval request',description:'Independent review',icon:'fa-user-shield',permission:'approvals.submit'},
       {kind:'cash_shift_close',href:'/tenant/cash/shifts',label:'Close day',description:'Auto closing balances from reports',icon:'fa-lock',permission:'treasury.view',roles:['Tenant Owner','Mobile Money Operator','Money Transfer Operator','Banking Operator','Forex Operator']},
       {kind:'cash_shift_open',href:'/tenant/cash/shifts',label:'Open day',description:'Opening drawer by currency',icon:'fa-cash-register',permission:'treasury.view',roles:['Tenant Owner','Mobile Money Operator','Money Transfer Operator','Banking Operator','Forex Operator']}
     ].filter(option=>visiblePaths.has(option.href) && can(option.permission) && (!option.roles || option.roles.includes(user.role))) : [];
     const assignedOperationBranch = typeof operationBranch === 'undefined' ? null : operationBranch;
     const availableCurrencies=typeof currencyOptions==='undefined'?[{code:'UGX',label:'UGX'},{code:'USD',label:'USD'},{code:'SSP',label:'SSP'},{code:'KES',label:'KSH'}]:currencyOptions;
     const momoOnlyDashboard=currentPath==='/tenant/dashboard'&&data.hasMobileMoney&&!data.hasTransfer&&!data.hasBanking&&!data.hasForex;
     const mobileOperationPage=/^\/tenant\/mobile-money\/(cash-in|cash-out|report)$/.test(currentPath);
     const mobileMarketCurrencies=mobileOperationPage?(data.networkMarkets||[]).map(m=>m.currency):
       momoOnlyDashboard?(data.mobileMarkets||[]).map(m=>m.currency):[];
     const dashboardCurrencies=mobileMarketCurrencies.length?
       availableCurrencies.filter(option=>mobileMarketCurrencies.includes(option.code)):availableCurrencies;
     // Reports and the overview default to every original currency. Entries
     // keep a concrete currency so the transaction dialog remains valid.
     const summaryCurrencyView=context==='tenant'&&(currentPath==='/tenant/dashboard'||
      /^\/tenant\/(?:money-transfer|banking|forex)\/(?:records|movements|report|fees|cash-impact|pending-payouts)$/.test(currentPath)||
      currentPath==='/tenant/mobile-money/report');
     const summaryCurrencyOptions=summaryCurrencyView&&currentPath.startsWith('/tenant/forex/')&&Array.isArray(data.currencies)?data.currencies.map(code=>({code,label:code==='KES'?'KSH':code})):availableCurrencies;
     const currencyChoices=summaryCurrencyView?[{code:'',label:'All currencies'},...summaryCurrencyOptions]:dashboardCurrencies;
     const currencyFilterParams=new URLSearchParams(typeof branchViewReturnTo==='string'?branchViewReturnTo.split('?')[1]||'':'');
     const requestedDisplayCurrency=currencyFilterParams.get('currency');
     const mobileMarketDefault=(mobileOperationPage||momoOnlyDashboard)&&dashboardCurrencies.length?
       (dashboardCurrencies.some(option=>option.code===data.mobileMoneySelectedCurrency)?data.mobileMoneySelectedCurrency:
        dashboardCurrencies.some(option=>option.code===data.mobileMarket?.currency)?data.mobileMarket.currency:dashboardCurrencies[0].code):null;
     const selectedDisplayCurrency=summaryCurrencyView?(data.dashboardCurrency||data.filters?.currency||
       (availableCurrencies.some(option=>option.code===requestedDisplayCurrency)?requestedDisplayCurrency:'')||''):
      (mobileMarketDefault||data.workspaceSnapshot?.selectedCurrency||data.filters?.currency||data.selectedCurrency||data.entryCurrency||
       (dashboardCurrencies.some(option=>option.code===requestedDisplayCurrency)?requestedDisplayCurrency:null)||
       assignedOperationBranch?.currency||'UGX');
     const pageContent = include(view, { data, money, tenant, user, context, quickActions, visiblePaths, transactionOptions });
     const hasPageSearch = pageContent.includes('data-search-row'); %>
  <a class="skip-link" href="#workspaceContent">Skip to workspace</a>
  <div class="grain" aria-hidden="true"></div>
  <div class="wrap"><div class="shell">
    <%- include('../partials/dashboard-sidebar', { context, menu, currentPath, tenant, user, canViewBranches:typeof canViewBranches!=='undefined'&&canViewBranches, viewBranches:typeof viewBranches!=='undefined'?viewBranches:[], viewBranchId:typeof viewBranchId!=='undefined'?viewBranchId:'', branchViewReturnTo:typeof branchViewReturnTo!=='undefined'?branchViewReturnTo:currentPath }) %>
    <main class="panel main" id="workspaceContent" tabindex="-1">
      <%- include('../partials/flash', { flash }) %>
      <dialog id="dashboardSignoutDialog" class="dashboardSignoutDialog" aria-labelledby="dashboardSignoutTitle" aria-describedby="dashboardSignoutDescription">
        <div class="dashboardSignoutDialogContent">
          <div class="signoutProgressIcon" aria-hidden="true"></div>
          <strong id="dashboardSignoutTitle">Signing out…</strong>
          <p id="dashboardSignoutDescription">Ending your secure session.</p>
        </div>
      </dialog>
      <div class="topbar">
        <div class="topActions">
          <% if(context==='tenant'){ %>
            <div class="tenantHeaderIdentityGroup">
              <button class="btn btnIcon mobileOnly headerMenu" id="menuBtn" type="button" aria-label="Open menu" aria-controls="sidePanel" aria-expanded="false">☰</button>
            <div class="headerIdentity" aria-label="Signed-in user and operating branch">
              <% if(assignedOperationBranch){ %><span data-operating-branch data-branch-name="<%= assignedOperationBranch.name %>" data-branch-currency="<%= assignedOperationBranch.currency %>" hidden></span><% } %>
              <strong><%= user?.name||'Account' %></strong>
              <span title="Operating branch, separate from the viewing branch"><%= assignedOperationBranch?.name||'No operating branch' %> · <%= user?.role||'Operator' %></span>
              </div>
            </div>
            <div class="tenantHeaderControlGroup">
              <% if(typeof canViewBranches!=='undefined'&&canViewBranches){ %>
              <form method="post" action="/tenant/view-branch" class="ctrl headerBranchView" data-branch-view-form>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="returnTo" value="<%= typeof branchViewReturnTo!=='undefined'?branchViewReturnTo:currentPath %>">
                <label for="headerViewingBranch" class="visuallyHidden">Viewing branch</label>
                <select id="headerViewingBranch" name="viewBranchId" aria-label="Viewing branch">
                  <option value="all" <%= typeof viewBranchId!=='undefined'&&viewBranchId==='all'?'selected':'' %>>All branches</option>
                  <% (typeof viewBranches!=='undefined'?viewBranches:[]).forEach(branch=>{ %>
                  <option value="<%= branch._id %>" <%= typeof viewBranchId!=='undefined'&&String(branch._id)===String(viewBranchId)?'selected':'' %>><%= branch.name %></option>
                  <% }) %>
                </select>
                <noscript><button class="btn" type="submit">Apply</button></noscript>
              </form>
              <% } %>
            <div class="headerScope" aria-label="Reporting currency">
              <% if(!summaryCurrencyView&&dashboardCurrencies.length===1&&(mobileOperationPage||momoOnlyDashboard)){ %>
               <span class="ctrl" aria-label="Network currency"><%= dashboardCurrencies[0].label %></span>
              <% }else{ %>
              <form method="get" action="<%= currentPath %>" class="ctrl" data-dashboard-currency-form><% for(const [key,value] of currencyFilterParams){if(!['currency','page','cursor','_csrf'].includes(key)){ %><input type="hidden" name="<%= key %>" value="<%= value %>"><% }} %><select id="currencySelect" name="currency" aria-label="Display currency"><% currencyChoices.forEach(option=>{ %><option value="<%= option.code %>" <%= selectedDisplayCurrency===option.code?'selected':'' %>><%= option.label %></option><% }) %></select><button type="submit" hidden>Apply currency</button><noscript><button type="submit" class="btn">Apply currency</button></noscript></form><% } %>
            </div>
            <div class="ctrl headerSearch"><input id="search" type="search" aria-label="Search loaded records" placeholder="Search name, phone, ref, PIN, account…"></div>
            <div class="headerButtons">
              <% if(visiblePaths.has('/tenant/notifications')){ %><a class="btn btnIcon headerNotice" id="phase2NotifyBtn" href="/tenant/notifications" aria-label="Notifications" title="Notifications"><i class="fa-regular fa-bell" aria-hidden="true"></i><span class="phase2Badge" id="phase2NotifyCount"><%= data.workspaceSnapshot?.notificationUnread??'—' %></span></a><% } %>
              <% if(['Tenant Owner','Branch Manager'].includes(user.role)){ %>
              <form method="post" action="/tenant/backups/action" class="headerDriveForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btnIcon" type="submit" aria-label="Google Drive backup" title="Google Drive backup"><i class="fa-brands fa-google-drive" aria-hidden="true"></i></button>
              </form>
              <% } %>
              <div class="headerPrimaryActions">
                <% if(visiblePaths.has('/tenant/last-receipt')){ %><a class="btn headerLastReceipt" id="lastReceiptBtn" href="<%= data.workspaceSnapshot?.latestAcknowledgement?.href||'/tenant/last-receipt' %>"><i class="fa-solid fa-receipt" aria-hidden="true"></i><span>Last receipt</span></a><% } %>
                <% if(transactionOptions.length){ %><button class="btn btnPrimary" id="newTransactionBtn" type="button" data-open-transaction>New transaction</button><% } %>
              </div>
            </div>
            </div>
          <% } else { %>
            <button class="btn btnIcon mobileOnly headerMenu" id="menuBtn" type="button" aria-label="Open menu" aria-controls="sidePanel" aria-expanded="false">☰</button>
            <% if(hasPageSearch){ %><div class="ctrl pageSearch headerSearch"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input id="search" type="search" aria-label="Search records on this page" placeholder="Search this page…"></div><% } %>
            <div class="headerButtons"><% if(['/platform/dashboard','/platform/tenants'].includes(currentPath)){ %><a class="btn btnPrimary" href="/platform/tenants/create"><i class="fa-solid fa-plus" aria-hidden="true"></i> Create tenant</a><% } %></div>
          <% } %>
        </div>
        <div class="title"><h2 id="pageTitle"><%= pageTitle %></h2><p id="pageSub"><%= pageSub %></p></div>
      </div>
      <%- pageContent %>
    </main>
  </div></div>
  <div class="menuOverlay" id="menuOverlay"></div>
  <% if(transactionOptions.length){ %><%- include('../partials/transaction-modal', {transactionOptions,visiblePaths,seedDisplayCurrency:selectedDisplayCurrency||assignedOperationBranch?.currency||'UGX'}) %><% } %>
  <% if(context === 'tenant'){ %><%- include('../partials/offline-queue') %><script src="/js/offline-workspace.js?v=<%= assetVersion %>" defer></script><script src="/js/customer-accounts.js?v=<%= assetVersion %>" defer></script><% } %>
  <script src="/js/operation-pricing.js?v=<%= assetVersion %>" defer></script>
  <script src="/js/dashboard.js?v=<%= assetVersion %>" defer></script>
  <% if(context==='tenant'){ %><script src="/js/mobile-money-quote.js?v=<%= assetVersion %>" defer></script><script src="/js/mobile-money-unified.js?v=<%= assetVersion %>" defer></script><% } %>
</body>
</html>
