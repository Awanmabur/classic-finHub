<section class="view show">
  <section class="card"><div class="cardHead"><b>Appointment requests</b><span>Confirm, add meeting link, complete, then convert to tenant.</span></div><div class="cardBody tableWrap"><table><thead><tr><th>Business</th><th>Contact</th><th>Preferred date</th><th>Modules</th><th>Status</th><th>Actions</th></tr></thead><tbody><% data.appointments.forEach(a => { %><tr data-search-row><td><b><%= a.businessName %></b><br><span class="tiny"><%= a.notes %></span></td><td><%= a.contactName %><br><span class="tiny"><%= a.email %> • <%= a.phone %></span></td><td><%= a.preferredDate || 'Flexible' %></td><td><%= a.modules.map(key=>data.moduleLabels?.[key]||key).join(', ') || 'Needs discovery' %></td><td><span class="tag"><%= a.status %></span></td><td><span class="tag">Review only</span><br><span class="tiny">Confirmation workflow unavailable until email delivery and audit are enabled.</span></td></tr><% }) %></tbody></table></div></section>
</section>
