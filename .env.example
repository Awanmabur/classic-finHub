NODE_ENV=development
PORT=3000
# Set a real HTTPS URL and SESSION_SECRET (32+ chars) in production.
APP_URL=http://localhost:3000
SESSION_SECRET=
# Default for npm run db:dev:up / npm run dev:local. Existing native MongoDB commonly uses port 27017.
MONGO_PLATFORM_URI=mongodb://127.0.0.1:27018/classicfin_platform_db?replicaSet=rs0&directConnection=true
# Enabled only after a real provider integration and regulatory approvals.
REAL_MONEY_ENABLED=false
TRUST_PROXY=0

# Secure password recovery (HTTPS API, optional for local dev; configure before production launch).
# Resend requires a verified sending domain/address; do not put Purelymail SMTP secrets here.
RESEND_API_KEY=
MAIL_FROM=

# Mandatory in production. Generate 32 random bytes and write as 64 hexadecimal characters.
MFA_ENCRYPTION_KEY=

# Enable indexing only on the genuine production domain; set false on staging.
# SEO_INDEXING_ENABLED=true

# Separate background process: npm run worker (same database and environment).
# Set a real verified sending domain to enable subscription notification delivery.
OUTBOX_POLL_MS=2000

# For production, supply a separate CLASSICFIN_WORKER_ENV_FILE rather than
# putting a worker database password in the main web application environment.

# Internal trusted gateway keys (two DISTINCT 32-byte hex secrets). Do not expose in frontend.
# These authorize normalized evidence from a provider-verified gateway ONLY; they do
# not authenticate actual payment-provider callbacks or prove bank settlement.
FINANCIAL_GATEWAY_CALLBACK_HMAC_KEY_HEX=
FINANCIAL_GATEWAY_STATEMENT_HMAC_KEY_HEX=
