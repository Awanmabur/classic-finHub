<% if(data.canObserve){ %>
<section class="card" style="margin-top:14px" id="add-funds"><div class="cardHead"><div><b>Add funds / transfer funds</b><br><span>Move funds between your existing accounts</span></div></div><form class="cardBody" method="post" action="/tenant/treasury/funding" data-wallet-funding-form>
 <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= data.fundingIdempotencyKey %>">
 <div class="formSection"><div class="formSectionTitle">Funding details</div><div class="row2">
  <label class="field">From account<select class="control" name="sourceAccountId" required><option value="">Select funding source</option><% data.fundingAccounts.forEach(account=>{ %><option value="<%= account._id %>"><% if(data.allBranches&&data.branchNames[String(account.branchId)]){ %><%= data.branchNames[String(account.branchId)] %> · <% } %><%= account.name %> · <%= data.format(account.bookBalanceMinor,account.currency) %></option><% }) %></select></label>
  <label class="field">To wallet / account<select class="control" name="destinationAccountId" required><option value="">Select destination</option><% data.fundingAccounts.forEach(account=>{ %><option value="<%= account._id %>" <%= data.fundingDestination===String(account._id)?'selected':'' %>><% if(data.allBranches&&data.branchNames[String(account.branchId)]){ %><%= data.branchNames[String(account.branchId)] %> · <% } %><%= account.name %> · <%= account.currency==='KES'?'KSH':account.currency %></option><% }) %></select></label>
  <label class="field">Amount<input class="control" name="amount" inputmode="decimal" required placeholder="0" pattern="[0-9]+([.][0-9]{1,2})?"></label>
  <label class="field">Funding reference<input class="control" name="evidenceReference" minlength="6" maxlength="120" required placeholder="Bank transfer, receipt or cash reference"></label>
 </div><label class="field">Note / narration<textarea class="control" name="note" minlength="12" maxlength="400" required rows="2" placeholder="Describe the transfer and its supporting receipt or statement"></textarea></label></div>
 <p class="tiny"><%= user.role==='Tenant Owner'?'Funding follows the branch of the selected accounts.':'Funding uses your assigned operating branch.' %> Both accounts need approved opening balances, the same branch and currency, and a matching operator assignment. A different reviewer approves the transfer before either book changes.</p>
 <% if(data.fundingAccounts.length<2){ %><p class="tiny">Set up at least two eligible accounts and confirm their opening balances first. A cash source also needs an independently verified open drawer.</p><% } %>
 <div class="rowBtns"><button type="submit" class="btn btnPrimary" <%= data.fundingAccounts.length<2?'disabled':'' %>>Submit funding transfer</button></div>
</form></section>
<% } %>
