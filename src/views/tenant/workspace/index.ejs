<link rel="stylesheet" href="/css/workspace.css?v=<%= assetVersion %>">
<section class="view show workspaceStack" data-workspace-page="<%= data.page %>">
<% const fmtDate=value=>value?new Date(value).toLocaleString('en-GB',{timeZone:data.config.profile.timezone||'UTC'}):'—'; %>
<% if(data.page==='overview'){ %>
 <% if(user.role==='Tenant Owner'){ %>
 <section class="card"><div class="cardHead"><div><b>New business? Set up everything in one place</b><br><span>One guided setup: branch, staff, cash and float accounts. No administrator approval to create them.</span></div><a class="btn btnPrimary" href="/tenant/setup">Start setup</a></div></section>
 <% } %>
 <%- include('_operations',{fmtDate}) %>
 <section class="card"><div class="cardHead"><div><b>Business setup &amp; administration</b><br><span>Use the working settings for your tenant</span></div></div><div class="cardBody workspaceActions"><a class="btn" href="/tenant/workspace/profile">Tenant profile &amp; operating setup</a><a class="btn" href="/tenant/branches">Branches &amp; assignments</a><a class="btn" href="/tenant/users">Staff &amp; access</a><a class="btn" href="/tenant/workspace/subscription">Subscription &amp; limits</a><a class="btn" href="/tenant/modules">Request modules</a><a class="btn" href="/tenant/workspace/database">Tenant database</a><a class="btn" href="/tenant/workspace/audit">Configuration audit</a></div></section>
 <details class="card workspaceSecondary"><summary>Public content &amp; policy records</summary><div class="cardBody workspaceStack"><p class="tiny">Profile, branding and published landing content are saved settings. KYC, compliance, notification and integration descriptions document policies; they do not add transaction rules, provider connections or scheduled jobs.</p><div class="workspaceActions"><a class="btn" href="/tenant/workspace/landing">Business website</a><a class="btn" href="/tenant/workspace/reviews">Customer reviews</a><a class="btn" href="/tenant/workspace/branding">Branding &amp; receipts</a><a class="btn" href="/tenant/workspace/roles"><%= user.role==='Tenant Owner'?'Manage role modules':'View my module access' %></a><% if(data.canCustomers){ %><a class="btn" href="/tenant/workspace/kyc">KYC policy records</a><% } %><a class="btn" href="/tenant/workspace/compliance">Compliance policy records</a><% if(data.canNotifications){ %><a class="btn" href="/tenant/workspace/notification-rules">Notification policy records</a><% } %><a class="btn" href="/tenant/workspace/integrations">Integration records</a><a class="btn" href="/tenant/workspace/import-export">Exports &amp; onboarding notes</a></div></div></details>
<% } %>
<% if(data.page==='profile'){ const p=data.config.profile; %>
 <div class="card"><div class="cardHead"><div><b>Tenant profile</b><br><span>Business identity, owner contact, and workspace preferences</span></div><% if(data.canManage){ %><a class="btn btnPrimary" href="/tenant/workspace/profile/edit" data-workspace-open="workspaceEditor">Edit profile</a><% } %></div><div class="cardBody"><dl class="workspaceFacts">
 <% [['Business name',p.name],['Legal name',p.legalName],['Owner / director',p.owner],['Owner email',p.ownerEmail],['Support phone',p.supportPhone],['Country',p.country],['Timezone',p.timezone],['Default currency',p.defaultCurrency],['Subdomain',tenant.slug],['Status',tenant.status]].forEach(row=>{ %><div><dt><%= row[0] %></dt><dd><%= row[1]||'—' %></dd></div><% }) %>
 </dl></div></div><p class="workspaceNote">Profile identity appears on your tenant landing page and receipts. Operating currencies, access and plan limits are managed through their respective settings.</p>
 <% if(data.summary){ %><%- include('_operations',{fmtDate}) %><% } %>
 <% if(data.canCash){ %><%- include('_operations-guide') %><% } %>
<% } %>
<% if(data.page==='landing'){ %>
 <% const listingActive=['active','trial'].includes(tenant.status)&&tenant.setupStatus==='complete'&&tenant.directoryListing?.visibility!=='hidden'; %>
 <div class="card" style="margin-bottom:14px">
  <div class="cardHead"><div><b>Your live business listing</b><br>
   <span><%= listingActive?'Public now — no approvals or waiting':'Hidden or account not activated' %></span></div>
   <% if(listingActive){ %><a class="btn" href="/t/<%= tenant.slug %>" target="_blank" rel="noopener noreferrer">View live profile</a><% } %>
  </div>
  <div class="cardBody">
   <p class="tiny">Once your account is activated, your business name and shareable profile link appear automatically. No platform administrator must approve it. You control the public visibility; contact details, services and images only appear after you publish them.</p>
   <% if(data.canManage&&user.role==='Tenant Owner'&&['trial','active'].includes(tenant.status)&&tenant.setupStatus==='complete'){ %>
    <form method="post" action="/tenant/workspace/listing/visibility" class="workspaceActions">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="action" value="<%= listingActive?'hide':'show' %>">
      <button type="submit" class="btn <%= listingActive?'':'btnPrimary' %>"><%= listingActive?'Hide my public business listing':'Show my business now' %></button>
    </form>
   <% } %>
  </div>
 </div>
 <% const site=data.config.landing,details=site.details||{};
     const checklist=[
       ['Headline',Boolean(site.headline)],['About',Boolean(details.about)],
       ['Services',Boolean(site.services?.length)],['Location',Boolean(details.city||details.address)],
       ['Hours',Boolean(details.hours)],['Public contact',Boolean(details.publicEmail||data.config.profile.supportPhone||details.whatsapp)],
       ['Business image',Boolean(details.logoUrl||details.coverUrl)],['Custom sections',Boolean(data.entries.some(e=>e.kind==='landing_section'&&e.status==='published'))]
     ];
     const readyItems=checklist.filter(item=>item[1]).length; %>
 <div class="card"><div class="cardHead"><div><b>Public business website</b><br><span>Your shareable profile, custom business content, public contacts and customer reviews</span></div><div class="workspaceActions"><% if(data.canManage){ %><a class="btn btnPrimary" href="/tenant/workspace/landing/headline/edit" data-workspace-open="workspaceHeroEditor">Edit business website</a><% } %><a class="btn" href="/tenant/workspace/landing-preview">Preview draft</a><a class="btn" href="/tenant/workspace/reviews">Customer reviews</a></div></div>
 <div class="cardBody workspaceStack">
  <p class="tiny">Website content completed: <strong><%= readyItems %> of <%= checklist.length %></strong> recommended items. This is an editorial checklist, not a transaction or identity-verification status.</p>
  <div class="workspaceServiceTags"><% checklist.forEach(item=>{ %><span class="tag"><%= item[1]?'✓':'○' %> <%= item[0] %></span><% }) %></div>
  <h2><%= site.headline||'Start with your public headline' %></h2><p class="workspaceText"><%= site.subtitle||'Introduce your business and the services you offer.' %></p>
  <dl class="workspaceFacts"><% [['Category',details.category],['Address',[details.address,details.city,details.region,data.config.profile.country].filter(Boolean).join(', ')],['Opening hours',details.hours],['Public email',details.publicEmail],['Website',details.website],['WhatsApp',details.whatsapp],['Gallery photos',(details.gallery||[]).length]].forEach(row=>{ %><div><dt><%= row[0] %></dt><dd><%= row[1]||'—' %></dd></div><% }) %></dl>
  <div class="workspaceActions">
  <% if(data.canManage&&site.headline){ %><form method="post" action="/tenant/workspace/landing/publish"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= data.config.revision %>"><button class="btn btnPrimary">Publish website updates</button></form><% } %>
  <span class="tiny">Last published: <%= fmtDate(site.publishedAt) %></span>
  <% if(site.publishedAt){ %><a class="btn" href="/t/<%= tenant.slug %>" target="_blank" rel="noopener noreferrer">Open live website</a><button type="button" class="btn" data-website-copy-path="/t/<%= tenant.slug %>">Copy shareable link</button><% } %>
  </div>
 </div></div>
 <% if(data.canManage){ %>
 <section class="card" aria-label="Uploaded business images">
  <div class="cardHead"><div><b>Your uploaded business images</b><br><span>Cloudflare R2 · public website media only</span></div><span class="tag"><%= !r2MediaConfigured?'Setup required':(data.media||[]).length+' of 200 images · '+((data.media||[]).reduce((sum,item)=>sum+Number(item.bytes||0),0)/1048576).toFixed(1)+' / '+(Number(data.mediaQuotaBytes||0)/1048576).toFixed(0)+' MiB' %></span></div>
  <div class="cardBody">
   <% if(!r2MediaConfigured){ %>
    <p class="workspaceNote">R2 public image storage is not connected on this server. The platform operator must configure the dedicated bucket and public domain. Existing HTTPS image links and previously published website content are preserved.</p>
   <% }else{ %>
   <p class="tiny">Images are publicly accessible to anyone holding their direct link. Add or replace images in Edit business website, save, then publish. An image still used by your draft or published website cannot be deleted.</p>
   <% if((data.media||[]).length){const activeSite=site.details||{},publishedSite=site.published?.details||{};
    const used=url=>[activeSite.logoUrl,activeSite.coverUrl,...(activeSite.gallery||[]),
      publishedSite.logoUrl,publishedSite.coverUrl,...(publishedSite.gallery||[])].includes(url); %>
   <div class="workspaceMediaGrid">
    <% data.media.forEach(item=>{ %>
     <article class="workspaceMediaCard">
      <img loading="lazy" decoding="async" src="<%= item.url %>" alt="Your <%= item.kind %> image">
      <div class="workspaceMediaMeta"><strong><%= item.kind==='gallery'?'Gallery photo':item.kind==='logo'?'Business logo':'Banner / cover' %></strong><span><%= Math.ceil(item.bytes/1024) %> KB</span></div>
      <div class="workspaceActions">
       <% if(used(item.url)){ %><span class="tag">In use</span><% }else{ %>
       <form method="post" action="/tenant/workspace/media/<%= item._id %>/delete">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btnDanger" type="submit"><%= item.status==='deleting'?'Retry cleanup':'Delete unused' %></button>
       </form>
       <% } %>
       <% if(item.status==='deleting'){ %><span class="tag">Cleanup pending</span><% } %>
      </div>
     </article>
    <% }) %>
   </div>
   <% }else{ %><p>No images have been uploaded to your media library yet.</p><% } %>
   <% } %>
  </div>
 </section>
 <% } %>
 <p class="workspaceNote">Your basic business profile appears after activation. Additional details and uploaded images appear on the profile after you publish. Reviews are submitted by customers and moderated independently. Never upload customer documents or financial records to the public-image bucket.</p>
<% } %>
<% if(data.page==='branding'){ const b=data.config.branding; %>
 <div class="card"><div class="cardHead"><div><b>Branding & receipts</b><br><span>Colors, tenant identity, and receipt wording</span></div><div class="workspaceActions"><% if(data.canManage){ %><a class="btn btnPrimary" href="/tenant/workspace/branding/edit" data-workspace-open="workspaceEditor">Edit colors</a><a class="btn" href="/tenant/workspace/branding/receipt/edit" data-workspace-open="workspaceReceiptEditor">Edit receipt settings</a><% } %><a class="btn" href="/tenant/workspace/receipt-preview">Preview receipt</a></div></div><div class="cardBody"><dl class="workspaceFacts"><% [['Theme',b.theme],['Primary color',b.primary],['Secondary color',b.secondary],['Logo status',b.logoStatus],['Receipt prefix',b.prefix],['Receipt title',b.template],['Receipt design',b.receiptLayout],['Receipt heading',b.receiptHeader],['Logo on receipts',b.receiptShowLogo!==false?'Yes':'No'],['Receipt footer note',b.receiptNote],['Rate board title',b.rateBoardTitle],['Rate board style',b.rateBoardStyle],['Public rates enabled',b.publicRatesEnabled!==false?'Yes':'No']].forEach(row=>{ %><div><dt><%= row[0] %></dt><dd><%= row[1]||'—' %></dd></div><% }) %></dl></div></div>
 <p class="workspaceNote">Your chosen receipt design, logo, colors, heading, and footer apply to new displays of authorized historical acknowledgements. Amounts, original references and financial status are immutable. Only independently approved, unexpired Forex rates can appear on the public board.</p>
 <section class="card workspaceRatePreview" style="--boardPrimary:<%= /^#[a-fA-F0-9]{6}$/.test(b.primary||'')?b.primary:'#082c52' %>">
  <% const board=data.rateBoardPreview||{settings:{enabled:false,title:'Exchange rates'},rates:[]}; %>
  <div class="cardHead"><div><b>Live rate board preview</b><br><span>Business-approved prices, no demo values</span></div>
   <div class="workspaceActions"><% if(data.canManage){ %><a class="btn btnPrimary" href="/tenant/workspace/branding/edit" data-workspace-open="workspaceEditor">Customize board</a><% } %>
    <% if(data.config.landing?.publishedAt){ %><a class="btn" href="/t/<%= encodeURIComponent(tenant.slug) %>#business-rates" target="_blank" rel="noopener noreferrer">Public rate board</a><% } %></div>
  </div>
  <div class="cardBody"><div class="workspaceRatePreviewTitle"><strong><%= board.settings.title||'Current exchange rates' %></strong><span class="tag"><%= board.settings.enabled?'Public':'Hidden' %></span></div>
   <p class="tiny"><%= board.settings.note||'Business-approved prices. Confirm before trading.' %> This is not an independent market feed.</p>
   <% if(board.rates.length){ %>
    <div class="tableWrap"><table class="<%= board.settings.style==='cards'?'workspaceRateCardRows':'' %>"><thead><tr><th>Branch</th><th>From</th><th>Type</th><th>Approved rate</th><th>Expires (branch time)</th></tr></thead><tbody>
    <% board.rates.forEach(rate=>{ %><tr><td><%= rate.branch %></td><td><%= rate.base %></td><td><%= rate.side==='buy'?'Buy':rate.side==='sell'?'Sell':'Indicative' %></td><td><b><%= rate.price %> <%= rate.to %></b></td><td><%= rate.expiresLocal %> (<%= rate.timeZone %>)</td></tr><% }) %>
    </tbody></table></div>
   <% }else{ %><p class="workspaceRateEmpty"><%= board.settings.enabled?'No approved, unexpired Forex rates are available. Create rates in Forex Operations.':'Public rate publication is disabled in Branding.' %></p><% } %>
   <p class="tiny">Only real, approved, active records appear. Historical records remain unchanged.</p>
  </div>
 </section>
<% } %>
<% if(data.spec){ const canEditEntries=data.canManage&&data.page!=='import-export'; %>
 <% if(data.page==='kyc'){ %><div class="workspaceActions"><% if(data.canCustomers){ %><a class="btn" href="/tenant/customers">Customers directory</a><% } %><% if(data.canCustomerExport){ %><a class="btn" href="/tenant/customers/export.csv">Export KYC</a><% } %></div><p class="workspaceNote">These field definitions document your verification requirements. Required fields do not change existing transaction acceptance rules. Customer verification is maintained in the customer directory.</p><% } %>
 <% if(data.page==='integrations'){ %><div class="workspaceActions"><% if(data.canSms){ %><a class="btn btnPrimary" href="/tenant/sms-capture">Android SMS gateway</a><% } %></div><p class="workspaceNote">Integration descriptions contain no credentials and do not establish provider connections. Configure working Android devices and signed message reception in SMS capture. Other provider secrets belong in managed platform configuration.</p><% } %>
 <% if(data.page==='notification-rules'){ %><div class="workspaceActions"><% if(data.canNotifications){ %><a class="btn" href="/tenant/notifications">Notification templates & delivery</a><% } %></div><p class="workspaceNote">Rules saved here document alert policies. Actual messages, delivery states, and supported templates are managed in Notifications. Saving a rule does not start a background alert scheduler.</p><% } %>
 <% if(data.page==='compliance'){ %><p class="workspaceNote">Compliance rule definitions record your policies and risk levels. Transaction limits, mandatory approvals, and server permissions continue to follow the active controls for each operation; these descriptions do not create executable rules.</p><% } %>
 <% if(data.page==='import-export'){ %><div class="workspaceActions"><% if(data.canManage){ %><a class="btn btnPrimary" href="/tenant/workspace/export.json">Export workspace settings</a><% } %><a class="btn" href="/tenant/workspace/audit.csv">Audit export</a><% if(data.canCustomerExport){ %><a class="btn" href="/tenant/customers/export.csv">Export customers</a><% } %></div><p class="workspaceNote">Exports download current scoped database records. Onboarding notes document a proposed migration or export. Saving a note does not run an import or export worker. Use the download buttons above for working exports.</p><% } %>
 <div class="card"><div class="cardHead"><div><b><%= data.page==='landing'?'Website information sections':data.title %></b><br><span><%= data.entries.filter(item=>item.status!=='archived').length %> current records</span></div><% if(canEditEntries){ %><a class="btn btnPrimary" href="/tenant/workspace/entries/<%= data.spec.kind %>/new" data-workspace-open="workspaceEditor"><%= data.spec.create %></a><% } %></div><div class="cardBody tableWrap"><table><thead><tr><th><%= data.page==='landing'?'Section':data.page==='kyc'?'Field':'Name' %></th><th>Details</th><th>Status</th><th>Updated</th><% if(canEditEntries){ %><th>Actions</th><% } %></tr></thead><tbody>
 <% if(!data.entries.length){ %><tr><td colspan="5" class="workspaceEmpty">No <%= data.page==='landing'?'landing sections':data.page==='kyc'?'KYC fields':'records' %> yet.<% if(canEditEntries){ %> Use <%= data.spec.create.toLowerCase() %> to create the first one.<% } %></td></tr><% } %>
 <% data.entries.forEach(item=>{ %><tr class="<%= item.status==='archived'?'workspaceArchived':'' %>"><td><b><%= item.name %></b><br><span class="tiny"><%= item.type||item.channel||item.riskLevel||'' %><%= item.required?' · Required':'' %></span></td><td class="workspaceText"><%= item.description||'—' %><% if(item.options?.length){ %><br><span class="tiny">Choices: <%= item.options.join(', ') %></span><% } %><% if(data.page==='import-export'){ %><br><span class="tiny">Onboarding note only</span><% } %><% if(item.result){ %><br><span class="tiny"><%= item.result %></span><% } %></td><td><span class="tag"><%= item.status %></span></td><td><%= fmtDate(item.updatedAt) %></td><% if(canEditEntries){ %><td><div class="workspaceTableActions"><% if(item.status!=='archived'){ %><a class="btn" href="/tenant/workspace/entries/<%= data.spec.kind %>/<%= item._id %>/edit" data-workspace-edit>Edit</a><% } %><form method="post" action="/tenant/workspace/entries/<%= data.spec.kind %>/<%= item._id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= item.revision %>"><input type="hidden" name="action" value="<%= item.status==='archived'?'restore':'archive' %>"><button class="btn <%= item.status==='archived'?'':'btnDanger' %>"><%= item.status==='archived'?'Restore':'Soft delete' %></button></form></div></td><% } %></tr><% }) %>
 </tbody></table></div></div>
<% } %>
<% if(data.page==='database'){ const s=data.stats; %>
 <div class="grid3"><div class="stat"><div class="k">Collections</div><div class="v"><%= s.collections %></div><div class="s">Current tenant database</div></div><div class="stat"><div class="k">Stored documents</div><div class="v"><%= s.objects %></div><div class="s">Actual database statistics</div></div><div class="stat"><div class="k">Data size</div><div class="v"><%= (s.dataBytes/1048576).toFixed(2) %> MB</div><div class="s">Logical document storage</div></div></div>
 <div class="card"><div class="cardHead"><div><b>Tenant database</b><br><span>Statistics checked <%= fmtDate(s.checkedAt) %></span></div><% if(data.canManage){ %><form method="post" action="/tenant/workspace/database/health"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn">Health check</button></form><% } %></div><div class="cardBody"><dl class="workspaceFacts"><div><dt>Isolation</dt><dd>Separate tenant database</dd></div><div><dt>Allocated storage</dt><dd><%= (s.storageBytes/1048576).toFixed(2) %> MB</dd></div><div><dt>Backup configuration</dt><dd><%= s.backupConfigured?'Present; operator verification required':'Not configured' %></dd></div><div><dt>Restore access</dt><dd>Platform operator only</dd></div></dl></div></div><p class="workspaceNote">Encrypted backups cover the full database replica set and run through the platform's dedicated backup service. Tenant sessions cannot download another tenant's data, launch a full-cluster restore, or change database paths. A configuration flag does not confirm backup health.</p>
<% } %>
<% if(data.page==='subscription'){ const terms=data.terms,s=terms.subscription; %>
 <div class="card"><div class="cardHead"><div><b>Subscription & limits</b><br><span>Platform-issued subscription snapshot</span></div><% if(data.canManage){ %><a class="btn" href="/tenant/modules">Request modules</a><a class="btn" href="/tenant/billing">Billing & Plan</a><% } %></div><div class="cardBody"><dl class="workspaceFacts"><% [['Plan',s?.planName||tenant.plan],['Subscription status',s?.status||'No subscription grant'],['Effective now',terms.effective?'Yes':'No'],['Billing currency',s?.currency||'—'],['Monthly price',s?`${s.currency} ${(s.priceMonthlyMinor/100).toFixed(2)}`:'—'],['Current period end',fmtDate(s?.periodEnd)],['Reserved user seats',terms.seatsReserved],['Active branch allocation',terms.branchCount]].forEach(row=>{ %><div><dt><%= row[0] %></dt><dd><%= row[1] %></dd></div><% }) %></dl></div></div>
 <div class="card"><div class="cardHead"><b>Plan limits</b></div><div class="cardBody"><dl class="workspaceFacts"><% Object.entries(s?.limits||{}).forEach(([key,value])=>{ %><div><dt><%= ({users:'User limit',branches:'Branch limit',transactionsPerMonth:'Monthly transaction limit',smsPerMonth:'Monthly SMS limit',storageMb:'Storage limit (MB)'})[key]||key %></dt><dd><%= value %></dd></div><% }) %></dl><% if(!s){ %><p>No authoritative subscription snapshot is recorded.</p><% } %></div></div>
 <div class="card"><div class="cardHead"><b>Included modules and additional grants</b></div><div class="cardBody"><div class="workspaceServiceTags"><% (s?.modules||[]).forEach(key=>{ %><span class="tag"><%= key %></span><% }) %></div><% terms.grants.forEach(grant=>{ %><p><b><%= grant.moduleKey %></b> · <%= grant.status %> · until <%= fmtDate(grant.periodEnd) %></p><% }) %></div></div><p class="workspaceNote">Plan prices, entitlements, and limits are read from authoritative platform grants. Use Modules to request additions; tenant users cannot grant plans or raise their own limits.</p>
<% } %>
<% if(data.page==='landing-preview'){ const d=data.config.landing.details||{}; %>
 <div class="workspaceActions"><a class="btn" href="/tenant/workspace/landing">Back to landing setup</a><span class="tag">Private draft preview</span></div><div class="workspacePageHero"><span class="tag"><%= data.config.profile.name %></span><h2><%= data.config.landing.headline||'Your landing headline' %></h2><p class="workspaceText"><%= data.config.landing.subtitle||'Save your landing headline and service description to preview them here.' %></p><div class="workspaceServiceTags"><% data.config.landing.services.forEach(text=>{ %><span class="tag"><%= text %></span><% }) %></div></div><div class="workspaceCardGrid"><% data.sections.filter(s=>s.status!=='hidden').forEach(section=>{ %><article class="card"><div class="cardHead"><b><%= section.name %></b><span class="tag"><%= section.status %></span></div><div class="cardBody workspaceText"><%= section.description %></div></article><% }) %></div><div class="card"><div class="cardHead"><b>Draft business website details</b></div><div class="cardBody"><dl class="workspaceFacts"><% [['About',d.about],['Category',d.category],['Address',[d.address,d.city,d.region].filter(Boolean).join(', ')],['Hours',d.hours],['Public email',d.publicEmail],['WhatsApp',d.whatsapp],['Website',d.website],['Gallery photos',(d.gallery||[]).length]].forEach(item=>{ %><div><dt><%= item[0] %></dt><dd><%= item[1]||'—' %></dd></div><% }) %></dl></div></div><% if(data.config.profile.supportPhone){ %><p>Public support phone after publication: <b><%= data.config.profile.supportPhone %></b></p><% } %>
<% } %>
<% if(data.page==='receipt-preview'){ %>
 <div class="workspaceActions"><a class="btn" href="/tenant/workspace/branding">Back to branding & receipts</a><span class="tag">Safe preview · no transaction</span></div><article class="workspacePreviewReceipt receiptPreview--<%= ['classic','compact','detailed'].includes(data.config.branding.receiptLayout)?data.config.branding.receiptLayout:'classic' %>" style="--receipt-primary:<%= /^#[a-fA-F0-9]{6}$/.test(data.config.branding.primary)?data.config.branding.primary:'#082c52' %>;--receipt-secondary:<%= /^#[a-fA-F0-9]{6}$/.test(data.config.branding.secondary)?data.config.branding.secondary:'#0d4f91' %>">
 <header class="workspaceReceiptHeader"><% if(data.config.branding.receiptShowLogo!==false){ %><img src="<%= data.config.landing?.details?.logoUrl||'/images/classicfinhub-mark.png' %>" alt="Receipt brand logo" width="70" height="70"><% } %><h2><%= data.config.profile.name %></h2><p><%= data.config.branding.receiptHeader||'Transaction acknowledgement' %></p><b><%= data.config.branding.template %></b></header>
 <dl class="workspaceFacts"><div><dt>Reference prefix</dt><dd><%= data.config.branding.prefix %></dd></div><div><dt>Document</dt><dd>Design preview only</dd></div><div><dt>Support phone</dt><dd><%= data.config.profile.supportPhone||'—' %></dd></div><div><dt>Document status</dt><dd>Not a payment receipt</dd></div></dl>
 <p class="workspaceText"><%= data.config.branding.receiptNote %></p><p class="tiny">Live receipts display verified stored amounts and original references. This preview does not claim a transaction occurred.</p>
 </article>
<% } %>
<% if(data.page==='customer-portal-preview'){ %>
 <div class="card"><div class="cardHead"><div><b>Customer portal preview</b><br><span>Current customer support and public information</span></div></div><div class="cardBody"><h2><%= data.config.profile.name %></h2><p>Support: <%= data.config.profile.supportPhone||data.config.profile.ownerEmail||'Contact details have not been configured.' %></p><% if(data.config.landing.publishedAt){ %><a class="btn" href="/t/<%= tenant.slug %>">View published landing page</a><% } %><p class="workspaceNote">Customer authentication, transfer tracking, and public receipt verification are not enabled by this preview. Actual operational records remain available only to authorized workspace staff.</p></div></div>
<% } %>
<% if(data.page==='audit'){ %>
 <div class="card"><div class="cardHead"><div><b>Tenant audit activity</b><br><span>Latest 200 workspace configuration events</span></div><a class="btn" href="/tenant/workspace/audit.csv">Export audit</a></div><div class="cardBody tableWrap"><table><thead><tr><th>Time</th><th>Action</th><th>Actor</th><th>Record</th><th>Revision</th></tr></thead><tbody><% if(!data.logs.length){ %><tr><td colspan="5" class="workspaceEmpty">No workspace configuration events yet.</td></tr><% } %><% data.logs.forEach(log=>{ %><tr><td><%= fmtDate(log.createdAt) %></td><td><%= log.action %></td><td class="mono"><%= log.actorId %></td><td><%= log.metadata?.name||log.targetId||'—' %></td><td><%= log.metadata?.revision??'—' %></td></tr><% }) %></tbody></table></div></div>
<% } %>
</section>
<% if(data.canManage&&data.form){ %><%- include('_dialog',{id:'workspaceEditor',titleId:'workspaceEditorTitle',title:data.form.title,subtitle:data.form.subtitle,form:data.form,remote:false}) %><% } %>
<% if(data.canManage&&data.heroForm){ %><%- include('_dialog',{id:'workspaceHeroEditor',titleId:'workspaceHeroTitle',title:data.heroForm.title,subtitle:data.heroForm.subtitle,form:data.heroForm,remote:false}) %><% } %>
<% if(data.canManage&&data.receiptForm){ %><%- include('_dialog',{id:'workspaceReceiptEditor',titleId:'workspaceReceiptTitle',title:data.receiptForm.title,subtitle:data.receiptForm.subtitle,form:data.receiptForm,remote:false}) %><% } %>
<% if(data.canManage){ %><%- include('_dialog',{id:'workspaceRemoteEditor',titleId:'workspaceRemoteTitle',title:'Edit workspace record',subtitle:'Update this tenant’s settings.',form:null,remote:true}) %><% } %>
<script src="/js/workspace.js?v=<%= assetVersion %>" defer></script>
