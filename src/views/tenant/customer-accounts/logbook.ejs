<section class="view show"><div class="rowBtns"><a class="btn" href="/tenant/customers">Customers directory</a><% if(data.canCreateCustomer){ %><a class="btn btnPrimary" href="/tenant/customers/new">New customer</a><% }if(data.records.customerId){ %><a class="btn" href="/tenant/customers/<%= data.records.customerId %>">Customer profile</a><% } %></div><section class="card" style="margin-top:14px"><div class="cardHead"><div><b>Customer logbook</b><br><span>Recent transactions from recorded phones and linked accounts</span></div></div><div class="cardBody"><p class="tiny">Only your assigned modules and permitted branches appear. A recorded phone match does not verify customer identity or provider settlement.</p><div class="txList"><% if(!data.records.items.length){ %><p class="tiny">No customer activity is linked in your permitted scope. Phone matches appear after a customer’s international phone is recorded on an operation; account activity appears after a real ledger journal is posted.</p><% }data.records.items.forEach(row=>{ %><div class="tx" data-search-row><div class="txMeta"><b><a href="<%= row.href %>"><%= row.reference||row.label %></a></b><span><%= row.label %> · <%= row.status %> · <%= row.customers.map(c=>c.name).join(', ') %></span><span><%= row.matchBasis %> · <%= new Date(row.createdAt).toLocaleString('en-GB') %></span></div><b><%= data.formatMinor(row.amountMinor,row.currency) %></b></div><% }) %></div><% if(data.records.nextCursor){ %><a class="btn" href="/tenant/customers/logbook?customerId=<%= data.records.customerId||'' %>&amp;cursor=<%= encodeURIComponent(data.records.nextCursor) %>">Next activity</a><% } %></div></section></section>
