# Copy to a private host file (0600); never commit completed credentials.
NODE_ENV=production
PORT=3000
APP_URL=https://replace-with-real-domain.example
TRUST_PROXY=1
SESSION_SECRET=
MFA_ENABLED=true
MFA_ENCRYPTION_KEY=
# Authenticated, TLS-protected replica-set URI naming the platform database.
PLATFORM_DB_URI=
# Optional base with empty database path and the same web principal/options.
# SRV pairs may omit authSource from both; otherwise set the same explicit value.
MONGO_URI_BASE=
REAL_MONEY_ENABLED=false
SEO_INDEXING_ENABLED=true
# MAIL_PROVIDER=gmail uses the Gmail send-only OAuth2 API; resend remains the legacy default.
MAIL_PROVIDER=resend
RESEND_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MAIL_FROM=
# Generate once: openssl rand -hex 32; keep identical in web and outbox worker.
INVITE_MAIL_ENCRYPTION_KEY_HEX=
# Receiver PIN SMS: none preserves explicit manual handoff. Set twilio only
# after configuring the notification worker and testing real handset delivery.
TRANSFER_SMS_PROVIDER=none
# Independent 32 random bytes as 64 hex; same value in notification worker.
# Keep stable: pending queued SMS depends on this encryption key.
TRANSFER_SMS_ENCRYPTION_KEY=
# Optional trusted internal evidence gateway, only after its adapter is approved.
FINANCIAL_GATEWAY_CALLBACK_HMAC_KEY_HEX=
FINANCIAL_GATEWAY_STATEMENT_HMAC_KEY_HEX=

# Trusted, overwriting edge GeoIP only; South Sudan is the default.
GEO_COUNTRY_HEADERS_TRUSTED=false
GEO_COUNTRY_HEADER=cf-ipcountry
# Tenant business archives (web needs read-only access to this persistent mount).
TENANT_BACKUPS_ENABLED=false
TENANT_BACKUP_ENCRYPTION_KEY=
TENANT_BACKUP_DIR=/var/lib/classicfin/tenant-backups
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
