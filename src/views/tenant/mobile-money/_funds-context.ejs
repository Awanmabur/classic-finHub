<% const funds=data.funds||{wallets:[],paymentAccounts:[]};
   // Show actual branch accounts to permitted owners even if another cashier owns
   // them, but never allow posting against another operator's custody.
   const walletOptions=funds.wallets||[];
   const ownWallet=w=>(w.assignedToOperator||w.shared);
   const readyWallet=w=>ownWallet(w)&&w.state==='active'&&w.reconciliation==='matched'&&w.expectedMinor!==null;
   const availableWallets=walletOptions.filter(readyWallet); %>
<div class="row2" data-mobile-funds>
 <input type="hidden" name="walletFeePolicy" data-wallet-fee-policy disabled>
 <label class="field" data-wallet-account-field>Provider float wallet<select class="control" name="walletAccountId" required data-wallet-account><option value="">Select wallet</option><% walletOptions.forEach(wallet=>{ %><option value="<%= wallet.id %>" data-network="<%= wallet.network %>" data-currency="<%= wallet.currency %>" data-expected-minor="<%= wallet.expectedMinor??'' %>" data-state="<%= wallet.state %>" data-reconciliation="<%= wallet.reconciliation %>" data-default="<%= wallet.isDefault?'true':'false' %>" data-assigned="<%= wallet.assignedToOperator?'true':'false' %>" data-fee-treatment="<%= wallet.feeTreatment||'record_only' %>" data-cash-drawer="<%= wallet.cashDrawerAccountId||'' %>" <%= !readyWallet(wallet)?'disabled':'' %>><%= wallet.name %> · <%= wallet.currency==='KES'?'KSH':wallet.currency %> · <%= wallet.network %><%= !ownWallet(wallet)?' (assigned to another cashier)':wallet.state!=='active'||wallet.reconciliation!=='matched'||wallet.expectedMinor===null?' (opening or reconciliation required)':'' %></option><% }) %></select><% if(!availableWallets.length){ %><span class="tiny" role="status">No ready provider wallet is available to your cashier login. <% if(walletOptions.some(w=>!ownWallet(w))){ %>Some wallets belong to another cashier; sign in as their assigned operator or ask the owner to assign your actual wallet.<% }else{ %>Ask the owner to create or approve a real provider wallet in Treasury.<% } %> <a href="/tenant/treasury">Review funds setup</a>.</span><% } %></label>
 
 <% const usableCash=(funds.paymentAccounts||[]).filter(a=>a.kind==='cash'&&a.assignedToOperator&&a.state==='active'&&a.reconciliation==='matched'&&a.expectedMinor!==null);
    const preferredSSP=usableCash.find(a=>a.currency==='SSP'&&a.isDefault)||usableCash.find(a=>a.currency==='SSP');
    const selectedCash=preferredSSP||(usableCash.length===1?usableCash[0]:null); %>
 <label class="field" data-payment-account-field>Cash drawer · customer receives or pays
  <select class="control" name="paymentAccountId" data-payment-account required>
   <option value="">Select cash drawer</option>
   <% (funds.paymentAccounts||[]).filter(a=>a.kind==='cash').forEach(account=>{ %>
    <option value="<%= account.id %>" data-method="Cash" data-currency="<%= account.currency %>"
     data-state="<%= account.state %>" data-reconciliation="<%= account.reconciliation %>"
     data-assigned="true" data-opened="<%= account.expectedMinor!==null?'true':'false' %>"
     data-expected-minor="<%= account.expectedMinor??'' %>"
     <%= !account.assignedToOperator||account.state!=='active'||account.reconciliation!=='matched'||account.expectedMinor===null?'disabled':'' %>
     <%= selectedCash?.id===account.id?'selected':'' %>><%= account.name %> · <%= account.currency==='KES'?'KSH':account.currency %><%= !account.assignedToOperator?' (assigned to another cashier)':account.state!=='active'||account.reconciliation!=='matched'||account.expectedMinor===null?' (opening or reconciliation required)':'' %></option>
   <% }) %>
  </select>
  <% if(!usableCash.length){ %><span class="tiny" role="status">No ready physical cash drawer is assigned to this cashier login. <% if((funds.paymentAccounts||[]).some(a=>a.kind==='cash'&&!a.assignedToOperator)){ %>The branch has drawers assigned to other staff; use the authorized drawer operator account or update the assignment.<% }else{ %>Open and approve a real cash drawer before accepting customers.<% } %> <a href="/tenant/treasury">Review cash setup</a>.</span><% } %>
 </label>
</div>
