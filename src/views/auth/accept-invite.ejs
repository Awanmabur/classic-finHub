<!doctype html><html lang="en"><head>
  <link rel="icon" type="image/png" href="/images/classicfinhub-logo.png"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Activate tenant access | ClassicFin Hub</title><link rel="stylesheet" href="/css/style.css"></head>
<body class="legal-body auth-body"><main class="auth-main"><section class="auth-card" style="max-width:520px;margin:3rem auto;padding:2rem"><h1>Activate tenant account</h1><p>Use the private invitation sent by your administrator. An invitation expires after 48 hours and can be used only once.</p>
<form method="post" action="/accept-invite" autocomplete="off" data-activation-form hidden><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="token" value="" data-activation-token><label><span>New password (14+ characters)</span><input type="password" minlength="14" maxlength="72" name="password" required autocomplete="new-password"></label><label><span>Confirm password</span><input type="password" name="confirmPassword" minlength="14" maxlength="72" required autocomplete="new-password"></label><p class="auth-helper">Use 14 or more characters, with uppercase, lowercase, a number and a symbol. Maximum 72 UTF-8 bytes (some characters use more than one byte).</p><button class="btn btn-dark" type="submit">Activate account</button></form><p data-activation-missing>Invitation missing or invalid. Request a new link from the platform administrator.</p>
<a href="/signin">Back to sign in</a><script src="/js/activation.js" defer></script></section></main></body></html>
